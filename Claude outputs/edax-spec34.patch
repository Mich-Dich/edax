@@ -0,0 +1,34 @@
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+static void step(std::vector<float>& px, std::vector<float>& py, std::vector<float>& vx, std::vector<float>& vy, float dt) {
+    for (size_t i = 0; i < px.size(); ++i) {
+        vy[i] -= 9.81f * dt;
+        vx[i] *= 0.999f;
+        vy[i] *= 0.999f;
+        px[i] += vx[i] * dt;
+        py[i] += vy[i] * dt;
+        if (py[i] < 0.0f) {
+            py[i] = -py[i];
+            vy[i] = -vy[i] * 0.8f;
+        }
+    }
+}
+int main() {
+    size_t n = 200000;
+    std::vector<float> px, py, vx, vy;
+    uint32_t seed = 12345;
+    for (size_t i = 0; i < n; ++i) {
+        seed = seed * 1664525u + 1013904223u;
+        float r = (float)(seed >> 8) / 16777216.0f;
+        px.push_back(r * 100.0f);
+        py.push_back(r * 50.0f + 1.0f);
+        vx.push_back(r - 0.5f);
+        vy.push_back(0.0f);
+    }
+    for (int s = 0; s < 100; ++s) step(px, py, vx, vy, 0.01f);
+    double sum = 0.0;
+    for (size_t i = 0; i < n; ++i) sum += (double)px[i] + (double)py[i];
+    std::printf("%llu\n", (unsigned long long)std::llround(sum));
+}
diff --git a/bench/edax/particles.ed b/bench/edax/particles.ed
new file mode 100644
index 0000000..d940421
--- /dev/null
+++ b/bench/edax/particles.ed
@@ -0,0 +1,45 @@
+// Particles in structure-of-arrays form (spec 34): 200k particles, 100 steps of gravity, drag and
+// a floor bounce, then a checksum. The kernel takes its columns as separate references, so the
+// compiler knows the columns don't overlap. Every access is bounds-checked: this benchmark
+// tracks the check removal of spec 34 §1.5.
+import std;
+
+void step(mut std::darray<f32>& px, mut std::darray<f32>& py, mut std::darray<f32>& vx, mut std::darray<f32>& vy, f32 dt) {
+    for (usize i : 0..px.len()) {
+        vy[i] -= 9.81 * dt;
+        vx[i] *= 0.999;
+        vy[i] *= 0.999;
+        px[i] += vx[i] * dt;
+        py[i] += vy[i] * dt;
+        if (py[i] < 0.0) {
+            py[i] = -py[i];
+            vy[i] = -vy[i] * 0.8;
+        }
+    }
+}
+
+i32 main() {
+    usize n = 200000;
+    mut std::darray<f32> px = default;
+    mut std::darray<f32> py = default;
+    mut std::darray<f32> vx = default;
+    mut std::darray<f32> vy = default;
+    mut u32 seed = 12345;
+    for (usize i : 0..n) {
+        seed = seed *% 1664525 +% 1013904223;
+        f32 r = cast::round<f32>(seed >> 8) / 16777216.0;
+        px.push(r * 100.0);
+        py.push(r * 50.0 + 1.0);
+        vx.push(r - 0.5);
+        vy.push(0.0);
+    }
+    for (u32 s : 0..100) {
+        step(mut px, mut py, mut vx, mut vy, 0.01);
+    }
+    mut f64 sum = 0.0;
+    for (usize i : 0..n) {
+        sum += cast<f64>(px[i]) + cast<f64>(py[i]);
+    }
+    std::println(f"{cast::saturate<u64>(sum.round())}");
+    return 0;
+}
