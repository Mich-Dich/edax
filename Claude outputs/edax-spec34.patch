+            if (i >= fn->arg_size() || !fn->getArg(i)->getType()->isPointerTy()) return;
+            if (is_mut) {
+                fn->addParamAttr(i, llvm::Attribute::NoAlias);
+            } else if (is_frozen(object)) {
+                fn->addParamAttr(i, llvm::Attribute::NoAlias);
+                fn->addParamAttr(i, llvm::Attribute::ReadOnly);
+            }
