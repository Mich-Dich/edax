-            if (root) args.push_back(Arg{root, marked, a->span});
+            if (!root) continue;
+            Arg  arg{root, marked, a->span, {}};
+            bool ended = false;
+            field_path(*a, arg.path, ended);
+            args.push_back(std::move(arg));
         }
         for (std::size_t i = 0; i < args.size(); ++i) {
