+import std;
+import math::sum;
+
+// Kept unoptimized whatever the mode: easy to step through in a debugger.
+@std::optimize{ .level = std::build::optimization::none }
+u64 slow_path(u64 x) {
+    return x + 1;
+}
+
+void main() {
+    std::println(f"mix: {math::mix(1000)}");
+    std::println(f"slow path: {slow_path(41)}");
+    std::println(f"debug-like: {std::build::mode_is(std::build::mode::debug)}");
+    std::println(f"development: {std::build::mode_is(std::build::mode::development)}");
+    std::println(f"optimization: {std::build::current_mode().optimization() == std::build::optimization::basic}");
+}
diff --git a/tests/action/build/perf_project/build.ed b/tests/action/build/perf_project/build.ed
new file mode 100644
index 0000000..eb62add
--- /dev/null
+++ b/tests/action/build/perf_project/build.ed
@@ -0,0 +1,19 @@
+// build.ed of a test project (spec 34): the development mode, per-file optimization and a mode
+// with deterministic floating point.
+import std;
+
+namespace build {
+    // Lockstep multiplayer: float results must be the same on every machine.
+    class lockstep : std::build::mode::release {
+    public:
+        compile_time std::build::float_determinism float_determinism() override { return std::build::float_determinism::strict; }
+    }
+
+    compile_time void build(mut std::build::graph& g) {
+        g.add_mode(lockstep);
+        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
+        // The math is optimized even in debug builds: a debug build stays playable.
+        g.optimize_files(app, "math/*.ed", std::build::optimization::speed);
+        g.add_executable(std::build::edax_target{ .name = "fastmath", .root = "app/fastmath.ed" });
+    }
+}
