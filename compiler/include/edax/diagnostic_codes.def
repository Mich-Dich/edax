EDAX_DIAG(E1009, error,   "missing digits after integer base prefix")
EDAX_DIAG(E1010, error,   "invalid digit for the literal's base")
EDAX_DIAG(E1011, error,   "invalid literal suffix")
EDAX_DIAG(E1012, error,   "integer literal is too large")
EDAX_DIAG(E1013, error,   "float suffix on an integer literal")
EDAX_DIAG(E1014, error,   "missing digits in float exponent")
EDAX_DIAG(E1015, error,   "source is not valid UTF-8")
EDAX_DIAG(E1016, error,   "C string literal contains a NUL character")

