// Registry of every diagnostic the compiler can emit.
//
//   EDAX_DIAG(code, severity, title)
//
// Rules:
//   * Codes are never reused or renumbered once released; retire a code by leaving it here
//     with a "(retired)" title.
//   * Ranges:  E0xxx driver / I/O      E1xxx lexer      E2xxx parser (M2)
//              E3xxx names / modules    E4xxx types      E5xxx ownership / borrows
//              E6xxx code generation
//              Wxxxx warnings, same ranges.
//   * The title is what `edaxc explain <code>` prints. The message at the report site can be
//     more specific.

#ifndef EDAX_DIAG
#error "define EDAX_DIAG(code, severity, title) before including diagnostic_codes.def"
#endif

// --- driver ---------------------------------------------------------------------------------
EDAX_DIAG(E0001, error,   "cannot read source file")
EDAX_DIAG(E0002, error,   "unsupported source file extension (expected .ed or .edh)")
EDAX_DIAG(E0003, error,   "cannot run the C compiler")
EDAX_DIAG(E0004, error,   "cannot write the output file")

