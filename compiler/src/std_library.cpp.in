const std::string& std_source_dir() {
    static const std::string dir = [] {
        std::error_code ec;
        std::filesystem::path exe = std::filesystem::read_symlink("/proc/self/exe", ec);
        if (!ec) {
            std::filesystem::path installed = exe.parent_path().parent_path() / "share" / "edax" / "std";
            if (std::filesystem::exists(installed / "std.edh", ec)) return installed.string();
        }
        return std::string(EDAX_STD_DIR);
    }();
    return dir;
}

