// Blocks, `if` and `match` are expressions; `for` only goes over ranges and containers.
import std;

i32 main() {
    i32 t = 12;
    std::static_str feel = if (t < 0) { "freezing" } else if (t < 15) { "cool" } else { "warm" };
    u32 squares = {
        mut u32 s = 0;
        for (u32 i : 1..=3) { s += i * i; }      // 1..=3 includes 3; 1..3 doesn't
        s                                        // the block's value: no `;`
    };
    u32 flags = 0b0110;
    if (flags & bit(2)) { std::println("bit 2 is set"); }   // an integer is a condition here
    std::println(f"{feel} {squares} {t:+} {3.14159f64:.2}");
    return 0;
}
//> bit 2 is set
//> cool 14 +12 3.14
