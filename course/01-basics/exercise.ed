import std;

// The readings of one day, in tenths of a degree (i16: -3276.8 to 3276.7 degrees)
compile_time std::array<i16, 8> readings = [-35, -12, 4, 31, 87, 122, 96, 18];

// Smallest and largest reading, as a tuple
(i16, i16) min_max(std::span<i16> values) {

    mut i16 low = i16::min;
    mut i16 high = i16::max;
    for (i16 value : values) {
        low = low.min(value);
        high = high.max(value);
    }
    return (low, high);
}

// The mean in degrees. The sum doesn't fit in i16: add the values up as i64
f64 mean_degrees(std::span<i16> values) {
    mut i64 sum = 0;
    for (i16 value : values) {
        sum += cast<i64>(value);
    }
    // TODO: sum, then convert to f64. Which casts are lossless, and which have to say how?
    return cast<f64>(sum / cast<i64>(values.size()));
}

// Counts the readings at or above `threshold`, and adds to `below_zero` the readings below zero
usize count_at_least(std::span<i16> values, i16 threshold, mut usize& below_zero) {
    // TODO
    return 0;
}

// "freezing" below 0.0, "cold" below 5.0, else "mild": write it as one `if` expression
// TODO: this returns std::str, which doesn't compile - see "Returning text" in the lesson
std::static_str describe(f64 mean) {
    return if (mean < 0.0) { "freezing" }
        else if (mean < 5.0) { "cold" }
        else { "mild" };
}

i32 main() {
    // TODO: an std::array isn't a span; pass readings.as_span()
    (i16 low, i16 high) = min_max(readings.as_span());
    f64 mean = 0.0;
    mut usize frosty = 0;
    usize warm = 0;
    std::println(f"low {low}, high {high}, span {high - low} tenths");
    std::println(f"mean {mean:.2} degrees: {describe(mean)}");
    std::println(f"{warm} readings at 5.0 or above, {frosty} below zero");
    // TODO: `level` is `high` clamped into a u8; `wrapped` is level + 200 wrapping around
    u8 level = 0;
    u8 wrapped = 0;
    std::println(f"saturated {level}, wrapped {wrapped}");
    return 0;
}
