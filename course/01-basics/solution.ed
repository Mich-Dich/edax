// Lesson 1: a temperature report (solution).
import std;

// The readings of one day, in tenths of a degree (i16: -3276.8 to 3276.7 degrees).
compile_time std::array<i16, 8> readings = [-35, -12, 4, 31, 87, 122, 96, 18];

// Smallest and largest reading, as a tuple.
(i16, i16) min_max(std::span<i16> values) {
    mut i16 low = i16::max;
    mut i16 high = i16::min;
    for (i16 v : values) {
        low = low.min(v);
        high = high.max(v);
    }
    return (low, high);
}

// The mean in degrees: the sum doesn't fit in i16, so it is summed as i64.
f64 mean_degrees(std::span<i16> values) {
    mut i64 sum = 0;
    for (i16 v : values) {
        sum += cast<i64>(v);
    }
    return cast::round<f64>(sum) / cast::round<f64>(values.length()) / 10.0;
}

// Counts the readings at or above `threshold`, and tells the caller how many were below zero.
usize count_at_least(std::span<i16> values, i16 threshold, mut usize& below_zero) {
    mut usize count = 0;
    for (i16 v : values) {
        if (v >= threshold) { count += 1; }
        if (v < 0) { below_zero += 1; }
    }
    return count;
}

std::static_str describe(f64 mean) {
    return if (mean < 0.0) { "freezing" } else if (mean < 5.0) { "cold" } else { "mild" };
}

i32 main() {
    (i16 low, i16 high) = min_max(readings.as_span());
    f64 mean = mean_degrees(readings.as_span());
    mut usize frosty = 0;
    usize warm = count_at_least(readings.as_span(), 50, mut frosty);
    std::println(f"low {low}, high {high}, span {high - low} tenths");
    std::println(f"mean {mean:.2} degrees: {describe(mean)}");
    std::println(f"{warm} readings at 5.0 or above, {frosty} below zero");
    u8 level = cast::saturate<u8>(high);
    u8 wrapped = level +% 200;
    std::println(f"saturated {level}, wrapped {wrapped}");
    return 0;
}
