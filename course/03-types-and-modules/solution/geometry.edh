// The module `geometry`: what other modules see.
import std;

namespace geo {
    // A point or a direction. A copy type: all fields are numbers.
    struct vec2 {
        f32 x = 0.0;
        f32 y = 0.0;

        vec2 operator+(vec2& other);
        vec2 operator-(vec2& other);
        f32  cross(vec2& other);
        f32  length();
        bool operator==(vec2& other) = default;
    }

    // A closed polygon with a name. It owns its points; its fields are private (in geometry.ed).
    class polygon {
    public:
        static polygon named(std::str name);
        void  add(vec2 p) mut;
        usize corners();
        f32   area();
        f32   perimeter();
        std::str name();
        ~polygon();
    }

    // "square: 4 corners, area 4.00, perimeter 8.00"
    std::string describe(polygon& p);
}
