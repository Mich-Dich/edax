// One `enum` covers C++'s enum class and std::variant.
import std;

enum op : u8 { add, sub, mul, div }             // the tag type is written; always scoped

struct circle_data {
    f32 radius = 0.0;
}

enum shape : u8 {                               // alternatives may carry one value each
    point,
    circle(circle_data),
    square(f32),
}

f32 area(shape s) {
    return match (s) {
        shape::point => 0.0,
        shape::circle(c) => 3.0 * c.radius * c.radius,
        shape::square(side) => side * side,
    };
}

std::static_str symbol(op o) {
    return match (o) {
        op::add => "+",
        op::sub => "-",
        _ => "* or /",                          // `_` covers the rest
    };
}

i32 main() {
    std::array<shape, 3> shapes = [shape::point, shape::circle(circle_data{ .radius = 2.0 }), shape::square(3.0)];
    std::println(f"{area(shapes[0])} {area(shapes[1])} {area(shapes[2])}");
    std::println(f"{symbol(op::sub)} {symbol(op::div)} {cast<u8>(op::mul)}");
    return 0;
}
//> 0.0 12.0 9.0
//> - * or / 2
