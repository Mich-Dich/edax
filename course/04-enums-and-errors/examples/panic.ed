// A panic ends the process: no unwinding, no destructors, no catch.
import std;

class noisy {
public:
    ~noisy() { std::println("destroyed"); }   // never printed: a panic doesn't unwind
}

i32 main() {
    noisy n = noisy{};
    std::array<u32, 3> xs = [1, 2, 3];
    std::println(f"{xs.get(7).is_some()}");   // get(i) asks: an std::option
    usize i = xs.length() + 4;
    std::println(f"{xs[i]}");                 // [i] out of bounds: a panic
    return 0;
}
//> false
//! panic: index
