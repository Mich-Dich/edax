// Lesson 8: compile-time code and checks. Fill in the TODOs until `python3 course/check.py 8`
// says done. The program ends with a panic on purpose (the last call); only stdout is compared.
import std;

// The CRC-8 table (polynomial 0x07), computed by the compiler: no code for it runs at startup.
compile_time std::array<u8, 256> crc8_table() {
    mut std::array<u8, 256> table = default;
    // TODO: for each byte i, shift it left 8 times; whenever its top bit was set, xor 0x07 in
    // after the shift. table[i] is the result.
    return table;
}
compile_time std::array<u8, 256> crc8 = crc8_table();

compile_time run_time u8 checksum(std::span<u8> bytes) {
    mut u8 crc = 0;
    // TODO: for each byte: crc = crc8[crc xor byte].
    return crc;
}

// The protocol's header, checked when the type is compiled.
@std::derive::formattable
struct header {
    u16 id = 0;
    u8  kind = 0;
    u8  flags = 0;
    u32 length = 0;

    // TODO: a check that fails the build if the header is not exactly 8 bytes, saying how big it is.
}

// A precondition, checked at every call: by the compiler when the argument is known, else when
// the program runs.
u8 percent_to_byte(u32 percent) {
    // TODO: "<percent>% is more than 100%" as a compile error when the argument is known, else a panic.
    return cast::truncate<u8>(percent * 255 / 100);
}

// TODO: the lowest `bits` bits set. Make `bits` a compile_time parameter, refuse 0 and anything
// above 32 at compile time, and handle 32 (where bit(32) doesn't exist) with `if compile_time`.
u32 mask(u32 bits) {
    return 0;
}

i32 main() {
    std::array<u8, 9> message = [49, 50, 51, 52, 53, 54, 55, 56, 57];   // "123456789"
    std::println(f"crc8 of 123456789: {checksum(message.as_span())}");
    compile_time u8 known = checksum([1, 2, 3]);                         // evaluated by the compiler
    std::println(f"crc8 of [1, 2, 3]: {known}");

    header h = header{ .id = 7, .kind = 2, .length = 512 };
    std::println(f"{h}");

    std::println(f"{percent_to_byte(50)} {percent_to_byte(100)}");
    std::println(f"masks {mask(4)} {mask(12)} {mask(32)}");

    // TODO: "debug" when built in a debug-derived mode, else "optimized", decided at compile time.
    std::static_str mode = "?";
    std::println(f"built as {mode}");

    u32 user_value = cast::truncate<u32>(message.len()) * 20;   // a run-time value: 180
    std::println(f"{percent_to_byte(user_value)}");     // the run-time half of the check fires
    return 0;
}
