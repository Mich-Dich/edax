// Lesson 10: workers, channels, a pool. Fill in the three parts of main until
// `python3 course/check.py 10` says done.
import std;

// How many primes lie in [from, to).
u32 count_primes(u32 from, u32 to) {
    mut u32 count = 0;
    for (u32 n : from..to) {
        if (n < 2) { continue; }
        mut bool prime = true;
        mut u32 d = 2;
        while (d * d <= n) {
            if (n % d == 0) {
                prime = false;
                break;
            }
            d += 1;
        }
        if (prime) { count += 1; }
    }
    return count;
}

struct range_job {
    u32 id;
    u32 from;
    u32 to;
}

struct range_result {
    u32 id;
    u32 primes;
}

