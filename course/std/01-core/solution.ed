// Standard-library lesson 1: a small resource manager (solution).
import std;

// A permission set: one bit per permission.
compile_time u32 read = bit(0);
compile_time u32 write = bit(1);
compile_time u32 execute = bit(2);
compile_time u32 admin = bit(7);

// A resource: ordered by priority, then by name; usable as a hash-map key.
struct resource {
    std::string name;
    u8 priority = 0;

    std::ordering operator<=>(resource& other) {
        if (priority != other.priority) { return other.priority <=> priority; }   // higher priority first
        return name <=> other.name;
    }
    bool operator==(resource& other) = default;
    u64 hash() { return std::hash_combine(std::hash(name), std::hash(priority)); }
}

// Spends `cost` from `budget` if it is enough; the budget never wraps below zero.
bool spend(mut u32& budget, u32 cost) {
    if (std::checked_sub(budget, cost) is std::some(left)) {
        budget = left;
        return true;
    }
    return false;
}

// The name of the lowest permission in `flags`, or "none".
std::static_str lowest(u32 flags) {
    if (flags == 0) { return "none"; }
    return match (std::trailing_zeros(flags)) {
        0 => "read",
        1 => "write",
        2 => "execute",
        7 => "admin",
        _ => "unknown",
    };
}

i32 main() {
    mut u32 budget = 100;
    std::array<u32, 4> costs = [40, 50, 30, 10];
    for (u32 c : costs) {
        bool ok = spend(mut budget, c);
        std::println(f"spend {c}: {ok}, left {budget}");
    }

    u32 user = read | write;
    u32 root = read | write | execute | admin;
    std::println(f"user has {std::count_ones(user)} permissions, root has {std::count_ones(root)}");
    std::println(f"lowest of root without read: {lowest(root & ~read)}, of nothing: {lowest(0)}");

    mut std::darray<resource> all = default;
    all.push(resource{ .name = std::string::from("disk"), .priority = 1 });
    all.push(resource{ .name = std::string::from("gpu"), .priority = 3 });
    all.push(resource{ .name = std::string::from("cpu"), .priority = 3 });
    all.sort();
    mut std::string order = default;
    for (resource& r : all) {
        if (!order.is_empty()) { order.push_str(", "); }
        order.push_str(std::format(f"{r.name}:{r.priority}"));
    }
    std::println(f"order: {order}");
    std::println(f"same hash for equal keys: {std::hash(all[0]) == std::hash(resource{ .name = std::string::from("cpu"), .priority = 3 })}");

    // Hand the current name over and put the next one in its place.
    mut resource current = resource{ .name = std::string::from("draft"), .priority = 2 };
    std::string previous = std::replace(mut current.name, std::string::from("final"));
    std::string taken = std::take(mut current.name);
    std::println(f"{previous} -> {taken}, left '{current.name}'");

    u8 level = 250;
    std::println(f"level +10: saturated {std::saturating_add(level, 10u8)}, wrapped {level +% 10}");
    return 0;
}
