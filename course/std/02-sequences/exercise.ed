std::string join(std::span<i32> values) {
    mut std::string out = default;
    for (i32 v : values) {
        if (!out.is_empty()) { out.push_str(" "); }
        out.push_str(std::format(f"{v}"));
    }
    return out;
}

i32 main() {
    mut std::darray<reading> log = default;
    std::array<i32, 10> raw = [12, 15, 999, 14, 11, -500, 13, 16, 18, 17];
    for (usize i : 0..raw.length()) {
        log.push(reading{ .sensor = cast::truncate<u8>(i % 3), .value = raw[i] });
    }

    // TODO: remove the outliers (values outside -100..=100) in place, with one call.
    std::println(f"{log.length()} readings kept");

    mut std::darray<i32> values = default;
    // TODO: copy the values into `values`, and mark each reading's sensor in a std::bitset<8>.
    std::println(f"sensors seen: 0");
    std::println(f"values: {join(values.as_span())}");

    std::darray<i32> means = chunk_means(values.as_span(), 3);
    std::println(f"means of 3: {join(means.as_span())}");

    adjust_halves(values.as_mut_span());
    std::println(f"adjusted: {join(values.as_span())}");

    // TODO: order the log by sensor, keeping the order of readings of the same sensor.
    mut std::string order = default;
    for (reading& r : log) { order.push_str(std::format(f"{r.sensor}:{r.value} ")); }
    std::println(f"by sensor: {order.as_str().trim()}");

    // TODO: remove the first reading in O(1) (the last one takes its place).
    reading last = reading{};
    std::println(f"swap-removed {last.sensor}:{last.value}, first is now {log[0].sensor}:{log[0].value}");
    return 0;
}
