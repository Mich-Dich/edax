// The environment: arguments, variables, terminals.
import std;

std::exit_code main(std::span<std::str> args) {
    std::println(f"{args.len() - 1} arguments");                     // args[0] is the program itself
    std::option<std::string> home = std::env::variable("HOME");
    std::option<std::string> nothing = std::env::variable("EDAX_COURSE_SURELY_NOT_SET");
    std::println(f"HOME set: {home.is_some()}, other: {nothing.is_some()}");
    bool tty = std::env::is_terminal(std::env::stream::output);
    std::println(f"output is a terminal: {tty}");                    // false under check.py: it's a pipe
    return std::exit_code::success;
}
//> 0 arguments
//> HOME set: true, other: false
//> output is a terminal: false
