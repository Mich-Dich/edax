// A thread pool: tasks, parallel loops over chunks, and deterministic reductions.
import std;

u64 fib(u64 n) { return if (n < 2) { n } else { fib(n - 1) + fib(n - 2) }; }

i32 main() {
    std::thread_pool pool = std::thread_pool::make(std::thread_pool::options{ .threads = 4 });

    std::thread_pool::task<u64> a = pool.spawn([]() { return fib(25); });   // owns its captures: a task
    u64 local = 21;
    std::thread_pool::scoped_task<u64> b = pool.spawn([&local]() { return fib(local); });   // borrows: scoped
    std::println(f"fib {a.join()} {b.join()}");

    mut std::darray<f32> samples = default;
    for (u32 i : 0..10000) { samples.push(1.0); }
    f32 gain = 0.5;
    pool.for_chunks(samples.as_mut_span(), 1024, [gain](std::span<mut f32> part) {   // each chunk is changed by one thread
        for (mut f32& x : part) { x *= gain; }
    });
    f64 sum = pool.reduce_chunks(samples.as_span(), 1024, 0.0,
        [](std::span<f32> part) {
            mut f64 s = 0.0;
            for (f32 v : part) { s += cast<f64>(v); }
            return s;
        },
        [](f64 x, f64 y) { return x + y; });
    std::println(f"sum {sum}");
    return 0;
}
//> fib 75025 10946
//> sum 5000.0
