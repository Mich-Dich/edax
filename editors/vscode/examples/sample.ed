// Highlighting showcase for Edax (spec v0.3).
import std;
import std::filesystem;

/* block comment */
compile_time usize buffer_size = 4_096;
private static mut std::atomic<u32> request_count = std::atomic<u32>{};

enum parse_error : u8 {
    bad_line = 0,
    bad_number,
}

enum token : u8 {
    number(f64),
    identifier(std::string),
    end,
}

struct employee : printable {
    std::string name;
    u32         age    = 0;
    f64         salary = 0.0;

    bool is_senior() {
        return this.age >= 30;
    }

    void give_raise(f64 percent) mut {
        this.salary *= 1.0 + percent / 100.0;
    }

    std::string to_text() override;
    bool operator==(employee& other) = default;
}

open class shape {
public:
    std::string name;
    virtual f64 area() abstract;
    ~shape();
}

class circle : shape, std::formattable {
public:
    f64 radius = 0.0;
    f64 area() override { return 3.14159 * this.radius * this.radius; }
private:
    u32 id = 0xFFu32;
}

template<type T : std::comparable>
T larger(T a, T b) {
    return if (a > b) { a } else { b };
}

template<type T>
deduce double_it(T x) {
    if compile_time (std::is_integer<T>()) {
        return cast<i64>(x) * 2;
    } else {
        return cast::round<f64>(x) * 2.0e0;
    }
}

extern "C" i32 puts(std::raw_ptr<u8> text);

std::result<employee, parse_error> parse_line(std::str line) {
    std::darray<std::str> parts = line.split(',');
    u32 age = parts[1].parse<u32>().or_error(parse_error::bad_number)?;
    return std::ok(employee{ .name = std::string::from(parts[0]), .age = age });
}

std::exit_code main(std::span<std::str> args) {
    mut u32 flags = 0b1010;
    flags |= bit(4);
    flags +%= 1;
    mut std::darray<employee> list = default;
    char c = '\n';
    std::str path = r"C:\no\escapes";
    unsafe { _ = puts(c"hi"); }

    for (employee& e : list) {
        std::println(f"{e.name:<20} {e.age:>3} {{literal}} {std::size_of<u32>()}");
    }
    for (usize i : 0..list.len()) { }

    auto inc = [mut &flags]() { flags += 1; };
    std::str label = match (flags) {
        0      => "zero",
        1..=9  => "small",
        _      => "big",
    };
    std::raw_ptr<mut u32> p = mut &flags;
    if (p && !false) { take(move list); }
    return std::exit_code::success;
}
