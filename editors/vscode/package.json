{
  "name": "edax-language",
  "displayName": "Edax Language",
  "description": "Edax (.ed / .edh): syntax highlighting, build, step-through debugging, and code insights that show what the compiler does implicitly",
  "version": "0.8.0",
  "publisher": "dominikm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:edax",
    "onLanguage:edax-header",
    "onDebugResolve:edax",
    "onDebugDynamicConfigurations:edax",
    "onDebugInitialConfigurations"
  ],
  "extensionDependencies": [
    "vadimcn.vscode-lldb"
  ],
  "contributes": {
    "languages": [
      {
        "id": "edax",
        "aliases": [
          "Edax",
          "edax"
        ],
        "extensions": [
          ".ed"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ed.svg",
          "dark": "./icons/ed.svg"
        }
      },
      {
        "id": "edax-header",
        "aliases": [
          "Edax Header"
        ],
        "extensions": [
          ".edh"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/edh.svg",
          "dark": "./icons/edh.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "edax",
        "scopeName": "source.edax",
        "path": "./syntaxes/edax.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.interpolation.edax": "edax"
        },
        "tokenTypes": {
          "meta.embedded.interpolation.edax": "other",
          "punctuation.section.interpolation.begin.edax": "other",
          "punctuation.section.interpolation.end.edax": "other",
          "constant.character.escape.brace.edax": "string"
        }
      },
      {
        "language": "edax-header",
        "scopeName": "source.edax.header",
        "path": "./syntaxes/edax-header.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.interpolation.edax": "edax"
        },
        "tokenTypes": {
          "meta.embedded.interpolation.edax": "other",
          "punctuation.section.interpolation.begin.edax": "other",
          "punctuation.section.interpolation.end.edax": "other",
          "constant.character.escape.brace.edax": "string"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "edax"
      },
      {
        "language": "edax-header"
      }
    ],
    "debuggers": [
      {
        "type": "edax",
        "label": "Edax (LLDB)",
        "languages": [
          "edax",
          "edax-header"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "A .ed file to build and debug, or an already built executable.",
                "default": "${file}"
              },
              "target": {
                "type": "string",
                "description": "A program target of build.ed (instead of 'program'). Built with 'edaxc build <target>'."
              },
              "root": {
                "type": "string",
                "description": "The project root that holds build.ed (default: the workspace folder).",
                "default": "${workspaceFolder}"
              },
              "mode": {
                "type": "string",
                "description": "Build mode. 'debug' has full debug info (variables); 'release_with_debug_info' is optimized.",
                "default": "debug"
              },
              "build": {
                "type": "boolean",
                "description": "Build with edaxc before launching.",
                "default": true
              },
              "buildArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra edaxc arguments, e.g. [\"-DNAME=VALUE\"].",
                "default": []
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command line arguments of the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables added to the program's.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's entry point.",
                "default": false
              },
              "terminal": {
                "type": "string",
                "enum": [
                  "integrated",
                  "external",
                  "console"
                ],
                "description": "Where the program's input and output go.",
                "default": "integrated"
              },
              "sourceMap": {
                "type": "object",
                "description": "Source path remapping (CodeLLDB), e.g. for a moved library/std.",
                "default": {}
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra LLDB commands run before the target is created.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "edax",
            "request": "launch",
            "name": "Debug current Edax file",
            "program": "${file}",
            "args": [],
            "cwd": "${fileDirname}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Edax: Debug current file",
            "description": "Build the open .ed file with edaxc and debug it.",
            "body": {
              "type": "edax",
              "request": "launch",
              "name": "Debug current Edax file",
              "program": "^\"\\${file}\"",
              "args": [],
              "cwd": "^\"\\${fileDirname}\""
            }
          },
          {
            "label": "Edax: Debug a build.ed target",
            "description": "Build one program of build.ed and debug it.",
            "body": {
              "type": "edax",
              "request": "launch",
              "name": "Debug ${1:app}",
              "target": "${1:app}",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "edax.debugFile",
        "title": "Debug Edax File",
        "category": "Edax",
        "icon": "$(debug-alt)"
      },
      {
        "command": "edax.runFile",
        "title": "Run Edax File",
        "category": "Edax",
        "icon": "$(play)"
      },
      {
        "command": "edax.buildFile",
        "title": "Build Edax File",
        "category": "Edax"
      },
      {
        "command": "edax.insights.toggle",
        "title": "Toggle Code Insights",
        "category": "Edax",
        "icon": "$(eye)"
      },
      {
        "command": "edax.insights.choose",
        "title": "Choose Code Insights\u2026",
        "category": "Edax"
      },
      {
        "command": "edax.insights.refresh",
        "title": "Refresh Code Insights",
        "category": "Edax"
      },
      {
        "command": "edax.insights.explain",
        "title": "Explain Insight",
        "category": "Edax"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "edax.runFile",
          "when": "resourceLangId == edax && resourceExtname == .ed",
          "group": "navigation@0"
        },
        {
          "command": "edax.debugFile",
          "when": "resourceLangId == edax && resourceExtname == .ed",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "edax.debugFile",
          "when": "editorLangId == edax"
        },
        {
          "command": "edax.runFile",
          "when": "editorLangId == edax"
        },
        {
          "command": "edax.buildFile",
          "when": "editorLangId == edax"
        },
        {
          "command": "edax.insights.toggle",
          "when": "editorLangId =~ /^edax(-header)?$/"
        },
        {
          "command": "edax.insights.choose",
          "when": "editorLangId =~ /^edax(-header)?$/"
        },
        {
          "command": "edax.insights.refresh",
          "when": "editorLangId =~ /^edax(-header)?$/"
        },
        {
          "command": "edax.insights.explain",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "edax.insights.toggle",
          "when": "resourceLangId =~ /^edax(-header)?$/",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "Edax",
      "properties": {
        "edax.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to edaxc. Empty: build/compiler/edaxc in a workspace folder, else edaxc on PATH."
        },
        "edax.standardLibraryPath": {
          "type": "string",
          "default": "",
          "description": "Folder with the standard library's source (library/std). Only needed when edaxc was built from a checkout that has since moved. Empty: library/std in a workspace folder."
        },
        "edax.debug.buildMode": {
          "type": "string",
          "default": "debug",
          "description": "Build mode used for debugging when the launch configuration has no 'mode'."
        },
        "edax.debug.stepIntoStandardLibrary": {
          "type": "boolean",
          "default": true,
          "description": "Step Into enters std:: functions (darray::push, string::from, ...), like stepping into a C++ library with sources."
        },
        "edax.insights.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show **code insights**: what the compiler does that the source doesn't spell out. Off by default; toggle with *Edax: Toggle Code Insights* (the eye in the editor title). Needs a edaxc with the `insights` command."
        },
        "edax.insights.virtualLines": {
          "type": "boolean",
          "default": true,
          "description": "Show stack frames and end-of-scope drops as lines of their own above the code (CodeLens). Off: at the end of the line."
        },
        "edax.insights.inlineLabels": {
          "type": "boolean",
          "default": true,
          "description": "At the end of each line, a short tag per fact (alloc, drop, move, copy24, tmp, conv, virt, dyn, chk), most important first. Hover a tag for the full explanation and the code it is about. Off: highlights only."
        },
        "edax.insights.show.stack": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Stack frames: every slot a function reserves when it is entered (variables of every scope, temporaries, drop flags)."
        },
        "edax.insights.show.heap": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Heap memory: calls that may allocate or free, with the call chain to the allocator."
        },
        "edax.insights.show.drops": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Drops: destructors that run at the end of a scope (in reverse order) or before return / break / continue."
        },
        "edax.insights.show.moves": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Moves: ownership leaving a variable (`move x`, returning a local)."
        },
        "edax.insights.show.copies": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Large copies: copy types over 16 bytes used by value."
        },
        "edax.insights.show.temporaries": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Temporaries: unnamed stack slots the compiler creates."
        },
        "edax.insights.show.conversions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Implicit conversions: string \u2192 str, literal \u2192 string, upcasts, integer/pointer \u2192 bool in conditions, lambda \u2192 std::function."
        },
        "edax.insights.show.dispatch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Dynamic dispatch: virtual and interface calls through a table."
        },
        "edax.insights.show.checks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run-time checks: overflow, shift and division checks that panic."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "edaxc",
        "owner": "edaxc",
        "source": "edaxc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note)(?:\\[([^\\]]+)\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "colors": [
      {
        "id": "edax.insights.stack.foreground",
        "description": "Edax code insights: text and underline of 'stack'.",
        "defaults": {
          "dark": "#4FC1FFB0",
          "light": "#0070C1C0",
          "highContrast": "#4FC1FF",
          "highContrastLight": "#0070C1"
        }
      },
      {
        "id": "edax.insights.stack.background",
        "description": "Edax code insights: highlight of 'stack' ranges.",
        "defaults": {
          "dark": "#4FC1FF1C",
          "light": "#0070C114",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "edax.insights.heap.foreground",
        "description": "Edax code insights: text and underline of 'heap'.",
        "defaults": {
          "dark": "#F48771B0",
          "light": "#C72E0FC0",
          "highContrast": "#F48771",
          "highContrastLight": "#C72E0F"
        }
