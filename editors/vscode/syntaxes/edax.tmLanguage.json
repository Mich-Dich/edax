{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Edax",
  "scopeName": "source.edax",
  "fileTypes": [
    "ed",
    "edh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#access-labels"
    },
    {
      "include": "#import"
    },
    {
      "include": "#namespace"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#template-parameters"
    },
    {
      "include": "#casts"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#type-usages"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.edax",
          "match": "(//)(?!/).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.edax"
            }
          }
        },
        {
          "name": "comment.line.double-slash.edax",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.edax"
            }
          }
        },
        {
          "name": "comment.block.edax",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.edax"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.edax"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.format.edax",
          "begin": "\\b(f)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.edax"
            },
            "2": {
              "name": "punctuation.definition.string.begin.edax"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.edax"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "name": "constant.character.escape.brace.edax",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.edax",
          "begin": "\\b(r)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.edax"
            },
            "2": {
              "name": "punctuation.definition.string.begin.edax"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.edax"
            }
          }
        },
        {
          "name": "string.quoted.double.c.edax",
          "begin": "\\b(c)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.edax"
            },
            "2": {
              "name": "punctuation.definition.string.begin.edax"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.edax"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.edax",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.edax"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.edax"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.unicode.edax",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.edax",
          "match": "\\\\[ntr\\\\\"'0]"
        },
        {
          "name": "invalid.illegal.escape.edax",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.edax",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.edax"
        }
      },
      "end": "(?:(:)(?!:)([^}\"]*))?(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.separator.format-spec.edax"
        },
        "2": {
          "name": "constant.other.format-spec.edax"
        },
        "3": {
          "name": "punctuation.section.interpolation.end.edax"
        }
      },
      "contentName": "meta.embedded.interpolation.edax",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#casts"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#type-usages"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.char.edax",
      "match": "(')(\\\\u\\{[0-9A-Fa-f]{1,6}\\}|\\\\[ntr\\\\\"'0]|[^'\\\\])(')",
      "captures": {
        "1": {
          "name": "punctuation.definition.char.begin.edax"
        },
        "2": {
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.char.end.edax"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.edax",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.edax"
            }
          }
        },
        {
          "name": "constant.numeric.binary.edax",
          "match": "\\b0b[01][01_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.edax"
            }
          }
        },
        {
          "name": "constant.numeric.octal.edax",
          "match": "\\b0o[0-7][0-7_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.edax"
            }
          }
        },
        {
          "name": "constant.numeric.float.edax",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(f16|f32|f64)?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.edax"
            }
          }
        },
        {
          "name": "constant.numeric.decimal.edax",
          "match": "\\b\\d[\\d_]*((?:[iu](?:8|16|32|64|128|size)|f16|f32|f64))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.edax"
            }
          }
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.edax",
      "match": "(@)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.edax"
        },
        "2": {
          "name": "entity.name.function.decorator.edax"
        }
      }
    },
    "access-labels": {
      "match": "\\b(public|protected|private)\\s*(:)(?!:)",
      "captures": {
        "1": {
          "name": "storage.modifier.access.edax"
        },
        "2": {
          "name": "punctuation.separator.colon.edax"
        }
      }
    },
    "import": {
      "name": "meta.import.edax",
      "match": "\\b(import)\\s+([A-Za-z_]\\w*(?:\\s*::\\s*[A-Za-z_]\\w*)*)\\s*(;)",
      "captures": {
        "1": {
          "name": "keyword.control.import.edax"
        },
        "2": {
          "patterns": [
            {
              "name": "punctuation.separator.namespace.edax",
              "match": "::"
            },
            {
              "name": "entity.name.namespace.edax",
              "match": "[A-Za-z_]\\w*"
            }
          ]
        },
        "3": {
          "name": "punctuation.terminator.statement.edax"
        }
      }
    },
    "type-declarations": {
      "patterns": [
        {
          "comment": "open class / view struct / plain struct, class, interface, enum — plus base list",
          "match": "\\b(?:(open|view)\\s+)?(struct|class|interface|enum)\\s+([A-Za-z_]\\w*)(?:\\s*(:)(?!:)\\s*([A-Za-z_][\\w\\s:,&]*?))?(?=\\s*(?:\\{|;|$))",
          "captures": {
            "1": {
              "name": "storage.modifier.edax"
            },
            "2": {
              "name": "storage.type.$2.edax"
            },
            "3": {
              "name": "entity.name.type.$2.edax"
            },
            "4": {
              "name": "punctuation.separator.colon.edax"
            },
            "5": {
              "patterns": [
                {
                  "include": "#builtin-types"
                },
                {
                  "include": "#namespaces"
                },
                {
                  "name": "punctuation.separator.namespace.edax",
                  "match": "::"
                },
                {
                  "name": "punctuation.separator.comma.edax",
                  "match": ","
                },
                {
                  "name": "entity.other.inherited-class.edax",
                  "match": "[A-Za-z_]\\w*"
                }
              ]
            }
          }
        },
        {
          "comment": "destructor ~name()",
          "match": "(~)([A-Za-z_]\\w*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.definition.destructor.edax"
            },
            "2": {
              "name": "entity.name.function.destructor.edax"
            }
          }
        },
        {
          "comment": "operator overloads: operator==, operator[], operator<=> ...",
          "match": "\\b(operator)\\s*(<=>|==|!=|<<|>>|\\[\\]|[-+*/%&|^~<>])",
          "captures": {
            "1": {
              "name": "keyword.other.operator.edax"
            },
            "2": {
              "name": "entity.name.function.operator.edax"
            }
          }
        }
      ]
    },
    "template-parameters": {
      "comment": "the 'type T' in template<type T, type U : iface>",
      "match": "\\b(type)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.template-parameter.edax"
        },
        "2": {
          "name": "entity.name.type.parameter.edax"
        }
      }
    },
    "casts": {
      "match": "\\b(cast)(?:\\s*(::)\\s*(truncate|saturate|round|checked|dynamic|reinterpret))?\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.cast.edax"
        },
        "2": {
          "name": "punctuation.separator.namespace.edax"
        },
        "3": {
          "name": "keyword.operator.cast.$3.edax"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.edax",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.edax",
          "match": "\\b(for|while)\\b"
        },
        {
          "name": "keyword.control.flow.edax",
          "match": "\\b(return|break|continue)\\b"
        },
        {
          "name": "keyword.control.import.edax",
          "match": "\\bimport\\b"
        },
        {
          "name": "storage.type.edax",
          "match": "\\b(struct|class|interface|enum|template|type)\\b"
        },
        {
          "name": "keyword.other.operator.edax",
          "match": "\\boperator\\b"
        },
        {
          "name": "storage.modifier.edax",
          "match": "\\b(mut|view|static|extern|compile_time|run_time|unsafe|virtual|override|abstract|public|protected|private)\\b"
        },
        {
          "name": "storage.modifier.open.edax",
          "match": "\\bopen(?=\\s+class\\b)"
        },
        {
          "name": "keyword.operator.move.edax",
          "match": "\\bmove\\b"
        },
        {
          "name": "storage.type.deduce.edax",
          "match": "\\b(auto|deduce)\\b"
        },
        {
          "name": "keyword.other.edax",
          "match": "\\b(bit|default|check)\\b"
        },
        {
          "name": "constant.language.boolean.edax",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.edax",
          "match": "\\bnullptr\\b"
        },
        {
          "name": "variable.language.this.edax",
          "match": "\\bthis\\b"
        },
        {
          "name": "variable.language.wildcard.edax",
          "match": "\\b_\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.primitive.edax",
      "match": "\\b(bool|char|void|never|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f16|f32|f64)\\b"
    },
    "namespaces": {
      "comment": "anything directly followed by :: (std::, module::, type::static_method)",
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.edax"
        }
      }
    },
    "function-calls": {
      "comment": "name(  or  name<T>(  — calls and definitions",
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=(?:<[\\w\\s:,<>&*]*>)?\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.edax"
        }
      }
    },
    "type-usages": {
      "patterns": [
        {
          "comment": "construction: name{ ... } or name<T>{ ... }",
          "match": "\\b([A-Za-z_]\\w*)(?=(?:<[\\w\\s:,<>&*]*>)?\\{)",
          "captures": {
            "1": {
              "name": "entity.name.type.edax"
            }
          }
        },
        {
          "comment": "declarations: Type name =  /  Type& name,  /  Type<T> name;  /  RetType fname(",
          "match": "\\b([A-Za-z_]\\w*)(?=(?:<[\\w\\s:,<>&*]*>)?\\s*&?\\s+&?[A-Za-z_]\\w*\\s*(?:[=;,)(]|:(?!:)))",
          "captures": {
            "1": {
              "name": "entity.name.type.edax"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.edax",
          "match": "=>"
        },
        {
          "name": "keyword.operator.member.edax",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.edax",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.edax",
          "match": "<=>"
        },
        {
          "name": "keyword.operator.assignment.compound.edax",
          "match": "(?:\\+%|-%|\\*%|<<|>>|[-+*/%&|^])="
        },
        {
          "name": "keyword.operator.comparison.edax",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.edax",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.wrapping.edax",
          "match": "\\+%|-%|\\*%"
        },
        {
          "name": "keyword.operator.bitwise.shift.edax",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.edax",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.edax",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.edax",
          "match": "[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.edax",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.error-propagation.edax",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.edax",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.edax",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.edax",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.edax",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.edax",
          "match": ":"
        },
        {
          "name": "punctuation.section.braces.edax",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.edax",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.edax",
          "match": "[\\[\\]]"
        }
      ]
    },
    "interpolation-braces": {
      "comment": "a `{ ... }` inside a hole (a lambda body, a struct literal): it does not end the hole",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.edax"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.edax"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#casts"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#type-usages"
        }
      ]
    },
    "namespace": {
      "patterns": [
        {
          "name": "meta.namespace.alias.edax",
          "match": "\\b(namespace)\\s+([A-Za-z_]\\w*)\\s*(=)\\s*((?:::)?[A-Za-z_]\\w*(?:\\s*::\\s*[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.edax"
            },
            "2": {
              "name": "entity.name.namespace.edax"
            },
            "3": {
              "name": "keyword.operator.assignment.edax"
            },
            "4": {
              "patterns": [
                {
                  "name": "punctuation.separator.namespace.edax",
                  "match": "::"
                },
                {
                  "name": "entity.name.namespace.edax",
                  "match": "[A-Za-z_]\\w*"
                }
              ]
            }
          }
        },
        {
          "name": "meta.namespace.edax",
          "match": "\\b(namespace)\\s+([A-Za-z_]\\w*(?:\\s*::\\s*[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.edax"
            },
            "2": {
              "patterns": [
                {
                  "name": "punctuation.separator.namespace.edax",
                  "match": "::"
                },
                {
                  "name": "entity.name.namespace.edax",
                  "match": "[A-Za-z_]\\w*"
                }
              ]
            }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.use.edax",
          "match": "(@)((?:::)?[A-Za-z_]\\w*(?:\\s*::\\s*[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.edax"
            },
            "2": {
              "name": "entity.name.function.decorator.edax"
            }
          }
        },
        {
          "name": "storage.modifier.annotation.edax",
          "match": "\\bannotation(?=\\s*\\()"
        },
        {
          "name": "keyword.other.generate.edax",
          "match": "\\bgenerate(?=\\s*[:{])"
        },
        {
          "name": "variable.language.annotated.edax",
          "match": "\\b(annotated|annotation)\\b(?=\\s*[.)>,;])"
        }
      ]
    }
  }
}
