{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rift",
  "scopeName": "source.rift",
  "fileTypes": [
    "rifts",
    "rifth"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#access-labels"
    },
    {
      "include": "#import"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#template-parameters"
    },
    {
      "include": "#casts"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#type-usages"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.rift",
          "match": "(///)(?!/).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.rift"
            }
          }
        },
        {
          "name": "comment.line.double-slash.rift",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.rift"
            }
          }
        },
        {
          "name": "comment.block.rift",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.rift"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.rift"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.format.rift",
          "begin": "\\b(f)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.rift"
            },
            "2": {
              "name": "punctuation.definition.string.begin.rift"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.rift"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "name": "constant.character.escape.brace.rift",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.rift",
          "begin": "\\b(r)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.rift"
            },
            "2": {
              "name": "punctuation.definition.string.begin.rift"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.rift"
            }
          }
        },
        {
          "name": "string.quoted.double.c.rift",
          "begin": "\\b(c)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.rift"
            },
            "2": {
              "name": "punctuation.definition.string.begin.rift"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.rift"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.rift",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.rift"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.rift"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.unicode.rift",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.rift",
          "match": "\\\\[ntr\\\\\"'0]"
        },
        {
          "name": "invalid.illegal.escape.rift",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.rift",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.rift"
        }
      },
      "end": "(?:(:)(?!:)([^}\"]*))?(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.separator.format-spec.rift"
        },
        "2": {
          "name": "constant.other.format-spec.rift"
        },
        "3": {
          "name": "punctuation.section.interpolation.end.rift"
        }
      },
      "contentName": "meta.embedded.interpolation.rift",
      "patterns": [
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#casts"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.char.rift",
      "match": "(')(\\\\u\\{[0-9A-Fa-f]{1,6}\\}|\\\\[ntr\\\\\"'0]|[^'\\\\])(')",
      "captures": {
        "1": {
          "name": "punctuation.definition.char.begin.rift"
        },
        "2": {
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.char.end.rift"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rift",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.rift"
            }
          }
        },
        {
          "name": "constant.numeric.binary.rift",
          "match": "\\b0b[01][01_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.rift"
            }
          }
        },
        {
          "name": "constant.numeric.octal.rift",
          "match": "\\b0o[0-7][0-7_]*((?:[iu](?:8|16|32|64|128|size)))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.rift"
            }
          }
        },
        {
          "name": "constant.numeric.float.rift",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(f32|f64)?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.rift"
            }
          }
        },
        {
          "name": "constant.numeric.decimal.rift",
          "match": "\\b\\d[\\d_]*((?:[iu](?:8|16|32|64|128|size)|f32|f64))?\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.suffix.rift"
            }
          }
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.rift",
      "match": "(@)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.rift"
        },
        "2": {
          "name": "entity.name.function.decorator.rift"
        }
      }
    },
    "access-labels": {
      "match": "\\b(public|protected|private)\\s*(:)(?!:)",
      "captures": {
        "1": {
          "name": "storage.modifier.access.rift"
        },
        "2": {
          "name": "punctuation.separator.colon.rift"
        }
      }
    },
    "import": {
      "name": "meta.import.rift",
      "match": "\\b(import)\\s+([A-Za-z_]\\w*(?:\\s*::\\s*[A-Za-z_]\\w*)*)\\s*(;)",
      "captures": {
        "1": {
          "name": "keyword.control.import.rift"
        },
        "2": {
          "patterns": [
            {
              "name": "punctuation.separator.namespace.rift",
              "match": "::"
            },
            {
              "name": "entity.name.namespace.rift",
              "match": "[A-Za-z_]\\w*"
            }
          ]
        },
        "3": {
          "name": "punctuation.terminator.statement.rift"
        }
      }
    },
    "type-declarations": {
      "patterns": [
        {
          "comment": "open class / view struct / plain struct, class, interface, enum \u2014 plus base list",
          "match": "\\b(?:(open|view)\\s+)?(struct|class|interface|enum)\\s+([A-Za-z_]\\w*)(?:\\s*(:)(?!:)\\s*([A-Za-z_][\\w\\s:,&]*?))?(?=\\s*(?:\\{|;|$))",
          "captures": {
            "1": {
              "name": "storage.modifier.rift"
            },
            "2": {
              "name": "storage.type.$2.rift"
            },
            "3": {
              "name": "entity.name.type.$2.rift"
            },
            "4": {
              "name": "punctuation.separator.colon.rift"
            },
            "5": {
              "patterns": [
                {
                  "include": "#builtin-types"
                },
                {
                  "include": "#namespaces"
                },
                {
                  "name": "punctuation.separator.namespace.rift",
                  "match": "::"
                },
                {
                  "name": "punctuation.separator.comma.rift",
                  "match": ","
                },
                {
                  "name": "entity.other.inherited-class.rift",
                  "match": "[A-Za-z_]\\w*"
                }
              ]
            }
          }
        },
        {
          "comment": "destructor ~name()",
          "match": "(~)([A-Za-z_]\\w*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.definition.destructor.rift"
            },
            "2": {
              "name": "entity.name.function.destructor.rift"
            }
          }
        },
        {
          "comment": "operator overloads: operator==, operator[], operator<=> ...",
          "match": "\\b(operator)\\s*(<=>|==|!=|<<|>>|\\[\\]|[-+*/%&|^~<>])",
          "captures": {
            "1": {
              "name": "keyword.other.operator.rift"
            },
            "2": {
              "name": "entity.name.function.operator.rift"
            }
          }
        }
      ]
    },
    "template-parameters": {
      "comment": "the 'type T' in template<type T, type U : iface>",
      "match": "\\b(type)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.template-parameter.rift"
        },
        "2": {
          "name": "entity.name.type.parameter.rift"
        }
      }
    },
    "casts": {
      "match": "\\b(cast)(?:\\s*(::)\\s*(truncate|saturate|round|checked|dynamic|reinterpret))?\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.cast.rift"
        },
        "2": {
          "name": "punctuation.separator.namespace.rift"
        },
        "3": {
          "name": "keyword.operator.cast.$3.rift"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.rift",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.rift",
          "match": "\\b(for|while)\\b"
        },
        {
          "name": "keyword.control.flow.rift",
          "match": "\\b(return|break|continue)\\b"
        },
        {
          "name": "keyword.control.import.rift",
          "match": "\\bimport\\b"
        },
        {
          "name": "storage.type.rift",
          "match": "\\b(struct|class|interface|enum|template|type)\\b"
        },
        {
          "name": "keyword.other.operator.rift",
          "match": "\\boperator\\b"
        },
        {
          "name": "storage.modifier.rift",
          "match": "\\b(mut|view|static|extern|compile_time|run_time|unsafe|virtual|override|abstract|public|protected|private)\\b"
        },
        {
          "name": "storage.modifier.open.rift",
          "match": "\\bopen(?=\\s+class\\b)"
        },
        {
          "name": "keyword.operator.move.rift",
          "match": "\\bmove\\b"
        },
        {
          "name": "storage.type.deduce.rift",
          "match": "\\b(auto|deduce)\\b"
        },
        {
          "name": "keyword.other.rift",
          "match": "\\b(bit|default|check)\\b"
        },
        {
          "name": "constant.language.boolean.rift",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.rift",
          "match": "\\bnullptr\\b"
        },
        {
          "name": "variable.language.this.rift",
          "match": "\\bthis\\b"
        },
        {
          "name": "variable.language.wildcard.rift",
          "match": "\\b_\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.primitive.rift",
      "match": "\\b(bool|char|void|never|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64)\\b"
    },
    "namespaces": {
      "comment": "anything directly followed by :: (std::, module::, type::static_method)",
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.rift"
        }
      }
    },
    "function-calls": {
      "comment": "name(  or  name<T>(  \u2014 calls and definitions",
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=(?:<[\\w\\s:,<>&*]*>)?\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.rift"
        }
      }
    },
    "type-usages": {
      "patterns": [
        {
          "comment": "construction: name{ ... } or name<T>{ ... }",
          "match": "\\b([A-Za-z_]\\w*)(?=(?:<[\\w\\s:,<>&*]*>)?\\{)",
          "captures": {
            "1": {
              "name": "entity.name.type.rift"
            }
          }
        },
        {
          "comment": "declarations: Type name =  /  Type& name,  /  Type<T> name;  /  RetType fname(",
          "match": "\\b([A-Za-z_]\\w*)(?=(?:<[\\w\\s:,<>&*]*>)?\\s*&?\\s+&?[A-Za-z_]\\w*\\s*(?:[=;,)(]|:(?!:)))",
          "captures": {
            "1": {
              "name": "entity.name.type.rift"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.rift",
          "match": "=>"
        },
        {
          "name": "keyword.operator.member.rift",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.rift",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.rift",
          "match": "<=>"
        },
        {
          "name": "keyword.operator.assignment.compound.rift",
          "match": "(?:\\+%|-%|\\*%|<<|>>|[-+*/%&|^])="
        },
        {
          "name": "keyword.operator.comparison.rift",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.rift",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.wrapping.rift",
          "match": "\\+%|-%|\\*%"
        },
        {
          "name": "keyword.operator.bitwise.shift.rift",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.rift",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.rift",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.rift",
          "match": "[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.rift",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.error-propagation.rift",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.rift",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.rift",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.rift",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.rift",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.rift",
          "match": ":"
        },
        {
          "name": "punctuation.section.braces.rift",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.rift",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.rift",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}