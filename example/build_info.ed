// build_info: what a program can know about its build (specs 24, 25). The mode is a class, and
// build.ed passes settings into the code as typed compile-time constants.
//
//   edaxc run --root=example build_info                    debug
//   edaxc run --root=example --mode=release build_info
//   edaxc run --root=example --mode=fast build_info        a mode of example/build.ed
//   edaxc run --root=example -Dgreeting=hi build_info      an option
import std;

// Set by build.ed with `g.set(...)`; build.ed declares them in namespace build. Reading one
// that is not set is a compile error.
compile_time std::static_str greeting = build::greeting.value();
compile_time u32 build_number = build::build_number.value();

std::static_str optimization_name() {
    return match (std::build::current_mode().optimization()) {
        std::build::optimization::none => "none",
        std::build::optimization::size => "size",
        std::build::optimization::speed => "speed",
        std::build::optimization::basic => "basic",
    };
}

i32 main() {
    std::println(f"{greeting} from build {build_number}");
    std::println(f"optimization: {optimization_name()}");
    std::println(f"debug-like mode: {std::build::mode_is(std::build::mode::debug)}");
    std::println(f"release-like mode: {std::build::mode_is(std::build::mode::release)}");
    bool wraps = std::build::current_mode().overflow() == std::build::overflow::wrap;
    std::println(f"overflow wraps: {wraps}");

    // Checks can be limited to modes. This one only exists in debug builds.
    run_time(std::build::mode::debug) check (build_number > 0) else "debug builds need a build number";
    // A mode of build.ed is named through the module `build` in mode lists.
    run_time(build::fast) check (wraps) else "the fast mode of example/build.ed wraps on overflow";

    u8 small = 250;
    u8 step = cast::truncate<u8>(build_number);   // 10 by default
    if (wraps) {
        std::println(f"250 + {step} = {small + step} (wrapped, because this mode says so)");
    } else {
        std::println(f"250 + {step} would panic in this mode; with +% it is {small +% step}");
    }
    return 0;
}
