// calculator: a tokenizer and a recursive-descent parser for arithmetic, with errors as values
// (std::result and `?`, spec 11), enums with payloads (08), view structs (12), main(args) (04).
//
//   riftc run example/calculator.rifts                     the built-in examples
//   riftc run example/calculator.rifts -- "2 * (3 + 4)"     your own expression
import std;

enum token : u8 {
    number(f64),
    op(char),
    open,
    close,
}

// Errors are an enum, not exceptions: every failure is in the signature.
enum calc_error : u8 {
    unexpected_char(char),
    unexpected_end,
    unbalanced,
    division_by_zero,
    trailing_input,
}

std::string explain(calc_error e) {
    return match (e) {
        calc_error::unexpected_char(c) => std::format(f"unexpected character '{c}'"),
        calc_error::unexpected_end => std::string::from("the expression ends too early"),
        calc_error::unbalanced => std::string::from("a ')' is missing"),
        calc_error::division_by_zero => std::string::from("division by zero"),
        calc_error::trailing_input => std::string::from("text after the expression"),
    };
}

std::result<std::darray<token>, calc_error> tokenize(std::str text) {
    mut std::darray<token> out = default;
    mut usize i = 0;
    while (i < text.len()) {
        std::str rest = text.slice(i, text.len());
        std::str one = text.slice(i, i + 1);
        if (one == " ") {
            i += 1;
        } else if (one == "(") {
            out.push(token::open);
            i += 1;
        } else if (one == ")") {
            out.push(token::close);
            i += 1;
        } else if (one == "+" || one == "-" || one == "*" || one == "/") {
            out.push(token::op(first_char(one)));
            i += 1;
        } else if (is_digit(one)) {
            mut usize end = i;
            while (end < text.len() && (is_digit(text.slice(end, end + 1)) || text.slice(end, end + 1) == ".")) { end += 1; }
            f64 value = text.slice(i, end).parse<f64>().or_error(calc_error::unexpected_char('.'))?;
            out.push(token::number(value));
            i = end;
        } else {
            return std::error(calc_error::unexpected_char(first_char(rest)));
        }
    }
    return std::ok(move out);
}

bool is_digit(std::str one) {
    char c = first_char(one);
    return c >= '0' && c <= '9';
}

char first_char(std::str one) {
    mut u8 byte = 0;
    unsafe { byte = std::raw::read(one.as_ptr()); }
    return cast::checked<char>(cast<u32>(byte)).value_or('?');
}

// The parser borrows the tokens, so it is a `view` struct (spec 12); `mut` methods advance it.
view struct parser {
    std::darray<token>& tokens;
    usize at = 0;

    std::option<token> peek() {
        if (this.at >= this.tokens.len()) { return std::none; }
        return std::some(this.tokens[this.at]);
    }

    // expression := term (('+' | '-') term)*
    std::result<f64, calc_error> expression() mut {
        mut f64 value = this.term()?;
        while (true) {
            match (this.peek()) {
                std::some(token::op('+')) => { this.at += 1; value += this.term()?; },
                std::some(token::op('-')) => { this.at += 1; value -= this.term()?; },
                _ => break,
            }
        }
        return std::ok(value);
    }

    // term := factor (('*' | '/') factor)*
    std::result<f64, calc_error> term() mut {
        mut f64 value = this.factor()?;
        while (true) {
            match (this.peek()) {
                std::some(token::op('*')) => { this.at += 1; value *= this.factor()?; },
                std::some(token::op('/')) => {
                    this.at += 1;
                    f64 divisor = this.factor()?;
                    if (divisor == 0.0) { return std::error(calc_error::division_by_zero); }
                    value /= divisor;
                },
                _ => break,
            }
        }
        return std::ok(value);
    }

    // factor := number | '-' factor | '(' expression ')'
    std::result<f64, calc_error> factor() mut {
        std::option<token> next = this.peek();
        this.at += 1;
        return match (next) {
            std::some(token::number(n)) => std::ok(n),
            std::some(token::op('-')) => std::ok(-this.factor()?),
            std::some(token::open) => {
                f64 inner = this.expression()?;
                match (this.peek()) {
                    std::some(token::close) => { this.at += 1; std::ok(inner) },
                    _ => std::error(calc_error::unbalanced),
                }
            },
            std::some(token::close) => std::error(calc_error::unexpected_char(')')),
            std::some(token::op(c)) => std::error(calc_error::unexpected_char(c)),
            std::none => std::error(calc_error::unexpected_end),
        };
    }
}

std::result<f64, calc_error> evaluate(std::str text) {
    std::darray<token> tokens = tokenize(text)?;
    mut parser p = parser{ .tokens = tokens };
    f64 value = p.expression()?;
    if (p.at != tokens.len()) { return std::error(calc_error::trailing_input); }
    return std::ok(value);
}

void show(std::str text) {
    match (evaluate(text)) {
        std::ok(v) => std::println(f"{text:<22} = {v}"),
        std::error(e) => std::println(f"{text:<22} : error: {explain(e)}"),
    }
}

i32 main(std::span<std::str> args) {
    if (args.len() > 1) {
        for (usize i : 1..args.len()) { show(args[i]); }
        return 0;
    }
    show("1 + 2 * 3");
    show("(1 + 2) * 3");
    show("-4 / (2 - 0.5)");
    show("2 * (3 + 4");
    show("10 / (5 - 5)");
    show("7 % 2");
    show("1 2");
    return 0;
}
