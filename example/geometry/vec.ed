import std;

namespace geometry {
    struct vec2 {
        vec2 operator+(vec2& other) { return vec2{ .x = this.x + other.x, .y = this.y + other.y }; }
        vec2 operator-(vec2& other) { return vec2{ .x = this.x - other.x, .y = this.y - other.y }; }
        vec2 operator-() { return vec2{ .x = -this.x, .y = -this.y }; }
        f64 dot(vec2& other) { return this.x * other.x + this.y * other.y; }
        f64 length() { return square_root(this.dot(this)); }
    }

    vec2 operator*(vec2& v, f64 k) { return vec2{ .x = v.x * k, .y = v.y * k }; }

    // Newton's method: `private` keeps it out of the module's interface.
    private f64 square_root(f64 value) {
        if (value <= 0.0) { return 0.0; }
        mut f64 guess = value;
        for (u32 i : 0..40) { guess = 0.5 * (guess + value / guess); }
        return guess;
    }
}
