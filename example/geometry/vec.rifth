// Module geometry::vec (spec 09): the header is the public interface, the .rifts has the bodies.
// The module is the file; its names live in namespace geometry (spec 30): `geometry::vec2`.

namespace geometry {
    /// A 2D vector. A struct: plain data, a copy type because all its fields are.
    struct vec2 {
        f64 x = 0.0;
        f64 y = 0.0;

        vec2 operator+(vec2& other);
        vec2 operator-(vec2& other);
        vec2 operator-();
        bool operator==(vec2& other) = default;

        f64 dot(vec2& other);
        f64 length();
    }

    /// `v * k`: an operator written as a free function.
    vec2 operator*(vec2& v, f64 k);
}
