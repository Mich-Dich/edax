
// hello: variables, functions, control flow and formatted output (specs 03, 04, 10, 19).
//   riftc run example/hello.rifts

import std;

// Greatest common divisor, by Euclid. Parameters are immutable; `mut` makes a local changeable.
u64 gcd(u64 a, u64 b) {
    mut u64 x = a;
    mut u64 y = b;
    while (y != 0) {
        u64 r = x % y;
        x = y;
        y = r;
    }
    return x;
}

// `if` and `match` are expressions: they have a value.
std::static_str size_word(u32 n) {
    return match (n) {
        0 => "nothing",
        1..=9 => "a few",
        10..=99 => "many",
        _ => "lots",
    };
}

bool is_prime(u32 n) {

    if (n < 2) { return false; }
    mut u32 d = 2;
    while (d * d <= n) {
        if (n % d == 0) { return false; }
        d += 1;
    }
    return true;
}


i32 main() {
    std::println("Hello from Rift!");

    // Literals take the type their context gives them: no suffixes needed here
    u32 apples = 7;
    f64 price = 0.35;
    std::println(f"{apples} apples cost {cast<f64>(apples) * price:.2}");

    // Format specs: width, alignment, precision, sign, radix
    std::println(f"[{"left":<8}] [{"right":>8}] [{"mid":^8}]");
    u32 byte = 255;
    i32 answer = -42;
    f64 pi = 3.14159;
    std::println(f"{byte:x} {byte:X} {byte:b} {byte:o} {answer:+} {pi:.3}");

    std::println(f"gcd(1071, 462) = {gcd(1071, 462)}");
    mut u32 next = 0;
    mut std::array<u32, 4> sizes = default;
    for (u32 i : 0..4) {
        sizes[cast<usize>(i)] = next;
        next = next * 10 + 3;
    }
    for (u32 n : sizes) {
        std::println(f"{n:>5} is {size_word(n)}");
    }

    mut u32 count = 0;
    mut std::string primes = std::string::from("");
    for (u32 n : 1..=50) {
        if (!is_prime(n)) { continue; }
        if (count > 0) { primes.push_str(", "); }
        primes.push_str(std::format(f"{n}"));
        count += 1;
    }
    std::println(f"{count} primes up to 50: {primes}");

    // Blocks are expressions too: the last expression without `;` is the value.
    u32 total = {
        mut u32 sum = 0;
        for (u32 i : 1..=10) { sum += i * i; }
        sum
    };
    std::println(f"sum of squares 1..10 = {total}");
    return 0;
}
