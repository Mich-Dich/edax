// numbers: Edax's integer and float rules (specs 02, 16, 17).
// No implicit conversions, overflow is never silent, and every lossy cast says how it loses.
import std;

// FNV-1a: a hash that *wants* to wrap, so it says so with `^` and `*%`.
u32 fnv1a(std::str text) {
    mut u32 h = 2166136261;
    for (usize i : 0..text.length()) {
        mut u8 byte = 0;
        unsafe { byte = std::raw::read(text.as_ptr().offset(i)); }
        h = (h ^ cast<u32>(byte)) *% 16777619;
    }
    return h;
}

i32 main() {
    // Every integer width, also 128 bits.
    u8 small = 200;
    i16 neg = -1234;
    u64 big = 18446744073709551615;
    i128 huge = 170141183460469231731687303715884105727;
    std::println(f"{small} {neg} {big} {huge}");

    // No implicit widening: convert explicitly. `cast<T>` only for conversions that never lose.
    u32 widened = cast<u32>(small) + 1000;
    std::println(f"widened: {widened}");

    // Lossy casts name their policy.
    u32 large = 70000;
    std::println(f"truncate: {cast::truncate<u16>(large)}  saturate: {cast::saturate<u16>(large)}");
    std::println(f"checked: fits? {cast::checked<u16>(large).is_some()}, 1234 -> {cast::checked<u16>(1234u32).value_or(0)}");
    f64 e = 2.71828;
    u64 count = 9007199254740993;   // 2^53 + 1: no f64 holds it exactly
    std::println(f"float -> int: {cast::saturate<i32>(e)}  int -> float: {cast::round<f64>(count)}  exact? {cast::checked<f64>(count).value_or(-1.0)}");

    // Arithmetic that would overflow: choose what you want.
    u8 a = 250;
    u8 b = 10;
    std::println(f"wrapping:   {a +% b}");
    std::println(f"saturating: {std::saturating_add(a, b)}");
    match (std::checked_add(a, b)) {
        std::some(v) => std::println(f"checked:    {v}"),
        std::none => std::println("checked:    overflow detected"),
    }
    // `a + b` would panic: "integer overflow in '+' (u8)" (try it!).

    // Bits.
    u32 flags = bit(0) | bit(3) | bit(5);
    std::println(f"flags = {flags:b}, bit 3 set: {(flags & bit(3)) != 0}, shifted: {flags << 4:x}");
    if (flags & bit(5)) { std::println("integers are conditions only in conditions"); }

    // Floats.
    f64 third = 1.0 / 3.0;
    f32 single = 0.1f32;
    f64 big_float = 1.0e10;
    std::println(f"{third} {third:.4} {single} {big_float}");

    // Chars are Unicode scalar values.
    char letter = 'R';
    std::println(f"{letter} = {cast<u32>(letter)}, next: {cast::checked<char>(cast<u32>(letter) + 1).value_or('?')}");

    std::static_str name = "edax";
    std::println(f"fnv1a(\"{name}\") = {fnv1a(name):x}");
    return 0;
}
