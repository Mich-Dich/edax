// ownership: values, moves, references and destructors (spec 12). Memory safety comes from a
// few local rules, checked in each function - no garbage collector and no lifetime syntax.
import std;

/// A class that owns a resource. Its destructor runs exactly once, when its owner goes away.
class connection {
public:
    std::string host = std::string::from("");

    static connection open(std::str host) {
        std::println(f"  open {host}");
        return connection{ .host = std::string::from(host) };
    }

    void send(std::str message) { std::println(f"  {this.host} <- {message}"); }

    ~connection() { std::println(f"  close {this.host}"); }
}

/// Taking a parameter by value takes ownership: the caller's variable is moved.
void consume(connection c) {
    c.send("bye");
}   // c is destroyed here

/// `T&` borrows for the call; `mut T&` borrows mutably, and the call site says `mut`.
void rename(mut std::string& name, std::str suffix) {
    name.push_str(suffix);
}

/// A returned reference (or view, like std::str) borrows from the only reference parameter.
/// With two reference parameters it would be ambiguous, and that is a compile error (E5012).
std::str first_word(std::string& text) {
    std::str all = text.as_str();
    return match (all.find(" ")) {
        std::some(i) => all.slice(0, i),
        std::none => all,
    };
}

struct inventory {
    std::darray<std::string> items;
    std::string owner = std::string::from("");
}

i32 main() {
    std::println("-- copy types are copied, everything else is moved");
    u32 n = 5;
    u32 m = n;                                  // a copy: n is still usable
    std::string s = std::string::from("hello");
    std::string t = move s;                     // a move, written out: `s` can't be used any more
    std::println(f"{n} {m} {t}");
    // std::println(s);                         // error[E5002]: 's' is used after it was moved
    std::string u = t.clone();                  // copying something that allocates is explicit
    std::println(f"{t} {u}");

    std::println("-- destructors run when the owner's scope ends");
    {
        connection a = connection::open("alpha");
        connection b = connection::open("beta");
        a.send("hi");
        consume(move b);                        // b is closed inside consume
        std::println("  end of block");
    }                                           // a is closed here

    std::println("-- borrowing");
    mut std::string name = std::string::from("report");
    rename(mut name, "_final");
    std::string sentence = std::string::from("borrowed words stay valid");
    std::println(f"{name}, first word: {first_word(sentence)}");

    std::println("-- moving parts out of a struct");
    mut inventory inv = inventory{ .items = default, .owner = std::string::from("ann") };
    inv.items.push(std::string::from("lamp"));
    inv.items.push(std::string::from("rope"));
    std::darray<std::string> taken = std::take(mut inv.items);           // leaves an empty darray
    std::string previous = std::replace(mut inv.owner, std::string::from("bob"));
    std::println(f"took {taken.len()} items from {previous}; {inv.owner} has {inv.items.len()}");
    mut std::string left = std::string::from("left");
    mut std::string right = std::string::from("right");
    std::swap(mut left, mut right);
    std::println(f"{left} {right}");

    std::println("-- a loop borrows its container");
    mut std::darray<u32> numbers = default;
    for (u32 i : 1..=4) { numbers.push(i * i); }
    for (mut u32& x : numbers) { x += 1; }      // a mutable borrow of each element
    // for (u32& x : numbers) { numbers.push(x); }   // error[E5021]: numbers is borrowed by the loop
    mut u32 total = 0;
    for (u32 x : numbers) { total += x; }
    std::println(f"total {total}");

    std::println("-- end of main");
    connection last = connection::open("gamma");
    return 0;
}
