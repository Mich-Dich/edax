// windowing_demo: DESIGN DRAFT for std::windowing, a GLFW-style window and input module in the
// standard library. Nothing here compiles yet. This file shows what using the API would look
// like, so the API can be reviewed before any of it is built.
//
// ------------------------------------------------------------------------------------------------
// Design decisions, and the spec rule each one comes from
// ------------------------------------------------------------------------------------------------
//  1. RAII, not init/terminate. std::windowing::system::start() replaces glfwInit. The destructor
//     of `system` replaces glfwTerminate, and the destructor of `window` replaces
//     glfwDestroyWindow. Locals are destroyed in reverse order (12), so a window declared after
//     the system is always closed first, which is the order GLFW needs.
//  2. Events are values, not callbacks. sys.poll_events() returns a std::span<event>. `event` is
//     an enum with payloads that you handle with an exhaustive `match` (08, 10). There is no
//     glfwSet*Callback: stored callbacks would need std::function (heap) and couldn't capture
//     references (18). One way to receive input.
//  3. Hints become a struct. The global glfwWindowHint state machine turns into `window_config`,
//     with designated fields and defaults (05). No hidden global state.
//  4. Errors are values. Creation returns std::result<T, std::windowing::error> instead of NULL
//     plus glfwSetErrorCallback (11).
//  5. Raw handles are unsafe. GL function pointers and native handles are std::raw_ptr; turning
//     them into something callable needs `unsafe` (13).
//  6. Changes are visible. Anything that changes a window (title, size, cursor, fullscreen) is a
//     `mut` method, so it only works on a `mut` window (06).
//  7. Main thread only. `system` and `window` can't cross threads (waiting on the concurrency
//     design, 22 #2).
//
// ------------------------------------------------------------------------------------------------
// GLFW → std::windowing
// ------------------------------------------------------------------------------------------------
//  glfwInit / glfwTerminate            std::windowing::system::start() / ~system()
//  glfwWindowHint + glfwCreateWindow   sys.create_window(std::windowing::window_config{ ... })
//  glfwDestroyWindow                   ~window()
//  glfwWindowShouldClose               win.should_close()
//  glfwSetWindowShouldClose            win.request_close() mut / win.cancel_close() mut
//  glfwPollEvents / glfwWaitEvents     sys.poll_events() mut / sys.wait_events() mut → std::span<event>
//  glfwSet*Callback                    std::windowing::event alternatives (no callbacks)
//  glfwGetKey / glfwGetMouseButton     win.key_down(key) / win.mouse_down(mouse_button)
//  glfwGetCursorPos                    win.cursor_position() → std::windowing::position
//  glfwSetInputMode(CURSOR, ...)       win.set_cursor_mode(cursor_mode) mut
//  glfwGetFramebufferSize              win.framebuffer_size() → std::windowing::size
//  glfwSetWindowMonitor                win.set_fullscreen(monitor) mut / win.set_windowed(rect) mut
//  glfwGetMonitors / glfwGetPrimary    sys.monitors() → std::span<monitor> / sys.primary_monitor()
//  glfwMakeContextCurrent              win.make_context_current()
//  glfwSwapBuffers / glfwSwapInterval  win.swap_buffers() / sys.set_swap_interval(u32) mut
//  glfwGetProcAddress                  win.gl_proc_address(name) → std::option<std::raw_ptr<u8>>
//  glfwGetTime                         sys.time() → f64 seconds
//  glfwGet/SetClipboardString          sys.clipboard_text() → std::option<std::string> / sys.set_clipboard_text(str) mut
//  glfwGetGamepadState                 sys.gamepad(u8) → std::option<gamepad_state>
//  glfwGetPlatform                     sys.platform() → std::windowing::platform (wayland, x11, ...)
// ------------------------------------------------------------------------------------------------

import std;
import std::windowing;

// Errors of this program. std::windowing errors are wrapped explicitly, because `?` never
// converts error types on its own (11).
enum app_error : u8 {
    windowing(std::windowing::error),
    missing_gl_function(std::static_str),
}

// The two GL functions this demo needs, loaded at run time from the driver.
struct gl_functions {
    std::fn_ptr<void(f32, f32, f32, f32)> clear_color;    // glClearColor
    std::fn_ptr<void(u32)>                clear;          // glClear
}

compile_time u32 gl_color_buffer_bit = 0x4000;

// The program's own state. Plain data: std::windowing never sees it.
struct app_state {
    f64  player_x = 640.0;
    f64  player_y = 360.0;
    f64  zoom     = 1.0;
    bool paused   = false;

    // Requests that need `sys`. While the event span borrows `sys`, the event handlers can't call
    // its methods (12), so they set these flags and the main loop acts on them afterwards.
    bool toggle_fullscreen_requested = false;
    bool copy_position_requested     = false;

    // Where the window was before going fullscreen, so it can go back there.
    std::windowing::rect saved_rect = default;

    u32 frames_this_second = 0;
    f64 second_started     = 0.0;
}

// Looks up the GL entry points. Asking for an address is safe; turning it into something
// callable is `unsafe`, because Rift can't check the signature (13).
std::result<gl_functions, app_error> load_gl(std::windowing::window& win) {
    std::raw_ptr<u8> clear_color = win.gl_proc_address("glClearColor").or_error(app_error::missing_gl_function("glClearColor"))?;
    std::raw_ptr<u8> clear = win.gl_proc_address("glClear").or_error(app_error::missing_gl_function("glClear"))?;
    unsafe {
        return std::ok(gl_functions{
            .clear_color = cast::reinterpret<std::fn_ptr<void(f32, f32, f32, f32)>>(clear_color),
            .clear       = cast::reinterpret<std::fn_ptr<void(u32)>>(clear),
        });
    }
}

// A key press. Releases and repeats are filtered out by the pattern in handle_event.
void handle_key_press(mut app_state& state, mut std::windowing::window& win,
    std::windowing::key key, std::windowing::modifiers mods) {

    match (key) {
        std::windowing::key::escape            => win.request_close(),
        std::windowing::key::space             => { state.paused = !state.paused; },
        std::windowing::key::f11               => { state.toggle_fullscreen_requested = true; },
        std::windowing::key::c if mods.control => { state.copy_position_requested = true; },
        _                                      => {},
    }
}

// One event. The match is exhaustive: a new alternative added to std::windowing::event is a
// compile error here until it's handled (or ignored on purpose with `_`).
void handle_event(mut app_state& state, mut std::windowing::window& win, std::windowing::event& e) {
    match (e) {
        std::windowing::event::close_requested(_) => {
            // win.should_close() is already true. Calling win.cancel_close() here would keep the
            // window open, e.g. to ask "save changes?".
            std::println("close requested");
        },

        // Struct patterns pick out presses; `..` skips the fields we don't need (window, scancode).
        std::windowing::event::key(std::windowing::key_event{
            .action = std::windowing::key_action::pressed, .key = k, .modifiers = m, ..
        }) => handle_key_press(mut state, mut win, k, m),
        std::windowing::event::key(_) => {},                    // released, repeated

        std::windowing::event::text(t) => std::println(f"typed '{t.character}'"),

        std::windowing::event::mouse_button(b) => {
            match (b.button) {
                // Holding the right button captures the cursor (hidden, unlimited movement).
                std::windowing::mouse_button::right => {
                    match (b.action) {
                        std::windowing::button_action::pressed =>
                            win.set_cursor_mode(std::windowing::cursor_mode::captured),
                        std::windowing::button_action::released =>
                            win.set_cursor_mode(std::windowing::cursor_mode::normal),
                    }
                },
                _ => {},
            }
        },

        std::windowing::event::cursor_moved(_) => {},           // read with win.cursor_position()

        std::windowing::event::scrolled(s) => {
            f64 next = state.zoom * (1.0 + s.y * 0.1);
            state.zoom = if (next < 0.25) { 0.25 } else if (next > 8.0) { 8.0 } else { next };
        },

        // Window size is in screen coordinates; the framebuffer is in pixels. They differ on
        // HiDPI screens. Rendering uses the framebuffer size.
        std::windowing::event::resized(_) => {},
        std::windowing::event::framebuffer_resized(r) =>
            std::println(f"framebuffer is now {r.width}x{r.height} pixels"),

        std::windowing::event::focus_changed(f) => { state.paused = !f.focused; },
    }
}

i32 main() {
    // ---- start: glfwInit ------------------------------------------------------------------
    mut std::windowing::system sys = match (std::windowing::system::start()) {
        std::ok(s)    => move s,
        std::error(e) => {
            std::eprintln(f"cannot start the windowing system: {e}");   // e.g. no_display
            return 1;
        },
    };
    std::println(f"platform: {sys.platform()}");                      // wayland, x11, win32, cocoa

    // monitor is a copy-type handle, like GLFWmonitor*. Its queries return values, not views.
    for (std::windowing::monitor m : sys.monitors()) {
        std::windowing::video_mode mode = m.video_mode();
        std::println(f"monitor {m.name()}: {mode.width}x{mode.height} @ {mode.refresh_rate} Hz");
    }

    // ---- create a window: glfwWindowHint + glfwCreateWindow -------------------------------
    // Every field not listed takes its default (visible = true, decorated = true, ...).
    mut std::windowing::window win = match (sys.create_window(std::windowing::window_config{
        .title     = "Rift windowing demo",
        .size      = std::windowing::size{ .width = 1280, .height = 720 },
        .resizable = true,
        .graphics  = std::windowing::graphics::opengl(std::windowing::opengl_config{
            .version_major = 3,
            .version_minor = 3,
            .profile       = std::windowing::opengl_profile::core,
        }),
        // For Vulkan: `.graphics = std::windowing::graphics::none`, then
        // sys.vulkan_required_extensions() and the unsafe win.create_vulkan_surface(instance).
    })) {
        std::ok(w)    => move w,
        std::error(e) => {
            std::eprintln(f"cannot create the window: {e}");          // e.g. version_unavailable
            return 1;
        },
    };

    // ---- graphics context --------------------------------------------------------------
    win.make_context_current();
    sys.set_swap_interval(1);                                         // vsync
    gl_functions gl = match (load_gl(win)) {
        std::ok(g) => g,
        std::error(app_error::missing_gl_function(name)) => {
            std::eprintln(f"the GL driver has no {name}");
            return 1;
        },
        std::error(app_error::windowing(e)) => {
            std::eprintln(f"windowing error: {e}");
            return 1;
        },
    };

    mut app_state state = default;
    mut f64 last_frame = sys.time();
    state.second_started = last_frame;

    // ---- main loop -------------------------------------------------------------------------
    while (!win.should_close()) {
        // 1. Events. The span is a view into `sys`, valid until the next poll. While it's alive,
        //    `sys` can't be used (12): writing sys.set_clipboard_text(...) inside this loop is
        //    a compile error. That's why the handlers only set request flags.
        for (std::windowing::event& e : sys.poll_events()) {
            handle_event(mut state, mut win, e);
        }

        // 2. Requests that need `sys`. std::take returns the flag and resets it to false.
        if (std::take(mut state.toggle_fullscreen_requested)) {
            match (win.mode()) {
                std::windowing::window_mode::windowed => {
                    match (sys.primary_monitor()) {
                        std::some(m) => {
                            state.saved_rect = win.rect();
                            win.set_fullscreen(m);
                        },
                        std::none => std::eprintln("no monitor to go fullscreen on"),
                    }
                },
                std::windowing::window_mode::fullscreen(_) => win.set_windowed(state.saved_rect),
            }
        }
        if (std::take(mut state.copy_position_requested)) {
            sys.set_clipboard_text(std::format(f"{state.player_x:.1}, {state.player_y:.1}"));
            std::println("position copied to the clipboard");
        }

        // 3. Continuous input: state queries (glfwGetKey), not events.
        f64 now = sys.time();
        f64 dt  = now - last_frame;
        last_frame = now;
        if (!state.paused) {
            f64 step = 300.0 * dt;
            if (win.key_down(std::windowing::key::w)) { state.player_y -= step; }
            if (win.key_down(std::windowing::key::s)) { state.player_y += step; }
            if (win.key_down(std::windowing::key::a)) { state.player_x -= step; }
            if (win.key_down(std::windowing::key::d)) { state.player_x += step; }

            // A gamepad is a value read once per frame, like glfwGetGamepadState.
            match (sys.gamepad(0)) {
                std::some(pad) => {
                    state.player_x += cast<f64>(pad.axis(std::windowing::gamepad_axis::left_x)) * step;
                    state.player_y += cast<f64>(pad.axis(std::windowing::gamepad_axis::left_y)) * step;
                    if (pad.button_down(std::windowing::gamepad_button::start)) { win.request_close(); }
                },
                std::none => {},
            }
        }

        // 4. Draw. Calling a pointer from the driver is unsafe (13).
        f32 shade = if (state.paused) { 0.05 } else { 0.12 };
        unsafe {
            gl.clear_color(shade, shade, shade + 0.03, 1.0);
            gl.clear(gl_color_buffer_bit);
        }
        win.swap_buffers();

        // 5. Frame counter in the title. std::format allocates, and you can see that it does.
        state.frames_this_second += 1;
        if (now - state.second_started >= 1.0) {
            win.set_title(std::format(f"Rift windowing demo - {state.frames_this_second} fps"));
            state.frames_this_second = 0;
            state.second_started     = now;
        }
    }

    std::println(f"bye, last position {state.player_x:.1}, {state.player_y:.1}");
    return 0;
}   // win is destroyed first (glfwDestroyWindow), then sys (glfwTerminate)

// ------------------------------------------------------------------------------------------------
// Open questions found while writing this demo
// ------------------------------------------------------------------------------------------------
//  1. Name length. Every name is written in full, so `std::windowing::key::escape` gets long in
//     input code. This is a real data point for module aliases (22 #12, #30).
//  2. C function pointers. std::fn_ptr has Rift's calling convention. GL pointers need a C one,
//     e.g. std::fn_ptr<extern(std::build::language::c) void(u32)>. Not designed yet.
//  3. Window outliving the system. Reverse destruction order handles the normal case, but
//     `move win` into a longer-lived place could outlive `sys`. Options: every window holds a
//     shared count on the platform connection, or windows are handles (ids) owned by `sys`.
//  4. Dropped files. A files_dropped event would carry paths. As a span into `sys` the event
//     becomes a view type; as std::darray<std::filesystem::path> every poll allocates.
//  5. Threads. Some platforms only allow windowing on the main thread. This needs the
//     "may cross threads" rule from the concurrency design (22 #2).
//  6. One event span for all windows (as here, events carry `.window`), or one queue per
//     window (`win.poll_events()`)? The first matches GLFW; the second is simpler with one window.
