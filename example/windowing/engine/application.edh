// windowing/engine/application: the application object and its main loop.
//
// The application owns the window system, the renderer, the main window and the layers. It is
// made from a project directory (where `config/` is), restores the main window from the saved
// attributes, and saves them again when it is destroyed. run() is the game loop:
//
//   1. poll the window system (or wait, when every layer is idle)
//   2. the main window's events, through the layers top to bottom
//   3. the layers' updates, bottom to top
//   4. what the layers asked for (quit, fullscreen)
//   5. assets the loader finished
//   6. render: one frame of the main window, every layer bottom to top
//   7. the frame clock: stats, the title's fps, the frame-rate cap
//
// The fields are declared in the order things are made, so they are destroyed the other way
// round: the layers (and the windows they opened) first, then the main window, the renderer and its
// share group, and the window system last.

import std;
import windowing::engine::layer;
import windowing::engine::renderer;
import windowing::engine::settings;
import windowing::engine::timing;

namespace engine {
    namespace wnd = std::windowing;

    class application {
    public:
        // Starts the window system, the renderer and the main window (from the saved attributes,
        // else `default_attributes`). `project` is where `config/` is.
        static std::result<application, wnd::error> make(std::filesystem::path project, window_attributes default_attributes);

        // Adds a layer below the overlays, and attaches it.
        void push_layer(std::unique_ptr<layer> l) mut;
        // Adds an overlay on top, and attaches it.
        void push_overlay(std::unique_ptr<layer> l) mut;
        void set_target_fps(u32 fps) mut;

        // The game loop, until the main window closes (or a layer asks to quit).
        void run() mut;

        // Detaches the layers and saves the main window's attributes.
        ~application();
    }
}
