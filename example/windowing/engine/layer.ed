// windowing/engine/layer (see layer.edh).

import std;
import windowing::engine::renderer;
import windowing::engine::timing;

namespace engine {
    namespace wnd = std::windowing;

    class layer_stack {
    public:
        void push_layer(std::unique_ptr<layer> l) mut {
            usize at = this.overlay_start;
            this.layers.insert(at, move l);
            this.overlay_start += 1;
            this.last_pushed = this.overlay_start - 1;
        }

        void push_overlay(std::unique_ptr<layer> l) mut {
            this.layers.push(move l);
            this.last_pushed = this.layers.len() - 1;
        }

        usize len() { return this.layers.len(); }

        void attach_last(mut context& ctx) mut {
            std::log::debug(f"layer '{this.layers[this.last_pushed]->name()}' attached");
            this.layers[this.last_pushed]->on_attach(mut ctx);
        }

        void detach_all(mut context& ctx) mut {
            mut usize i = this.layers.len();
            while (i > 0) {
                i -= 1;
                this.layers[i]->on_detach(mut ctx);
            }
        }

        event_result dispatch(wnd::event& e, mut context& ctx) mut {
            mut usize i = this.layers.len();
            while (i > 0) {
                i -= 1;
                if (this.layers[i]->on_event(e, mut ctx) == event_result::handled) {
                    return event_result::handled;
                }
            }
            return event_result::pass;
        }

        void update(mut context& ctx) mut {
            for (mut std::unique_ptr<layer>& l : this.layers) {
                l->on_update(mut ctx);
            }
        }

        void render(render_context& rc, mut wnd::opengl::frame& frame) mut {
            for (mut std::unique_ptr<layer>& l : this.layers) {
                l->on_render(rc, mut frame);
            }
        }
    private:
        std::darray<std::unique_ptr<layer>> layers = default;
        usize overlay_start = 0;
        usize last_pushed = 0;
    }
}
