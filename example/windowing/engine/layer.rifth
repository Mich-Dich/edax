// windowing/engine/layer: how the application's parts plug in.
//
// A layer is one part of the program: the game, the editor's tools, the debug overlay. The
// application owns them in a layer_stack:
//
//   events   top to bottom: overlays first, then the layers from the last pushed; a layer that
//            returns `handled` stops the event there (an open debug UI keeps keys from the game)
//   update   bottom to top, once per frame, with the frame's context
//   render   bottom to top, into the main window's frame: overlays draw last, on top
//
// Layers get the application through `context`: the window system (to open windows), the main
// window, the renderer, the frame's timing, and `commands` for what only the application does
// (quitting, fullscreen, idling). Rendering gets a frame instead: while the frame is drawn the main
// window is borrowed by it, so nothing else can touch the window.

import std;
import windowing::engine::renderer;
import windowing::engine::timing;

namespace engine {
    namespace wnd = std::windowing;

    // Whether a layer took an event.
    enum event_result : u8 {
        pass,
        handled,
    }

    // What layers ask the application to do; read after the frame's updates.
    struct commands {
        bool quit = false;
        bool toggle_fullscreen = false;
        // Nothing animates: sleep until an event comes instead of polling (set every frame).
        bool idle = false;
    }

    // The application, as the layers see it during events and updates.
    view struct context {
        mut wnd::system&      system;
        mut wnd::gl_window&   main_window;
        mut renderer&         renderer;
        mut commands&         commands;
        frame_stats&          stats;
        std::filesystem::path& config_dir;
    }

    // What a layer draws with: the renderer and the timing (the frame is the other argument).
    view struct render_context {
        renderer&    renderer;
        frame_stats& stats;
    }

    interface layer {
        // For the log.
        std::static_str name();
        // When the layer joins the application.
        void on_attach(mut context& ctx) mut { }
        // When the application ends, before the windows close.
        void on_detach(mut context& ctx) mut { }
        // One event of the main window.
        event_result on_event(wnd::event& e, mut context& ctx) mut { return event_result::pass; }
        // Once per frame, after the events.
        void on_update(mut context& ctx) mut { }
        // Into the main window's frame.
        void on_render(render_context& rc, mut wnd::opengl::frame& frame) mut { }
    }

    // The layers, overlays on top.
    class layer_stack {
    public:
        // Adds a layer below the overlays.
        void push_layer(std::unique_ptr<layer> l) mut;
        // Adds an overlay on top of everything.
        void push_overlay(std::unique_ptr<layer> l) mut;
        usize len();

        void attach_last(mut context& ctx) mut;
        void detach_all(mut context& ctx) mut;
        // Top to bottom until a layer handles it.
        event_result dispatch(wnd::event& e, mut context& ctx) mut;
        void update(mut context& ctx) mut;
        void render(render_context& rc, mut wnd::opengl::frame& frame) mut;
    }
}
