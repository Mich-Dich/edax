// windowing/engine/renderer: the GPU side the layers share.
//
// One OpenGL share group holds the program's resources. It has a context of its own, so resources
// are made with no window involved and outlive every window; every window made with the
// renderer's config joins it (sharing::automatic, or join(group) explicitly). The renderer also
// owns the GL function table and the asset loader: a worker thread makes an image and sends it
// over a channel, the main thread uploads it once into the group.
//
// Vulkan has nothing like a share group: a Vulkan resource belongs to a VkDevice, and one device
// presents to as many window surfaces as you like. Only OpenGL ties resources to contexts, which is
// why share_group lives under std::windowing::opengl.

import std;
import windowing::engine::gl;

namespace engine {
    namespace wnd = std::windowing;

    // The OpenGL context every window of the renderer asks for. Equal configs share a group.
    compile_time wnd::opengl::config gl_33 = wnd::opengl::config{
        .major   = 3,
        .minor   = 3,
        .profile = wnd::opengl::profile::core,
    };

    class renderer {
    public:
        // The share group and the GL functions.
        static std::result<renderer, wnd::error> make(mut wnd::system& sys);

        gl::functions& gl();
        // The group, for windows that join it explicitly: sharing::join(r.share_group()).
        wnd::opengl::share_group share_group();
        // The texture the loader made, once it has arrived.
        std::option<u32> shared_texture();

        // Starts loading the shared texture on a worker thread.
        void load_assets() mut;
        // Uploads what the loader sent since the last call; the image, when one arrived (the
        // application makes it the window icon).
        std::option<wnd::image> upload_arrivals() mut;
    }

    // An RGBA checkerboard: the "asset" the loader makes.
    wnd::image make_checker_image(u32 size, u32 cell);

    // The corner marker of a window: green when the shared texture exists in the window's context
    // (glIsTexture), red when it doesn't. That's sharing, visible.
    void draw_sharing_marker(gl::functions& f, wnd::size framebuffer, std::option<u32> shared_texture);
}
