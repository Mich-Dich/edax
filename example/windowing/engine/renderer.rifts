// windowing/engine/renderer (see renderer.rifth).

import std;
import windowing::engine::gl;

namespace engine {
    namespace wnd = std::windowing;

    class renderer {
    public:
        static std::result<renderer, wnd::error> make(mut wnd::system& sys) {
            mut wnd::opengl::share_group group = sys.create_share_group(gl_33)?;
            gl::functions f = {
                wnd::opengl::current context = group.make_current();
                gl::load(context).expect("OpenGL 1.1 functions")     // GLX: the same addresses in every context
            };
            std::log::info(f"renderer: OpenGL share group {group.id()}");
            return std::ok(renderer{ .group = move group, .functions = f });
        }

        gl::functions& gl() { return this.functions; }

        wnd::opengl::share_group share_group() { return this.group.clone(); }

        std::option<u32> shared_texture() { return this.texture; }

        void load_assets() mut {
            std::channel<wnd::image> loaded = std::channel<wnd::image>::bounded(1);
            this.arrivals = std::some(loaded.receiver());
            // std::thread::spawn([move window]() { ... }) would not compile: windows are thread_bound.
            this.loader = std::some(std::thread::spawn([out = loaded.sender()]() {
                _ = out.send(make_checker_image(64, 8));
            }));
        }

        std::option<wnd::image> upload_arrivals() mut {
            wnd::image img = match (mut this.arrivals) {
                std::some(r) => match (r.try_receive()) {
                    std::ok(i)    => move i,
                    std::error(_) => return std::none,
                },
                std::none => return std::none,
            };
            {
                wnd::opengl::current context = this.group.make_current();
                this.texture = std::some(gl::upload_texture(this.functions, context, img));
            }
            std::log::info(f"renderer: shared texture {this.texture.value_or(0)} uploaded ({img.width}x{img.height})");
            return std::some(move img);
        }
    private:
        // Destroyed in reverse: the loader thread (joined) and its channel, then the group.
        wnd::opengl::share_group                          group;
        gl::functions                                     functions;
        std::option<u32>                                  texture = std::none;
        std::option<std::channel_receiver<wnd::image>>    arrivals = std::none;
        std::option<std::thread::handle<void>>            loader = std::none;
    }

    wnd::image make_checker_image(u32 size, u32 cell) {
        mut std::darray<u8> pixels = std::darray<u8>::with_capacity(cast<usize>(size) * cast<usize>(size) * 4);
        for (u32 y : 0..size) {
            for (u32 x : 0..size) {
                u8 v = if ((x / cell + y / cell) % 2 == 0) { 40 } else { 220 };
                pixels.push(v);
                pixels.push(v);
                pixels.push(v);
                pixels.push(255);
            }
        }
        return wnd::image{ .width = size, .height = size, .pixels = move pixels };
    }

    void draw_sharing_marker(gl::functions& f, wnd::size framebuffer, std::option<u32> shared_texture) {
        bool present = match (shared_texture) {
            std::some(t) => unsafe { f.glIsTexture(t) } != 0,
            std::none    => false,
        };
        gl::color c = if (present) { gl::color{ .g = 0.8 } } else { gl::color{ .r = 0.8 } };
        i32 width = cast::saturate<i32>(framebuffer.width);
        gl::fill(f, cast::saturate<i32>(framebuffer.height), width - 24, 8, 16, 16, c);
    }
}
