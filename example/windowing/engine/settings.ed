// windowing/engine/settings (see settings.edh).

import std;

namespace engine {
    private compile_time std::static_str settings_file = "app_settings.cfg";

    std::filesystem::path config_dir(std::filesystem::path& project) {
        return project / "config";
    }

    void serialize_window_attributes(std::filesystem::path& project, mut window_attributes& attributes, serialize_option option) {
        std::filesystem::path dir = config_dir(project);
        std::filesystem::path file = dir / settings_file;
        match (option) {
            serialize_option::load => load_attributes(file, mut attributes),
            serialize_option::save => {
                match (std::filesystem::create_directories(dir)) {
                    std::ok(_)    => save_attributes(file, attributes),
                    std::error(e) => std::log::error(f"can't create {dir.as_str()}: {e}"),
                }
            },
        }
    }

    private void load_attributes(std::filesystem::path& file, mut window_attributes& a) {
        mut std::file f = match (std::file::open(file)) {
            std::ok(opened) => move opened,
            std::error(_)   => {
                std::log::debug(f"no {file.as_str()} yet: the default window");
                return;
            },
        };
        mut u32 line_number = 0;
        for (std::str line : f.lines()) {
            line_number += 1;
            std::str text = line.trim();
            if (text.is_empty() || text.starts_with("#")) {
                continue;
            }
            usize equals = match (text.find("=")) {
                std::some(at) => at,
                std::none     => {
                    std::log::warn(f"{file.as_str()}:{line_number}: not 'key = value'");
                    continue;
                },
            };
            std::str key = text.slice(0, equals).trim();
            std::str value = text.slice(equals + 1, text.len()).trim();
            if (!apply(mut a, key, value)) {
                std::log::warn(f"{file.as_str()}:{line_number}: can't use '{key} = {value}'");
            }
        }
        std::log::info(f"window attributes loaded from {file.as_str()}");
    }

    // One `key = value` line; false for an unknown key or a value that doesn't parse.
    private bool apply(mut window_attributes& a, std::str key, std::str value) {
        if (key == "window.title") {
            a.title = std::string::from(value);
            return true;
        }
        if (key == "window.width" || key == "window.height") {
            u32 n = match (value.parse<u32>()) {
                std::some(v) => v,
                std::none    => return false,
            };
            if (n < 64) {
                return false;
            }
            if (key == "window.width") { a.width = n; } else { a.height = n; }
            return true;
        }
        if (key == "window.pos_x" || key == "window.pos_y") {
            i32 n = match (value.parse<i32>()) {
                std::some(v) => v,
                std::none    => return false,
            };
            if (key == "window.pos_x") { a.pos_x = n; } else { a.pos_y = n; }
            return true;
        }
        if (key == "window.vsync") {
            match (value.parse<bool>()) {
                std::some(v) => { a.vsync = v; },
                std::none    => return false,
            }
            return true;
        }
        if (key == "window.size_state") {
            if (value == "windowed") {
                a.size_state = window_size_state::windowed;
            } else if (value == "fullscreen") {
                a.size_state = window_size_state::fullscreen;
            } else {
                return false;
            }
            return true;
        }
        return false;
    }

    private void save_attributes(std::filesystem::path& file, window_attributes& a) {
        mut std::file out = match (std::file::create(file)) {
            std::ok(created) => move created,
            std::error(e)    => {
                std::log::error(f"can't save the window attributes to {file.as_str()}: {e}");
                return;
            },
        };
        std::str state = match (a.size_state) {
            window_size_state::windowed   => "windowed",
            window_size_state::fullscreen => "fullscreen",
        };
        _ = out.write("# The main window, written when the application ends.\n");
        _ = out.write(std::format(f"window.title = {a.title}\n").as_str());
        _ = out.write(std::format(f"window.width = {a.width}\n").as_str());
        _ = out.write(std::format(f"window.height = {a.height}\n").as_str());
        _ = out.write(std::format(f"window.pos_x = {a.pos_x}\n").as_str());
        _ = out.write(std::format(f"window.pos_y = {a.pos_y}\n").as_str());
        _ = out.write(std::format(f"window.vsync = {a.vsync}\n").as_str());
        _ = out.write(std::format(f"window.size_state = {state}\n").as_str());
        std::log::info(f"window attributes saved to {file.as_str()}");
    }
}
