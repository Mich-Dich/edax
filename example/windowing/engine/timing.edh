// windowing/engine/timing: the frame clock.
//
// interval_controller keeps the loop at a target rate (it sleeps away what's left of a frame), and
// frame_stats counts what happened: the delta and total time the layers get, frames per second.

import std;

namespace engine {
    // Caps the frame rate: begin() when a frame starts, wait() when it is done.
    class interval_controller {
    public:
        static interval_controller with_fps(u32 fps);
        void set_target_fps(u32 fps) mut;
        u32 target_fps();
        void begin() mut;
        // Sleeps for the rest of the frame's interval (nothing when the frame took longer).
        void wait() mut;
    }

    // The application's timing, updated once per frame.
    @std::derive::formattable
    struct frame_stats {
        f64 delta_time = 0.0;       // seconds since the previous frame
        f64 total_time = 0.0;       // seconds since the application started
        u64 frame_count = 0;
        u32 fps = 0;                // frames in the last whole second
        f64 frame_ms = 0.0;         // the last frame's work, without the wait
    }

    // Counts frames into its frame_stats.
    class frame_clock {
    public:
        static frame_clock start();
        // A new frame: delta and total time. Returns true once a second, when `fps` is new.
        bool tick() mut;
        // The frame's work is done (before the wait): its time in milliseconds.
        void work_done() mut;
        frame_stats& stats();
    }
}
