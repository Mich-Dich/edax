// windowing/game/actions (see actions.edh).

import std;

namespace game {
    namespace wnd = std::windowing;

    class rebind_prompt {
    public:
        void start(game_action action) mut {
            this.waiting_for = std::some(action);
            std::log::info(f"press the new key for '{action}' (Escape keeps the old one)");
        }

        bool is_waiting() { return this.waiting_for.is_some(); }

        std::option<(game_action, wnd::chord)> take_result() mut {
            return std::take(mut this.result);
        }

        wnd::routing on_event(wnd::event e, wnd::input_state& input) mut override {
            game_action action = match (this.waiting_for) {
                std::some(a) => a,
                std::none    => return wnd::routing::pass,
            };
            mut std::option<wnd::chord> pressed = std::none;
            match (e) {
                wnd::event::key(k) => {
                    if (k.action == wnd::key_action::pressed && !is_modifier(k.key)) {
                        pressed = if (k.key == wnd::key::escape) {
                            std::none
                        } else {
                            std::some(wnd::chord::with(k.key, k.modifiers))
                        };
                        this.waiting_for = std::none;
                    }
                },
                wnd::event::mouse_button(b) => {
                    if (b.action == wnd::button_action::pressed) {
                        pressed = std::some(wnd::chord{ .trigger = wnd::trigger::button(b.button), .modifiers = b.modifiers });
                        this.waiting_for = std::none;
                    }
                },
                wnd::event::text(_) => {},
                _ => return wnd::routing::pass,      // moves, resizes, focus: not for the prompt
            }
            match (pressed) {
                std::some(c) => { this.result = std::some((action, c)); },
                std::none    => {},
            }
            return wnd::routing::consume;            // the game never sees keys typed into the prompt
        }

        bool is_active() override { return this.waiting_for.is_some(); }
    private:
        std::option<game_action>               waiting_for = std::none;
        std::option<(game_action, wnd::chord)> result = std::none;
    }

    private bool is_modifier(wnd::key k) {
        return match (k) {
            wnd::key::left_shift    => true,
            wnd::key::right_shift   => true,
            wnd::key::left_control  => true,
            wnd::key::right_control => true,
            wnd::key::left_alt      => true,
            wnd::key::right_alt     => true,
            wnd::key::left_super    => true,
            wnd::key::right_super   => true,
            _                       => false,
        };
    }

    wnd::bindings<game_action> load_bindings(std::filesystem::path& file) {
        mut std::file f = match (std::file::open(file)) {
            std::ok(opened) => move opened,
            std::error(_)   => return wnd::bindings<game_action>::defaults(),
        };
        mut std::string text = default;
        for (std::str line : f.lines()) {
            text.push_str(line);
            text.push(';');
        }
        return match (wnd::bindings<game_action>::from_text(text.as_str())) {
            std::ok(keys) => {
                std::log::info(f"key bindings loaded from {file.as_str()}");
                keys
            },
            std::error(e) => {
                std::log::warn(f"{file.as_str()}: {e}; using the default keys");
                wnd::bindings<game_action>::defaults()
            },
        };
    }

    void save_bindings(wnd::bindings<game_action>& keys, std::filesystem::path& file) {
        match (std::file::create(file)) {
            std::ok(f) => {
                mut std::file out = move f;
                // One binding per line: easy to edit by hand.
                std::string text = keys.to_text();
                for (std::str part : text.as_str().split(';')) {
                    _ = out.write(part.trim());
                    _ = out.write("\n");
                }
                std::log::info(f"key bindings saved to {file.as_str()}");
            },
            std::error(e) => std::log::error(f"can't save the key bindings to {file.as_str()}: {e}"),
        }
    }
}
