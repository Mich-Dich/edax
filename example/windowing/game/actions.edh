// windowing/game/actions: what the player can do, and which keys do it.
//
// The *actions* are an enum, fixed when the program is compiled: every `match` on them is checked
// for completeness. The *keys* are data (std::windowing::bindings): they start from the defaults
// written on the enum, and change while the program runs:
//
//   - rebind_prompt: a layer that takes the next key press and binds it to an action (F2),
//   - profiles: a whole set of bindings swapped at once (Tab: WASD <-> arrow keys),
//   - save/load: the bindings as text in a file (Ctrl+S, read at start-up).
//
// Each layer that reads input owns its own bindings with its own action enum: the game layer uses
// game_action, the tools layer tool_action, the inspector windows inspector_action. Swapping one map
// doesn't touch the others.

import std;

namespace game {
    namespace wnd = std::windowing;

    // What the player does in the game window. The annotations are the default keys.
    @std::derive::formattable
    enum game_action : u8 {
        @wnd::default_key{ .key = wnd::key::escape }    quit,
        @wnd::default_key{ .key = wnd::key::p }         pause,
        @wnd::default_key{ .key = wnd::key::w }         move_up,
        @wnd::default_key{ .key = wnd::key::s }         move_down,
        @wnd::default_key{ .key = wnd::key::a }         move_left,
        @wnd::default_key{ .key = wnd::key::d }         move_right,
        @wnd::default_button{ .button = wnd::mouse_button::right }  look,
        @wnd::default_key{ .key = wnd::key::f11 }       fullscreen,
        @wnd::default_key{ .key = wnd::key::f2 }        rebind_pause,
        @wnd::default_key{ .key = wnd::key::tab }       switch_profile,
        @wnd::default_key{ .key = wnd::key::s, .modifiers = wnd::modifiers{ .control = true } }  save_bindings,
        // @wnd::default_key{ .key = wnd::key::p } jump,
        //   → error: 'pause' and 'jump' have the same @default_key
    }

    // The second binding profile: movement on the arrow keys. Profiles are text, the same format
    // bindings::to_text writes, so they can come from a file just as well.
    compile_time std::static_str arrows_profile = "quit = escape; pause = p; move_up = up; move_down = down; move_left = left; move_right = right; look = mouse_right; fullscreen = f11; rebind_pause = f2; switch_profile = tab; save_bindings = control+s";

    // A layer that, while waiting, takes the next key press (or button) for itself and reports it
    // as the new chord of `action`. The program applies it: the layer only borrows input.
    class rebind_prompt : wnd::input_layer {
    public:
        // Waits for the next key or button for `action`.
        void start(game_action action) mut;
        bool is_waiting();
        // The chord the user pressed, once; then the prompt is idle again.
        std::option<(game_action, wnd::chord)> take_result() mut;

        wnd::routing on_event(wnd::event e, wnd::input_state& input) mut override;
        bool is_active() override;
    }

    // The bindings saved by save_bindings, or the defaults when there is no such file (or it
    // doesn't parse: the reason is logged).
    wnd::bindings<game_action> load_bindings(std::filesystem::path& file);

    // Writes the bindings to `file` as text.
    void save_bindings(wnd::bindings<game_action>& keys, std::filesystem::path& file);
}
