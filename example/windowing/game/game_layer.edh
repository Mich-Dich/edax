// windowing/game/game_layer: the game, as a layer of the application.
//
// It owns the world (plain data: std::windowing never sees it), the player's key bindings and the
// rebinding prompt. Events become actions through the bindings; held actions (movement, mouse look)
// are read every update from the window's input state. It draws the world into the main window.

import std;
import windowing::engine::layer;
import windowing::engine::renderer;
import windowing::engine::timing;
import windowing::game::actions;

namespace game {
    namespace wnd = std::windowing;

    // The game's state.
    @std::derive::formattable
    struct world {
        f64  player_x = 300.0;
        f64  player_y = 200.0;
        f64  speed    = 240.0;     // screen units per second
        bool paused   = false;
        bool looking  = false;     // the look action is held: the cursor is captured
    }

    class game_layer : engine::layer {
    public:
        static game_layer make();

        std::static_str name() override;
        void on_attach(mut engine::context& ctx) mut override;
        void on_detach(mut engine::context& ctx) mut override;
        engine::event_result on_event(wnd::event& e, mut engine::context& ctx) mut override;
        void on_update(mut engine::context& ctx) mut override;
        void on_render(engine::render_context& rc, mut wnd::opengl::frame& frame) mut override;

        world& state();
    }
}
