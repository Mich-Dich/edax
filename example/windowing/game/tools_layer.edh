// windowing/game/tools_layer: the editor's tool windows, as a layer.
//
//   inspectors  Ctrl+N: tool windows of the main window, drawn on demand: the frame stats as bars.
//               They ask for the renderer's OpenGL config with sharing::automatic, so they join
//               its share group by themselves: the shared texture exists in them (green marker)
//   sandbox     Ctrl+Shift+N: OpenGL 2.1 with sharing::independent: a group of its own, so the
//               texture does *not* exist there (red marker)
//   Vulkan      Ctrl+K: a Vulkan window with its own instance and surface
//
// The layer owns these windows: closing one is destroying it. It reads its own shortcuts through
// its own bindings (tool_action), separate from the game's.

import std;
import windowing::engine::layer;
import windowing::engine::renderer;
import windowing::engine::timing;

namespace game {
    namespace wnd = std::windowing;

    // The tools' shortcuts in the main window.
    @std::derive::formattable
    enum tool_action : u8 {
        @wnd::default_key{ .key = wnd::key::n, .modifiers = wnd::modifiers{ .control = true } }  open_inspector,
        @wnd::default_key{ .key = wnd::key::n, .modifiers = wnd::modifiers{ .control = true, .shift = true } }  toggle_sandbox,
        @wnd::default_key{ .key = wnd::key::k, .modifiers = wnd::modifiers{ .control = true } }  toggle_vulkan,
    }

    // What the user does in an inspector window: its own map.
    @std::derive::formattable
    enum inspector_action : u8 {
        @wnd::default_key{ .key = wnd::key::escape }    close,
        @wnd::default_key{ .key = wnd::key::r }         refresh,
    }

    class tools_layer : engine::layer {
    public:
        static tools_layer make();

        std::static_str name() override;
        engine::event_result on_event(wnd::event& e, mut engine::context& ctx) mut override;
        void on_update(mut engine::context& ctx) mut override;
        void on_detach(mut engine::context& ctx) mut override;
    }
}
