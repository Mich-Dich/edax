// windowing: several windows with std::windowing, OpenGL and Vulkan.
//
//   edaxc run --root=example windowing          (from the repository root)
//
// The program has three parts:
//
//   main.ed           the entry point: starts the log, makes the application, runs it
//   application       the program: its windows, their input and what they draw (application.edh)
//   std::windowing    the windows themselves, and std::graphics for OpenGL's and Vulkan's functions
//
// Keys (main window): W A S D or the arrows move the box, the right mouse button held moves it with
// the mouse (the cursor is captured), the wheel resizes it, P pauses, F11 fullscreen, Ctrl+N an
// inspector, Ctrl+Shift+N the OpenGL 2.1 sandbox, Ctrl+K the Vulkan window, Esc quits (in an
// inspector: closes it).

import std;
import windowing::application;

@std::log::level_override{ .level = std::log::level::debug };

std::exit_code main() {
    std::thread::set_current_name("main");
    mut std::log::session logs = std::log::start(std::log::options{});
    _ = logs.add(std::log::console::make(), std::log::sink_options{ .pattern = std::log::patterns::detailed });

    mut demo::application app = match (demo::application::make()) {
        std::ok(a)    => move a,
        std::error(e) => {
            std::log::fatal(f"windowing: {e}");
            return std::exit_code::failure;
        },
    };
    app.run();
    return std::exit_code::success;
}
