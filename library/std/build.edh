// The Edax standard library: module std::build, what build modes and build.ed are made of
// (spec 24, 25). Everything here runs at compile time.

namespace std::build {
    // How much the optimizer works (spec 24): `basic` is the light optimization of the
    // `development` mode (fast to compile, playable to run, still easy to debug).
    enum optimization : u8 {
        none,
        size,
        speed,
        basic,
    }

    // How much debug information goes into the program.
    enum debug_info : u8 {
        none,
        line_tables,
        full,
    }

    // What `+`, `-` and `*` do when the result does not fit.
    enum overflow : u8 {
        panic,
        wrap,
    }

    // What `<<`, `>>` and `bit(n)` do with a count of at least the width.
    enum shifts : u8 {
        panic,
        mask,
    }

    // Whether `a[i]` checks `i` (unchecked allows undefined behaviour).
    enum bounds : u8 {
        panic,
        unchecked,
    }

    // Which `run_time` checks are compiled in (anything but `all` allows undefined behaviour).
    enum run_time_checks : u8 {
        all,
        gated_only,
        none,
    }

    // Whether `@std::float_mode` may relax floating point (spec 34): `strict` keeps every float
    // result identical on every machine (lockstep games, replays).
    enum float_determinism : u8 {
        relaxed,
        strict,
    }

    // Run-time instrumentation for finding memory and thread bugs in unsafe and C/C++ code
    // (spec 34). The C and C++ targets of the build are instrumented the same way.
    enum sanitizer : u8 {
        none,
        address,
        thread,
    }

    // What a panic does: print and abort, or a CPU trap instruction without a message.
    enum panic_behavior : u8 {
        abort,
        trap,
    }

    // A language that `extern(...)` and C targets name (spec 13, 25).
    enum language : u8 {
        c,
        cpp,
    }

    // The standard a C or C++ target is compiled with.
    enum cpp_standard : u8 {
        c11,
        c17,
        cpp17,
        cpp20,
        cpp23,
    }

    // Whether a target's include directories and defines also apply to the targets that link it.
    enum visibility : u8 {
        own,
        shared,
        users,
    }

    // A target of the build graph: what `g.add_executable(...)` and friends return. A copy type.
    struct target {
        u32 id = 0;
    }

    // A Edax program, library or test: `root` is its main `.ed` file.
    struct edax_target {
        std::static_str name = "";
        std::static_str root = "";
    }

    // A static library compiled from C or C++ sources (`g.add_sources`).
    struct c_target {
        std::static_str name = "";
        std::build::language language = std::build::language::c;
        std::build::cpp_standard standard = std::build::cpp_standard::c17;
    }

    // The C headers `g.import_c_headers` turns into a Edax module (C interop): `module` is the
    // generated `<module>.edh`, `namespace` the namespace of its declarations.
    view struct c_import {
        std::span<std::static_str> headers = [];
        std::static_str module = "";
        std::static_str namespace = "";
    }

    // C++ classes `g.wrap_cpp` makes usable from Edax (C interop): `classes` qualified
    // (`"JPH::PhysicsSystem"`), `templates` the instances to wrap, written out.
    view struct cpp_wrap {
        std::span<std::static_str> headers = [];
        std::span<std::static_str> classes = [];
        std::span<std::static_str> templates = [];
        std::static_str module = "";
        std::static_str namespace = "";
    }

    // A file in the project, relative to its root (spec 25). Its methods work on the text.
    struct path {
        std::static_str text = "";

        // The file name without its extension: `shaders/blur.slang` → `blur`.
        compile_time std::static_str stem();
        // The extension with its dot: `.slang`, or "".
        compile_time std::static_str extension();
        // The same path with another extension: `with_extension("spv")`.
        compile_time std::build::path with_extension(std::static_str ext);
    }

    // An external program a step runs (`g.find_program("slangc")`).
    struct program {
        std::static_str path = "";
    }

    // A custom step of the build: a program run with declared inputs and outputs.
    struct step {
        u32 id = 0;
    }

    struct step_spec {
        std::static_str name = "";
        std::build::program program = std::build::program{};
    }

    // A library installed on the system: linked as `-l<name>`, from `<root>/lib` when given.
    struct system_library {
        std::static_str name = "";
        std::static_str root = "";
    }

    // Where a package comes from (packages): `std::build::git`, `std::build::archive` or
    // `std::build::local`.
    interface package_source {
    }

    // A dependency pinned to a git commit (never a branch). A package may name a `.tag`
    // instead, resolved to its commit once and recorded in build.lock.
    struct git : std::build::package_source {
        std::static_str url = "";
        std::static_str commit = "";
        std::static_str tag = "";
    }

    // A package downloaded as an archive (.tar.gz, .tar.xz, .zip), checked against its SHA-256.
    struct archive : std::build::package_source {
        std::static_str url = "";
        std::static_str sha256 = "";
    }

    // A dependency in a directory of this machine.
    struct local : std::build::package_source {
        std::static_str path = "";
    }

    // How edaxc learns a package's targets (packages, section 3).
    enum package_build : u8 {
        // Its build.ed, else its CMakeLists.txt, else its headers.
        automatic,
        // Its own build.ed.
        edax,
        // Its CMakeLists.txt, read by edaxc's CMake reader.
        cmake,
        // One header-only target named after the package; the payload is its include directory
        // ("" for `include/` if it exists, else the package's root).
        headers_only(std::static_str),
        // A description in the project (`packages/<name>.ed`): the payload is its file, under
        // `packages/`. Its `describe(g, p)` adds the targets and exports them.
        script(std::static_str),
        // Real CMake, run as a build step (the last resort): the files it installs.
        cmake_external(std::build::cmake_outputs),
    }

    // What `package_build::cmake_external` uses of CMake's install directory (paths relative to it).
    view struct cmake_outputs {
        // Libraries to link, in order: `"lib/libfoo.a"`.
        std::span<std::static_str> outputs = [];
        // Include directories for what links the package: `"include"`.
        std::span<std::static_str> include_dirs = [];
    }

    // A package (packages): outside code fetched into the project and built with it.
    view struct package_spec {
        std::build::package_source& source;
        // Where it lives, relative to the project root; "" for `build/packages/<name>`.
        std::static_str path = "";
        // Its name in messages and build.lock; "" for the last part of the URL or path.
        std::static_str name = "";
        std::build::package_build build = std::build::package_build::automatic;
        // Settings for its build: CMake options and cache variables.
        std::span<(std::static_str, std::static_str)> options = [];
        // Targets that answer the package's own `find_package(NAME)`.
        std::span<(std::static_str, std::build::target)> uses = [];
        // Patch files of the project, applied after fetching, in order.
        std::span<std::static_str> patches = [];
    }

    // A package of the build (`g.package(...)`).
    struct package {
        u32 id = 0;
        // Its directory, relative to the project root.
        std::static_str path = "";

        // One of its targets (an unknown name is an error that lists them).
        compile_time std::build::target target(std::static_str name);
        // The files of the package matching a pattern (absolute paths).
        compile_time std::span<std::build::path> glob(std::static_str pattern);
        // Files of the package by their path inside it (absolute paths; a missing one is an error).
        compile_time std::span<std::build::path> files(std::span<std::static_str> relative);
        // A directory or file of the package by its path inside it, as an absolute path.
        compile_time std::static_str at(std::static_str relative);
        // A package description (`describe`): makes `t` the package's target, what
        // `p.target(name)` returns, under its own name or under `name` (a CMake-style alias).
        compile_time void export_target(std::build::target t);
        compile_time void export_target(std::build::target t, std::static_str name);
    }

    // Another project this build uses (`g.dependency(...)`).
    struct project {
        u32 id = 0;
    }

    // The build graph that `build.ed`' `build(mut std::build::graph& g)` describes (spec 25).
    // Its methods record what the build needs; edaxc builds it afterwards.
    // A value build.ed passes to code: a declared name (`compile_time std::build::setting<bool>
    // vulkan_validation = default;`), so a typo is an unknown name on both sides. `T` is bool, an
    // integer type, std::static_str or a simple enum.
    template<type T>
    struct setting {
        u8 unused = 0;

        // The value build.ed set for this target; a compile error when it set none.
        compile_time T value();

        // The value for the file of `where`, else the target's, else none.
        compile_time std::option<T> value_at(std::call_site where);
    }

    // How the build reports itself on the console (build-output.md).
    enum progress : u8 {
        // Live lines on a terminal, a line per finished target otherwise.
        automatic,
        live,
        // Each target once, when it is finished.
        lines,
        // Diagnostics and the last line only.
        quiet,
    }

    // What the console shows under a target's line; build.log always has all of them.
    enum detail : u8 {
        // Each source file with lines, size, its mark and time.
        sources,
        // The steps after the source files (check, code, link) with their times.
        units,
        // The compiler command of each C/C++ file.
        commands,
        // Each package: where it comes from and where it is.
        packages,
        // edaxc's version, the C/C++ compiler and the linker.
        toolchain,
        // The slowest units of the build, under the last line.
        timings,
    }

    // `g.output(...)`: the project's defaults; the command line (--progress, --details,
    // --no-log-file) overrides them. The lines are patterns: the std::log syntax with the
    // build's placeholders ({mark}, {target}, {bar:40}, {done}, {total}, {running}, {elapsed},
    // {summary}, {output}, {lines}, {size}, {file:<*}, {time}, {targets}, {errors}, {warnings},
    // {log}); "" keeps the default.
    view struct output {
        std::build::progress          progress = std::build::progress::automatic;
        std::span<std::build::detail> details  = [];
        bool                          log_file  = true;
        u32                           keep_logs = 5;
        std::static_str               target_line = "";
        std::static_str               done_line   = "";
        std::static_str               source_row  = "";
        std::static_str               last_line   = "";
        std::static_str               failed_line = "";
    }

    class graph {
    public:
        // The option `-D<name>=<value>` for a setting (its name without the namespace).
        template<type T>
        compile_time T option(std::build::setting<T> s, T fallback, std::static_str help) mut;
        // Gives target `t` the value of a setting.
        template<type T>
        compile_time void set(std::build::target t, std::build::setting<T> s, T value) mut;
        // Gives the files of `t` matching `pattern` (relative to its root file's directory) a value.
        template<type T>
        compile_time void set_for_files(std::build::target t, std::static_str pattern, std::build::setting<T> s, T value) mut;
        // Optimizes the files `t` compiles that match `pattern` (relative to the project root, or a
        // package's root) at `level`, whatever the mode (spec 34):
        // the math and the standard library at `speed` in a debug build, one file at `none` to
        // debug it in a release build.
        compile_time void optimize_files(std::build::target t, std::static_str pattern, std::build::optimization level) mut;
        // Compiles the Edax code of `t` for a CPU level instead of the build's (spec 34): its vector
        // code may use that level's instructions, and `target_has_cpu_feature` answers for it.
        // The program then needs a CPU of that level to run.
        compile_time void target_cpu(std::build::target t, std::build::cpu level) mut;
        // Include directories for C/C++ code: `visibility::shared` also for what links `t`,
        // `own` for `t` only, `users` only for what links it.
        compile_time void add_include_dirs(std::build::target t, std::span<std::static_str> dirs, std::build::visibility v) mut;
        // The arguments, inputs and outputs of a step, as lists.
        compile_time void add_arguments(std::build::step s, std::span<std::static_str> arguments) mut;
        compile_time void add_inputs(std::build::step s, std::span<std::build::path> files) mut;
        compile_time void add_outputs(std::build::step s, std::span<std::build::path> files) mut;

        // A program (a module with `main`).
        compile_time std::build::target add_executable(std::build::edax_target t) mut;
        // A library of Edax modules.
        compile_time std::build::target add_library(std::build::edax_target t) mut;
        // A test program: `edaxc test` builds and runs it.
        compile_time std::build::target add_test(std::build::edax_target t) mut;
        // A static library compiled from C or C++.
        compile_time std::build::target add_c_library(std::build::c_target t) mut;
        // A shared C or C++ library (`lib<name>.so`), loaded by the operating system when a
        // program that links it starts. Its sources are added like a static one's.
        compile_time std::build::target add_shared_library(std::build::c_target spec) mut;
        // A shared Edax library: its modules' code is compiled once, into lib<name>.so next to the
        // programs; the programs that link it import its modules and call into it.
        compile_time std::build::target add_shared_library(std::build::edax_target spec) mut;
        // A Edax plugin (dynamic libraries): its `@std::plugin_entry` class, built as
        // `<name>.so` in the `plugins` directory next to the programs, which load it with
        // `std::plugin<I>::load`. Built with the programs of the build.
        compile_time std::build::target add_plugin(std::build::edax_target spec) mut;
        // Turns C headers of the C target `t` into a Edax module: preprocessed with `t`'s include
        // directories and defines. Programs that link `t` import it. What can't be translated is
        // listed in `<module>.report.txt` next to the generated header.
        compile_time void import_c_headers(std::build::target t, std::build::c_import spec) mut;
        // Generates C wrappers (compiled into the C++ target `t`) and a Edax module with a class per
        // listed C++ class. Reads the headers with clang (`clang++`, or $EDAX_CLANGXX). What isn't
        // wrapped, and the Edax names of overloads and operators, are in `<module>.report.txt`.
        compile_time void wrap_cpp(std::build::target t, std::build::cpp_wrap spec) mut;

        // `user` imports `used`'s modules and links it.
        compile_time void link(std::build::target user, std::build::target used) mut;
        // Adds a source file to a C target.
        compile_time void add_sources(std::build::target t, std::static_str file) mut;
        // Adds an include directory to a C target.
        compile_time void add_include_dir(std::build::target t, std::static_str dir, std::build::visibility v) mut;
        // Defines a preprocessor macro for a C target.
        compile_time void define(std::build::target t, std::static_str name, std::static_str value) mut;

        // Makes a mode class of build.ed selectable with `--mode=` (spec 24).
        compile_time void add_mode(type mode) mut;
        // Builds `t` in `mode`, whatever the build's mode.
        compile_time void set_mode(std::build::target t, type mode) mut;

        // A value given on the command line as `-Dname=value`, or `fallback`.
        template<type T>
        compile_time T option(std::static_str name, T fallback, std::static_str help) mut;
        // Passes a compile-time value to `t`'s code: `std::build::setting<T>(name)` (spec 25).
        template<type T>
        compile_time void set(std::build::target t, std::static_str name, T value) mut;
        // Passes a value to the files of `t` that match `pattern` (relative to the target's root,
        // `*` within a name, `**` across directories): `std::build::setting_at<T>(where, name)`
        // (spec 31). A pattern that matches no file is an error.
        template<type T>
        compile_time void set_for_files(std::build::target t, std::static_str pattern, std::static_str name, T value) mut;

        // An environment variable (recorded as an input of the build), or "".
        compile_time std::static_str env(std::static_str name);

        // The files matching a pattern relative to the root: `*` within a name, `**` across
        // directories. Sorted.
        compile_time std::span<std::build::path> glob(std::static_str pattern);
        // Adds every file of a list to a C target.
        compile_time void add_sources(std::build::target t, std::span<std::build::path> files) mut;
        // A program on the PATH; the build fails when it is missing.
        compile_time std::build::program find_program(std::static_str name);
        // Where a generated file goes: the same relative path under the build directory.
        compile_time std::build::path output_path(std::build::path file);
        // A step: `program` run with the arguments added to it.
        compile_time std::build::step add_step(std::build::step_spec spec) mut;
        compile_time void add_argument(std::build::step s, std::static_str argument) mut;
        compile_time void add_argument(std::build::step s, std::build::path argument) mut;
        // A file the step reads: the step runs again when it changes.
        compile_time void add_input(std::build::step s, std::build::path file) mut;
        // A file the step writes: it must exist after the step ran.
        compile_time void add_output(std::build::step s, std::build::path file) mut;
        // `t` is built after `s` ran.
        compile_time void depends_on(std::build::target t, std::build::step s) mut;
        // A library of the system, linked by name.
        compile_time std::build::target add_system_library(std::build::system_library lib) mut;
        // Another project: its build.ed adds its targets (`g.target_of(p, "name")`).
        compile_time std::build::project dependency(std::build::git source) mut;
        compile_time std::build::project dependency(std::build::local source) mut;
        // The files of a dependency matching a pattern (absolute paths): the sources of a
        // dependency that has no build.ed of its own.
        compile_time std::span<std::build::path> glob_in(std::build::project p, std::static_str pattern);
        // A target of a dependency.
        compile_time std::build::target target_of(std::build::project p, std::static_str name);
        // A package (packages): fetched into `.path`, locked in build.lock, built with the project.
        compile_time std::build::package package(std::build::package_spec spec) mut;
        // Gives `t` another global allocator (allocators): a type implementing std::allocator,
        // std::shareable, with a default: `g.set_global_allocator(app, std::sealable_allocator)`.
        compile_time void set_global_allocator(std::build::target t, type allocator) mut;
        // The same with an allocator type of the program, which build.ed can't see:
        // `g.set_global_allocator(app, "engine::frame_heap")`.
        compile_time void set_global_allocator(std::build::target t, std::static_str allocator) mut;
        // How the build reports itself (build-output.md).
        compile_time void output(std::build::output o) mut;
        // The details shown under one target's line, instead of the project's.
        compile_time void details(std::build::target t, std::span<std::build::detail> d) mut;
        // The platform edaxc runs on and the one it builds for.
        compile_time std::build::platform host();
        compile_time std::build::platform target_platform();
    }


    // What a target platform offers (build system, "Target platforms").
    enum capability : u8 {
        // An operating system is present.
        os,
        // std::thread, the thread pool and blocking synchronization work.
        threads,
        // The global allocator exists.
        heap,
        // std::file and std::filesystem work.
        files,
        // Shared libraries and plugins can be loaded.
        dynamic_libraries,
        // The CPU has vector registers (otherwise vector types are computed lane by lane).
        simd,
    }

    // The operating system of a platform.
    enum os : u8 {
        none,
        linux,
        windows,
        macos,
    }

    // A CPU level: which instructions code may use. `baseline` is the first level of the
    // architecture (`x86_64`, `armv8`, `riscv64`).
    enum cpu : u8 {
        baseline,
        x86_64,
        x86_64_v2,
        x86_64_v3,
        x86_64_v4,
        armv8,
        armv9,
        riscv64,
        riscv64_v,
    }

    // A single CPU feature a level may include.
    enum cpu_feature : u8 {
        sse, sse2, sse3, ssse3, sse4_1, sse4_2, popcnt,
        avx, avx2, fma, bmi1, bmi2, f16c, lzcnt,
        avx512f, avx512bw, avx512cd, avx512dq, avx512vl,
        neon, sve, sve2,
        rvv,
    }

    // A platform: what `g.target_platform()` and `std::build::target_platform()` return, and what a user
    // target description (`edaxc build --target=board.ed`) declares as
    // `compile_time std::build::platform target = ...;`.
    view struct platform {
        // The LLVM triple: `x86_64-pc-linux-gnu`, `aarch64-unknown-none`.
        std::static_str triple;
        std::build::os os = std::build::os::none;
        std::build::cpu cpu = std::build::cpu::baseline;
        std::span<std::build::capability> capabilities;

        // Whether the platform has `c`.
        compile_time bool has(std::build::capability c);
    }

    // The platform being built for.
    compile_time std::build::platform target_platform();

    // The global allocator build.ed chose for the target being built, or `void` (the C
    // library's heap).
    compile_time type global_allocator_type();

    // Whether the platform being built for has `c`: `if compile_time (std::build::target_has(...))`.
    compile_time bool target_has(std::build::capability c);

    // Whether the CPU level being built for includes `f`.
    compile_time bool target_has_cpu_feature(std::build::cpu_feature f);

    // The value build.ed passed for the file of `where` (`g.set_for_files`), else the one it
    // passed to the target (`g.set`), else none (spec 31).
    template<type T>
    compile_time std::option<T> setting_at(std::call_site where, std::static_str name);

    // Whether the mode being built is `mode` or derived from it: `mode_is(std::build::mode::debug)`.
    compile_time bool mode_is(type mode);

    // The settings of the mode being built.
    compile_time std::build::mode::settings& current_mode();
}
