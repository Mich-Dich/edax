// The Edax standard library: module std::build::mode.

namespace std::build::mode {
    open class debug : settings {
    public:
        compile_time std::build::optimization optimization() override { return std::build::optimization::none; }
        compile_time std::build::debug_info debug_info() override { return std::build::debug_info::full; }
        compile_time std::build::overflow overflow() override { return std::build::overflow::panic; }
        compile_time std::build::shifts shifts() override { return std::build::shifts::panic; }
        compile_time std::build::bounds bounds() override { return std::build::bounds::panic; }
        compile_time std::build::run_time_checks run_time_checks() override { return std::build::run_time_checks::all; }
        compile_time std::build::panic_behavior panic() override { return std::build::panic_behavior::abort; }
        compile_time bool link_time_optimization() override { return false; }
        compile_time bool allow_undefined_behavior() override { return false; }
        compile_time std::build::float_determinism float_determinism() override { return std::build::float_determinism::relaxed; }
        compile_time std::build::sanitizer sanitize() override { return std::build::sanitizer::none; }
        compile_time std::build::optimization std_optimization() override { return std::build::optimization::speed; }
        compile_time std::option<std::static_str> profile_guided() override { return std::none; }
        compile_time bool stop_debugger_on_panic() override { return true; }
    }

    open class release : settings {
    public:
        compile_time std::build::optimization optimization() override { return std::build::optimization::speed; }
        compile_time std::build::debug_info debug_info() override { return std::build::debug_info::none; }
        compile_time std::build::overflow overflow() override { return std::build::overflow::panic; }
        compile_time std::build::shifts shifts() override { return std::build::shifts::panic; }
        compile_time std::build::bounds bounds() override { return std::build::bounds::panic; }
        compile_time std::build::run_time_checks run_time_checks() override { return std::build::run_time_checks::all; }
        compile_time std::build::panic_behavior panic() override { return std::build::panic_behavior::abort; }
        compile_time bool link_time_optimization() override { return false; }
        compile_time bool allow_undefined_behavior() override { return false; }
        compile_time std::build::float_determinism float_determinism() override { return std::build::float_determinism::relaxed; }
        compile_time std::build::sanitizer sanitize() override { return std::build::sanitizer::none; }
        compile_time std::build::optimization std_optimization() override { return std::build::optimization::speed; }
        compile_time std::option<std::static_str> profile_guided() override { return std::none; }
        compile_time bool stop_debugger_on_panic() override { return true; }
    }

    open class development : debug {
    public:
        compile_time std::build::optimization optimization() override { return std::build::optimization::basic; }
    }

    open class release_with_debug_info : release {
    public:
        compile_time std::build::debug_info debug_info() override { return std::build::debug_info::full; }
    }
}
