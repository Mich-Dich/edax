// The Edax standard library: module std::build::mode, the build modes (spec 24). A mode is a
// class implementing `settings`; build.ed derives its own modes from these.

namespace std::build::mode {
    // The settings of a build mode. A mode overrides the methods whose values it changes.
    interface settings {
        compile_time std::build::optimization optimization();
        compile_time std::build::debug_info debug_info();
        compile_time std::build::overflow overflow();
        compile_time std::build::shifts shifts();
        compile_time std::build::bounds bounds();
        compile_time std::build::run_time_checks run_time_checks();
        compile_time std::build::panic_behavior panic();
        compile_time bool link_time_optimization();
        compile_time bool allow_undefined_behavior();
    }

    // No optimization, full debug info, every check (the default mode).
    open class debug : settings {
    public:
        compile_time std::build::optimization optimization() override;
        compile_time std::build::debug_info debug_info() override;
        compile_time std::build::overflow overflow() override;
        compile_time std::build::shifts shifts() override;
        compile_time std::build::bounds bounds() override;
        compile_time std::build::run_time_checks run_time_checks() override;
        compile_time std::build::panic_behavior panic() override;
        compile_time bool link_time_optimization() override;
        compile_time bool allow_undefined_behavior() override;
    }

    // Optimized for speed, no debug info, every check.
    open class release : settings {
    public:
        compile_time std::build::optimization optimization() override;
        compile_time std::build::debug_info debug_info() override;
        compile_time std::build::overflow overflow() override;
        compile_time std::build::shifts shifts() override;
        compile_time std::build::bounds bounds() override;
        compile_time std::build::run_time_checks run_time_checks() override;
        compile_time std::build::panic_behavior panic() override;
        compile_time bool link_time_optimization() override;
        compile_time bool allow_undefined_behavior() override;
    }

    // `release` with full debug info.
    open class release_with_debug_info : release {
    public:
        compile_time std::build::debug_info debug_info() override;
    }
}
