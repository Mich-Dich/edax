// The Edax standard library: module std::derive, annotations that implement interfaces from a
// type's fields (spec 29). They are ordinary annotations with generate blocks, written in Edax.

namespace std::derive {
    // Implements std::formattable from the fields: `point { x: 1.0, y: 2.5 }`. On an enum, the
    // compiler prints the alternative's name and its payload: `circle(2.0)`.
    annotation(std::meta::target::type)
    struct formattable {
        generate : std::formattable {
            void format(mut std::formatter& out) override {
                out.write(std::type_name<annotated>());
                out.write(" {");
                for compile_time (std::meta::field f : std::meta::fields<annotated>()) {
                    if compile_time (f.index > 0) {
                        out.write(",");
                    }
                    out.write(" ");
                    out.write(f.name);
                    out.write(": ");
                    out.write(std::format(f"{f.get(this)}"));
                }
                out.write(" }");
            }
        }
    }

    // Implements std::hashable (`u64 hash()`) from all fields, so the type can be a
    // std::hash_map key. Its `==` is still needed: `bool operator==(T& other) = default;`.
    annotation(std::meta::target::type)
    struct hashable {
        generate : std::hashable {
            u64 hash() override {
                mut u64 h = std::hash_seed();
                for compile_time (std::meta::field f : std::meta::fields<annotated>()) {
                    h = std::hash_combine(h, std::hash(f.get(this)));
                }
                return h;
            }
        }
    }

    // For a `distinct type` (spec 34): the compiler gives it the arithmetic of its underlying
    // type. `meters + meters`, `meters - meters` and `meters % meters` are meters; `meters * f32`,
    // `f32 * meters` and `meters / f32` are meters; `meters / meters` is an f32; `-meters`,
    // comparisons and `+= -= *= /=` work too. `meters + seconds` and `meters * meters` are errors.
    annotation(std::meta::target::type)
    struct arithmetic { }

    // Generates `operator<=>` comparing the fields in declaration order (spec 16): the first
    // field that differs decides.
    annotation(std::meta::target::type)
    struct ordered {
        generate {
            std::ordering operator<=>(annotated& other) {
                for compile_time (std::meta::field f : std::meta::fields<annotated>()) {
                    std::ordering o = f.get(this) <=> f.get(other);
                    if (o != std::ordering::equal) {
                        return o;
                    }
                }
                return std::ordering::equal;
            }
        }
    }
}
