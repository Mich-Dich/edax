// The Edax standard library: module std::env.

namespace std::env {
    // Kept by the runtime when the program starts.
    private extern(std::build::language::c) {
        i32 edax_arg_count();
        std::raw_ptr<std::raw_ptr<u8>> edax_arg_values();
        usize strlen(std::raw_ptr<u8> text);
        std::raw_ptr<u8> getenv(std::raw_ptr<u8> name);
        i32 isatty(i32 fd);
        i32 ioctl(i32 fd, u64 request, std::raw_ptr<mut u8> argument);
    }

    // struct winsize (sys/ioctl.h).
    private struct window_size {
        u16 rows = 0;
        u16 columns = 0;
        u16 x_pixels = 0;
        u16 y_pixels = 0;
    }

    std::darray<std::darray<u8>> raw_args() {
        mut std::darray<std::darray<u8>> out = default;
        unsafe {
            std::raw_ptr<std::raw_ptr<u8>> values = edax_arg_values();
            mut i32 i = 0;
            while (i < edax_arg_count()) {
                std::raw_ptr<u8> text = *values.offset(i);
                mut std::darray<u8> bytes = default;
                mut usize k = 0;
                usize n = strlen(text);
                while (k < n) {
                    bytes.push(*text.offset(k));
                    k += 1;
                }
                out.push(move bytes);
                i += 1;
            }
        }
        return out;
    }

    std::option<std::string> variable(std::str name) {
        mut std::string c_name = std::string::from(name);
        c_name.push('\0');
        std::str text = c_name;
        unsafe {
            std::raw_ptr<u8> value = getenv(text.as_ptr());
            if (!value) { return std::none; }
            return std::some(std::string::from(std::raw::str_from(value, strlen(value))));
        }
    }

    bool is_terminal(std::env::stream s) {
        i32 fd = match (s) {
            std::env::stream::input  => 0,
            std::env::stream::output => 1,
            std::env::stream::error  => 2,
        };
        unsafe { return isatty(fd) != 0; }
    }

    std::option<std::env::terminal_size> output_terminal_size() {
        if (!is_terminal(std::env::stream::output)) {
            return std::none;
        }
        mut window_size w = default;
        unsafe {
            if (ioctl(1, 0x5413, cast::reinterpret<std::raw_ptr<mut u8>>(mut &w)) != 0 || w.columns == 0) {   // TIOCGWINSZ
                return std::some(std::env::terminal_size{});
            }
        }
        // A terminal that doesn't know its height (0) gets the usual 24 rows.
        return std::some(std::env::terminal_size{ .columns = cast<u32>(w.columns), .rows = if (w.rows == 0) { 24 } else { cast<u32>(w.rows) } });
    }
}
