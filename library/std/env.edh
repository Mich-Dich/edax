// The Edax standard library: module std::env, the program's environment (spec 04, 20).

namespace std::env {
    // The program's arguments as bytes, the executable first: for arguments that are not UTF-8,
    // which `main(std::span<std::str> args)` refuses. Allocates copies.
    std::darray<std::darray<u8>> raw_args();

    // The environment variable `name`, or `none` when it is not set (allocates a copy).
    std::option<std::string> variable(std::str name);

    // The program's standard streams.
    enum stream : u8 {
        input,
        output,
        error,
    }

    // Whether `s` is a terminal (not a file or a pipe): whether escape codes and redrawn lines
    // make sense there.
    bool is_terminal(std::env::stream s);

    // The size of a terminal in character cells.
    struct terminal_size {
        u32 columns = 80;
        u32 rows    = 24;
    }

    // The size of the terminal the program's output goes to, or none when it isn't a terminal.
    std::option<std::env::terminal_size> output_terminal_size();
}
