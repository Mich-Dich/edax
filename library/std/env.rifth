// The Rift standard library: module std::env, the program's environment (spec 04, 20).

namespace std::env {
    // The program's arguments as bytes, the executable first: for arguments that are not UTF-8,
    // which `main(std::span<std::str> args)` refuses. Allocates copies.
    std::darray<std::darray<u8>> raw_args();

    // The environment variable `name`, or `none` when it is not set (allocates a copy).
    std::option<std::string> variable(std::str name);
}
