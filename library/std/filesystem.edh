// The Edax standard library: module std::filesystem (spec 19, 20).

namespace std::filesystem {
    // A path in the file system, as text.
    class path {
    public:
        // A path with a copy of `text` (allocates).
        static path from(std::str text);

        // A path relative to the working directory, on purpose: no `std::relative_path` warning
        // (allocates).
        static path relative(std::str text);

        // The path as text.
        std::str as_str();

        // A copy (allocates).
        path clone();

        // The directory part: everything before the last `/` (`"logs/app.log"` → `"logs"`,
        // `"/app.log"` → `"/"`, `"app.log"` → `""`) (allocates).
        path parent();

        // The last part: `"logs/app.log"` → `"app.log"`.
        std::str file_name();

        // The extension of the last part, without its dot: `"logs/app.log"` → `"log"`, `""` when
        // there is none (`".bashrc"` has none).
        std::str extension();
    }

    // `dir / name`: `name` appended after a separator.
    path operator/(path& dir, std::str name);

    // The directory that contains the running executable.
    path executable_dir();

    // Reports the files that change under a directory and its subdirectories (created, written,
    // removed, renamed), so a program can rebuild or reload when a source changes (dynamic
    // libraries, "Hot reload"). Linux: inotify. Closing happens when it is destroyed.
    class watcher : unsafe std::sendable {
    public:
        // The files changed since the last call, each once, without waiting.
        std::darray<path> changes() mut;

        // Waits up to `milliseconds` for a change (0: don't wait, -1: wait forever), then returns
        // the files changed so far, each once.
        std::darray<path> wait(i32 milliseconds) mut;

        ~watcher();
    }

    // Starts watching `directory` and every directory below it (new ones too).
    std::result<watcher, std::io_error> watch(path& directory);

    // Creates `dir` and every missing directory above it. A directory that already exists is
    // fine; anything else in the way is `std::io_error::already_exists`.
    std::result<void, std::io_error> create_directories(path& dir);
}
