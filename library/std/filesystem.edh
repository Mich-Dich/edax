// The Edax standard library: module std::filesystem (spec 19, 20; filesystem.md).
//
// Every call goes through a mount table: a path's first parts choose a source (a folder on disk,
// a packed archive, files in memory, or one of the program's own), so the same code reads from the
// project's folders during development and from an archive in a shipped game. A program that
// mounts nothing gets the operating system's file system, as everywhere else. Which table a call
// uses is chosen per file in build.ed (the setting `std::filesystem::table`), by
// `@std::filesystem::use_table` on a file, or by calling a table's methods.

namespace std::filesystem {
    // A path in the file system, as text. Parts are separated by `/`. A path that starts with `/`
    // is an operating-system path, which no mount table sees.
    class path {
    public:
        // A path with a copy of `text` (allocates).
        static path from(std::str text);

        // A path relative to the working directory, on purpose: no `std::relative_path` warning
        // (allocates). Text starting with `/` is a compile error when it is known there, else a
        // panic (`relative_path`'s check).
        static std::filesystem::relative_path relative(std::str text);

        // An operating-system path: text starting with `/` (allocates). Other text is a compile
        // error when it is known there, else a panic (`absolute_path`'s check).
        static std::filesystem::absolute_path absolute(std::str text);

        // The path as text.
        std::str as_str();

        // A copy (allocates).
        path clone();

        // The directory part: everything before the last `/` (`"logs/app.log"` → `"logs"`,
        // `"/app.log"` → `"/"`, `"app.log"` → `""`) (allocates).
        path parent();

        // The last part: `"logs/app.log"` → `"app.log"`.
        std::str file_name();

        // The extension of the last part, without its dot: `"logs/app.log"` → `"log"`, `""` when
        // there is none (`".bashrc"` has none).
        std::str extension();

        // The last part without its extension: `"logs/app.log"` → `"app"`, `".bashrc"` → `".bashrc"`.
        std::str stem();

        // Whether the extension is `ext` (without the dot, compared exactly): `p.has_extension("so")`.
        bool has_extension(std::str ext);

        // The same path with the extension `ext` instead (`""` removes it): `"a/b.txt"` →
        // `"a/b.log"` (allocates).
        path with_extension(std::str ext);

        // Whether it starts with `/`: an operating-system path.
        bool is_absolute();

        // The path as an `absolute_path` when it starts with `/`, else `none` (allocates).
        std::option<std::filesystem::absolute_path> to_absolute();

        // The path as a `relative_path` when it doesn't start with `/`, else `none` (allocates).
        std::option<std::filesystem::relative_path> to_relative();

        // The same path with `.` parts, empty parts and `part/..` removed: `"a/./b//c/../d"` →
        // `"a/b/d"`. A `..` that would leave the start is kept (`"../x"`) (allocates).
        path normalized();

        bool operator==(path& other);
    }

    // `dir / name`: `name` appended after a separator.
    path operator/(path& dir, std::str name);

    // A path that starts with `/`: the operating system's, which no mount table sees
    // (`executable_dir()`, `/proc/...`). It is lent as a `path&` (and moved into a `path`) where
    // either kind will do; `cast<absolute_path>(p)` or `p.to_absolute()` makes one.
    distinct type absolute_path = path check (value.is_absolute())
        else f"'{value.as_str()}' is not an absolute path: it doesn't start with '/'";

    // A path the calling file's mount table resolves (and, without a mount for it, the operating
    // system relative to the working directory). Lent as a `path&` like `absolute_path`.
    distinct type relative_path = path check (!value.is_absolute())
        else f"'{value.as_str()}' is not a relative path: it starts with '/'";

    // Appending keeps the kind: an absolute directory gives absolute paths, a relative one
    // relative paths. `relative_path / absolute_path` doesn't exist.
    std::filesystem::absolute_path operator/(std::filesystem::absolute_path& dir, std::str name);
    std::filesystem::absolute_path operator/(std::filesystem::absolute_path& dir, std::filesystem::relative_path& rest);
    std::filesystem::relative_path operator/(std::filesystem::relative_path& dir, std::str name);
    std::filesystem::relative_path operator/(std::filesystem::relative_path& dir, std::filesystem::relative_path& rest);

    // --- what a source answers -------------------------------------------------------------------

    // What a path names.
    enum kind : u8 {
        file,
        directory,
        link,
        other,
    }

    // What `info` tells about a file or directory.
    struct file_info {
        std::filesystem::kind kind = std::filesystem::kind::file;
        // Bytes; 0 for directories.
        u64                   size = 0;
        // The last change; zero when the source doesn't know (archives).
        std::time::wall_time  modified = default;
        // Whether it can't be written through this table.
        bool                  read_only = false;

        bool is_file();
        bool is_directory();
        // Never for `info` on disk, which follows links; `list` reports them.
        bool is_link();
    }

    // One entry of a directory listing.
    struct entry {
        std::string           name = default;
        std::filesystem::kind kind = std::filesystem::kind::file;

        bool is_file();
        bool is_directory();
        bool is_link();
    }

    // --- walking a directory tree ------------------------------------------------------------------

    // What `walk` reports for each file or directory below its root. `P` is the kind of path the
    // walk started from (`path`, `absolute_path` or `relative_path`), and every entry's path has it.
    template<type P = path>
    struct walk_entry {
        // The root, the directories on the way, and the name: `root / ... / name`.
        P                     path;
        // What it is; a symbolic link is `link` unless the walk follows links.
        std::filesystem::kind kind  = std::filesystem::kind::file;
        // 0: directly in the root.
        u32                   depth = 0;

        bool is_file();
        bool is_directory();
        bool is_link();
        // The last part of the path: `path.file_name()`.
        std::str name();
    }

    // The order of a walk. In both, the entries of one directory come sorted by name.
    enum walk_order : u8 {
        // A directory, then everything below it, then the next entry of its directory.
        depth_first,
        // Everything at depth 0, then everything at depth 1, and so on.
        breadth_first,
    }

    struct walk_options {
        // How deep to go: 0 = only the root's own entries (like `list`). No limit by default.
        u32                         max_depth           = u32::max;
        std::filesystem::walk_order order               = std::filesystem::walk_order::depth_first;
        // Whether directories are reported too; they are entered either way.
        bool                        include_directories = true;
        // Whether names starting with `.` are reported and entered (`.git`, the build's `.edax`).
        bool                        include_hidden      = false;
        // Whether a symbolic link to a directory is entered (on disk). A link back to a directory
        // above it is not, and at most 8 links are followed on one way down.
        bool                        follow_links        = false;
    }

    // A directory a walk couldn't read (permission, removed meanwhile); the walk went on without it.
    struct walk_problem {
        std::filesystem::path path  = default;
        std::io_error         error = std::io_error::other;
    }

    // The entries below a directory, one per `next()`: a stream, used with `for`. It reads one
    // directory at a time, so the tree is never loaded at once: it holds the listings of the
    // directories on the way down (depth first) or of one level (breadth first).
    template<type P = path>
    class walker {
    public:
        // The next entry, or `none` at the end.
        std::option<walk_entry<P>> next() mut;

        // Doesn't enter the directory `next()` returned last (nothing for a file).
        void skip_children() mut;

        // The directories that couldn't be read so far.
        std::span<walk_problem> problems();
    }

    // How a source opens a file.
    enum open_mode : u8 {
        // An existing file, for reading.
        read,
        // A new or emptied file, for writing.
        write,
        // A file for writing at its end; created when missing.
        append,
    }

    // An open file of a source: what `std::file` reads and writes through.
    interface stream {
        // Reads at the current position into `into`; 0 at the end.
        std::result<usize, std::io_error> read(std::span_mut<u8> into) mut;
        // Reads at `offset` without moving the position; safe from several threads at once.
        std::result<usize, std::io_error> read_at(u64 offset, std::span_mut<u8> into);
        // Writes `data` at the current position (at the end for `append`).
        std::result<usize, std::io_error> write(std::span<u8> data) mut;
        // Hands buffered writes on (to the operating system, or into the source).
        std::result<void, std::io_error> flush() mut;
        // The file's size in bytes.
        u64 size();
    }

    // The bytes of a file in memory, as long as it lives (`map`).
    interface region {
        std::span<u8> bytes();
    }

    // Where files come from: a folder on disk (`native`), a packed archive (`archive`), files in
    // memory (`memory`), or the program's own (an encrypted pack, a network share). Paths given to
    // a source are relative to where it is mounted, use `/`, and are normalized. A source is shared
    // by every thread that uses its table, so its methods don't change it (it locks inside what
    // it must change). Sources that can't write keep the default bodies: `read_only`.
    interface source {
        std::result<std::unique_ptr<stream>, std::io_error> open(std::str at, open_mode mode);
        std::result<file_info, std::io_error> info(std::str at);
        std::result<std::darray<entry>, std::io_error> list(std::str at);
        std::result<void, std::io_error> create_directory(std::str at) { return std::error(std::io_error::read_only); }
        std::result<void, std::io_error> rename(std::str from, std::str to) { return std::error(std::io_error::read_only); }
        std::result<void, std::io_error> remove(std::str at) { return std::error(std::io_error::read_only); }
        // The file's bytes in memory: mapped, or held by the source.
        std::result<std::unique_ptr<region>, std::io_error> map(std::str at);
        // The operating-system path behind `at`, for sources on disk: what `watch`, `os_path` and
        // `std::plugin<I>::load` need.
        std::option<path> os_path(std::str at) { return std::none; }
    }

    // --- the sources std provides ----------------------------------------------------------------

    // A folder on disk: reading, writing, mapping and watching. `native::at(root)` serves the
    // files under `root`; `native::os()` takes paths as they are (relative ones to the working
    // directory).
    class native : std::filesystem::source {
    public:
        static native at(path root);
        static native os();
        std::result<std::unique_ptr<stream>, std::io_error> open(std::str at, open_mode mode) override;
        std::result<file_info, std::io_error> info(std::str at) override;
        std::result<std::darray<entry>, std::io_error> list(std::str at) override;
        std::result<void, std::io_error> create_directory(std::str at) override;
        std::result<void, std::io_error> rename(std::str from, std::str to) override;
        std::result<void, std::io_error> remove(std::str at) override;
        std::result<std::unique_ptr<region>, std::io_error> map(std::str at) override;
        std::option<path> os_path(std::str at) override;
    }

    // Files in memory, readable and writable: tests, generated data, `std::embed` blobs. Copies
    // made with `share` use the same files, so a program can keep one to add files after mounting
    // the other.
    class memory : std::filesystem::source {
    public:
        static memory make();
        // Adds or replaces the file `at` (its directories exist implicitly).
        void add(std::str at, std::span<u8> bytes);
        // Adds or replaces the file `at` with text.
        void add_text(std::str at, std::str text);
        // Another handle to the same files.
        memory share();
        std::result<std::unique_ptr<stream>, std::io_error> open(std::str at, open_mode mode) override;
        std::result<file_info, std::io_error> info(std::str at) override;
        std::result<std::darray<entry>, std::io_error> list(std::str at) override;
        std::result<void, std::io_error> create_directory(std::str at) override;
        std::result<void, std::io_error> rename(std::str from, std::str to) override;
        std::result<void, std::io_error> remove(std::str at) override;
        std::result<std::unique_ptr<region>, std::io_error> map(std::str at) override;
    }

    // A read-only archive: many files packed into one, as `edaxc pack` and build.ed's
    // `g.add_archive` write it (filesystem.md, "Archives"). The archive is mapped into memory
    // once; `map` hands out its files without copying, and reads are copies out of it. A lookup
    // is a binary search of the index by the path's hash.
    class archive : std::filesystem::source {
    public:
        // Opens the archive at `p`, which must end up at a file on disk; `invalid_data` when it
        // isn't an archive.
        static std::result<archive, std::io_error> load(path& p, implicit compile_time std::call_site where);
        // The number of files.
        usize length();
        std::result<std::unique_ptr<stream>, std::io_error> open(std::str at, open_mode mode) override;
        std::result<file_info, std::io_error> info(std::str at) override;
        std::result<std::darray<entry>, std::io_error> list(std::str at) override;
        std::result<std::unique_ptr<region>, std::io_error> map(std::str at) override;
    }

    // --- mount tables ----------------------------------------------------------------------------

    // How a source is mounted.
    struct mount_options {
        // Among the mounts of one prefix, higher priorities are asked first (mods and patches over
        // the base archive); for equal ones, the newer mount first.
        i32  priority = 0;
        // Whether writes go here: to the first writable mount of the prefix in priority order.
        bool writable = false;
    }

    // A mounted source. Destroying it (or `unmount`) takes the source out of its table; reads that
    // already started finish first.
    @std::must_use
    class mounted : unsafe std::sendable {
    public:
        // The prefix it is mounted at.
        std::str prefix();
        // Unmounts now.
        void unmount() move;
        ~mounted();
    }

    // A file's bytes in memory, mapped or held by its source (`map`).
    class mapped : unsafe std::sendable, unsafe std::shareable {
    public:
        std::span<u8> bytes();
        usize length();
    }

    // Reports the files that change under a directory and its subdirectories (created, written,
    // removed, renamed), so a program can rebuild or reload when a source changes (dynamic
    // libraries, "Hot reload"). Changes come as paths of the table that watched. Linux: inotify.
    // Closing happens when it is destroyed.
    class watcher : unsafe std::sendable {
    public:
        // The files changed since the last call, each once, without waiting.
        std::darray<path> changes() mut;

        // Waits up to `milliseconds` for a change (0: don't wait, -1: wait forever), then returns
        // the files changed so far, each once.
        std::darray<path> wait(i32 milliseconds) mut;

        ~watcher();
    }

    // A mount table: a name, and sources mounted at path prefixes. A copy type: a handle to a
    // table that lives as long as the program. Threads may mount and read at the same time.
    //
    // A relative path goes to the mounts with the longest prefix that matches it (`content`
    // matches `content` and `content/...`, `""` matches everything); reads ask those mounts in
    // priority order until one has the file. A path no mount matches goes to the operating
    // system (relative to the working directory), unless `set_fallback(false)` made that an
    // error (`not_mounted`), as a shipped game may want. Absolute paths always go to the
    // operating system.
    struct table {
        u32 id = 0;

        // The table every call uses unless build.ed or the file chooses another.
        static table global();
        // A new, empty table named `name`; `already_exists` when there is one.
        static std::result<table, std::io_error> create(std::str table_name);
        // The table named `name`; `""` is the global one.
        static std::option<table> named(std::str table_name);

        std::string name();

        // Mounts `src` at `prefix` (`""`: everything not mounted more specifically).
        template<type S : source>
        mounted mount(std::str prefix, S src, mount_options o);
        // Mounts a source shared with other tables, or one a plugin made.
        mounted mount_shared(std::str prefix, std::shared_ptr<source> src, mount_options o);
        // Whether paths no mount matches go to the operating system (the default) or fail with
        // `not_mounted`.
        void set_fallback(bool to_os);
        // The mounted prefixes, longest first (each once).
        std::darray<std::string> prefixes();

        bool exists(path& p);
        // Whether `p` is a file, a directory, or a symbolic link (false when it doesn't exist or
        // can't be asked). `is_file` and `is_directory` follow links.
        bool is_file(path& p);
        bool is_directory(path& p);
        bool is_link(path& p);
        std::result<file_info, std::io_error> info(path& p);
        // The entries of a directory, merged over every mount of its prefix (the higher priority
        // wins for equal names), with the mounts below it as directories. Sorted by name.
        std::result<std::darray<entry>, std::io_error> list(path& dir);
        std::result<std::darray<u8>, std::io_error> read_bytes(path& p);
        // The file as text; `invalid_data` when it isn't UTF-8.
        std::result<std::string, std::io_error> read_text(path& p);
        // Creates or empties the file and writes `data`.
        std::result<void, std::io_error> write_bytes(path& p, std::span<u8> data);
        std::result<void, std::io_error> write_text(path& p, std::str text);
        // Creates `dir` and every missing directory above it. A directory that already exists is
        // fine; a file in the way is `already_exists`.
        std::result<void, std::io_error> create_directories(path& dir);
        // Renames within one source (`not_supported` across sources).
        std::result<void, std::io_error> rename(path& from, path& to);
        // Removes a file or an empty directory.
        std::result<void, std::io_error> remove(path& p);
        // Opens a file (what `std::file::open`, `create` and `append` use).
        std::result<std::file, std::io_error> open(path& p, open_mode mode);
        // The file's bytes in memory, without copying when its source holds them (archives) or
        // can map them (disk).
        std::result<mapped, std::io_error> map(path& p);
        // Watches a directory whose source is on disk (`not_supported` otherwise).
        std::result<watcher, std::io_error> watch(path& dir);
        // The operating-system path a path ends up at, when its source is on disk.
        std::option<path> os_path(path& p);

        // The entries below `dir`, as a stream for `for`; an error when `dir` itself can't be
        // listed. `P` is `path`, `absolute_path` or `relative_path`.
        template<type P>
        std::result<walker<P>, std::io_error> walk(P& dir, walk_options o);
        // All of them at once.
        template<type P>
        std::result<std::darray<walk_entry<P>>, std::io_error> walk_all(P& dir, walk_options o);
    }

    // On a file: its calls without a table use this one (`@std::filesystem::use_table{ .name =
    // "disk" };`). Without it, build.ed's setting `std::filesystem::table` for the file (or the
    // target) decides, else the global table.
    annotation(std::meta::target::file)
    struct use_table {
        std::static_str name = "";
    }

    // The name of the table the calls at `where` use (see `use_table`); "" for the global one.
    compile_time std::static_str table_name(std::call_site where);

    // The table the calls at `where` use; `not_mounted` when it names a table the program hasn't
    // created.
    std::result<table, std::io_error> table_at(implicit compile_time std::call_site where);

    // --- the same operations on the calling file's table (see `table`) ------------------------------

    bool exists(path& p, implicit compile_time std::call_site where);
    bool is_file(path& p, implicit compile_time std::call_site where);
    bool is_directory(path& p, implicit compile_time std::call_site where);
    bool is_link(path& p, implicit compile_time std::call_site where);
    std::result<file_info, std::io_error> info(path& p, implicit compile_time std::call_site where);
    std::result<std::darray<entry>, std::io_error> list(path& dir, implicit compile_time std::call_site where);
    std::result<std::darray<u8>, std::io_error> read_bytes(path& p, implicit compile_time std::call_site where);
    std::result<std::string, std::io_error> read_text(path& p, implicit compile_time std::call_site where);
    std::result<void, std::io_error> write_bytes(path& p, std::span<u8> data, implicit compile_time std::call_site where);
    std::result<void, std::io_error> write_text(path& p, std::str text, implicit compile_time std::call_site where);
    std::result<void, std::io_error> create_directories(path& dir, implicit compile_time std::call_site where);
    std::result<void, std::io_error> rename(path& from, path& to, implicit compile_time std::call_site where);
    std::result<void, std::io_error> remove(path& p, implicit compile_time std::call_site where);
    std::result<mapped, std::io_error> map(path& p, implicit compile_time std::call_site where);
    std::result<watcher, std::io_error> watch(path& directory, implicit compile_time std::call_site where);
    std::option<path> os_path(path& p, implicit compile_time std::call_site where);
    template<type P>
    std::result<walker<P>, std::io_error> walk(P& dir, implicit compile_time std::call_site where);
    template<type P>
    std::result<walker<P>, std::io_error> walk(P& dir, walk_options o, implicit compile_time std::call_site where);
    template<type P>
    std::result<std::darray<walk_entry<P>>, std::io_error> walk_all(P& dir, walk_options o, implicit compile_time std::call_site where);

    // The file extension of a dynamic library on the platform being built for, without the dot:
    // "so", "dll" or "dylib".
    compile_time std::static_str dynamic_library_extension();

    // The target of a symbolic link on disk (an operating-system path).
    std::result<path, std::io_error> read_link(path& link);

    // --- places ----------------------------------------------------------------------------------

    // The directory that contains the running executable.
    std::filesystem::absolute_path executable_dir();
    // Where a program keeps its data for this user: $XDG_DATA_HOME/<app>, else
    // ~/.local/share/<app>. Not created. Variables that aren't absolute paths are ignored.
    std::filesystem::absolute_path user_data_dir(std::str app);
    // Where a program keeps its settings for this user: $XDG_CONFIG_HOME/<app>, else
    // ~/.config/<app>. Not created.
    std::filesystem::absolute_path user_config_dir(std::str app);
    // The directory for temporary files: $TMPDIR, else /tmp.
    std::filesystem::absolute_path temp_dir();

    // --- a file that continues in a new one ---------------------------------------------------------

    // Start a new file when the current one would grow past `max_bytes`.
    struct size_rotation {
        u64 max_bytes;
        // Older files to keep: app.1.log (newest) ... app.5.log.
        u32 keep = 5;
    }

    // When a `rotating_file` continues in a new one. The older files are numbered: app.1.log is
    // the newest. Rotation happens between two writes, so a write is never split.
    enum rotation : u8 {
        // One file (the default).
        none,
        by_size(size_rotation),
        // A new file at local midnight; the payload is how many old files to keep.
        daily(u32),
    }

    struct rotating_options {
        std::filesystem::rotation rotation = std::filesystem::rotation::none;
        // Continue an existing file instead of emptying it.
        bool                      append = false;
    }

    // A file written in order (logs, recordings, telemetry) that moves on to a new file by size or
    // by day, all through the table its path resolves in. Missing directories are created.
    class rotating_file : std::writer {
    public:
        static std::result<rotating_file, std::io_error> open(path p, rotating_options o,
                                                              implicit compile_time std::call_site where);
        // The path it writes to.
        path& file_path();
        // Bytes in the current file.
        u64 size();
        // Whether the last write started a new file (a writer can put a header first).
        bool rotated();
        std::result<usize, std::io_error> write(std::str text) mut override;
        std::result<void, std::io_error> flush() mut override;
    }
}
