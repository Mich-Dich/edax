// The Rift standard library: module std::log, messages from any thread to any number of sinks
// (spec 31).
//
//     std::log::info(f"loaded {count} meshes");
//
// A call knows where it is written (an `implicit std::call_site`). Whether it exists is decided
// at compile time from the level of its function, type, file or build target (`level_at`): a call
// below that level is removed, and its f-string holes are never evaluated. Calls that exist are
// filtered again at run time by the levels of the sinks. One thread, started by `std::log::start`,
// owns the sinks; log calls only format their message and queue it.

namespace std::log {
    // How important a message is. `off` as a level removes every call except `fatal`.
    enum level : u8 {
        trace,
        debug,
        info,
        warn,
        error,
        fatal,
        off,
    }

    // The compile-time level of a file (`@std::log::level_override{ ... };` after the imports),
    // a type (its methods) or a function. The most specific one applies (spec 31).
    annotation(std::meta::target::file, std::meta::target::type, std::meta::target::function)
    struct level_override {
        std::log::level level = std::log::level::trace;
    }

    // A log message that ends with a line break: sinks add the line break themselves.
    compile_time std::diagnostic trailing_newline = default;

    // A `@std::log::level_override` on a function or type that is more verbose than `error`, in a
    // build mode based on release: probably a debugging aid that should not ship.
    compile_time std::diagnostic verbose_override = default;

    // --- writing messages ------------------------------------------------------------------------

    @std::inline_always
    void trace(std::format_args message, implicit compile_time std::call_site where);
    @std::inline_always
    void debug(std::format_args message, implicit compile_time std::call_site where);
    @std::inline_always
    void info(std::format_args message, implicit compile_time std::call_site where);
    @std::inline_always
    void warn(std::format_args message, implicit compile_time std::call_site where);
    @std::inline_always
    void error(std::format_args message, implicit compile_time std::call_site where);

    // Logs the message, then writes every queued message and flushes every sink before it
    // returns, so the message is on disk even if the program dies next. Never removed. It doesn't
    // end the program: the caller decides (reset, retry, or `std::panic`).
    @std::cold
    void fatal(std::format_args message, implicit std::call_site where);

    // --- asserts and validation ------------------------------------------------------------------

    // For conditions that must hold (a broken invariant, a bug). When `condition` is false: logs
    // `failure` like `fatal` (written and flushed at once), stops in the debugger if one is
    // attached, and returns false, so the caller can recover:
    //
    //     std::log::assert(index < count, f"index {index} out of {count}") else { return; }
    //
    // The condition is checked in every build mode. Unlike `run_time check`, it never ends the
    // program. With a `success` message, that message is logged at `trace` when the condition
    // holds.
    @std::check_result
    bool assert(bool condition, std::format_args failure, implicit compile_time std::call_site where);
    @std::check_result
    bool assert(bool condition, std::format_args success, std::format_args failure, implicit compile_time std::call_site where);

    // For conditions that may fail at run time (bad input, a missing file). When `condition` is
    // false: logs `failure` at `error` and returns false:
    //
    //     std::log::validate(texture.is_valid(), f"texture '{name}' is invalid") else { return false; }
    //
    // The condition is checked in every build mode; the messages follow the log levels. With a
    // `success` message, that message is logged at `trace` when the condition holds.
    @std::check_result
    bool validate(bool condition, std::format_args failure, implicit compile_time std::call_site where);
    @std::check_result
    bool validate(bool condition, std::format_args success, std::format_args failure, implicit compile_time std::call_site where);

    // Logs at a level chosen at compile time: the functions above call it.
    @std::inline_always
    void write(compile_time std::log::level lvl, std::format_args message, implicit compile_time std::call_site where);

    // The compile-time level of the code at `where`: a `@std::log::level_override` on its function,
    // its type or its file, else the level build.rifts gave its file or target, else the build
    // mode's default.
    compile_time std::log::level level_at(std::call_site where);

    // `trace` in modes based on debug, `error` in modes based on release.
    compile_time std::log::level mode_default();

    // The level called `name` ("trace" ... "off"), or none.
    compile_time run_time std::option<std::log::level> level_named(std::str name);

    // `TRACE` ... `FATAL`.
    compile_time run_time std::static_str level_text(std::log::level l);

    // --- build.rifts ----------------------------------------------------------------------------

    // The compile-time level of every file of `t`.
    compile_time void set_level(mut std::build::graph& g, std::build::target t, std::log::level l);

    // The compile-time level of the files of `t` matching `pattern` (relative to the target's root).
    compile_time void set_level(mut std::build::graph& g, std::build::target t, std::static_str pattern, std::log::level l);

    // Declares the option `-Dlog_level=<level>`, which sets the level of every file of `t`.
    compile_time void add_options(mut std::build::graph& g, std::build::target t);

    // --- records and patterns -------------------------------------------------------------------

    // What a sink receives.
    view struct record {
        std::log::level      level;
        std::call_site       where;
        u64                  thread_id;
        std::str             thread_name;
        std::time::wall_time time;
        std::str             message;
        // The message of a panic: the runtime prints it on stderr after the sinks are flushed.
        bool                 from_panic;
    }

    // How a record becomes a line: the f-string syntax of spec 19 with record fields as names:
    // `{message}`, `{level}`, `{time}`, `{date}`, `{millis}`, `{micros}`, `{thread}`, `{thread_id}`,
    // `{target}`, `{module}`, `{namespace}`, `{file}`, `{file_name}`, `{function}`,
    // `{function_name}`, `{line}`, `{column}`, `{color}` and `{/color}`; `{{` and `}}` are braces.
    // A field may have an alignment and width: `{level:<5}`.
    struct pattern {
        std::static_str text = "[{time}.{millis}] [{level:<5}] {thread}: {message}";

        // A pattern from a literal. The text is checked when the program is compiled.
        compile_time run_time static std::log::pattern from(std::static_str text);

        // What is wrong with a pattern's text, or "".
        compile_time run_time static std::static_str problem(std::str text);

        // Appends `r` as a line (without the line break) to `out`. `{color}` writes the record's
        // style from `colors`, or nothing when `colors` is null (a sink without colors).
        void render(std::log::record& r, std::raw_ptr<std::log::palette> colors, mut std::string& out);
    }

    // The pattern sinks use when their options don't name one: `std::log::patterns::standard`.
    compile_time std::log::pattern default_pattern = std::log::pattern{};

    // Ready-made patterns.
    namespace patterns {

        // `INFO  loaded 12 meshes`
        compile_time std::log::pattern minimal = std::log::pattern{ .text = "{color}{level:<5}{/color} {message}" };

        // `[14:33:10.887] [INFO ] main: loaded 12 meshes` (the default)
        compile_time std::log::pattern standard = std::log::pattern{};

        // `[14:33:10.887] [INFO ] scene.rifts:42 loaded 12 meshes`
        compile_time std::log::pattern source = std::log::pattern{ .text = "{color}[{time}.{millis}] [{level:<5}]{/color} {file_name}:{line} {message}" };

        // `[14:33:10.887] [renderer INFO  main - scene.rifts:load:42] loaded 12 meshes`
        compile_time std::log::pattern engine = std::log::pattern{ .text = "{color}[{time}.{millis}]{/color} [{target} {color}{level:<5}{/color} {thread} - {file_name}:{function_name}:{line}] {message}" };

        // `[2026-11-19 14:33:10.887412] [renderer INFO  main] gfx::load (src/scene.rifts:42) loaded 12 meshes`
        compile_time std::log::pattern detailed = std::log::pattern{ .text = "[{date} {time}.{micros}] [{target} {color}{level:<5}{/color} {thread}] {function} ({file}:{line}) {message}" };

        // `[2026-11-19 14:33:10.887] [renderer INFO  main] src/scene.rifts:42 loaded 12 meshes`, for files
        compile_time std::log::pattern file = std::log::pattern{ .text = "[{date} {time}.{millis}] [{target} {level:<5} {thread}] {file}:{line} {message}" };
    }

    // --- colors ---------------------------------------------------------------------------------

    // A color in 24 bits.
    struct rgb {
        u8 r = 0;
        u8 g = 0;
        u8 b = 0;
    }

    // A terminal color: one of the 16 standard ones, an entry of the 256-color table, or 24-bit.
    enum color : u8 {
        none,   // the terminal's own color
        black,
        red,
        green,
        yellow,
        blue,
        magenta,
        cyan,
        white,
        gray,
        bright_red,
        bright_green,
        bright_yellow,
        bright_blue,
        bright_magenta,
        bright_cyan,
        bright_white,
        indexed(u8),
        rgb(std::log::rgb),
    }

    // How `{color}` ... `{/color}` look for one level.
    struct style {
        std::log::color foreground = std::log::color::none;
        std::log::color background = std::log::color::none;
        bool            bold = false;
        bool            underline = false;

        // Appends the terminal escape sequence for this style (nothing for a plain style).
        void escape(mut std::string& out);
    }

    // The style of every level.
    struct palette {
        std::log::style trace = std::log::style{ .foreground = std::log::color::gray };
        std::log::style debug = std::log::style{ .foreground = std::log::color::bright_blue };
        std::log::style info = std::log::style{ .foreground = std::log::color::bright_green };
        std::log::style warn = std::log::style{ .foreground = std::log::color::yellow };
        std::log::style error = std::log::style{ .foreground = std::log::color::red };
        std::log::style fatal = std::log::style{ .foreground = std::log::color::black, .background = std::log::color::red, .bold = true };

        // The style of `l` (`off`: plain).
        std::log::style of(std::log::level l);
    }

    // The palette sinks use when their options don't name one.
    compile_time std::log::palette default_palette = std::log::palette{};

    // Which records a sink gets besides its level: all, or those of one build target.
    struct filter {
        std::static_str target = "";

        static std::log::filter all();
        static std::log::filter targets(std::static_str name);
        bool accepts(std::log::record& r);
    }

    // --- sinks ------------------------------------------------------------------------------

    // Where records go. Sinks are owned by the log thread: they must be std::sendable, and they
    // are never shared, so they need no locks.
    interface sink {
        // Whether `{color}` / `{/color}` in the pattern are written.
        bool colored();
        // Writes one record; `line` is the record rendered with the sink's pattern.
        void write(std::log::record& r, std::str line) mut;
        // Hands everything written so far on (to the file, the terminal, ...).
        void flush() mut;
    }

    // Options for one sink of a session.
    struct sink_options {
        std::log::level   min_level = std::log::level::trace;
        std::log::pattern pattern = std::log::default_pattern;
        std::log::filter  filter = std::log::filter{};
        // The colors of `{color}`, for sinks that write colors.
        std::log::palette palette = std::log::default_palette;
    }

    // Names a sink of a session.
    struct sink_id {
        u32 value = 0;
    }

    // Whether the console sink writes colors.
    enum colors : u8 {
        automatic,   // when the stream is a terminal
        always,
        off,
    }

    // stdout; `error` and `fatal` records go to stderr.
    class console : std::log::sink {
    public:
        static std::unique_ptr<std::log::console> make();
        static std::unique_ptr<std::log::console> make_with(std::log::colors c);
        bool colored() override;
        void write(std::log::record& r, std::str line) mut override;
        void flush() mut override;
    }

    // Whether a log file is emptied or continued.
    enum file_mode : u8 {
        truncate,
        append,
    }

    // Start a new file when the current one would grow past `max_bytes`.
    struct size_rotation {
        u64 max_bytes;
        // Older files to keep: app.1.log (newest) ... app.5.log.
        u32 keep = 5;
    }

    // When a log file is continued in a new one. The older files are numbered: app.1.log is
    // the newest. Rotation happens between two records, so a record is never split.
    enum rotation : u8 {
        // One file (the default).
        none,
        by_size(std::log::size_rotation),
        // A new file at local midnight; the payload is how many old files to keep.
        daily(u32),
    }

    // How records are written to a log file.
    enum file_format : u8 {
        // The sink's pattern, one line per record.
        text,
        // One JSON object per line: time, level, location, thread and message as keys.
        json_lines,
    }

    struct file_options {
        std::filesystem::path   path;
        std::log::file_mode     mode = std::log::file_mode::truncate;
        // Records at this level and above are flushed at once.
        std::log::level         flush_at = std::log::level::warn;
        // Bytes written before the file is flushed anyway.
        usize                   buffer_size = 65536;
        std::log::rotation      rotation = std::log::rotation::none;
        std::log::file_format   format = std::log::file_format::text;
    }

    // A file, kept open; missing directories above it are created. Writes "log started" / "log stopped"
    // lines with the date and time.
    class file : std::log::sink {
    public:
        static std::result<std::unique_ptr<std::log::file>, std::io_error> create(std::log::file_options& options);
        bool colored() override;
        void write(std::log::record& r, std::str line) mut override;
        void flush() mut override;
        ~file();
    }

    // The last lines a `memory` sink kept, readable from any thread (an in-game console).
    class history : unsafe std::sendable, unsafe std::shareable {
    public:
        static std::log::history make(usize capacity);
        // A copy of the lines, oldest first.
        std::darray<std::string> snapshot();
        std::log::history clone();
        // Adds a line, replacing the oldest once the ring is full.
        void push(std::str line);
    }

    // Keeps the last lines in a `history`.
    class memory : std::log::sink {
    public:
        static std::unique_ptr<std::log::memory> make(std::log::history& into);
        bool colored() override;
        void write(std::log::record& r, std::str line) mut override;
        void flush() mut override;
    }

    // --- the session ----------------------------------------------------------------------------

    // What a full queue does to a log call.
    enum when_full : u8 {
        wait,   // the caller waits for room
        drop,   // trace to warn records are dropped and counted; error and fatal still wait
    }

    struct options {
        usize               queue_capacity = 16384;
        std::log::when_full when_full = std::log::when_full::wait;
    }

    // The running logger: one thread that owns the sinks. Destroying it writes what is queued,
    // flushes and destroys the sinks, and joins the thread. Changes travel through the same
    // queue as records, so they apply between the records sent before and after them.
    class session {
    public:
        std::log::sink_id add(std::unique_ptr<std::log::sink> s, std::log::sink_options o) mut;
        void remove(std::log::sink_id id) mut;
        void set_level(std::log::sink_id id, std::log::level l) mut;
        void set_pattern(std::log::sink_id id, std::log::pattern p);
        void set_palette(std::log::sink_id id, std::log::palette p);
        // Returns once everything sent before it is written and every sink is flushed.
        void flush();
        ~session();
    }

    // Starts the log thread. Records logged before are written first. One session at a time.
    std::log::session start(std::log::options o);
}
