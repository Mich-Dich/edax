// The Rift standard library: module std::log (spec 31).
//
// A log call formats its message on the calling thread and queues an `entry` in a bounded channel.
// One thread (`run`) owns the sinks and turns entries into lines. Settings travel through the same
// channel as `command`s. Before `start`, entries wait in a small static buffer; the log thread
// keeps the entries that arrive while it has no sinks and writes them to every sink that is added.

namespace std::log {
    // --- state shared by every thread ------------------------------------------------------------

    // One message on its way to the sinks.
    private struct entry {
        std::log::level      lvl;
        std::call_site       where;
        u64                  thread_id;
        std::string          thread_name;
        std::time::wall_time time;
        std::string          message;
        bool                 from_panic;
    }

    // A sink of the log thread with its options. (A class: it has no `clone()`.)
    private class slot {
    public:
        std::log::sink_id               id;
        std::unique_ptr<std::log::sink> sink;
        std::log::sink_options          options;
    }

    private struct sink_level {
        std::log::sink_id id;
        std::log::level   level;
    }

    private struct sink_pattern {
        std::log::sink_id id;
        std::log::pattern pattern;
    }

    private struct sink_palette {
        std::log::sink_id id;
        std::log::palette palette;
    }

    // What the log thread is asked to do, in order.
    private enum command : u8 {
        write(std::log::entry),
        add(std::log::slot),
        remove(std::log::sink_id),
        set_level(std::log::sink_level),
        set_pattern(std::log::sink_pattern),
        set_palette(std::log::sink_palette),
        flush(std::channel_sender<u32>),
    }

    // The running session, as log calls on any thread see it.
    private struct shared {
        std::channel_sender<std::log::command> sender;
        std::atomic<u32>                       users;     // threads sending right now
        std::log::when_full                    when_full;
        std::atomic<u64>                       dropped;   // records a full queue dropped
    }

    // The lowest level any sink takes: calls below it don't even format their message.
    private static std::atomic<u8> minimum = default;
    // The running session, or null.
    private static std::atomic<std::raw_ptr<mut std::log::shared>> active = default;
    // The entries logged before `start` (at most 256), behind a spin lock.
    private static std::atomic<u32> early_lock = default;
    private static mut std::raw_ptr<mut std::darray<std::log::entry>> early = nullptr;
    private static std::atomic<u64> early_dropped = default;
    // The log thread's id while it runs (0 otherwise): it can't wait for itself.
    private static std::atomic<u64> log_thread_id = default;

    private extern(std::build::language::c) {
        i32 isatty(i32 fd);
        i32 raise(i32 signal);
        i32 fflush(std::raw_ptr<mut u8> stream);
    }

    private compile_time usize early_capacity = 256;

    // --- writing messages ------------------------------------------------------------------------

    void trace(std::format_args message, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::write(std::log::level::trace, move message, where);
    }

    void debug(std::format_args message, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::write(std::log::level::debug, move message, where);
    }

    void info(std::format_args message, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::write(std::log::level::info, move message, where);
    }

    void warn(std::format_args message, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::write(std::log::level::warn, move message, where);
    }

    void error(std::format_args message, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::write(std::log::level::error, move message, where);
    }

    void fatal(std::format_args message, implicit std::call_site where) {
        compile_time check {
            if (std::literal_text(message).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
            if (std::literal_text(message).is_empty() && std::is_compile_time(message)) {
                std::compile_error("std::log: the message is empty");
            }
        }
        std::log::submit(std::log::level::fatal, move message, where);
        std::log::flush_all();
    }

    // --- asserts and validation ------------------------------------------------------------------

    bool assert(bool condition, std::format_args failure, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(failure).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
        }
        if (condition) {
            return true;
        }
        std::log::assert_failed(move failure, where);
        return false;
    }

    bool assert(bool condition, std::format_args success, std::format_args failure, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(success).ends_with("\n") || std::literal_text(failure).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
        }
        if (condition) {
            std::log::write(std::log::level::trace, move success, where);
            return true;
        }
        std::log::assert_failed(move failure, where);
        return false;
    }

    bool validate(bool condition, std::format_args failure, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(failure).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
        }
        if (condition) {
            return true;
        }
        std::log::write(std::log::level::error, move failure, where);
        return false;
    }

    bool validate(bool condition, std::format_args success, std::format_args failure, implicit compile_time std::call_site where) {
        compile_time check {
            if (std::literal_text(success).ends_with("\n") || std::literal_text(failure).ends_with("\n")) {
                std::compile_warning(std::log::trailing_newline, "the message ends with '\\n'; sinks add the line break");
            }
        }
        if (condition) {
            std::log::write(std::log::level::trace, move success, where);
            return true;
        }
        std::log::write(std::log::level::error, move failure, where);
        return false;
    }

    // A failed assert: logged like `fatal`, then the debugger (if any) stops here.
    @std::cold
    private void assert_failed(std::format_args failure, std::call_site where) {
        std::log::submit(std::log::level::fatal, move failure, where);
        std::log::flush_all();
        if (std::log::debugger_attached()) {
            unsafe { _ = raise(5); }   // SIGTRAP: the debugger stops at the failed assert
        }
    }

    // Whether a debugger traces this process (`TracerPid` in /proc/self/status is not 0).
    private bool debugger_attached() {
        std::result<std::file, std::io_error> opened = std::file::open(std::filesystem::path::from("/proc/self/status"));
        if (opened.is_error()) {
            return false;
        }
        mut std::file status = (move opened).expect("opened");
        for (std::str line : status.lines()) {
            if (line.starts_with("TracerPid:")) {
                std::str pid = line.slice(10, line.len()).trim();
                return pid != "0";
            }
        }
        return false;
    }

    void write(compile_time std::log::level lvl, std::format_args message, implicit compile_time std::call_site where) {
        if compile_time (cast<u8>(lvl) >= cast<u8>(std::log::level_at(where))) {
            if (cast<u8>(lvl) >= minimum.load(std::memory_order::relaxed)) {
                std::log::submit(lvl, move message, where);
            }
        }
    }

    // Formats the message (its holes run now, on this thread) and queues the entry.
    private void submit(std::log::level lvl, std::format_args message, std::call_site where) {
        std::log::deliver(std::log::entry{
            .lvl = lvl,
            .where = where,
            .thread_id = std::thread::current_id(),
            .thread_name = std::thread::current_name(),
            .time = std::time::wall_time::now(),
            .message = std::format(move message),
            .from_panic = false,
        });
    }

    // To the running session, else into the early buffer.
    private void deliver(std::log::entry e) {
        std::raw_ptr<mut std::log::shared> s = active.load(std::memory_order::sequentially_consistent);
        if (s) {
            unsafe {
                _ = (*s).users.fetch_wrapping_add(1, std::memory_order::sequentially_consistent);
                if (active.load(std::memory_order::sequentially_consistent) == s) {   // still running
                    std::log::send(s, move e);
                    _ = (*s).users.fetch_wrapping_sub(1, std::memory_order::sequentially_consistent);
                    return;
                }
                _ = (*s).users.fetch_wrapping_sub(1, std::memory_order::sequentially_consistent);
            }
        }
        std::log::keep_early(move e);
    }

    private unsafe void send(std::raw_ptr<mut std::log::shared> s, std::log::entry e) {
        if ((*s).when_full == std::log::when_full::drop && cast<u8>(e.lvl) < cast<u8>(std::log::level::error)) {
            std::result<void, std::send_error<std::log::command>> r = (*s).sender.try_send(std::log::command::write(move e));
            if (r.is_error()) {
                _ = (*s).dropped.fetch_wrapping_add(1, std::memory_order::relaxed);
                return;
            }
        } else {
            _ = (*s).sender.send(std::log::command::write(move e));
        }
        u64 lost = (*s).dropped.exchange(0, std::memory_order::relaxed);
        if (lost > 0) {
            _ = (*s).sender.send(std::log::command::write(std::log::note(std::log::level::warn, std::format(f"[std::log] {lost} messages dropped"))));
        }
    }

    // An entry the logger itself writes.
    private std::log::entry note(std::log::level lvl, std::string text) {
        return std::log::entry{
            .lvl = lvl,
            .where = std::call_site{ .file = "std/log.rifts", .file_name = "log.rifts", .function = "std::log", .function_name = "log",
                                     .namespace_name = "std::log", .module = "std::log", .target = "std", .line = 0, .column = 0 },
            .thread_id = std::thread::current_id(),
            .thread_name = std::thread::current_name(),
            .time = std::time::wall_time::now(),
            .message = move text,
            .from_panic = false,
        };
    }

    private void lock_early() {
        while (early_lock.compare_exchange_weak(0, 1, std::memory_order::acquire, std::memory_order::relaxed).is_error()) {
            std::thread::spin_hint();
        }
    }

    private void unlock_early() { early_lock.store(0, std::memory_order::release); }

    private void keep_early(std::log::entry e) {
        std::log::lock_early();
        if (active.load(std::memory_order::sequentially_consistent)) {   // started meanwhile
            std::log::unlock_early();
            std::log::deliver(move e);
            return;
        }
        unsafe {
            if (!early) {
                early = std::raw::allocate<std::darray<std::log::entry>>(1);
                std::raw::write(early, std::darray<std::log::entry>::with_capacity(early_capacity));
            }
            if ((*early).len() < early_capacity) {
                (*early).push(move e);
            } else {
                _ = early_dropped.fetch_wrapping_add(1, std::memory_order::relaxed);
            }
        }
        std::log::unlock_early();
    }

    // --- compile-time levels -------------------------------------------------------------------

    struct level_override {
        compile_time check {
            if (std::build::mode_is(std::build::mode::release) && cast<u8>(annotation.level) < cast<u8>(std::log::level::error)) {
                std::compile_warning(std::log::verbose_override,
                    f"@std::log::level_override makes this code log at {std::log::level_text(annotation.level)} in a release build");
            }
        }
    }

    compile_time std::log::level level_at(std::call_site where) {
        std::option<std::log::level_override> f = std::meta::function_annotation<std::log::level_override>(where);
        if (f.is_some()) {
            return f.expect("is_some").level;
        }
        std::option<std::log::level_override> t = std::meta::type_annotation<std::log::level_override>(where);
        if (t.is_some()) {
            return t.expect("is_some").level;
        }
        std::option<std::log::level_override> file = std::meta::file_annotation<std::log::level_override>(where);
        if (file.is_some()) {
            return file.expect("is_some").level;
        }
        // build.rifts: the file's level, then `-Dlog_level`, then the target's level.
        mut std::option<std::static_str> setting = std::build::setting_at<std::static_str>(where, "std::log::file_level");
        if (setting.is_none()) {
            setting = std::build::setting_at<std::static_str>(where, "std::log::option_level");
        }
        if (setting.is_none()) {
            setting = std::build::setting_at<std::static_str>(where, "std::log::level");
        }
        if (setting.is_some()) {
            std::static_str name = setting.expect("is_some");
            std::option<std::log::level> l = std::log::level_named(name);
            if (l.is_none()) {
                std::compile_error(f"std::log: the level \"{name}\" from build.rifts is not a level (trace, debug, info, warn, error, fatal, off)");
            }
            return l.expect("is_some");
        }
        return std::log::mode_default();
    }

    compile_time std::log::level mode_default() {
        if (std::build::mode_is(std::build::mode::release)) {
            return std::log::level::error;
        }
        return std::log::level::trace;
    }

    compile_time run_time std::option<std::log::level> level_named(std::str name) {
        if (name == "trace") { return std::some(std::log::level::trace); }
        if (name == "debug") { return std::some(std::log::level::debug); }
        if (name == "info") { return std::some(std::log::level::info); }
        if (name == "warn") { return std::some(std::log::level::warn); }
        if (name == "error") { return std::some(std::log::level::error); }
        if (name == "fatal") { return std::some(std::log::level::fatal); }
        if (name == "off") { return std::some(std::log::level::off); }
        return std::none;
    }

    compile_time run_time std::static_str level_text(std::log::level l) {
        return match (l) {
            std::log::level::trace => "TRACE",
            std::log::level::debug => "DEBUG",
            std::log::level::info => "INFO",
            std::log::level::warn => "WARN",
            std::log::level::error => "ERROR",
            std::log::level::fatal => "FATAL",
            std::log::level::off => "OFF",
        };
    }

    // "trace" ... "off": how build.rifts passes a level.
    private compile_time run_time std::static_str level_word(std::log::level l) {
        return match (l) {
            std::log::level::trace => "trace",
            std::log::level::debug => "debug",
            std::log::level::info => "info",
            std::log::level::warn => "warn",
            std::log::level::error => "error",
            std::log::level::fatal => "fatal",
            std::log::level::off => "off",
        };
    }

    // --- build.rifts ----------------------------------------------------------------------------

    compile_time void set_level(mut std::build::graph& g, std::build::target t, std::log::level l) {
        g.set(t, "std::log::level", std::log::level_word(l));
    }

    compile_time void set_level(mut std::build::graph& g, std::build::target t, std::static_str pattern, std::log::level l) {
        g.set_for_files(t, pattern, "std::log::file_level", std::log::level_word(l));
    }

    compile_time void add_options(mut std::build::graph& g, std::build::target t) {
        std::static_str given = g.option<std::static_str>("log_level", "", "The compile-time log level of the target (trace ... off)");
        if (!given.is_empty()) {
            if (std::log::level_named(given).is_none()) {
                std::compile_error(f"-Dlog_level={given}: not a level (trace, debug, info, warn, error, fatal, off)");
            }
            g.set(t, "std::log::option_level", given);
        }
    }

    // --- patterns -------------------------------------------------------------------------------

    // Whether `name` is a field a pattern can name.
    private compile_time run_time bool known_field(std::str name) {
        return name == "message" || name == "level" || name == "time" || name == "date" || name == "millis" || name == "micros" ||
               name == "thread" || name == "thread_id" || name == "target" || name == "module" || name == "namespace" ||
               name == "file" || name == "file_name" || name == "function" || name == "function_name" || name == "line" ||
               name == "column" || name == "color" || name == "/color";
    }

    // Whether `spec` (after ':') is an alignment and a width: `<5`, `>8`, `^10`, `12`.
    private compile_time run_time bool known_spec(std::str spec) {
        mut usize at = 0;
        if (spec.starts_with("<") || spec.starts_with(">") || spec.starts_with("^")) {
            at = 1;
        }
        if (at == spec.len()) {
            return false;
        }
        while (at < spec.len()) {
            std::str c = spec.slice(at, at + 1);
            if (!(c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9")) {
                return false;
            }
            at += 1;
        }
        return true;
    }

    // The first `{...}` of `text` that is not a field with a valid spec, or "" (with `what` saying why).
    private compile_time run_time std::str first_problem(std::str text, bool want_reason) {
        mut usize at = 0;
        while (at < text.len()) {
            std::str c = text.slice(at, at + 1);
            if (c == "}") {
                if (at + 1 < text.len() && text.slice(at + 1, at + 2) == "}") {
                    at += 2;
                    continue;
                }
                return if (want_reason) { "a '}' without '{' (write '}}' for a brace)" } else { text.slice(at, at + 1) };
            }
            if (c != "{") {
                at += 1;
                continue;
            }
            if (at + 1 < text.len() && text.slice(at + 1, at + 2) == "{") {
                at += 2;
                continue;
            }
            std::option<usize> close = text.slice(at, text.len()).find("}");
            if (close.is_none()) {
                return if (want_reason) { "a '{' without '}'" } else { text.slice(at, text.len()) };
            }
            usize end = at + close.expect("is_some");
            std::str inside = text.slice(at + 1, end);
            std::option<usize> colon = inside.find(":");
            std::str name = if (colon.is_some()) { inside.slice(0, colon.expect("is_some")) } else { inside };
            if (!std::log::known_field(name)) {
                return if (want_reason) { "unknown field" } else { text.slice(at, end + 1) };
            }
            if (colon.is_some() && !std::log::known_spec(inside.slice(colon.expect("is_some") + 1, inside.len()))) {
                return if (want_reason) { "a spec is an alignment and a width ('{level:<5}')" } else { text.slice(at, end + 1) };
            }
            at = end + 1;
        }
        return "";
    }

    struct pattern {
        compile_time run_time static std::log::pattern from(std::static_str text) {
            compile_time run_time check (std::log::first_problem(text, true).is_empty())
                else f"std::log::pattern: {std::log::first_problem(text, true)}: '{std::log::first_problem(text, false)}' (fields: message, level, time, date, millis, micros, thread, thread_id, target, module, namespace, file, file_name, function, function_name, line, column, color, /color)";
            return std::log::pattern{ .text = text };
        }

        compile_time run_time static std::static_str problem(std::str text) {
            if (std::log::first_problem(text, true).is_empty()) {
                return "";
            }
            return "the pattern has an unknown field or a bad spec";
        }

        void render(std::log::record& r, std::raw_ptr<std::log::palette> colors, mut std::string& out) {
            std::str text = this.text;
            usize n = text.len();
            std::time::civil_time when = std::log::local_time(r.time);
            mut usize at = 0;
            while (at < n) {
                // the literal text up to the next brace, in one piece
                mut usize end = at;
                while (end < n && std::log::byte_at(text, end) != 123u8 && std::log::byte_at(text, end) != 125u8) {
                    end += 1;
                }
                if (end > at) {
                    out.push_str(text.slice(at, end));
                    at = end;
                    continue;
                }
                u8 c = std::log::byte_at(text, at);
                if (at + 1 < n && std::log::byte_at(text, at + 1) == c) {   // `{{` or `}}`
                    out.push_str(text.slice(at, at + 1));
                    at += 2;
                    continue;
                }
                if (c == 125u8) {   // a lone `}` (the check rejects it in literals)
                    out.push_str("}");
                    at += 1;
                    continue;
                }
                mut usize close = at + 1;
                mut usize colon = 0;
                while (close < n && std::log::byte_at(text, close) != 125u8) {
                    if (colon == 0 && std::log::byte_at(text, close) == 58u8) {
                        colon = close;
                    }
                    close += 1;
                }
                if (close >= n) {
                    out.push_str(text.slice(at, n));
                    return;
                }
                std::str name = if (colon > 0) { text.slice(at + 1, colon) } else { text.slice(at + 1, close) };
                std::str spec = if (colon > 0) { text.slice(colon + 1, close) } else { "" };
                if (spec.is_empty()) {
                    std::log::field_value(r, name, colors, when, mut out);
                } else {
                    mut std::string value = default;
                    std::log::field_value(r, name, colors, when, mut value);
                    std::log::pad(value, spec, mut out);
                }
                at = close + 1;
            }
        }
    }

    private u8 byte_at(std::str text, usize i) {
        unsafe { return *text.as_ptr().offset(i); }
    }

    // The local calendar time of the last second seen on this thread: localtime_r is slow.
    private thread_local mut i64 cached_second = -1;
    private thread_local mut std::time::civil_time cached_time = std::time::civil_time{};

    private std::time::civil_time local_time(std::time::wall_time t) {
        if (t.seconds != cached_second) {
            cached_time   = t.local();
            cached_second = t.seconds;
        }
        mut std::time::civil_time out = cached_time;
        out.nanosecond = t.nanos;
        return out;
    }

    // The text of one field of `r`.
    private void field_value(std::log::record& r, std::str name, std::raw_ptr<std::log::palette> colors, std::time::civil_time when, mut std::string& out) {
        if (name == "message") { out.push_str(r.message); }
        else if (name == "level") { out.push_str(std::log::level_text(r.level)); }
        else if (name == "time") {
            std::log::digits(mut out, cast<u64>(when.hour), 2);
            out.push_str(":");
            std::log::digits(mut out, cast<u64>(when.minute), 2);
            out.push_str(":");
            std::log::digits(mut out, cast<u64>(when.second), 2);
        }
        else if (name == "date") {
            std::log::digits(mut out, cast::saturate<u64>(when.year), 4);
            out.push_str("-");
            std::log::digits(mut out, cast<u64>(when.month), 2);
            out.push_str("-");
            std::log::digits(mut out, cast<u64>(when.day), 2);
        }
        else if (name == "millis") { std::log::digits(mut out, cast<u64>(when.nanosecond / 1000000), 3); }
        else if (name == "micros") { std::log::digits(mut out, cast<u64>(when.nanosecond / 1000), 6); }
        else if (name == "thread") {
            if (r.thread_name.is_empty()) { std::log::digits(mut out, r.thread_id, 1); } else { out.push_str(r.thread_name); }
        }
        else if (name == "thread_id") { std::log::digits(mut out, r.thread_id, 1); }
        else if (name == "target") { out.push_str(r.where.target); }
        else if (name == "module") { out.push_str(r.where.module); }
        else if (name == "namespace") { out.push_str(r.where.namespace_name); }
        else if (name == "file") { out.push_str(r.where.file); }
        else if (name == "file_name") { out.push_str(r.where.file_name); }
        else if (name == "function") { out.push_str(r.where.function); }
        else if (name == "function_name") { out.push_str(r.where.function_name); }
        else if (name == "line") { std::log::digits(mut out, cast<u64>(r.where.line), 1); }
        else if (name == "column") { std::log::digits(mut out, cast<u64>(r.where.column), 1); }
        else if (name == "color") { if (colors) { unsafe { (*colors).of(r.level).escape(mut out); } } }
        else if (name == "/color") { if (colors) { out.push_str("\u{1b}[0m"); } }
    }

    // --- colors ---------------------------------------------------------------------------------

    struct style {
        void escape(mut std::string& out) {
            mut bool first = true;
            if (this.bold) { std::log::sgr(mut out, mut first, 1); }
            if (this.underline) { std::log::sgr(mut out, mut first, 4); }
            std::log::color_codes(mut out, mut first, this.foreground, 30);
            std::log::color_codes(mut out, mut first, this.background, 40);
            if (!first) { out.push_str("m"); }
        }
    }

    struct palette {
        std::log::style of(std::log::level l) {
            return match (l) {
                std::log::level::trace => this.trace,
                std::log::level::debug => this.debug,
                std::log::level::info => this.info,
                std::log::level::warn => this.warn,
                std::log::level::error => this.error,
                std::log::level::fatal => this.fatal,
                std::log::level::off => std::log::style{},
            };
        }
    }

    // One SGR parameter: `ESC[` before the first, `;` between them.
    private void sgr(mut std::string& out, mut bool& first, u32 code) {
        if (first) { out.push_str("\u{1b}["); first = false; } else { out.push_str(";"); }
        std::log::digits(mut out, cast<u64>(code), 1);
    }

    // The SGR parameters of `c` as a foreground (`base` 30) or background (`base` 40) color.
    private void color_codes(mut std::string& out, mut bool& first, std::log::color c, u32 base) {
        match (c) {
            std::log::color::none => {},
            std::log::color::black => std::log::sgr(mut out, mut first, base + 0),
            std::log::color::red => std::log::sgr(mut out, mut first, base + 1),
            std::log::color::green => std::log::sgr(mut out, mut first, base + 2),
            std::log::color::yellow => std::log::sgr(mut out, mut first, base + 3),
            std::log::color::blue => std::log::sgr(mut out, mut first, base + 4),
            std::log::color::magenta => std::log::sgr(mut out, mut first, base + 5),
            std::log::color::cyan => std::log::sgr(mut out, mut first, base + 6),
            std::log::color::white => std::log::sgr(mut out, mut first, base + 7),
            std::log::color::gray => std::log::sgr(mut out, mut first, base + 60),
            std::log::color::bright_red => std::log::sgr(mut out, mut first, base + 61),
            std::log::color::bright_green => std::log::sgr(mut out, mut first, base + 62),
            std::log::color::bright_yellow => std::log::sgr(mut out, mut first, base + 63),
            std::log::color::bright_blue => std::log::sgr(mut out, mut first, base + 64),
            std::log::color::bright_magenta => std::log::sgr(mut out, mut first, base + 65),
            std::log::color::bright_cyan => std::log::sgr(mut out, mut first, base + 66),
            std::log::color::bright_white => std::log::sgr(mut out, mut first, base + 67),
            std::log::color::indexed(n) => {
                std::log::sgr(mut out, mut first, base + 8);
                std::log::sgr(mut out, mut first, 5);
                std::log::sgr(mut out, mut first, cast<u32>(n));
            },
            std::log::color::rgb(v) => {
                std::log::sgr(mut out, mut first, base + 8);
                std::log::sgr(mut out, mut first, 2);
                std::log::sgr(mut out, mut first, cast<u32>(v.r));
                std::log::sgr(mut out, mut first, cast<u32>(v.g));
                std::log::sgr(mut out, mut first, cast<u32>(v.b));
            },
        }
    }

    // `n` in decimal with at least `width` digits.
    private void digits(mut std::string& out, u64 n, usize width) {
        mut u64   divisor = 1;
        mut usize count = 1;
        while (n / divisor >= 10) {
            divisor = divisor * 10;
            count += 1;
        }
        mut usize zeros = width;
        while (zeros > count) {
            out.push('0');
            zeros -= 1;
        }
        std::str all = "0123456789";
        while (divisor > 0) {
            usize d = cast::truncate<usize>((n / divisor) % 10);
            unsafe { out.push_str(std::raw::str_from(all.as_ptr().offset(d), 1)); }
            divisor = divisor / 10;
        }
    }

    // `value` aligned in the width `spec` asks for (`<5`, `>8`, `^10`; text aligns left by default).
    private void pad(std::str value, std::str spec, mut std::string& out) {
        if (spec.is_empty()) {
            out.push_str(value);
            return;
        }
        mut usize at = 0;
        mut std::str align = "<";
        if (spec.starts_with("<") || spec.starts_with(">") || spec.starts_with("^")) {
            align = spec.slice(0, 1);
            at = 1;
        }
        mut usize width = 0;
        while (at < spec.len()) {
            width = width * 10 + cast<usize>(std::log::byte_at(spec, at) - 48u8);
            at += 1;
        }
        usize length = value.len();
        usize fill = if (width > length) { width - length } else { 0 };
        usize before = if (align == ">") { fill } else if (align == "^") { fill / 2 } else { 0 };
        mut usize i = 0;
        while (i < before) {
            out.push(' ');
            i += 1;
        }
        out.push_str(value);
        while (i < fill) {
            out.push(' ');
            i += 1;
        }
    }

    // --- filters --------------------------------------------------------------------------------

    struct filter {
        static std::log::filter all() { return std::log::filter{}; }

        static std::log::filter targets(std::static_str name) { return std::log::filter{ .target = name }; }

        bool accepts(std::log::record& r) {
            std::str wanted = this.target;
            return wanted.is_empty() || r.where.target == wanted;
        }
    }

    // --- sinks ----------------------------------------------------------------------------------

    class console {
    public:
        static std::unique_ptr<std::log::console> make() { return std::log::console::make_with(std::log::colors::automatic); }

        static std::unique_ptr<std::log::console> make_with(std::log::colors c) {
            mut bool out_tty = false;
            mut bool err_tty = false;
            unsafe {
                out_tty = isatty(1) != 0;
                err_tty = isatty(2) != 0;
            }
            bool colored = match (c) {
                std::log::colors::always => true,
                std::log::colors::off => false,
                std::log::colors::automatic => out_tty && err_tty,
            };
            return std::unique_ptr<std::log::console>::make(std::log::console{ .use_colors = colored });
        }

        bool colored() override { return this.use_colors; }

        void write(std::log::record& r, std::str line) mut override {
            if (r.from_panic) {
                return;   // the runtime prints the panic on stderr after the hook
            }
            if (cast<u8>(r.level) >= cast<u8>(std::log::level::error)) {
                unsafe { _ = fflush(nullptr); }   // keep the order with the lines on stdout
                std::eprintln(line);
            } else {
                std::println(line);
            }
        }

        void flush() mut override {
            unsafe { _ = fflush(nullptr); }   // every C stream: stdout and stderr
        }

    private:
        bool use_colors = false;
    }

    private extern(std::build::language::c) {
        i32 rename(std::raw_ptr<u8> from, std::raw_ptr<u8> to);
        i32 remove(std::raw_ptr<u8> path);
        i32 open(std::raw_ptr<u8> path, i32 flags);
        i64 lseek(i32 fd, i64 offset, i32 whence);
        i32 close(i32 fd);
    }

    // `path` with a NUL after it, for C.
    private std::string c_path(std::str path) {
        mut std::string text = std::string::from(path);
        text.push('\0');
        return text;
    }

    // The size of the file at `path`, or 0.
    private u64 file_size(std::str path) {
        std::string name = c_path(path);
        std::str c_name = name;
        unsafe {
            i32 fd = open(c_name.as_ptr(), 0);
            if (fd < 0) { return 0; }
            i64 end = lseek(fd, 0, 2);   // SEEK_END
            _ = close(fd);
            return cast::saturate<u64>(end);
        }
    }

    // The rotated file number `n` of `path`: `logs/app.log` → `logs/app.3.log`; `n` = 0 is
    // the path itself.
    private std::string numbered(std::filesystem::path& path, u32 n) {
        std::str whole = path.as_str();
        if (n == 0) { return std::string::from(whole); }
        std::str ext = path.extension();
        if (ext.is_empty()) { return std::format(f"{whole}.{n}"); }
        std::str stem = whole.slice(0, whole.len() - ext.len() - 1);
        return std::format(f"{stem}.{n}.{ext}");
    }

    // The local date of `t` as a number: 20261120.
    private i64 day_key(std::time::wall_time t) {
        std::time::civil_time c = t.local();
        return cast<i64>(c.year) * 10000 + cast<i64>(c.month) * 100 + cast<i64>(c.day);
    }

    // Appends `text` as a JSON string literal.
    private void json_string(mut std::string& out, std::str text) {
        out.push('"');
        std::str hex = "0123456789abcdef";
        mut usize run = 0;   // the start of the bytes not copied yet
        mut usize i = 0;
        while (i < text.len()) {
            mut u8 b = 0;
            unsafe { b = *text.as_ptr().offset(i); }
            if (b == 34 || b == 92 || b < 32) {
                out.push_str(text.slice(run, i));
                if (b == 34) {
                    out.push_str("\\\"");
                } else if (b == 92) {
                    out.push_str("\\\\");
                } else if (b == 10) {
                    out.push_str("\\n");
                } else if (b == 13) {
                    out.push_str("\\r");
                } else if (b == 9) {
                    out.push_str("\\t");
                } else {
                    out.push_str("\\u00");
                    out.push_str(hex.slice(cast<usize>(b / 16), cast<usize>(b / 16) + 1));
                    out.push_str(hex.slice(cast<usize>(b % 16), cast<usize>(b % 16) + 1));
                }
                run = i + 1;
            }
            i += 1;
        }
        out.push_str(text.slice(run, text.len()));
        out.push('"');
    }

    // One record as a JSON object (without the line break).
    private void json_record(mut std::string& out, std::log::record& r) {
        std::time::civil_time c = r.time.utc();
        out.push_str("{\"time\":\"");
        std::log::digits(mut out, cast::saturate<u64>(c.year), 4);
        out.push('-');
        std::log::digits(mut out, cast<u64>(c.month), 2);
        out.push('-');
        std::log::digits(mut out, cast<u64>(c.day), 2);
        out.push('T');
        std::log::digits(mut out, cast<u64>(c.hour), 2);
        out.push(':');
        std::log::digits(mut out, cast<u64>(c.minute), 2);
        out.push(':');
        std::log::digits(mut out, cast<u64>(c.second), 2);
        out.push('.');
        std::log::digits(mut out, cast<u64>(c.nanosecond / 1000000), 3);
        out.push_str("Z\",\"level\":");
        json_string(mut out, std::log::level_word(r.level));
        out.push_str(",\"target\":");
        json_string(mut out, r.where.target);
        out.push_str(",\"file\":");
        json_string(mut out, r.where.file);
        out.push_str(",\"line\":");
        std::log::digits(mut out, cast<u64>(r.where.line), 1);
        out.push_str(",\"function\":");
        json_string(mut out, r.where.function);
        out.push_str(",\"thread\":");
        json_string(mut out, r.thread_name);
        out.push_str(",\"message\":");
        json_string(mut out, r.message);
        out.push('}');
    }

    class file {
    public:
        static std::result<std::unique_ptr<std::log::file>, std::io_error> create(std::log::file_options& options) {
            std::filesystem::path dir = options.path.parent();
            if (!dir.as_str().is_empty()) {
                std::filesystem::create_directories(dir)?;
            }
            u64 existing = match (options.mode) {
                std::log::file_mode::truncate => 0,
                std::log::file_mode::append => file_size(options.path.as_str()),
            };
            mut std::file out = match (options.mode) {
                std::log::file_mode::truncate => std::file::create(options.path)?,
                std::log::file_mode::append => std::file::append(options.path)?,
            };
            mut std::log::file sink = std::log::file{
                .out = move out,
                .path = options.path.clone(),
                .flush_at = options.flush_at,
                .buffer_size = options.buffer_size,
                .pending = 0,
                .rotation = options.rotation,
                .format = options.format,
                .size = existing,
                .day = day_key(std::time::wall_time::now()),
            };
            sink.banner("log started at ");
            return std::ok(std::unique_ptr<std::log::file>::make(move sink));
        }

        bool colored() override { return false; }

        void write(std::log::record& r, std::str line) mut override {
            mut std::string json = default;
            if (this.format == std::log::file_format::json_lines) { json_record(mut json, r); }
            std::str text = if (this.format == std::log::file_format::json_lines) { json.as_str() } else { line };
            this.rotate_before(r, cast<u64>(text.len() + 1));
            _ = this.out.write(text);
            _ = this.out.write("\n");
            this.pending += text.len() + 1;
            this.size += cast<u64>(text.len() + 1);
            if (cast<u8>(r.level) >= cast<u8>(this.flush_at) || this.pending >= this.buffer_size) {
                this.flush();
            }
        }

        void flush() mut override {
            _ = this.out.flush();
            this.pending = 0;
        }

        ~file() {
            this.banner("log stopped at ");
        }

    private:
        std::file             out;
        std::filesystem::path path;
        std::log::level       flush_at = std::log::level::warn;
        usize                 buffer_size = 65536;
        usize                 pending = 0;
        std::log::rotation    rotation = std::log::rotation::none;
        std::log::file_format format = std::log::file_format::text;
        u64                   size = 0;   // bytes in the current file
        i64                   day = 0;    // the local date the current file was started on

        // The "log started" / "log stopped" lines (text files only: a JSON file holds records only).
        void banner(std::static_str what) mut {
            if (this.format == std::log::file_format::json_lines) { return; }
            mut std::string text = default;
            bool start = what.starts_with("log started");
            text.push_str(if (start) { "==================================================================\n" } else { "------------------------------------------------------------------\n" });
            text.push_str(what);
            std::log::stamp(mut text);
            text.push_str(if (start) { "\n------------------------------------------------------------------\n" } else { "\n==================================================================\n" });
            _ = this.out.write(text);
            _ = this.out.flush();
            this.size += cast<u64>(text.len());
        }

        // Starts a new file when the rotation says so before a record of `bytes` is written.
        void rotate_before(std::log::record& r, u64 bytes) mut {
            match (this.rotation) {
                std::log::rotation::none => { },
                std::log::rotation::by_size(limit) => {
                    if (this.size > 0 && this.size + bytes > limit.max_bytes) { this.rotate(limit.keep); }
                },
                std::log::rotation::daily(keep) => {
                    i64 today = day_key(r.time);
                    if (today != this.day) {
                        this.rotate(keep);
                        this.day = today;
                    }
                },
            }
        }

        // app.log becomes app.1.log, app.1.log becomes app.2.log, ...; the oldest beyond `keep`
        // is deleted, and a new app.log is started.
        void rotate(u32 keep) mut {
            this.banner("log continued in a new file at ");
            this.flush();
            if (keep == 0) {
                std::string name = c_path(this.path.as_str());
                std::str c_name = name;
                unsafe { _ = remove(c_name.as_ptr()); }
            } else {
                mut u32 k = keep;
                while (k > 0) {
                    std::string from = c_path(numbered(this.path, k - 1).as_str());
                    std::string to = c_path(numbered(this.path, k).as_str());
                    std::str c_from = from;
                    std::str c_to = to;
                    unsafe { _ = rename(c_from.as_ptr(), c_to.as_ptr()); }
                    k -= 1;
                }
            }
            match (std::file::create(this.path)) {
                std::ok(f) => {
                    this.out = move f;
                    this.size = 0;
                    this.banner("log started at ");
                },
                std::error(_) => { },   // keep writing to the renamed file
            }
        }
    }

    // `yyyy-mm-dd hh:mm:ss` now, in local time.
    private void stamp(mut std::string& out) {
        std::time::civil_time c = std::time::wall_time::now().local();
        std::log::digits(mut out, cast::saturate<u64>(c.year), 4);
        out.push('-');
        std::log::digits(mut out, cast<u64>(c.month), 2);
        out.push('-');
        std::log::digits(mut out, cast<u64>(c.day), 2);
        out.push(' ');
        std::log::digits(mut out, cast<u64>(c.hour), 2);
        out.push(':');
        std::log::digits(mut out, cast<u64>(c.minute), 2);
        out.push(':');
        std::log::digits(mut out, cast<u64>(c.second), 2);
    }

    // The lines of a history: a ring of `capacity` lines.
    private struct history_lines {
        std::darray<std::string> lines;
        usize                    capacity;
        usize                    next;   // where the next line goes once the ring is full
    }

    class history {
    public:
        static std::log::history make(usize capacity) {
            return std::log::history{
                .shared = std::shared_ptr<std::mutex<std::log::history_lines>>::make(std::mutex<std::log::history_lines>::make(
                    std::log::history_lines{ .lines = default, .capacity = capacity, .next = 0 })),
            };
        }

        std::darray<std::string> snapshot() {
            mut std::darray<std::string> out = default;
            std::mutex_guard<std::log::history_lines> g = this.shared->lock();
            usize n = g->lines.len();
            mut usize i = 0;
            while (i < n) {
                out.push(g->lines[(g->next + i) % n].clone());
                i += 1;
            }
            return out;
        }

        std::log::history clone() { return std::log::history{ .shared = this.shared.clone() }; }

        // Adds a line, replacing the oldest once the ring is full.
        void push(std::str line) {
            mut std::mutex_guard<std::log::history_lines> g = this.shared->lock();
            if (g->capacity == 0) {
                return;
            }
            if (g->lines.len() < g->capacity) {
                g->lines.push(std::string::from(line));
            } else {
                usize at = g->next;
                g->lines[at] = std::string::from(line);
                g->next = (at + 1) % g->capacity;
            }
        }

    private:
        std::shared_ptr<std::mutex<std::log::history_lines>> shared;
    }

    class memory {
    public:
        static std::unique_ptr<std::log::memory> make(std::log::history& into) {
            return std::unique_ptr<std::log::memory>::make(std::log::memory{ .into = into.clone() });
        }

        bool colored() override { return false; }

        void write(std::log::record& r, std::str line) mut override { this.into.push(line); }

        void flush() mut override { }

    private:
        std::log::history into;
    }

    // --- the log thread -------------------------------------------------------------------------

    // A record for the sinks, borrowing from `e`.
    private std::log::record record_of(std::log::entry& e) {
        return std::log::record{
            .level = e.lvl,
            .where = e.where,
            .thread_id = e.thread_id,
            .thread_name = e.thread_name.as_str(),
            .time = e.time,
            .message = e.message.as_str(),
            .from_panic = e.from_panic,
        };
    }

    private void write_to(mut std::log::slot& s, std::log::entry& e, mut std::string& line) {
        if (cast<u8>(e.lvl) < cast<u8>(s.options.min_level)) {
            return;
        }
        std::log::record r = std::log::record_of(e);
        if (!s.options.filter.accepts(r)) {
            return;
        }
        line.clear();
        if (s.sink->colored()) {
            s.options.pattern.render(r, &s.options.palette, mut line);
        } else {
            s.options.pattern.render(r, nullptr, mut line);
        }
        s.sink->write(r, line);
    }

    private void run(std::channel_receiver<std::log::command>& input) {
        log_thread_id.store(std::thread::current_id(), std::memory_order::sequentially_consistent);
        mut std::darray<std::log::slot>  sinks = default;
        mut std::darray<std::log::entry> backlog = default;   // what arrived while there was no sink
        mut std::string                  line = default;
        for (std::log::command c : input) {
            match (move c) {
                std::log::command::write(e) => {
                    if (sinks.is_empty()) {
                        if (backlog.len() < early_capacity) {
                            backlog.push(move e);
                        }
                    } else {
                        for (mut std::log::slot& s : sinks) {
                            std::log::write_to(mut s, e, mut line);
                        }
                    }
                },
                std::log::command::add(s) => {
                    mut std::log::slot added = move s;
                    for (std::log::entry& old : backlog) {
                        std::log::write_to(mut added, old, mut line);
                    }
                    sinks.push(move added);
                },
                std::log::command::remove(id) => {
                    sinks.retain([id](std::log::slot& s) { return s.id.value != id.value; });
                },
                std::log::command::set_level(l) => {
                    for (mut std::log::slot& s : sinks) {
                        if (s.id.value == l.id.value) {
                            s.options.min_level = l.level;
                        }
                    }
                },
                std::log::command::set_pattern(p) => {
                    for (mut std::log::slot& s : sinks) {
                        if (s.id.value == p.id.value) {
                            s.options.pattern = p.pattern;
                        }
                    }
                },
                std::log::command::set_palette(p) => {
                    for (mut std::log::slot& s : sinks) {
                        if (s.id.value == p.id.value) {
                            s.options.palette = p.palette;
                        }
                    }
                },
                std::log::command::flush(reply) => {
                    for (mut std::log::slot& s : sinks) {
                        s.sink->flush();
                    }
                    _ = reply.send(0);
                },
            }
        }
        for (mut std::log::slot& s : sinks) {
            s.sink->flush();
        }
        log_thread_id.store(0, std::memory_order::sequentially_consistent);
    }

    // --- panics ---------------------------------------------------------------------------------

    // A panic anywhere: log its message, then write everything queued and flush the sinks.
    private void on_panic(std::panic_info& info) {
        std::string message = std::format(f"{info.where.file}:{info.where.line}:{info.where.column}: panic: {info.message}");
        mut std::log::entry e = std::log::note(std::log::level::fatal, move message);
        e.from_panic = true;
        std::log::deliver(move e);
        std::log::flush_all();
    }

    // Writes everything queued and flushes every sink, waiting for the log thread; without a
    // session, prints the early entries on stderr.
    // Writes every queued message and flushes every sink, then returns (on the log thread itself:
    // at once; without a session: the early messages go to stderr).
    private void flush_all() {
        if (log_thread_id.load(std::memory_order::sequentially_consistent) == std::thread::current_id()) {
            return;   // on the log thread itself: it can't wait for itself
        }
        std::raw_ptr<mut std::log::shared> s = active.load(std::memory_order::sequentially_consistent);
        if (!s) {
            std::log::print_early();
            return;
        }
        unsafe {
            _ = (*s).users.fetch_wrapping_add(1, std::memory_order::sequentially_consistent);
            if (active.load(std::memory_order::sequentially_consistent) == s) {
                std::channel<u32> reply = std::channel<u32>::bounded(1);
                if ((*s).sender.send(std::log::command::flush(reply.sender())).is_ok()) {
                    _ = reply.receiver().receive();
                }
            }
            _ = (*s).users.fetch_wrapping_sub(1, std::memory_order::sequentially_consistent);
        }
    }

    private void print_early() {
        std::log::lock_early();
        unsafe {
            if (early) {
                mut std::string line = default;
                for (std::log::entry& e : *early) {
                    if (e.from_panic) {
                        continue;
                    }
                    line.clear();
                    std::log::default_pattern.render(std::log::record_of(e), nullptr, mut line);
                    std::eprintln(line);
                }
                (*early).clear();
            }
        }
        std::log::unlock_early();
    }

    private void set_panic_hook() {
        _ = std::set_panic_hook([](std::panic_info& info) { std::log::on_panic(info); });
    }

    // --- the session ----------------------------------------------------------------------------

    std::log::session start(std::log::options o) {
        run_time check (!active.load(std::memory_order::sequentially_consistent))
            else "std::log::start: a log session is already running";
        std::channel<std::log::command> queue = std::channel<std::log::command>::bounded(o.queue_capacity);
        std::channel_receiver<std::log::command> input = queue.receiver();
        std::thread::handle<void> worker = std::thread::spawn(std::thread::options{ .name = "log" }, [move input]() {
            std::log::run(input);           // borrowed: the lambda owns the receiver and drops it once
        });
        mut std::raw_ptr<mut std::log::shared> state = nullptr;
        unsafe {
            state = std::raw::allocate<std::log::shared>(1);
            std::raw::write(state, std::log::shared{
                .sender = queue.sender(),
                .users = default,
                .when_full = o.when_full,
                .dropped = default,
            });
        }
        // The early entries go first; the lock keeps new ones from passing them.
        std::log::lock_early();
        unsafe {
            if (early) {
                for (std::log::entry& e : *early) {
                    _ = (*state).sender.send(std::log::command::write(e.clone()));
                }
                (*early).clear();
            }
        }
        u64 lost = early_dropped.exchange(0, std::memory_order::relaxed);
        if (lost > 0) {
            unsafe {
                _ = (*state).sender.send(std::log::command::write(
                    std::log::note(std::log::level::warn, std::format(f"[std::log] {lost} messages before the session were dropped"))));
            }
        }
        active.store(state, std::memory_order::sequentially_consistent);
        std::log::unlock_early();
        std::log::set_panic_hook();
        minimum.store(0, std::memory_order::relaxed);   // the log thread keeps them until there is a sink
        return std::log::session{
            .state = state,
            .queue = move queue,
            .worker = std::some(move worker),
            .levels = default,
            .next_id = 0,
        };
    }

    class session {
    public:
        std::log::sink_id add(std::unique_ptr<std::log::sink> s, std::log::sink_options o) mut {
            this.next_id += 1;
            std::log::sink_id id = std::log::sink_id{ .value = this.next_id };
            this.levels.push(std::log::sink_level{ .id = id, .level = o.min_level });
            this.send(std::log::command::add(std::log::slot{ .id = id, .sink = move s, .options = o }));
            this.update_minimum();
            return id;
        }

        void remove(std::log::sink_id id) mut {
            this.levels.retain([id](std::log::sink_level& l) { return l.id.value != id.value; });
            this.send(std::log::command::remove(id));
            this.update_minimum();
        }

        void set_level(std::log::sink_id id, std::log::level l) mut {
            for (mut std::log::sink_level& x : this.levels) {
                if (x.id.value == id.value) {
                    x.level = l;
                }
            }
            // A lower level must reach the log thread before records at that level do.
            this.send(std::log::command::set_level(std::log::sink_level{ .id = id, .level = l }));
            this.update_minimum();
        }

        void set_pattern(std::log::sink_id id, std::log::pattern p) {
            this.send(std::log::command::set_pattern(std::log::sink_pattern{ .id = id, .pattern = p }));
        }

        void set_palette(std::log::sink_id id, std::log::palette p) {
            this.send(std::log::command::set_palette(std::log::sink_palette{ .id = id, .palette = p }));
        }

        void flush() {
            std::channel<u32> reply = std::channel<u32>::bounded(1);
            this.send(std::log::command::flush(reply.sender()));
            _ = reply.receiver().receive();
        }

        ~session() {
            active.store(nullptr, std::memory_order::sequentially_consistent);
            unsafe {
                while ((*this.state).users.load(std::memory_order::sequentially_consistent) != 0) {
                    std::thread::spin_hint();
                }
            }
            minimum.store(0, std::memory_order::relaxed);   // calls go to the early buffer again
            this.queue.close();
            std::thread::handle<void> worker = std::take(mut this.worker).expect("the log thread runs until the session ends");
            worker.join();
            unsafe {
                std::raw::drop(this.state);
                std::raw::free(this.state);
            }
        }

    private:
        // Sends a command, unless the log thread is gone.
        void send(std::log::command c) {
            unsafe { _ = (*this.state).sender.send(move c); }
        }

        // The run-time minimum: the lowest level of any sink (`off` without sinks).
        void update_minimum() {
            mut u8 lowest = cast<u8>(std::log::level::off);
            for (std::log::sink_level& l : this.levels) {
                if (cast<u8>(l.level) < lowest) {
                    lowest = cast<u8>(l.level);
                }
            }
            minimum.store(lowest, std::memory_order::relaxed);
        }

        std::raw_ptr<mut std::log::shared>        state;
        std::channel<std::log::command>            queue;
        std::option<std::thread::handle<void>>     worker;
        std::darray<std::log::sink_level>          levels;
        u32                                        next_id = 0;
    }
}
