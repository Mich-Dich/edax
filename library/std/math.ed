    template<type T>
    compile_time run_time bool approx_equal(vec2<T> a, vec2<T> b, T tolerance) { return (a.x - b.x).abs() <= tolerance && (a.y - b.y).abs() <= tolerance; }

    template<type T>
    compile_time run_time bool approx_equal(vec3<T> a, vec3<T> b, T tolerance) { return (a.x - b.x).abs() <= tolerance && (a.y - b.y).abs() <= tolerance && (a.z - b.z).abs() <= tolerance; }

    template<type T>
    compile_time run_time bool approx_equal(vec4<T> a, vec4<T> b, T tolerance) { return (a.x - b.x).abs() <= tolerance && (a.y - b.y).abs() <= tolerance && (a.z - b.z).abs() <= tolerance && (a.w - b.w).abs() <= tolerance; }

    template<type T>
    compile_time run_time vec2<bool> less_than(vec2<T> a, vec2<T> b) { return vec2<bool>{ .x = a.x < b.x, .y = a.y < b.y }; }

    template<type T>
    compile_time run_time vec3<bool> less_than(vec3<T> a, vec3<T> b) { return vec3<bool>{ .x = a.x < b.x, .y = a.y < b.y, .z = a.z < b.z }; }

