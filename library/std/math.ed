    compile_time run_time vec4<T> lerp(vec4<T> a, vec4<T> b, T t) { return vec4<T>{ .x = a.x + (b.x - a.x) * t, .y = a.y + (b.y - a.y) * t, .z = a.z + (b.z - a.z) * t, .w = a.w + (b.w - a.w) * t }; }

