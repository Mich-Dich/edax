    compile_time run_time vec4<T> clamp(vec4<T> v, vec4<T> lo, vec4<T> hi) { return vec4<T>{ .x = min(max(v.x, lo.x), hi.x), .y = min(max(v.y, lo.y), hi.y), .z = min(max(v.z, lo.z), hi.z), .w = min(max(v.w, lo.w), hi.w) }; }

    template<type T>
    compile_time run_time vec2<T> lerp(vec2<T> a, vec2<T> b, T t) { return vec2<T>{ .x = a.x + (b.x - a.x) * t, .y = a.y + (b.y - a.y) * t }; }

    template<type T>
    compile_time run_time vec3<T> lerp(vec3<T> a, vec3<T> b, T t) { return vec3<T>{ .x = a.x + (b.x - a.x) * t, .y = a.y + (b.y - a.y) * t, .z = a.z + (b.z - a.z) * t }; }

