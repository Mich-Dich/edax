// The Edax standard library: module std::math (see math.edh).

namespace std::math {
    // ---- angles -----------------------------------------------------------------------------------------

    compile_time run_time radians rad(f32 value) { return cast<radians>(value); }

    compile_time run_time radians deg(f32 value) { return cast<radians>(value * 0.017453292519943295); }

    compile_time run_time radians to_radians(degrees a) { return cast<radians>(cast<f32>(a) * 0.017453292519943295); }

    compile_time run_time degrees to_degrees(radians a) { return cast<degrees>(cast<f32>(a) * 57.29577951308232); }

    compile_time run_time f32 sin(radians a) { return cast<f32>(a).sin(); }

    compile_time run_time f32 cos(radians a) { return cast<f32>(a).cos(); }

    compile_time run_time f32 tan(radians a) { return cast<f32>(a).tan(); }

    compile_time run_time radians asin(f32 x) { return cast<radians>(x.asin()); }

    compile_time run_time radians acos(f32 x) { return cast<radians>(x.acos()); }

    compile_time run_time radians atan(f32 x) { return cast<radians>(x.atan()); }

    compile_time run_time radians atan2(f32 y, f32 x) { return cast<radians>(y.atan2(x)); }

    compile_time run_time radians wrap_angle(radians a) {
        f32 v = cast<f32>(a);
        return cast<radians>(v - 6.28318530717959 * ((v + 3.14159265358979) / 6.28318530717959).floor());
    }

    compile_time run_time radians angle_difference(radians from, radians to) { return wrap_angle(to - from); }

    compile_time run_time radians lerp_angle(radians a, radians b, f32 t) { return a + angle_difference(a, b) * t; }

    // ---- numbers -----------------------------------------------------------------------------------------

    template<type T>
    compile_time run_time T abs(T x) { return x.abs(); }

    template<type T>
    compile_time run_time T sign(T x) {
        T zero = default;
        if (x > zero) { return scalar_one<T>(); }
        if (x < zero) { return zero - scalar_one<T>(); }
        return zero;
    }

    template<type T>
    compile_time run_time T min(T a, T b) {
        if (b < a) { return b; }
        return a;
    }

    template<type T>
    compile_time run_time T max(T a, T b) {
        if (a < b) { return b; }
        return a;
    }

    template<type T>
    compile_time run_time T clamp(T x, T lo, T hi) { return min(max(x, lo), hi); }

    template<type T>
    compile_time run_time T saturate(T x) {
        T zero = default;
        return min(max(x, zero), scalar_one<T>());
    }

    template<type T>
    compile_time run_time T floor(T x) { return x.floor(); }

    template<type T>
    compile_time run_time T ceil(T x) { return x.ceil(); }

    template<type T>
    compile_time run_time T round(T x) { return x.round(); }

    template<type T>
    compile_time run_time T trunc(T x) { return x.trunc(); }

    template<type T>
    compile_time run_time T fract(T x) { return x - x.floor(); }

    template<type T>
    compile_time run_time T mod(T x, T y) { return x - y * (x / y).floor(); }

    template<type T>
    compile_time run_time T sqrt(T x) { return x.sqrt(); }

    template<type T>
    compile_time run_time T inverse_sqrt(T x) { return scalar_one<T>() / x.sqrt(); }

    template<type T>
    compile_time run_time T pow(T x, T y) { return x.pow(y); }

    template<type T>
    compile_time run_time T exp(T x) { return x.exp(); }

    template<type T>
    compile_time run_time T exp2(T x) { return x.exp2(); }

    template<type T>
    compile_time run_time T log(T x) { return x.log(); }

    template<type T>
    compile_time run_time T log2(T x) { return x.log2(); }

    template<type T>
    compile_time run_time T lerp(T a, T b, T t) { return a + (b - a) * t; }

    template<type T>
    compile_time run_time T inverse_lerp(T a, T b, T v) { return (v - a) / (b - a); }

    template<type T>
    compile_time run_time T remap(T v, T in_lo, T in_hi, T out_lo, T out_hi) { return out_lo + (v - in_lo) * (out_hi - out_lo) / (in_hi - in_lo); }

    template<type T>
    compile_time run_time T step(T edge, T x) {
        T zero = default;
        if (x < edge) { return zero; }
        return scalar_one<T>();
    }

    template<type T>
    compile_time run_time T smoothstep(T edge0, T edge1, T x) {
        T t = saturate((x - edge0) / (edge1 - edge0));
        return t * t * (3.0 - 2.0 * t);
    }

    template<type T>
    compile_time run_time T smootherstep(T edge0, T edge1, T x) {
        T t = saturate((x - edge0) / (edge1 - edge0));
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    template<type T>
    compile_time run_time bool approx_equal(T a, T b, T tolerance) { return (a - b).abs() <= tolerance; }

    // ---- vectors -----------------------------------------------------------------------------------------

    private template<type T>
    compile_time run_time T scalar_one() {
        if compile_time (std::is_float<T>()) {
            return 1.0;
        } else {
            return 1;
        }
    }

    private template<type U, type T>
    compile_time run_time U scalar_cast(T v) {
        if compile_time (std::is_float<U>()) {
            return cast::round<U>(v);
        } else {
            return cast::saturate<U>(v);
        }
    }

    template<type T>
    struct vec2 {
        compile_time run_time static vec2<T> make(T x, T y) { return vec2<T>{ .x = x, .y = y }; }
        compile_time run_time static vec2<T> splat(T v) { return vec2<T>{ .x = v, .y = v }; }
        compile_time run_time static vec2<T> zero() { return vec2<T>{}; }
        compile_time run_time static vec2<T> one() { return vec2<T>{ .x = scalar_one<T>(), .y = scalar_one<T>() }; }
        compile_time run_time static vec2<T> unit_x() { return vec2<T>{ .x = scalar_one<T>() }; }
        compile_time run_time static vec2<T> unit_y() { return vec2<T>{ .y = scalar_one<T>() }; }
        template<type U>
        compile_time run_time vec2<U> to() { return vec2<U>{ .x = scalar_cast<U, T>(this.x), .y = scalar_cast<U, T>(this.y) }; }

        std::span<T> as_span() {
            unsafe { return std::span<T>::from_raw(&this.x, 2); }
        }

        compile_time run_time vec2<T> operator+(vec2<T> other) { return vec2<T>{ .x = this.x + other.x, .y = this.y + other.y }; }
        compile_time run_time vec2<T> operator-(vec2<T> other) { return vec2<T>{ .x = this.x - other.x, .y = this.y - other.y }; }
        compile_time run_time vec2<T> operator*(vec2<T> other) { return vec2<T>{ .x = this.x * other.x, .y = this.y * other.y }; }
        compile_time run_time vec2<T> operator/(vec2<T> other) { return vec2<T>{ .x = this.x / other.x, .y = this.y / other.y }; }
        compile_time run_time vec2<T> operator*(T k) { return vec2<T>{ .x = this.x * k, .y = this.y * k }; }
        compile_time run_time vec2<T> operator/(T k) { return vec2<T>{ .x = this.x / k, .y = this.y / k }; }
        compile_time run_time vec2<T> operator-() { return vec2<T>{ .x = -this.x, .y = -this.y }; }

        T& operator[](usize i) {
            run_time check (i < 2) else "a vec2 has the components 0 to 1";
            unsafe { return *(&this.x).offset(i); }
        }

        mut T& operator[](usize i) mut {
            run_time check (i < 2) else "a vec2 has the components 0 to 1";
            unsafe { return *(mut &this.x).offset(i); }
        }

        void format(mut std::formatter& out) { out.write(std::format(f"({this.x}, {this.y})")); }
    }

    template<type T>
    compile_time run_time vec2<T> operator*(T k, vec2<T> v) { return vec2<T>{ .x = k * v.x, .y = k * v.y }; }

    template<type T>
    struct vec3 {
        compile_time run_time static vec3<T> make(T x, T y, T z) { return vec3<T>{ .x = x, .y = y, .z = z }; }
        compile_time run_time static vec3<T> splat(T v) { return vec3<T>{ .x = v, .y = v, .z = v }; }
        compile_time run_time static vec3<T> zero() { return vec3<T>{}; }
        compile_time run_time static vec3<T> one() { return vec3<T>{ .x = scalar_one<T>(), .y = scalar_one<T>(), .z = scalar_one<T>() }; }
        compile_time run_time static vec3<T> unit_x() { return vec3<T>{ .x = scalar_one<T>() }; }
        compile_time run_time static vec3<T> unit_y() { return vec3<T>{ .y = scalar_one<T>() }; }
        compile_time run_time static vec3<T> unit_z() { return vec3<T>{ .z = scalar_one<T>() }; }
        compile_time run_time static vec3<T> from_xy(vec2<T> xy, T z) { return vec3<T>{ .x = xy.x, .y = xy.y, .z = z }; }
        compile_time run_time vec2<T> xy() { return vec2<T>{ .x = this.x, .y = this.y }; }
        compile_time run_time vec2<T> xz() { return vec2<T>{ .x = this.x, .y = this.z }; }
        compile_time run_time vec2<T> yz() { return vec2<T>{ .x = this.y, .y = this.z }; }
        template<type U>
        compile_time run_time vec3<U> to() { return vec3<U>{ .x = scalar_cast<U, T>(this.x), .y = scalar_cast<U, T>(this.y), .z = scalar_cast<U, T>(this.z) }; }

        std::span<T> as_span() {
            unsafe { return std::span<T>::from_raw(&this.x, 3); }
        }

        compile_time run_time vec3<T> operator+(vec3<T> other) { return vec3<T>{ .x = this.x + other.x, .y = this.y + other.y, .z = this.z + other.z }; }
        compile_time run_time vec3<T> operator-(vec3<T> other) { return vec3<T>{ .x = this.x - other.x, .y = this.y - other.y, .z = this.z - other.z }; }
        compile_time run_time vec3<T> operator*(vec3<T> other) { return vec3<T>{ .x = this.x * other.x, .y = this.y * other.y, .z = this.z * other.z }; }
        compile_time run_time vec3<T> operator/(vec3<T> other) { return vec3<T>{ .x = this.x / other.x, .y = this.y / other.y, .z = this.z / other.z }; }
        compile_time run_time vec3<T> operator*(T k) { return vec3<T>{ .x = this.x * k, .y = this.y * k, .z = this.z * k }; }
        compile_time run_time vec3<T> operator/(T k) { return vec3<T>{ .x = this.x / k, .y = this.y / k, .z = this.z / k }; }
        compile_time run_time vec3<T> operator-() { return vec3<T>{ .x = -this.x, .y = -this.y, .z = -this.z }; }

        T& operator[](usize i) {
            run_time check (i < 3) else "a vec3 has the components 0 to 2";
            unsafe { return *(&this.x).offset(i); }
        }

        mut T& operator[](usize i) mut {
            run_time check (i < 3) else "a vec3 has the components 0 to 2";
            unsafe { return *(mut &this.x).offset(i); }
        }

        void format(mut std::formatter& out) { out.write(std::format(f"({this.x}, {this.y}, {this.z})")); }
    }

    template<type T>
    compile_time run_time vec3<T> operator*(T k, vec3<T> v) { return vec3<T>{ .x = k * v.x, .y = k * v.y, .z = k * v.z }; }

    template<type T>
    struct vec4 {
        compile_time run_time static vec4<T> make(T x, T y, T z, T w) { return vec4<T>{ .x = x, .y = y, .z = z, .w = w }; }
        compile_time run_time static vec4<T> splat(T v) { return vec4<T>{ .x = v, .y = v, .z = v, .w = v }; }
        compile_time run_time static vec4<T> zero() { return vec4<T>{}; }
        compile_time run_time static vec4<T> one() { return vec4<T>{ .x = scalar_one<T>(), .y = scalar_one<T>(), .z = scalar_one<T>(), .w = scalar_one<T>() }; }
        compile_time run_time static vec4<T> unit_x() { return vec4<T>{ .x = scalar_one<T>() }; }
        compile_time run_time static vec4<T> unit_y() { return vec4<T>{ .y = scalar_one<T>() }; }
        compile_time run_time static vec4<T> unit_z() { return vec4<T>{ .z = scalar_one<T>() }; }
        compile_time run_time static vec4<T> unit_w() { return vec4<T>{ .w = scalar_one<T>() }; }
        compile_time run_time static vec4<T> from_xyz(vec3<T> xyz, T w) { return vec4<T>{ .x = xyz.x, .y = xyz.y, .z = xyz.z, .w = w }; }
        compile_time run_time vec3<T> xyz() { return vec3<T>{ .x = this.x, .y = this.y, .z = this.z }; }
        compile_time run_time vec2<T> xy() { return vec2<T>{ .x = this.x, .y = this.y }; }
        compile_time run_time vec2<T> zw() { return vec2<T>{ .x = this.z, .y = this.w }; }
        template<type U>
        compile_time run_time vec4<U> to() { return vec4<U>{ .x = scalar_cast<U, T>(this.x), .y = scalar_cast<U, T>(this.y), .z = scalar_cast<U, T>(this.z), .w = scalar_cast<U, T>(this.w) }; }

        std::span<T> as_span() {
            unsafe { return std::span<T>::from_raw(&this.x, 4); }
        }

        compile_time run_time vec4<T> operator+(vec4<T> other) { return vec4<T>{ .x = this.x + other.x, .y = this.y + other.y, .z = this.z + other.z, .w = this.w + other.w }; }
        compile_time run_time vec4<T> operator-(vec4<T> other) { return vec4<T>{ .x = this.x - other.x, .y = this.y - other.y, .z = this.z - other.z, .w = this.w - other.w }; }
        compile_time run_time vec4<T> operator*(vec4<T> other) { return vec4<T>{ .x = this.x * other.x, .y = this.y * other.y, .z = this.z * other.z, .w = this.w * other.w }; }
        compile_time run_time vec4<T> operator/(vec4<T> other) { return vec4<T>{ .x = this.x / other.x, .y = this.y / other.y, .z = this.z / other.z, .w = this.w / other.w }; }
        compile_time run_time vec4<T> operator*(T k) { return vec4<T>{ .x = this.x * k, .y = this.y * k, .z = this.z * k, .w = this.w * k }; }
        compile_time run_time vec4<T> operator/(T k) { return vec4<T>{ .x = this.x / k, .y = this.y / k, .z = this.z / k, .w = this.w / k }; }
        compile_time run_time vec4<T> operator-() { return vec4<T>{ .x = -this.x, .y = -this.y, .z = -this.z, .w = -this.w }; }

        T& operator[](usize i) {
            run_time check (i < 4) else "a vec4 has the components 0 to 3";
            unsafe { return *(&this.x).offset(i); }
        }

        mut T& operator[](usize i) mut {
            run_time check (i < 4) else "a vec4 has the components 0 to 3";
            unsafe { return *(mut &this.x).offset(i); }
        }

        void format(mut std::formatter& out) { out.write(std::format(f"({this.x}, {this.y}, {this.z}, {this.w})")); }
    }

    template<type T>
    compile_time run_time vec4<T> operator*(T k, vec4<T> v) { return vec4<T>{ .x = k * v.x, .y = k * v.y, .z = k * v.z, .w = k * v.w }; }

    // ---- vector functions --------------------------------------------------------------------------------

    template<type T>
    compile_time run_time T dot(vec2<T> a, vec2<T> b) { return a.x * b.x + a.y * b.y; }

    template<type T>
    compile_time run_time T dot(vec3<T> a, vec3<T> b) { return a.x * b.x + a.y * b.y + a.z * b.z; }

    template<type T>
    compile_time run_time T dot(vec4<T> a, vec4<T> b) { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }

    template<type T>
    compile_time run_time vec3<T> cross(vec3<T> a, vec3<T> b) { return vec3<T>{ .x = a.y * b.z - a.z * b.y, .y = a.z * b.x - a.x * b.z, .z = a.x * b.y - a.y * b.x }; }

    template<type T>
    compile_time run_time T cross(vec2<T> a, vec2<T> b) { return a.x * b.y - a.y * b.x; }

    template<type T>
    compile_time run_time T length(vec2<T> v) { return dot(v, v).sqrt(); }

    template<type T>
    compile_time run_time T length(vec3<T> v) { return dot(v, v).sqrt(); }

    template<type T>
    compile_time run_time T length(vec4<T> v) { return dot(v, v).sqrt(); }

    template<type T>
    compile_time run_time T length_squared(vec2<T> v) { return dot(v, v); }

    template<type T>
    compile_time run_time T length_squared(vec3<T> v) { return dot(v, v); }

    template<type T>
    compile_time run_time T length_squared(vec4<T> v) { return dot(v, v); }

    template<type T>
    compile_time run_time T distance(vec2<T> a, vec2<T> b) { return length(a - b); }

    template<type T>
    compile_time run_time T distance(vec3<T> a, vec3<T> b) { return length(a - b); }

    template<type T>
    compile_time run_time T distance(vec4<T> a, vec4<T> b) { return length(a - b); }

    template<type T>
    compile_time run_time T distance_squared(vec2<T> a, vec2<T> b) { return length_squared(a - b); }

    template<type T>
    compile_time run_time T distance_squared(vec3<T> a, vec3<T> b) { return length_squared(a - b); }

    template<type T>
    compile_time run_time T distance_squared(vec4<T> a, vec4<T> b) { return length_squared(a - b); }

    template<type T>
    compile_time run_time vec2<T> normalize(vec2<T> v) { return v * (scalar_one<T>() / dot(v, v).sqrt()); }

    template<type T>
    compile_time run_time vec3<T> normalize(vec3<T> v) { return v * (scalar_one<T>() / dot(v, v).sqrt()); }

    template<type T>
    compile_time run_time vec4<T> normalize(vec4<T> v) { return v * (scalar_one<T>() / dot(v, v).sqrt()); }

    template<type T>
    compile_time run_time vec2<T> normalize_or_zero(vec2<T> v) {
        T n = dot(v, v);
        T zero = default;
        if (n == zero) { return v; }
        return v * (scalar_one<T>() / n.sqrt());
    }

    template<type T>
    compile_time run_time vec3<T> normalize_or_zero(vec3<T> v) {
        T n = dot(v, v);
        T zero = default;
        if (n == zero) { return v; }
        return v * (scalar_one<T>() / n.sqrt());
    }

    template<type T>
    compile_time run_time vec4<T> normalize_or_zero(vec4<T> v) {
        T n = dot(v, v);
        T zero = default;
        if (n == zero) { return v; }
        return v * (scalar_one<T>() / n.sqrt());
    }

    template<type T>
    compile_time run_time vec2<T> reflect(vec2<T> v, vec2<T> n) { return v - n * (dot(n, v) * 2.0); }

    template<type T>
    compile_time run_time vec3<T> reflect(vec3<T> v, vec3<T> n) { return v - n * (dot(n, v) * 2.0); }

    template<type T>
    compile_time run_time vec2<T> refract(vec2<T> v, vec2<T> n, T eta) {
        T d = dot(n, v);
        T k = 1.0 - eta * eta * (1.0 - d * d);
        if (k < 0.0) { return vec2<T>{}; }
        return v * eta - n * (eta * d + k.sqrt());
    }

    template<type T>
    compile_time run_time vec3<T> refract(vec3<T> v, vec3<T> n, T eta) {
        T d = dot(n, v);
        T k = 1.0 - eta * eta * (1.0 - d * d);
        if (k < 0.0) { return vec3<T>{}; }
        return v * eta - n * (eta * d + k.sqrt());
    }

    template<type T>
    compile_time run_time vec2<T> face_forward(vec2<T> n, vec2<T> v) {
        T zero = default;
        if (dot(n, v) > zero) { return -n; }
        return n;
    }

    template<type T>
    compile_time run_time vec3<T> face_forward(vec3<T> n, vec3<T> v) {
        T zero = default;
        if (dot(n, v) > zero) { return -n; }
        return n;
    }

    template<type T>
    compile_time run_time vec2<T> project(vec2<T> v, vec2<T> onto) { return onto * (dot(v, onto) / dot(onto, onto)); }

    template<type T>
    compile_time run_time vec3<T> project(vec3<T> v, vec3<T> onto) { return onto * (dot(v, onto) / dot(onto, onto)); }

    template<type T>
    compile_time run_time vec2<T> reject(vec2<T> v, vec2<T> from) { return v - from * (dot(v, from) / dot(from, from)); }

    template<type T>
    compile_time run_time vec3<T> reject(vec3<T> v, vec3<T> from) { return v - from * (dot(v, from) / dot(from, from)); }

    template<type T>
    compile_time run_time radians angle(vec2<T> a, vec2<T> b) {
        T c = dot(a, b) / (dot(a, a) * dot(b, b)).sqrt();
        return cast<radians>(scalar_cast<f32, T>(clamp(c, -1.0, 1.0).acos()));
    }

    template<type T>
    compile_time run_time radians angle(vec3<T> a, vec3<T> b) {
        T c = dot(a, b) / (dot(a, a) * dot(b, b)).sqrt();
        return cast<radians>(scalar_cast<f32, T>(clamp(c, -1.0, 1.0).acos()));
    }

    template<type T>
    compile_time run_time vec2<T> perpendicular(vec2<T> v) { return vec2<T>{ .x = -v.y, .y = v.x }; }

    template<type T>
    compile_time run_time vec2<T> rotate(vec2<T> v, radians a) {
        T s = scalar_cast<T, f32>(sin(a));
        T c = scalar_cast<T, f32>(cos(a));
        return vec2<T>{ .x = v.x * c - v.y * s, .y = v.x * s + v.y * c };
    }

    template<type T>
    compile_time run_time vec2<T> abs(vec2<T> v) { return vec2<T>{ .x = abs(v.x), .y = abs(v.y) }; }

    template<type T>
    compile_time run_time vec3<T> abs(vec3<T> v) { return vec3<T>{ .x = abs(v.x), .y = abs(v.y), .z = abs(v.z) }; }

    template<type T>
    compile_time run_time vec4<T> abs(vec4<T> v) { return vec4<T>{ .x = abs(v.x), .y = abs(v.y), .z = abs(v.z), .w = abs(v.w) }; }

    template<type T>
    compile_time run_time vec2<T> sign(vec2<T> v) { return vec2<T>{ .x = sign(v.x), .y = sign(v.y) }; }

    template<type T>
    compile_time run_time vec3<T> sign(vec3<T> v) { return vec3<T>{ .x = sign(v.x), .y = sign(v.y), .z = sign(v.z) }; }

