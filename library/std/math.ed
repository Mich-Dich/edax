    compile_time run_time vec2<bool> greater_than_equal(vec2<T> a, vec2<T> b) { return vec2<bool>{ .x = a.x >= b.x, .y = a.y >= b.y }; }

    template<type T>
    compile_time run_time vec3<bool> greater_than_equal(vec3<T> a, vec3<T> b) { return vec3<bool>{ .x = a.x >= b.x, .y = a.y >= b.y, .z = a.z >= b.z }; }

