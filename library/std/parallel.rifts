// The Rift standard library: module std::parallel.
import std;

namespace std::parallel {
    // Below this many elements the work runs on the calling thread alone.
    private compile_time usize small = 4096;

    private usize chunk_for(std::thread_pool& pool, usize n) {
        usize parts = pool.thread_count() * 4;
        usize size  = (n + parts - 1) / parts;
        return if (size < 1024) { 1024 } else { size };
    }

    // The elements of a span, reached from several threads: each thread uses only its own range.
    private template<type T>
    struct shared_elements : unsafe std::sendable, unsafe std::shareable {
        std::raw_ptr<mut T> data;
    }

    private template<type T>
    shared_elements<T> elements_of(std::span<mut T>& items) {
        return shared_elements<T>{ .data = mut &items[0] };
    }

    // The chunks are sorted in parallel, then the whole span once more: that last pass meets
    // long sorted runs (and for sort_by_key it is the stable merge sort).
    template<type T>
    void sort(std::thread_pool& pool, std::span<mut T> items) {
        usize n = items.len();
        if (n >= small) {
            shared_elements<T> e = elements_of(items);
            pool.for_index_chunks(n, chunk_for(pool, n), [e](usize from, usize to) {
                unsafe { std::span_mut<T>::from_raw(e.data.offset(from), to - from).sort(); }
            });
        }
        items.sort();
    }

    template<type T, type F : std::shareable>
    void sort_by(std::thread_pool& pool, std::span<mut T> items, F less) {
        usize n = items.len();
        if (n >= small) {
            shared_elements<T> e = elements_of(items);
            pool.for_index_chunks(n, chunk_for(pool, n), [e, &less](usize from, usize to) {
                unsafe { std::span_mut<T>::from_raw(e.data.offset(from), to - from).sort_by(less); }
            });
        }
        items.sort_by(less);
    }

    template<type T, type F : std::shareable>
    void sort_by_key(std::thread_pool& pool, std::span<mut T> items, std::sort_order order, F key) {
        usize n = items.len();
        if (n >= small) {
            shared_elements<T> e = elements_of(items);
            pool.for_index_chunks(n, chunk_for(pool, n), [e, &key, order](usize from, usize to) {
                unsafe { std::span_mut<T>::from_raw(e.data.offset(from), to - from).sort_by_key(order, key); }
            });
        }
        items.sort_by_key(order, key);
    }

    template<type T, type F : std::shareable>
    std::option<usize> find(std::thread_pool& pool, std::span<T> items, F predicate) {
        if (items.len() < small) {
            for (usize i : 0..items.len()) {
                if (predicate(items[i])) { return std::some(i); }
            }
            return std::none;
        }
        std::atomic<u64> best = std::atomic<u64>::make(u64::max);
        pool.for_index_chunks(items.len(), chunk_for(pool, items.len()), [&items, &predicate, &best](usize from, usize to) {
            for (usize i : from..to) {
                if (cast<u64>(i) >= best.load(std::memory_order::relaxed)) { return; }
                if (predicate(items[i])) {
                    mut u64 seen = best.load(std::memory_order::relaxed);
                    while (cast<u64>(i) < seen) {
                        match (best.compare_exchange_weak(seen, cast<u64>(i), std::memory_order::relaxed, std::memory_order::relaxed)) {
                            std::ok(_) => { return; },
                            std::error(now) => { seen = now; },
                        }
                    }
                    return;
                }
            }
        });
        u64 found = best.load(std::memory_order::sequentially_consistent);
        if (found == u64::max) { return std::none; }
        return std::some(cast::truncate<usize>(found));
    }

    template<type T, type F : std::shareable>
    bool any(std::thread_pool& pool, std::span<T> items, F predicate) {
        return std::parallel::find(pool, items, predicate).is_some();
    }

    template<type T, type F : std::shareable>
    bool all(std::thread_pool& pool, std::span<T> items, F predicate) {
        return std::parallel::find(pool, items, [&predicate](T& x) { return !predicate(x); }).is_none();
    }

    template<type T, type U, type F : std::shareable>
    void transform(std::thread_pool& pool, std::span<T> input, std::span<mut U> output, F f) {
        run_time check (input.len() == output.len()) else "std::parallel::transform: the spans' lengths differ";
        usize n = input.len();
        if (n == 0) { return; }
        shared_elements<U> out = elements_of(output);
        usize chunk = if (n < small) { n } else { chunk_for(pool, n) };
        pool.for_index_chunks(n, chunk, [&input, &f, out](usize from, usize to) {
            for (usize i : from..to) {
                unsafe { *out.data.offset(i) = f(input[i]); }
            }
        });
    }
}
