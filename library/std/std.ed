// The Edax standard library: bodies of the functions and methods declared in std.edh.
//
// This file is compiled into edaxc together with std.edh (spec 09: a module is a header and a
// source). It is written in Edax; the `std::raw` intrinsics are its only access to memory.

namespace std {
    template<type F, type R>
    compile_time bool returns() {
        compile_time type got = std::meta::result_of<F>();
        return std::is_same<got, R>();
    }

    // Whether `a[i]` and the other index checks are compiled in: the mode's `bounds()` (spec 24).
    private compile_time bool checks_bounds() {
        return std::build::current_mode().bounds() == std::build::bounds::panic;
    }

    // --- versions --------------------------------------------------------------------------------

    struct version {
        bool operator==(version& other) = default;

        compile_time run_time std::ordering operator<=>(version& other) {
            if (this.major != other.major) { return this.major <=> other.major; }
            if (this.minor != other.minor) { return this.minor <=> other.minor; }
            return this.patch <=> other.patch;
        }

        compile_time run_time bool at_least(version other) {
            if (this.major != other.major) { return this.major > other.major; }
            if (this.minor != other.minor) { return this.minor > other.minor; }
            return this.patch >= other.patch;
        }

        void format(mut std::formatter& out) {
            out.write(std::format(f"{this.major}.{this.minor}.{this.patch}"));
        }
    }

    // --- allocators ------------------------------------------------------------------------------

    // `n` values of T from `a`; panics when it is out of memory.
    private unsafe template<type T, type A>
    std::raw_ptr<mut T> allocate_in(mut A& a, usize n) {
        mut usize bytes = n * std::size_of<T>();
        if (bytes == 0) { bytes = 1; }
        std::raw_ptr<mut u8> p = a.allocate(bytes, std::align_of<T>());
        run_time check (p != nullptr) else "out of memory";
        return cast::reinterpret<std::raw_ptr<mut T>>(p);
    }

    // The `old` values at `p` moved to room for `n`.
    private unsafe template<type T, type A>
    std::raw_ptr<mut T> reallocate_in(mut A& a, std::raw_ptr<mut T> p, usize old, usize n) {
        mut usize old_bytes = old * std::size_of<T>();
        if (old_bytes == 0) { old_bytes = 1; }
        mut usize bytes = n * std::size_of<T>();
        if (bytes == 0) { bytes = 1; }
        std::raw_ptr<mut u8> q = a.reallocate(cast::reinterpret<std::raw_ptr<mut u8>>(p), old_bytes, bytes, std::align_of<T>());
        run_time check (q != nullptr) else "out of memory";
        return cast::reinterpret<std::raw_ptr<mut T>>(q);
    }

    private unsafe template<type T, type A>
    void free_in(mut A& a, std::raw_ptr<mut T> p, usize n) {
        mut usize bytes = n * std::size_of<T>();
        if (bytes == 0) { bytes = 1; }
        a.free(cast::reinterpret<std::raw_ptr<mut u8>>(p), bytes, std::align_of<T>());
    }

    interface allocator {
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut {
            std::raw_ptr<mut u8> fresh = this.allocate(new_size, alignment);
            if (!fresh) { return nullptr; }
            std::raw::copy(fresh, block, if (old_size < new_size) { old_size } else { new_size });
            this.free(block, old_size, alignment);
            return fresh;
        }
    }

    // The global allocator build.ed chose (`g.set_global_allocator`), or `void` for the C
    // library's heap.
    private compile_time type chosen_heap = std::build::global_allocator_type();

    private compile_time bool custom_heap() { return !std::is_same<chosen_heap, void>(); }

    struct global_allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override {
            if compile_time (custom_heap()) {
                mut chosen_heap h = default;
                return h.allocate(size, alignment);
            } else {
                unsafe { return std::raw::allocate<u8>(size); }
            }
        }

        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override {
            if compile_time (custom_heap()) {
                mut chosen_heap h = default;
                h.free(block, size, alignment);
            } else {
                std::raw::free(block);
            }
        }

        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override {
            if compile_time (custom_heap()) {
                mut chosen_heap h = default;
                return h.reallocate(block, old_size, new_size, alignment);
            } else {
                return std::raw::reallocate(block, new_size);
            }
        }
    }

    // The blocks of std::raw::allocate when build.ed chose a global allocator: they carry their
    // size in a 16-byte header, so the allocator gets the sizes its interface promises. edaxc
    // calls these three instead of the C library then.

    private std::raw_ptr<mut u8> raw_heap_allocate(usize bytes) {
        if compile_time (custom_heap()) {
            mut chosen_heap h = default;
            std::raw_ptr<mut u8> p = h.allocate(bytes + 16, 16);
            run_time check (p != nullptr) else "out of memory";
            unsafe {
                std::raw::write(cast::reinterpret<std::raw_ptr<mut usize>>(p), bytes);
                return p.offset(16);
            }
        } else {
            unsafe { return std::raw::allocate<u8>(bytes); }
        }
    }

    private std::raw_ptr<mut u8> raw_heap_reallocate(std::raw_ptr<mut u8> block, usize bytes) {
        if (!block) { return raw_heap_allocate(bytes); }
        if compile_time (custom_heap()) {
            mut chosen_heap h = default;
            unsafe {
                std::raw_ptr<mut u8> p = cast::reinterpret<std::raw_ptr<mut u8>>(cast::reinterpret<usize>(block) - 16);
                usize old = std::raw::read(cast::reinterpret<std::raw_ptr<mut usize>>(p));
                std::raw_ptr<mut u8> q = h.reallocate(p, old + 16, bytes + 16, 16);
                run_time check (q != nullptr) else "out of memory";
                std::raw::write(cast::reinterpret<std::raw_ptr<mut usize>>(q), bytes);
                return q.offset(16);
            }
        } else {
            unsafe { return std::raw::reallocate(block, bytes); }
        }
    }

    private void raw_heap_free(std::raw_ptr<mut u8> block) {
        if (!block) { return; }
        if compile_time (custom_heap()) {
            mut chosen_heap h = default;
            unsafe {
                std::raw_ptr<mut u8> p = cast::reinterpret<std::raw_ptr<mut u8>>(cast::reinterpret<usize>(block) - 16);
                usize old = std::raw::read(cast::reinterpret<std::raw_ptr<mut usize>>(p));
                h.free(p, old + 16, 16);
            }
        } else {
            unsafe { std::raw::free(block); }
        }
    }

    private struct arena_block {
        std::raw_ptr<mut u8> base = nullptr;
        usize size = 0;
        usize used = 0;
    }

    class arena {
    public:
        static arena make(usize size) {
            unsafe {
                std::raw_ptr<mut arena_block> block = std::raw::allocate<arena_block>(1);
                std::raw::write(block, arena_block{ .base = std::raw::allocate<u8>(size), .size = size });
                return arena{ .block = block };
            }
        }

        arena_allocator allocator() { return arena_allocator{ .source = this }; }

        usize used() {
            unsafe { return (*this.block).used; }
        }

        usize capacity() {
            unsafe { return (*this.block).size; }
        }

        void reset() mut {
            unsafe { (*this.block).used = 0; }
        }

        ~arena() {
            unsafe {
                std::raw::free((*this.block).base);
                std::raw::free(this.block);
            }
        }

    private:
        std::raw_ptr<mut arena_block> block;

        // The next `size` bytes aligned to `alignment`, or nullptr when the arena is full.
        std::raw_ptr<mut u8> take(usize size, usize alignment) {
            unsafe {
                std::raw_ptr<mut arena_block> b = this.block;
                usize address = cast::reinterpret<usize>((*b).base) + (*b).used;
                usize padding = (alignment - address % alignment) % alignment;
                if ((*b).used + padding + size > (*b).size) { return nullptr; }
                std::raw_ptr<mut u8> p = (*b).base.offset((*b).used + padding);
                (*b).used += padding + size;
                return p;
            }
        }
    }

    struct arena_allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override { return this.source.take(size, alignment); }

        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override { }

        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override {
            if (new_size <= old_size) { return block; }
            std::raw_ptr<mut u8> fresh = this.source.take(new_size, alignment);
            if (!fresh) { return nullptr; }
            std::raw::copy(fresh, block, old_size);
            return fresh;
        }
    }

    private static std::atomic<bool> heap_sealed = default;

    void seal_heap() { heap_sealed.store(true, std::memory_order::release); }

    bool is_heap_sealed() { return heap_sealed.load(std::memory_order::acquire); }

    struct sealable_allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override {
            run_time check (!is_heap_sealed()) else "allocation after std::seal_heap()";
            unsafe { return malloc(size); }
        }

        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override { std::free(block); }

        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override {
            run_time check (!is_heap_sealed()) else "allocation after std::seal_heap()";
            return realloc(block, new_size);
        }
    }

    struct no_allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override {
            std::panic(f"std::no_allocator: an allocation of {size} bytes in a program that must not use the heap");
        }

        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override { }

        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override {
            std::panic(f"std::no_allocator: an allocation of {new_size} bytes in a program that must not use the heap");
        }
    }

    template<type T, type A>
    class darray {
    public:
        static darray<T, A> with_capacity(usize n) {
            mut darray<T, A> out = default;
            out.reserve(n);
            return out;
        }

        static darray<T, A> with_allocator(A alloc) { return darray<T, A>{ .alloc = alloc }; }

        static darray<T, A> with_capacity_in(usize n, A alloc) {
            mut darray<T, A> out = darray<T, A>{ .alloc = alloc };
            out.reserve(n);
            return out;
        }

        static darray<T, A> from(span<T> items) {
            mut darray<T, A> out = default;
            out.reserve(items.len());
            for (T& item : items) {
                out.push(item.clone());
            }
            return out;
        }

        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        void push(T value) mut {
            if (this.count == this.room) { this.grow(); }
            unsafe { std::raw::write(this.data.offset(this.count), move value); }
            this.count += 1;
        }

        std::option<T> pop() mut {
            if (this.count == 0) { return std::none; }
            this.count -= 1;
            unsafe { return std::some(std::raw::read(this.data.offset(this.count))); }
        }

        void clear() mut {
            while (this.count > 0) {
                this.count -= 1;
                unsafe { std::raw::drop(this.data.offset(this.count)); }
            }
        }

        darray<T, A> clone() {
            mut darray<T, A> out = darray<T, A>{ .alloc = this.alloc };
            if (this.count > 0) {
                unsafe { out.data = allocate_in<T, A>(mut out.alloc, this.count); }
                out.room = this.count;
                while (out.count < this.count) {
                    unsafe { std::raw::write(out.data.offset(out.count), (*this.data.offset(out.count)).clone()); }
                    out.count += 1;
                }
            }
            return out;
        }

        template<type F>
        void retain(mut F keep) mut {
            mut usize kept = 0;
            mut usize i = 0;
            while (i < this.count) {
                unsafe {
                    std::raw_ptr<mut T> item = this.data.offset(i);
                    if (keep(*item)) {
                        if (kept != i) { std::raw::write(this.data.offset(kept), std::raw::read(item)); }
                        kept += 1;
                    } else {
                        std::raw::drop(item);
                    }
                }
                i += 1;
            }
            this.count = kept;
        }

        template<type F>
        void sort_by_key(std::sort_order order, F key) mut {
            compile_time type K = std::meta::result_of<F>();
            if compile_time (radix_key<K>()) {   // integer keys: a stable radix sort (spec 34)
                if (this.count >= radix_threshold) {
                    u64 flip = if (order == std::sort_order::ascending) { 0 } else { radix_mask<K>() };
                    unsafe { radix_sort(this.data, this.count, [&key, flip](T& a) { return radix_bits<K>(key(a)) ^ flip; }, std::size_of<K>()); }
                    return;
                }
            }
            if (order == std::sort_order::ascending) {
                unsafe { merge_sort(this.data, this.count, [&key](T& a, T& b) { return key(a) < key(b); }); }
            } else {
                unsafe { merge_sort(this.data, this.count, [&key](T& a, T& b) { return key(b) < key(a); }); }
            }
        }

        void sort() mut {
            if compile_time (radix_key<T>()) {   // integers: a radix sort (spec 34)
                if (this.count >= radix_threshold) {
                    unsafe { radix_sort(this.data, this.count, [](T& a) { return radix_bits<T>(a); }, std::size_of<T>()); }
                    return;
                }
            }
            unsafe { intro_sort(this.data, this.count, [](T& a, T& b) { return a < b; }); }
        }

        template<type F>
        void sort_by(F less) mut {
            compile_time check (std::returns<F, bool>())
                else "sort_by takes less(a, b) returning bool; a three-way comparison is `(a <=> b) == std::ordering::less`";
            if compile_time (std::returns<F, bool>()) {
                unsafe { intro_sort(this.data, this.count, less); }
            }
        }

        void reserve(usize n) mut {
            if (n <= this.room) { return; }
            unsafe {
                if (this.room == 0) {
                    this.data = allocate_in<T, A>(mut this.alloc, n);
                } else {
                    std::raw_ptr<mut T> old = this.data;
                    usize spare = this.room;
                    this.data = reallocate_in<T, A>(mut this.alloc, old, spare, n);
                }
            }
            this.room = n;
        }

        usize capacity() { return this.room; }

        void truncate(usize n) mut {
            while (this.count > n) {
                this.count -= 1;
                unsafe { std::raw::drop(this.data.offset(this.count)); }
            }
        }

        void shrink_to_fit() mut {
            if (this.room == this.count) { return; }
            unsafe {
                if (this.count == 0) {
                    std::raw_ptr<mut T> old = this.data;
                    usize spare = this.room;
                    free_in<T, A>(mut this.alloc, old, spare);
                    this.data = nullptr;
                } else {
                    std::raw_ptr<mut T> old = this.data;
                    usize spare = this.room;
                    usize filled = this.count;
                    this.data = reallocate_in<T, A>(mut this.alloc, old, spare, filled);
                }
            }
            this.room = this.count;
        }

        void resize(usize n, T value) mut {
            if (n <= this.count) {
                this.truncate(n);
                return;
            }
            this.reserve(n);
            while (this.count + 1 < n) {
                unsafe { std::raw::write(this.data.offset(this.count), value.clone()); }
                this.count += 1;
            }
            unsafe { std::raw::write(this.data.offset(this.count), move value); }
            this.count += 1;
        }

        T swap_remove(usize i) mut {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"swap_remove position {i} out of bounds (length {this.count})"; }
            this.count -= 1;
            unsafe {
                T out = std::raw::read(this.data.offset(i));
                if (i != this.count) { std::raw::write(this.data.offset(i), std::raw::read(this.data.offset(this.count))); }
                return out;
            }
        }

        bool contains(T& value) {
            mut usize i = 0;
            while (i < this.count) {
                unsafe {
                    if (*this.data.offset(i) == value) { return true; }
                }
                i += 1;
            }
            return false;
        }

        T& operator[](usize i) {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"index {i} out of bounds (length {this.count})"; }
            unsafe { return *this.data.offset(i); }
        }

        mut T& operator[](usize i) mut {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"index {i} out of bounds (length {this.count})"; }
            unsafe { return *this.data.offset(i); }
        }

        span<T> as_span() {
            unsafe { return span<T>::from_raw(this.data, this.count); }
        }

        span<mut T> as_mut_span() mut {
            unsafe { return span_mut<T>::from_raw(this.data, this.count); }
        }

        std::option<T&> get(usize i) {
            if (i >= this.count) { return std::none; }
            unsafe { return std::some(*this.data.offset(i)); }
        }

        void insert(usize i, T value) mut {
            if compile_time (checks_bounds()) { run_time check (i <= this.count) else f"insert position {i} out of bounds (length {this.count})"; }
            this.push(move value);   // makes room; the new value is moved into place below
            unsafe {
                T last = std::raw::read(this.data.offset(this.count - 1));
                std::raw::copy(this.data.offset(i + 1), this.data.offset(i), this.count - 1 - i);
                std::raw::write(this.data.offset(i), move last);
            }
        }

        T remove(usize i) mut {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"remove position {i} out of bounds (length {this.count})"; }
            unsafe {
                T out = std::raw::read(this.data.offset(i));
                std::raw::copy(this.data.offset(i), this.data.offset(i + 1), this.count - 1 - i);
                this.count -= 1;
                return out;
            }
        }

        ~darray() {
            this.clear();
            unsafe {
                std::raw_ptr<mut T> old = this.data;
                usize spare = this.room;
                if (old) { free_in<T, A>(mut this.alloc, old, spare); }
            }
        }

    private:
        std::raw_ptr<mut T> data = nullptr;
        usize count = 0;
        usize room = 0;
        A alloc = default;

        // Doubles the room (the slow path of push, kept out of line).
        void grow() mut {
            mut usize next = 4;
            if (this.room > 0) { next = this.room * 2; }
            this.reserve(next);
        }
    }

    // --- sorting (spec 20) ---------------------------------------------------------------------------
    // The algorithms work on raw memory: elements are moved bit by bit (std::raw::read/write), which is
    // what a move is in Edax. `less` is any callable taking two references.

    // Sorts `p[from..to)` by insertion: fast for short runs.
    private unsafe template<type T, type F>
    void insertion_sort(std::raw_ptr<mut T> p, usize from, usize to, F& less) {
        mut usize i = from + 1;
        while (i < to) {
            if (less(*p.offset(i), *p.offset(i - 1))) {
                T moving = std::raw::read(p.offset(i));
                mut usize j = i;
                while (j > from && less(moving, *p.offset(j - 1))) {
                    std::raw::write(p.offset(j), std::raw::read(p.offset(j - 1)));
                    j -= 1;
                }
                std::raw::write(p.offset(j), move moving);
            }
            i += 1;
        }
    }

    private unsafe template<type T>
    void swap_at(std::raw_ptr<mut T> p, usize i, usize j) {
        T a = std::raw::read(p.offset(i));
        std::raw::write(p.offset(i), std::raw::read(p.offset(j)));
        std::raw::write(p.offset(j), move a);
    }

    // Restores the heap property below `root` in the max-heap `p[0..n)`.
    private unsafe template<type T, type F>
    void sift_down(std::raw_ptr<mut T> p, usize root, usize n, F& less) {
        mut usize parent = root;
        while (true) {
            mut usize child = 2 * parent + 1;
            if (child >= n) { return; }
            if (child + 1 < n && less(*p.offset(child), *p.offset(child + 1))) { child += 1; }
            if (!less(*p.offset(parent), *p.offset(child))) { return; }
            swap_at(p, parent, child);
            parent = child;
        }
    }

    private unsafe template<type T, type F>
    void heap_sort(std::raw_ptr<mut T> p, usize n, F& less) {
        mut usize i = n / 2;
        while (i > 0) {
            i -= 1;
            sift_down(p, i, n, less);
        }
        mut usize end = n;
        while (end > 1) {
            end -= 1;
            swap_at(p, 0, end);
            sift_down(p, 0, end, less);
        }
    }

    // Quicksort on `p[0..n)` with a median-of-three pivot; small runs are left for one final
    // insertion sort, and a run that recurses too deep is heap sorted (O(n log n) worst case).
    private unsafe template<type T, type F>
    void quick_sort(std::raw_ptr<mut T> p, usize n, u32 depth, F& less) {
        mut std::raw_ptr<mut T> base = p;
        mut usize len = n;
        mut u32 budget = depth;
        while (len > 24) {
            if (budget == 0) {
                heap_sort(base, len, less);
                return;
            }
            budget -= 1;
            // Median of three, moved to the front as the pivot.
            usize mid = len / 2;
            if (less(*base.offset(mid), *base.offset(0))) { swap_at(base, mid, 0); }
            if (less(*base.offset(len - 1), *base.offset(0))) { swap_at(base, len - 1, 0); }
            if (less(*base.offset(len - 1), *base.offset(mid))) { swap_at(base, len - 1, mid); }
            swap_at(base, 0, mid);
            // Hoare partition around base[0].
            mut usize i = 0;
            mut usize j = len;
            while (true) {
                i += 1;
                while (less(*base.offset(i), *base.offset(0))) { i += 1; }
                j -= 1;
                while (less(*base.offset(0), *base.offset(j))) { j -= 1; }
                if (i >= j) { break; }
                swap_at(base, i, j);
            }
            swap_at(base, 0, j);
            // Recurse into the smaller side, loop on the larger: O(log n) stack.
            usize left = j;
            usize right = len - j - 1;
            if (left < right) {
                quick_sort(base, left, budget, less);
                base = base.offset(j + 1);
                len = right;
            } else {
                quick_sort(base.offset(j + 1), right, budget, less);
                len = left;
            }
        }
    }

    private unsafe template<type T, type F>
    void intro_sort(std::raw_ptr<mut T> p, usize n, F less) {
        if (n < 2) { return; }
        mut u32 depth = 0;
        mut usize m = n;
        while (m > 0) {
            depth += 2;
            m >>= 1;
        }
        quick_sort(p, n, depth, less);
        insertion_sort(p, 0, n, less);
    }

    // --- radix sort (spec 34) -----------------------------------------------------------------------
    // Integers and integer keys are sorted by their bytes, lowest first: a counting pass for all
    // bytes, then one stable scatter per byte that differs between the elements. O(n) per byte,
    // no comparisons; it needs a buffer of n elements. Below `radix_threshold` elements the
    // comparison sorts are faster.

    private compile_time usize radix_threshold = 256;

    // Whether K is an integer type of at most 64 bits.
    private template<type K>
    compile_time bool radix_key() {
        return std::is_same<K, u8>() || std::is_same<K, u16>() || std::is_same<K, u32>() || std::is_same<K, u64>() ||
               std::is_same<K, usize>() || std::is_same<K, i8>() || std::is_same<K, i16>() || std::is_same<K, i32>() ||
               std::is_same<K, i64>() || std::is_same<K, isize>();
    }

    private template<type K>
    compile_time bool radix_signed() {
        return std::is_same<K, i8>() || std::is_same<K, i16>() || std::is_same<K, i32>() || std::is_same<K, i64>() ||
               std::is_same<K, isize>();
    }

    // The bits of a K: all ones in its size.
    private template<type K>
    u64 radix_mask() {
        if compile_time (std::size_of<K>() == 8) { return 0xFFFFFFFFFFFFFFFFu64; }
        return (1u64 << cast<u64>(8 * std::size_of<K>())) - 1;
    }

    // `k` as unsigned bits that order like `k`: a signed value has its sign bit flipped.
    private template<type K>
    u64 radix_bits(K k) {
        u64 bits = cast::truncate<u64>(k) & radix_mask<K>();
        if compile_time (radix_signed<K>()) {
            return bits ^ (1u64 << cast<u64>(8 * std::size_of<K>() - 1));
        }
        return bits;
    }

    private unsafe template<type T, type F>
    void radix_sort(std::raw_ptr<mut T> p, usize n, F bits, usize bytes) {
        std::raw_ptr<mut usize> counts = std::raw::allocate<usize>(bytes * 256);
        for (usize i : 0..bytes * 256) { std::raw::write(counts.offset(i), 0); }
        for (usize i : 0..n) {
            mut u64 b = bits(*p.offset(i));
            for (usize d : 0..bytes) {
                usize at = d * 256 + cast::truncate<usize>(b & 255);
                std::raw::write(counts.offset(at), *counts.offset(at) + 1);
                b >>= 8;
            }
        }
        std::raw_ptr<mut T> buffer = std::raw::allocate<T>(n);
        mut std::raw_ptr<mut T> from = p;
        mut std::raw_ptr<mut T> to = buffer;
        u64 first = bits(*p.offset(0));
        for (usize d : 0..bytes) {
            std::raw_ptr<mut usize> c = counts.offset(d * 256);
            u64 shift = cast<u64>(8 * d);
            // All elements share this byte: nothing to do.
            if (*c.offset(cast::truncate<usize>((first >> shift) & 255)) == n) { continue; }
            mut usize sum = 0;
            for (usize v : 0..256) {
                usize k = *c.offset(v);
                std::raw::write(c.offset(v), sum);
                sum += k;
            }
            for (usize i : 0..n) {
                usize v = cast::truncate<usize>((bits(*from.offset(i)) >> shift) & 255);
                usize at = *c.offset(v);
                std::raw::write(c.offset(v), at + 1);
                std::raw::write(to.offset(at), std::raw::read(from.offset(i)));
            }
            std::raw_ptr<mut T> swap = from;
            from = to;
            to = swap;
        }
        if (from != p) { std::raw::copy(p, from, n); }
        std::raw::free(buffer);
        std::raw::free(counts);
    }

    // Merges the sorted runs `from[lo..mid)` and `from[mid..hi)` into `to[lo..hi)`; on equal
    // elements the left run goes first (stable).
    private unsafe template<type T, type F>
    void merge_runs(std::raw_ptr<mut T> from, std::raw_ptr<mut T> to, usize lo, usize mid, usize hi, F& less) {
        mut usize i = lo;
        mut usize j = mid;
        mut usize k = lo;
        while (i < mid && j < hi) {
            if (less(*from.offset(j), *from.offset(i))) {
                std::raw::write(to.offset(k), std::raw::read(from.offset(j)));
                j += 1;
            } else {
                std::raw::write(to.offset(k), std::raw::read(from.offset(i)));
                i += 1;
            }
            k += 1;
        }
        if (i < mid) { std::raw::copy(to.offset(k), from.offset(i), mid - i); }
        if (j < hi) { std::raw::copy(to.offset(k + (mid - i)), from.offset(j), hi - j); }
    }

    // A stable bottom-up merge sort: insertion-sorted runs of 16, then merges between `p` and a
    // buffer of n elements.
    private unsafe template<type T, type F>
    void merge_sort(std::raw_ptr<mut T> p, usize n, F less) {
        if (n < 2) { return; }
        usize run = 16;
        mut usize start = 0;
        while (start < n) {
            mut usize end = start + run;
            if (end > n) { end = n; }
            insertion_sort(p, start, end, less);
            start = end;
        }
        if (n <= run) { return; }
        std::raw_ptr<mut T> buffer = std::raw::allocate<T>(n);
        mut std::raw_ptr<mut T> from = p;
        mut std::raw_ptr<mut T> to = buffer;
        mut usize width = run;
        while (width < n) {
            mut usize lo = 0;
            while (lo < n) {
                mut usize mid = lo + width;
                if (mid > n) { mid = n; }
                mut usize hi = mid + width;
                if (hi > n) { hi = n; }
                merge_runs(from, to, lo, mid, hi, less);
                lo = hi;
            }
            std::raw_ptr<mut T> swap = from;
            from = to;
            to = swap;
            width *= 2;
        }
        if (from != p) { std::raw::copy(p, from, n); }
        std::raw::free(buffer);
    }

    template<type T>
    class span {
    public:
        static unsafe span<T> from_raw(std::raw_ptr<T> data, usize count) { return span<T>{ .data = data, .count = count }; }

        std::raw_ptr<T> as_ptr() { return this.data; }

        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        T& operator[](usize i) {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"index {i} out of bounds (length {this.count})"; }
            unsafe { return *this.data.offset(i); }
        }

        span<T> slice(usize from, usize to) {
            run_time check (from <= to && to <= this.count) else f"span slice {from}..{to} out of bounds (length {this.count})";
            unsafe { return span<T>{ .data = this.data.offset(from), .count = to - from }; }
        }

        (span<T>, span<T>) split_at(usize i) move {
            run_time check (i <= this.count) else f"span split_at {i} out of bounds (length {this.count})";
            unsafe {
                return (span<T>{ .data = this.data, .count = i },
                        span<T>{ .data = this.data.offset(i), .count = this.count - i });
            }
        }

        span_chunks<T> chunks(usize n) {
            run_time check (n > 0) else "chunks of 0 elements";
            return span_chunks<T>{ .data = this.data, .left = this.count, .size = n };
        }

    private:
        std::raw_ptr<T> data;
        usize count;
    }

    template<type T>
    view class span_mut {
    public:
        static unsafe span_mut<T> from_raw(std::raw_ptr<mut T> data, usize count) { return span_mut<T>{ .data = data, .count = count }; }

        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        mut T& operator[](usize i) {
            if compile_time (checks_bounds()) { run_time check (i < this.count) else f"index {i} out of bounds (length {this.count})"; }
            unsafe { return *this.data.offset(i); }
        }

        span<T> as_span() {
            unsafe { return span<T>::from_raw(this.data, this.count); }
        }

        span_mut<T> slice(usize from, usize to) move {
            run_time check (from <= to && to <= this.count) else f"span slice {from}..{to} out of bounds (length {this.count})";
            unsafe { return span_mut<T>{ .data = this.data.offset(from), .count = to - from }; }
        }

        void sort() {
            if compile_time (radix_key<T>()) {
                if (this.count >= radix_threshold) {
                    unsafe { radix_sort(this.data, this.count, [](T& a) { return radix_bits<T>(a); }, std::size_of<T>()); }
                    return;
                }
            }
            unsafe { intro_sort(this.data, this.count, [](T& a, T& b) { return a < b; }); }
        }

        template<type F>
        void sort_by(F less) {
            compile_time check (std::returns<F, bool>())
                else "sort_by takes less(a, b) returning bool; a three-way comparison is `(a <=> b) == std::ordering::less`";
            if compile_time (std::returns<F, bool>()) {
                unsafe { intro_sort(this.data, this.count, less); }
            }
        }

        template<type F>
        void sort_by_key(std::sort_order order, F key) {
            compile_time type K = std::meta::result_of<F>();
            if compile_time (radix_key<K>()) {
                if (this.count >= radix_threshold) {
                    u64 flip = if (order == std::sort_order::ascending) { 0 } else { radix_mask<K>() };
                    unsafe { radix_sort(this.data, this.count, [&key, flip](T& a) { return radix_bits<K>(key(a)) ^ flip; }, std::size_of<K>()); }
                    return;
                }
            }
            if (order == std::sort_order::ascending) {
                unsafe { merge_sort(this.data, this.count, [&key](T& a, T& b) { return key(a) < key(b); }); }
            } else {
                unsafe { merge_sort(this.data, this.count, [&key](T& a, T& b) { return key(b) < key(a); }); }
            }
        }

        (span_mut<T>, span_mut<T>) split_at(usize i) move {
            run_time check (i <= this.count) else f"span split_at {i} out of bounds (length {this.count})";
            unsafe {
                return (span_mut<T>{ .data = this.data, .count = i },
                        span_mut<T>{ .data = this.data.offset(i), .count = this.count - i });
            }
        }

        span_mut_chunks<T> chunks(usize n) move {
            run_time check (n > 0) else "chunks of 0 elements";
            return span_mut_chunks<T>{ .data = this.data, .left = this.count, .size = n };
        }

    private:
        std::raw_ptr<mut T> data;
        usize count;
    }

    template<type T>
    view class span_chunks {
    public:
        std::option<span<T>> next() mut {
            if (this.left == 0) { return std::none; }
            mut usize n = this.size;
            if (n > this.left) { n = this.left; }
            std::raw_ptr<T> at = this.data;
            unsafe { this.data = this.data.offset(n); }
            this.left -= n;
            unsafe { return std::some(span<T>::from_raw(at, n)); }
        }

    private:
        std::raw_ptr<T> data;
        usize left;
        usize size;
    }

    template<type T>
    view class span_mut_chunks {
    public:
        std::option<span_mut<T>> next() mut {
            if (this.left == 0) { return std::none; }
            mut usize n = this.size;
            if (n > this.left) { n = this.left; }
            std::raw_ptr<mut T> at = this.data;
            unsafe { this.data = this.data.offset(n); }
            this.left -= n;
            unsafe { return std::some(span_mut<T>::from_raw(at, n)); }
        }

    private:
        std::raw_ptr<mut T> data;
        usize left;
        usize size;
    }

    // --- string_with: text in an allocator's memory (allocators) ------------------------------------
    template<type A>
    class string_with {
    public:
        static string_with<A> with_allocator(A alloc) { return string_with<A>{ .alloc = alloc }; }

        static string_with<A> from_in(std::str text, A alloc) {
            mut string_with<A> out = string_with<A>{ .alloc = alloc };
            out.push_str(text);
            return out;
        }

        static string_with<A> from(std::str text) {
            mut string_with<A> out = default;
            out.push_str(text);
            return out;
        }

        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        std::str as_str() {
            if (this.count == 0) { return ""; }
            unsafe { return std::raw::str_from(this.data, this.count); }
        }

        void push_str(std::str text) mut {
            usize n = text.len();
            if (n == 0) { return; }
            this.reserve(this.count + n);
            unsafe { std::raw::copy(this.data.offset(this.count), text.as_ptr(), n); }
            this.count += n;
        }

        void push(char c) mut {
            mut std::string one = default;   // the UTF-8 bytes of `c` (inline: no allocation)
            one.push(c);
            this.push_str(one.as_str());
        }

        void clear() mut { this.count = 0; }

        void reserve(usize n) mut {
            if (n <= this.room) { return; }
            mut usize next = this.room * 2;
            if (next < 32) { next = 32; }
            if (next < n) { next = n; }
            unsafe {
                if (this.room == 0) {
                    this.data = allocate_in<u8, A>(mut this.alloc, next);
                } else {
                    this.data = reallocate_in<u8, A>(mut this.alloc, this.data, this.room, next);
                }
            }
            this.room = next;
        }

        usize capacity() { return this.room; }

        string_with<A> clone() { return string_with<A>::from_in(this.as_str(), this.alloc); }

        bool operator==(string_with<A>& other) { return this.as_str() == other.as_str(); }

        std::ordering operator<=>(string_with<A>& other) {
            std::str a = this.as_str();
            std::str b = other.as_str();
            mut usize n = a.len();
            if (b.len() < n) { n = b.len(); }
            mut i32 c = 0;
            if (n > 0) {
                unsafe { c = memcmp(a.as_ptr(), b.as_ptr(), n); }
            }
            if (c < 0) { return std::ordering::less; }
            if (c > 0) { return std::ordering::greater; }
            return a.len() <=> b.len();
        }

        ~string_with() {
            if (this.room > 0) {
                unsafe { free_in<u8, A>(mut this.alloc, this.data, this.room); }
            }
        }

    private:
        std::raw_ptr<mut u8> data = nullptr;
        usize count = 0;
        usize room = 0;
        A alloc = default;
    }

    // --- string: small-string optimization ---------------------------------------------------------
    // The 24 bytes of a string are three words. On the heap: [data, length, capacity | 1 << 63]. Inline
    // (up to 23 bytes): the text in bytes 0..23 and its length in byte 23. Byte 23 is the top byte of
    // the capacity word on a little-endian machine, so its high bit says which form it is; all zero is
    // the empty inline string, which is what `default` makes.

    private compile_time usize string_inline = 23;
    private compile_time u64 string_heap_bit = 0x8000000000000000u64;

    class string {
    public:
        static string with_capacity(usize n) {
            mut string out = default;
            if (n > string_inline) { out.grow_to(n); }
            return out;
        }

        static string from(std::str text) {
            mut string out = default;
            out.push_str(text);
            return out;
        }

        usize len() {
            if (this.on_heap()) { return cast::truncate<usize>(this.word(1)); }
            return cast<usize>(this.inline_len());
        }

        bool is_empty() { return this.len() == 0; }

        std::str as_str() {
            unsafe { return std::raw::str_from(this.bytes(), this.len()); }
        }

        void push_str(std::str text) mut {
            usize n = text.len();
            usize length = this.len();
            if (length + n > this.capacity()) { this.reserve(length + n); }
            unsafe { std::raw::copy(this.bytes_mut().offset(length), text.as_ptr(), n); }
            this.set_len(length + n);
        }

        void push(char c) mut {
            u32 code = cast<u32>(c);
            usize length = this.len();
            mut usize size = 4;
            if (code < 0x80) { size = 1; } else if (code < 0x800) { size = 2; } else if (code < 0x10000) { size = 3; }
            if (length + size > this.capacity()) { this.reserve(length + size); }
            unsafe {
                std::raw_ptr<mut u8> at = this.bytes_mut().offset(length);
                if (code < 0x80) {
                    std::raw::write(at, cast::truncate<u8>(code));
                    this.set_len(length + 1);
                } else if (code < 0x800) {
                    std::raw::write(at, cast::truncate<u8>(0xC0 | (code >> 6)));
                    std::raw::write(at.offset(1), cast::truncate<u8>(0x80 | (code & 0x3F)));
                    this.set_len(length + 2);
                } else if (code < 0x10000) {
                    std::raw::write(at, cast::truncate<u8>(0xE0 | (code >> 12)));
                    std::raw::write(at.offset(1), cast::truncate<u8>(0x80 | ((code >> 6) & 0x3F)));
                    std::raw::write(at.offset(2), cast::truncate<u8>(0x80 | (code & 0x3F)));
                    this.set_len(length + 3);
                } else {
                    std::raw::write(at, cast::truncate<u8>(0xF0 | (code >> 18)));
                    std::raw::write(at.offset(1), cast::truncate<u8>(0x80 | ((code >> 12) & 0x3F)));
                    std::raw::write(at.offset(2), cast::truncate<u8>(0x80 | ((code >> 6) & 0x3F)));
                    std::raw::write(at.offset(3), cast::truncate<u8>(0x80 | (code & 0x3F)));
                    this.set_len(length + 4);
                }
            }
        }

        void clear() mut { this.set_len(0); }

        void reserve(usize n) mut {
            usize cap = this.capacity();
            if (n <= cap) { return; }
            mut usize next = cap * 2;
            if (next < 32) { next = 32; }
            if (next < n) { next = n; }
            this.grow_to(next);
        }

        usize capacity() {
            if (this.on_heap()) { return cast::truncate<usize>(this.word(2) & ~string_heap_bit); }
            return string_inline;
        }

        string clone() { return string::from(this.as_str()); }

        bool operator==(string& other) { return this.as_str() == other.as_str(); }

        std::ordering operator<=>(string& other) {
            std::str a = this.as_str();
            std::str b = other.as_str();
            mut usize n = a.len();
            if (b.len() < n) { n = b.len(); }
            mut i32 c = 0;
            unsafe { c = memcmp(a.as_ptr(), b.as_ptr(), n); }
            if (c < 0) { return std::ordering::less; }
            if (c > 0) { return std::ordering::greater; }
            return a.len() <=> b.len();
        }

        ~string() {
            if (this.on_heap()) {
                unsafe { std::raw::free(this.heap_data()); }
            }
        }

    private:
        // Moves the text to a heap buffer of exactly `next` bytes (more than the capacity now).
        void grow_to(usize next) mut {
            usize length = this.len();
            unsafe {
                if (this.on_heap()) {
                    std::raw_ptr<mut u8> data = std::raw::reallocate(this.heap_data(), next);
                    this.set_word(0, cast::reinterpret<u64>(data));
                } else {
                    std::raw_ptr<mut u8> data = std::raw::allocate<u8>(next);
                    std::raw::copy(data, this.bytes(), length);
                    this.set_word(0, cast::reinterpret<u64>(data));
                    this.set_word(1, cast<u64>(length));
                }
            }
            this.set_word(2, cast<u64>(next) | string_heap_bit);
        }

        std::raw::array<u64, 3> repr = default;

        u64 word(usize i) {
            unsafe { return std::raw::read(cast::reinterpret<std::raw_ptr<u64>>(&this.repr).offset(i)); }
        }

        void set_word(usize i, u64 value) mut {
            unsafe { std::raw::write(cast::reinterpret<std::raw_ptr<mut u64>>(mut &this.repr).offset(i), value); }
        }

        bool on_heap() { return (this.word(2) & string_heap_bit) != 0; }

        u8 inline_len() { return cast::truncate<u8>(this.word(2) >> 56); }

        unsafe std::raw_ptr<mut u8> heap_data() { return cast::reinterpret<std::raw_ptr<mut u8>>(this.word(0)); }

        std::raw_ptr<u8> bytes() {
            if (this.on_heap()) { unsafe { return this.heap_data(); } }
            unsafe { return cast::reinterpret<std::raw_ptr<u8>>(&this.repr); }
        }

        std::raw_ptr<mut u8> bytes_mut() mut {
            if (this.on_heap()) { unsafe { return this.heap_data(); } }
            unsafe { return cast::reinterpret<std::raw_ptr<mut u8>>(mut &this.repr); }
        }

        void set_len(usize n) mut {
            if (this.on_heap()) {
                this.set_word(1, cast<u64>(n));
            } else {
                // the length goes in byte 23 (the top byte of word 2); the text's last bytes stay
                u64 low = this.word(2) & 0x00FFFFFFFFFFFFFFu64;
                this.set_word(2, low | (cast<u64>(n) << 56));
            }
        }
    }

    // --- the panic hook (error handling) -------------------------------------------------------

    private extern(std::build::language::c) {
        void edax_set_panic_hook(std::fn_ptr<void(std::raw_ptr<u8>, u64, std::raw_ptr<u8>)> hook);
        usize strlen(std::raw_ptr<u8> text);
        u64 pthread_self();
        i32 pthread_getname_np(u64 thread, std::raw_ptr<mut u8> name, usize length);
    }

    // The runtime's source location of a panic: the file (a C string in static data), line, column.
    private struct panic_location {
        std::raw_ptr<u8> file;
        u32              line;
        u32              column;
        std::raw_ptr<u8> function;   // a C string, or null
    }

    private static mut std::option<std::fn_ptr<void(std::panic_info&)>> panic_hook = std::none;

    std::option<std::fn_ptr<void(std::panic_info&)>> set_panic_hook(std::fn_ptr<void(std::panic_info&)> hook) {
        mut std::option<std::fn_ptr<void(std::panic_info&)>> previous = std::none;
        unsafe {
            previous   = panic_hook;
            panic_hook = std::some(hook);
            edax_set_panic_hook([](std::raw_ptr<u8> text, u64 length, std::raw_ptr<u8> at) {
                std::raw_ptr<std::panic_location> where = cast::reinterpret<std::raw_ptr<std::panic_location>>(at);
                std::static_str file = std::raw::static_str_from((*where).file, strlen((*where).file));
                mut usize name_start = 0;
                for (usize i : 0..file.len()) {
                    if (file.slice(i, i + 1) == "/") { name_start = i + 1; }
                }
                std::array<u8, 32> name = default;
                std::raw_ptr<mut u8> name_bytes = cast::reinterpret<std::raw_ptr<mut u8>>(&name);
                mut usize name_length = 0;
                if (pthread_getname_np(pthread_self(), name_bytes, 32) == 0) { name_length = strlen(cast::reinterpret<std::raw_ptr<u8>>(name_bytes)); }
                std::panic_info info = std::panic_info{
                    .message     = std::raw::str_from(text, cast::truncate<usize>(length)),
                    .where       = std::call_site{
                        .file      = file,
                        .file_name = std::raw::static_str_from(file.as_ptr().offset(name_start), file.len() - name_start),
                        .line      = (*where).line,
                        .column    = (*where).column,
                    },
                    .function    = if ((*where).function) { std::raw::static_str_from((*where).function, strlen((*where).function)) } else { "" },
                    .thread_name = std::raw::str_from(cast::reinterpret<std::raw_ptr<u8>>(name_bytes), name_length),
                };
                match (panic_hook) {
                    std::some(h) => h(info),
                    std::none    => { },
                }
            });
        }
        return previous;
    }

    private extern(std::build::language::c) i32 memcmp(std::raw_ptr<u8> a, std::raw_ptr<u8> b, usize n);

    // --- the methods of std::str ----------------------------------------------------------------
    // `text.name(args)` calls `str_name(text, args)` (the compiler maps the call).

    private u8 byte_at(std::str text, usize i) {
        unsafe { return std::raw::read(text.as_ptr().offset(i)); }
    }

    // `text.byte(i)`: byte `i` of the UTF-8 text; panics when out of bounds.
    private u8 str_byte(std::str text, usize i) {
        if compile_time (checks_bounds()) { run_time check (i < text.len()) else f"byte {i} out of bounds (length {text.len()})"; }
        unsafe { return std::raw::read(text.as_ptr().offset(i)); }
    }

    private std::str str_slice(std::str text, usize from, usize to) {
        if compile_time (checks_bounds()) { run_time check (from <= to && to <= text.len()) else f"slice {from}..{to} out of bounds (length {text.len()})"; }
        unsafe { return std::raw::str_from(text.as_ptr().offset(from), to - from); }
    }

    private bool str_starts_with(std::str text, std::str prefix) {
        if (prefix.len() > text.len()) { return false; }
        return str_slice(text, 0, prefix.len()) == prefix;
    }

    private bool str_ends_with(std::str text, std::str suffix) {
        if (suffix.len() > text.len()) { return false; }
        return str_slice(text, text.len() - suffix.len(), text.len()) == suffix;
    }

    private std::option<usize> str_find(std::str text, std::str needle) {
        if (needle.len() > text.len()) { return std::none; }
        mut usize i = 0;
        while (i + needle.len() <= text.len()) {
            if (str_slice(text, i, i + needle.len()) == needle) { return std::some(i); }
            i += 1;
        }
        return std::none;
    }

    private bool str_contains(std::str text, std::str needle) {
        return str_find(text, needle).value_or(text.len() + 1) <= text.len();
    }

    private bool is_space(u8 b) {
        return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
    }

    private std::str str_trim(std::str text) {
        mut usize from = 0;
        mut usize to = text.len();
        while (from < to && is_space(byte_at(text, from))) { from += 1; }
        while (to > from && is_space(byte_at(text, to - 1))) { to -= 1; }
        return str_slice(text, from, to);
    }

    private std::darray<std::str> str_split(std::str text, char separator) {
        mut std::darray<std::str> parts = default;
        mut std::string sep = default;
        sep.push(separator);
        std::str s = sep;
        mut usize start = 0;
        mut usize i = 0;
        while (i + s.len() <= text.len()) {
            if (str_slice(text, i, i + s.len()) == s) {
                parts.push(str_slice(text, start, i));
                i += s.len();
                start = i;
            } else {
                i += 1;
            }
        }
        parts.push(str_slice(text, start, text.len()));
        return parts;
    }

    private extern(std::build::language::c) f64 strtod(std::raw_ptr<u8> text, std::raw_ptr<mut std::raw_ptr<u8>> end);

    // `text.parse<T>()`: the number the whole text spells, or `none`. Integers are decimal with an
    // optional sign; floats are what C's strtod reads, without leading spaces; a bool is exactly
    // `true` or `false`.
    template<type T>
    private std::option<T> str_parse(std::str text) {
        if (text.is_empty()) { return std::none; }
        if compile_time (std::is_same<T, bool>()) {
            if (text == "true") { return std::some(true); }
            if (text == "false") { return std::some(false); }
            return std::none;
        } else if compile_time (std::is_integer<T>()) {
            mut usize i = 0;
            mut bool negative = false;
            u8 first = byte_at(text, 0);
            if (first == 45 || first == 43) {   // '-' or '+'
                negative = first == 45;
                i = 1;
            }
            if (i == text.len()) { return std::none; }
            mut u128 value = 0;
            while (i < text.len()) {
                u8 b = byte_at(text, i);
                if (b < 48 || b > 57) { return std::none; }
                std::option<u128> next = std::checked_mul(value, 10u128);
                match (next) {
                    std::some(v) => { value = v; },
                    std::none => { return std::none; },
                }
                match (std::checked_add(value, cast<u128>(b - 48))) {
                    std::some(v) => { value = v; },
                    std::none => { return std::none; },
                }
                i += 1;
            }
            if (negative) {
                std::option<i128> magnitude = cast::checked<i128>(value);
                match (magnitude) {
                    std::some(m) => { return cast::checked<T>(-m); },
                    std::none => {
                        if (value == 170141183460469231731687303715884105728u128) { return cast::checked<T>(-170141183460469231731687303715884105727i128 - 1); }
                        return std::none;
                    },
                }
            }
            return cast::checked<T>(value);
        } else {
            u8 first = byte_at(text, 0);
            if (is_space(first)) { return std::none; }
            mut std::raw_ptr<mut u8> copy = nullptr;
            unsafe {
                copy = std::raw::allocate<u8>(text.len() + 1);
                std::raw::copy(copy, text.as_ptr(), text.len());
                std::raw::write(copy.offset(text.len()), 0u8);
            }
            mut std::raw_ptr<u8> end = nullptr;
            mut f64 value = 0.0;
            mut bool whole = false;
            unsafe {
                value = strtod(copy, mut &end);
                whole = cast::reinterpret<usize>(end) == cast::reinterpret<usize>(copy) + text.len();
                std::raw::free(copy);
            }
            if (!whole) { return std::none; }
            if compile_time (std::is_same<T, f32>()) {
                return std::some(cast::round<f32>(value));
            } else {
                return std::some(value);
            }
        }
    }

    // --- files ------------------------------------------------------------------------------------

    // The C library functions behind std::file.
    private extern(std::build::language::c) {
        std::raw_ptr<mut u8> fopen(std::raw_ptr<u8> path, std::raw_ptr<u8> mode);
        i32 fclose(std::raw_ptr<mut u8> stream);
        i32 fflush(std::raw_ptr<mut u8> stream);
        usize fwrite(std::raw_ptr<u8> data, usize size, usize count, std::raw_ptr<mut u8> stream);
        isize getline(std::raw_ptr<mut std::raw_ptr<mut u8>> line, std::raw_ptr<mut usize> capacity, std::raw_ptr<mut u8> stream);
        usize fread(std::raw_ptr<mut u8> data, usize size, usize count, std::raw_ptr<mut u8> stream);
        i32 ferror(std::raw_ptr<mut u8> stream);
        std::raw_ptr<mut i32> __errno_location();
        void free(std::raw_ptr<mut u8> p);
        std::raw_ptr<mut u8> malloc(usize size);
        std::raw_ptr<mut u8> realloc(std::raw_ptr<mut u8> p, usize size);
    }

    // Whether `b` is well-formed UTF-8 (no overlong forms, surrogates or values above 0x10FFFF).
    private bool valid_utf8(std::darray<u8>& b) {
        mut usize i = 0;
        usize n = b.len();
        while (i < n) {
            u8 c = b[i];
            if (c < 0x80) {
                i += 1;
                continue;
            }
            mut usize extra = 0;
            mut u32 value = 0;
            mut u32 least = 0;
            if (c >= 0xC2 && c <= 0xDF) {
                extra = 1;
                value = cast<u32>(c & 0x1F);
                least = 0x80;
            } else if (c >= 0xE0 && c <= 0xEF) {
                extra = 2;
                value = cast<u32>(c & 0x0F);
                least = 0x800;
            } else if (c >= 0xF0 && c <= 0xF4) {
                extra = 3;
                value = cast<u32>(c & 0x07);
                least = 0x10000;
            } else {
                return false;
            }
            if (i + extra >= n) { return false; }
            mut usize k = 1;
            while (k <= extra) {
                u8 next = b[i + k];
                if ((next & 0xC0) != 0x80) { return false; }
                value = (value << 6) | cast<u32>(next & 0x3F);
                k += 1;
            }
            if (value < least || value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF)) { return false; }
            i += extra + 1;
        }
        return true;
    }

    // The io_error for C's `errno`.
    private io_error last_error() {
        mut i32 code = 0;
        unsafe { code = *__errno_location(); }
        return match (code) {
            2 => io_error::not_found,
            13 => io_error::permission_denied,
            17 => io_error::already_exists,
            21 => io_error::is_directory,
            _ => io_error::other,
        };
    }

    // Opens `path` with the C mode `mode` (c"r", c"w").
    private std::result<file, io_error> open_with(std::filesystem::path& path, std::raw_ptr<u8> mode) {
        mut std::string name = std::string::from(path.as_str());
        name.push('\0');
        std::str c_name = name;
        mut std::raw_ptr<mut u8> handle = nullptr;
        unsafe { handle = fopen(c_name.as_ptr(), mode); }
        if (!handle) { return std::error(last_error()); }
        return std::ok(file{ .handle = handle });
    }

    // A path that is relative without saying so: not `/...`, `./...` or `../...` (spec 19).
    private compile_time run_time bool is_plain_relative(std::str path) {
        return !path.starts_with("/") && !path.starts_with("./") && !path.starts_with("../");
    }

    class file {
    public:
        static std::result<file, io_error> open(std::filesystem::path& path) {
            compile_time check (std::build::target_has(std::build::capability::files)) else "std::file needs a target with files";
            return open_with(path, c"r");
        }

        static std::result<file, io_error> create(std::filesystem::path& path) {
            compile_time check (std::build::target_has(std::build::capability::files)) else "std::file needs a target with files";
            return open_with(path, c"w");
        }

        static std::result<file, io_error> append(std::filesystem::path& path) {
            compile_time check (std::build::target_has(std::build::capability::files)) else "std::file needs a target with files";
            return open_with(path, c"a");
        }

        static std::result<file, io_error> open(std::str path) {
            compile_time check (std::build::target_has(std::build::capability::files)) else "std::file needs a target with files";
            compile_time check {
                if (std::is_compile_time(path)) {
                    if (is_plain_relative(path)) {
                        std::compile_note("use 'std::filesystem::executable_dir() / name', or 'std::filesystem::path::relative(name)' when the working directory is meant");
                        std::compile_warning(std::location_of(path), std::relative_path,
                            f"\"{path}\" is relative to the working directory, not to the executable");
                    }
                }
            }
            return open_with(std::filesystem::path::from(path), c"r");
        }

        static std::result<file, io_error> create(std::str path) {
            compile_time check (std::build::target_has(std::build::capability::files)) else "std::file needs a target with files";
            compile_time check {
                if (std::is_compile_time(path)) {
                    if (is_plain_relative(path)) {
                        std::compile_note("use 'std::filesystem::executable_dir() / name', or 'std::filesystem::path::relative(name)' when the working directory is meant");
                        std::compile_warning(std::location_of(path), std::relative_path,
                            f"\"{path}\" is relative to the working directory, not to the executable");
                    }
                }
            }
            return open_with(std::filesystem::path::from(path), c"w");
        }

        file_lines lines() mut { return file_lines{ .handle = this.handle }; }

        std::result<std::string, io_error> read_all() mut {
            mut std::darray<u8> bytes = default;
            mut std::raw::array<u8, 8192> chunk = default;
            unsafe {
                std::raw_ptr<mut u8> buffer = cast::reinterpret<std::raw_ptr<mut u8>>(mut &chunk);
                while (true) {
                    usize n = fread(buffer, 1, 8192, this.handle);
                    mut usize i = 0;
                    while (i < n) {
                        bytes.push(*buffer.offset(i));
                        i += 1;
                    }
                    if (n < 8192) { break; }
                }
                if (ferror(this.handle) != 0) { return std::error(last_error()); }
            }
            if (!valid_utf8(bytes)) { return std::error(io_error::invalid_data); }
            unsafe {
                if (bytes.is_empty()) { return std::ok(std::string{}); }
                return std::ok(std::string::from(std::raw::str_from(cast::reinterpret<std::raw_ptr<u8>>(&bytes[0]), bytes.len())));
            }
        }

        std::result<usize, io_error> write(std::str text) mut {
            mut usize written = 0;
            unsafe { written = fwrite(text.as_ptr(), 1, text.len(), this.handle); }
            if (written != text.len()) { return std::error(last_error()); }
            return std::ok(written);
        }

        std::result<void, io_error> flush() mut {
            mut i32 r = 0;
            unsafe { r = fflush(this.handle); }
            if (r != 0) { return std::error(last_error()); }
            return std::ok();
        }

        ~file() {
            unsafe { fclose(this.handle); }
        }

    private:
        std::raw_ptr<mut u8> handle;
    }

    class file_lines {
    public:
        std::option<std::str> next() mut {
            mut isize n = 0;
            unsafe { n = getline(mut &this.buffer, mut &this.capacity, this.handle); }
            if (n < 0) { return std::none; }
            mut usize len = cast::saturate<usize>(n);
            unsafe {
                if (len > 0 && std::raw::read(this.buffer.offset(len - 1)) == 10u8) { len -= 1; }
                if (len > 0 && std::raw::read(this.buffer.offset(len - 1)) == 13u8) { len -= 1; }
                return std::some(std::raw::str_from(this.buffer, len));
            }
        }

        ~file_lines() {
            unsafe {
                if (this.buffer) { free(this.buffer); }   // getline's buffer comes from C's malloc
            }
        }

    private:
        std::raw_ptr<mut u8> handle;
        std::raw_ptr<mut u8> buffer = nullptr;
        usize capacity = 0;
    }

    // --- smart pointers ---------------------------------------------------------------------------

    // --- C libraries loaded at run time -------------------------------------------------------

    private extern(std::build::language::c) {
        std::raw_ptr<mut u8> dlopen(std::raw_ptr<u8> name, i32 flags);
        std::raw_ptr<u8> dlsym(std::raw_ptr<mut u8> handle, std::raw_ptr<u8> symbol);
        i32 dlclose(std::raw_ptr<mut u8> handle);
    }

    // --- Edax plugins ----------------------------------------------------------------------------
    // A plugin exports `edax_plugin_entry`, which edaxc generates for its @std::plugin_entry class:
    // it returns the plugin's descriptor. `create` makes the object with T::make() and writes it,
    // as a `std::raw_ptr<mut I>` (the object and its interface table), to `out`.

    private compile_time u64 plugin_magic = 0x5249465450474C32;   // "EDAXPGL2"

    // One field of a plugin object's state (hot reload); a row with a null name ends the table.
    private struct plugin_state_field {
        std::raw_ptr<u8> name;   // NUL-terminated
        u64              offset;
        u64              size;
        u64              type_hash;
    }

    private struct plugin_descriptor {
        u64                                     magic;
        u64                                     interface_hash;
        std::raw_ptr<u8>                        compiler;   // the edaxc version, NUL-terminated
        std::fn_ptr<void(std::raw_ptr<mut u8>)> create;
        std::raw_ptr<plugin_state_field>        state;      // null: the object carries no state over
    }

    template<type I>
    class plugin {
    public:
        static std::result<plugin<I>, plugin_error> load(std::filesystem::path& path) {
            compile_time check (std::build::target_has(std::build::capability::dynamic_libraries))
                else "std::plugin needs a target with dynamic libraries";
            mut std::string c_name = std::string::from(path.as_str());
            c_name.push('\0');
            std::str text = c_name;
            unsafe {
                std::raw_ptr<mut u8> handle = dlopen(text.as_ptr(), 2);   // RTLD_NOW
                if (!handle) { return std::error(plugin_error::not_found); }
                std::raw_ptr<u8> entry = dlsym(handle, c"edax_plugin_entry");
                if (!entry) {
                    _ = dlclose(handle);
                    return std::error(plugin_error::not_a_plugin);
                }
                std::fn_ptr<std::raw_ptr<plugin_descriptor>()> describe = cast::reinterpret<std::fn_ptr<std::raw_ptr<plugin_descriptor>()>>(entry);
                std::raw_ptr<plugin_descriptor> d = describe();
                if (!d || (*d).magic != plugin_magic) {
                    _ = dlclose(handle);
                    return std::error(plugin_error::not_a_plugin);
                }
                compile_time std::static_str ours = std::meta::compiler_version();
                std::str theirs = std::raw::str_from((*d).compiler, strlen((*d).compiler));
                if ((*d).interface_hash != std::meta::interface_hash<I>() || theirs != ours) {
                    _ = dlclose(handle);
                    return std::error(plugin_error::incompatible);
                }
                mut std::raw::array<u64, 2> slot = default;
                (*d).create(cast::reinterpret<std::raw_ptr<mut u8>>(mut &slot));
                std::raw_ptr<mut I> object = std::raw::read(cast::reinterpret<std::raw_ptr<mut std::raw_ptr<mut I>>>(mut &slot));
                return std::ok(plugin<I>{ .handle = handle, .object = object, .state = (*d).state });
            }
        }

        std::result<void, plugin_error> reload(std::filesystem::path& path) mut {
            compile_time check (std::build::target_has(std::build::capability::dynamic_libraries))
                else "std::plugin needs a target with dynamic libraries";
            if compile_time (std::build::target_has(std::build::capability::dynamic_libraries)) {
                mut plugin<I> fresh = plugin<I>::load(path)?;
                unsafe {
                    if (this.state && fresh.state) {
                        // Every field both builds have must have kept its type.
                        mut usize i = 0;
                        while ((*this.state.offset(i)).name) {
                            std::raw_ptr<plugin_state_field> old = this.state.offset(i);
                            std::raw_ptr<plugin_state_field> now = plugin_state_find(fresh.state, (*old).name);
                            if (now && ((*now).type_hash != (*old).type_hash || (*now).size != (*old).size)) {
                                return std::error(plugin_error::state_changed);
                            }
                            i += 1;
                        }
                        // Swap them: the new object gets the old values, the old object (destroyed with
                        // the old build below) the new defaults. Fields only one side has stay put.
                        std::raw_ptr<mut u8> old_object = std::raw::read(cast::reinterpret<std::raw_ptr<std::raw_ptr<mut u8>>>(mut &this.object));
                        std::raw_ptr<mut u8> new_object = std::raw::read(cast::reinterpret<std::raw_ptr<std::raw_ptr<mut u8>>>(mut &fresh.object));
                        i = 0;
                        while ((*this.state.offset(i)).name) {
                            std::raw_ptr<plugin_state_field> old = this.state.offset(i);
                            std::raw_ptr<plugin_state_field> now = plugin_state_find(fresh.state, (*old).name);
                            if (now) {
                                std::raw_ptr<mut u8> a = old_object.offset(cast::truncate<usize>((*old).offset));
                                std::raw_ptr<mut u8> b = new_object.offset(cast::truncate<usize>((*now).offset));
                                mut usize k = 0;
                                while (k < cast::truncate<usize>((*old).size)) {
                                    u8 t = std::raw::read(a.offset(k));
                                    std::raw::write(a.offset(k), std::raw::read(b.offset(k)));
                                    std::raw::write(b.offset(k), t);
                                    k += 1;
                                }
                            }
                            i += 1;
                        }
                    }
                }
                std::swap(mut this.handle, mut fresh.handle);
                std::swap(mut this.object, mut fresh.object);
                std::swap(mut this.state, mut fresh.state);
                return std::ok();   // `fresh` now holds the old build: its object is destroyed, then it is unloaded
            } else {
                return std::error(plugin_error::not_found);   // never runs: the check above
            }
        }

        I& operator*() {
            unsafe { return *this.object; }
        }

        mut I& operator*() mut {
            unsafe { return *this.object; }
        }

        ~plugin() {
            unsafe {
                std::raw::drop(this.object);
                std::raw::free(this.object);
                _ = dlclose(this.handle);
            }
        }

    private:
        std::raw_ptr<mut u8> handle;
        std::raw_ptr<mut I>  object;
        std::raw_ptr<plugin_state_field> state = nullptr;
    }

    // The field called `name` in a state table, or null.
    private unsafe std::raw_ptr<plugin_state_field> plugin_state_find(std::raw_ptr<plugin_state_field> table, std::raw_ptr<u8> name) {
        usize n = strlen(name);
        std::str wanted = std::raw::str_from(name, n);
        mut usize i = 0;
        while ((*table.offset(i)).name) {
            std::raw_ptr<u8> other = (*table.offset(i)).name;
            if (std::raw::str_from(other, strlen(other)) == wanted) { return table.offset(i); }
            i += 1;
        }
        return nullptr;
    }

    struct cpp_exception {
        std::str what() { return this.message; }
    }

    class c_library {
    public:
        static std::result<c_library, c_library_error> load(std::str name) {
            compile_time check (std::build::target_has(std::build::capability::dynamic_libraries))
                else "std::c_library needs a target with dynamic libraries";
            mut std::string c_name = std::string::from(name);
            c_name.push('\0');
            std::str text = c_name;
            mut std::raw_ptr<mut u8> handle = nullptr;
            unsafe { handle = dlopen(text.as_ptr(), 2); }   // RTLD_NOW
            if (!handle) { return std::error(c_library_error::not_found); }
            return std::ok(c_library{ .handle = handle });
        }

        template<type F>
        std::result<F, c_library_error> function(std::raw_ptr<u8> symbol) {
            unsafe {
                std::raw_ptr<u8> address = dlsym(this.handle, symbol);
                if (!address) { return std::error(c_library_error::symbol_not_found); }
                return std::ok(cast::reinterpret<F>(address));
            }
        }

        ~c_library() {
            unsafe { _ = dlclose(this.handle); }
        }

    private:
        std::raw_ptr<mut u8> handle;
    }

    // --- 8-bit floats -----------------------------------------------------------------------------

    // The f8 bits of `v` below the smallest normal: `n` units of 2^-(bias - 1 + mantissa bits),
    // rounded to nearest even. `shift_base` is 127 + 23 - (bias - 1 + mantissa bits) + ... folded:
    // the unit count is the 24-bit significand shifted right by `shift_base - exponent`.
    private compile_time run_time u32 f8_subnormal(u32 a, u32 shift_base, u32 zero_below) {
        u32 e = a >> 23;
        if (e <= zero_below) { return 0; }                    // under half the smallest unit
        u32 s    = shift_base - e;                            // 21..24
        u32 full = (a & 0x7FFFFF) | 0x800000;
        mut u32 n = full >> s;
        u32 rem  = full & ((bit<u32>(s)) - 1);
        u32 half = bit<u32>(s - 1);
        if (rem > half || (rem == half && (n & 1) == 1)) { n += 1; }
        return n;                                             // n == 2^mantissa bits is the smallest normal
    }

    private compile_time run_time u8 f8e4m3_encode(f32 v, bool saturate) {
        u32 x    = std::bit_cast<u32>(v);
        u32 sign = (x >> 24) & 0x80;
        u32 a    = x & 0x7FFFFFFF;
        if (a > 0x7F800000) { return cast::truncate<u8>(sign | 0x7F); }   // NaN
        if (a > 0x43E80000) {                                             // rounds beyond 448 (or inf)
            if (saturate) { return cast::truncate<u8>(sign | 0x7E); }
            return cast::truncate<u8>(sign | 0x7F);
        }
        if (a >= 0x3C800000) {                                            // normal: from 2^-6
            u32 r = a + 0x7FFFF + ((a >> 20) & 1);
            return cast::truncate<u8>(sign | (((r >> 23) - 120) << 3) | ((r >> 20) & 7));
        }
        return cast::truncate<u8>(sign | f8_subnormal(a, 141, 116));
    }

    private compile_time run_time u8 f8e5m2_encode(f32 v, bool saturate) {
        u32 x    = std::bit_cast<u32>(v);
        u32 sign = (x >> 24) & 0x80;
        u32 a    = x & 0x7FFFFFFF;
        if (a > 0x7F800000) { return cast::truncate<u8>(sign | 0x7E); }   // NaN
        if (a >= 0x47700000) {                                            // rounds to 2^16 or beyond (or inf)
            if (saturate) { return cast::truncate<u8>(sign | 0x7B); }
            return cast::truncate<u8>(sign | 0x7C);
        }
        if (a >= 0x38800000) {                                            // normal: from 2^-14
            u32 r = a + 0xFFFFF + ((a >> 21) & 1);
            return cast::truncate<u8>(sign | (((r >> 23) - 112) << 2) | ((r >> 21) & 3));
        }
        return cast::truncate<u8>(sign | f8_subnormal(a, 134, 109));
    }

    // -1, 0, 1, NaN last: the order of `f8` values for sorting.
    private compile_time run_time std::ordering f8_total_cmp(f32 a, f32 b) {
        bool an = a != a;
        bool bn = b != b;
        if (an || bn) {
            if (an && bn) { return std::ordering::equal; }
            if (an) { return std::ordering::greater; }
            return std::ordering::less;
        }
        if (a < b) { return std::ordering::less; }
        if (a > b) { return std::ordering::greater; }
        return std::ordering::equal;
    }

    struct f8e4m3 {
        compile_time run_time static f8e4m3 from_f32(f32 v) { return f8e4m3{ .bits = f8e4m3_encode(v, false) }; }
        compile_time run_time static f8e4m3 saturate(f32 v) { return f8e4m3{ .bits = f8e4m3_encode(v, true) }; }
        compile_time run_time static f8e4m3 from_bits(u8 bits) { return f8e4m3{ .bits = bits }; }
        compile_time run_time static f8e4m3 max() { return f8e4m3{ .bits = 0x7E }; }
        compile_time run_time static f8e4m3 min() { return f8e4m3{ .bits = 0xFE }; }
        compile_time run_time static f8e4m3 epsilon() { return f8e4m3{ .bits = 0x20 }; }
        compile_time run_time static f8e4m3 min_positive() { return f8e4m3{ .bits = 0x01 }; }
        compile_time run_time static f8e4m3 nan() { return f8e4m3{ .bits = 0x7F }; }

        compile_time run_time f32 to_f32() {
            u32 b    = cast<u32>(this.bits);
            u32 sign = (b & 0x80) << 24;
            u32 e    = (b >> 3) & 15;
            u32 m    = b & 7;
            if (e == 15 && m == 7) { return std::bit_cast<f32>(sign | 0x7FC00000); }
            if (e == 0) {                                    // subnormal: m * 2^-9
                return std::bit_cast<f32>(sign | std::bit_cast<u32>(cast::round<f32>(m) * 0.001953125));
            }
            return std::bit_cast<f32>(sign | ((e + 120) << 23) | (m << 20));
        }
        compile_time run_time f16 to_f16() { return cast::round<f16>(this.to_f32()); }
        compile_time run_time bool is_nan() { return (this.bits & 0x7F) == 0x7F; }
        compile_time run_time std::ordering total_cmp(f8e4m3 other) { return f8_total_cmp(this.to_f32(), other.to_f32()); }

        compile_time run_time f8e4m3 operator+(f8e4m3 other) { return f8e4m3::from_f32(this.to_f32() + other.to_f32()); }
        compile_time run_time f8e4m3 operator-(f8e4m3 other) { return f8e4m3::from_f32(this.to_f32() - other.to_f32()); }
        compile_time run_time f8e4m3 operator*(f8e4m3 other) { return f8e4m3::from_f32(this.to_f32() * other.to_f32()); }
        compile_time run_time f8e4m3 operator/(f8e4m3 other) { return f8e4m3::from_f32(this.to_f32() / other.to_f32()); }
        compile_time run_time f8e4m3 operator-() { return f8e4m3{ .bits = this.bits ^ 0x80 }; }
        compile_time run_time bool operator==(f8e4m3& other) { return this.to_f32() == other.to_f32(); }

        void format(mut std::formatter& out) { out.write(std::format(f"{this.to_f32()}")); }
    }

    struct f8e5m2 {
        compile_time run_time static f8e5m2 from_f32(f32 v) { return f8e5m2{ .bits = f8e5m2_encode(v, false) }; }
        compile_time run_time static f8e5m2 saturate(f32 v) { return f8e5m2{ .bits = f8e5m2_encode(v, true) }; }
        compile_time run_time static f8e5m2 from_bits(u8 bits) { return f8e5m2{ .bits = bits }; }
        compile_time run_time static f8e5m2 max() { return f8e5m2{ .bits = 0x7B }; }
        compile_time run_time static f8e5m2 min() { return f8e5m2{ .bits = 0xFB }; }
        compile_time run_time static f8e5m2 epsilon() { return f8e5m2{ .bits = 0x34 }; }
        compile_time run_time static f8e5m2 min_positive() { return f8e5m2{ .bits = 0x01 }; }
        compile_time run_time static f8e5m2 infinity() { return f8e5m2{ .bits = 0x7C }; }
        compile_time run_time static f8e5m2 nan() { return f8e5m2{ .bits = 0x7E }; }

        // The top byte of an f16.
        compile_time run_time f32 to_f32() { return cast<f32>(this.to_f16()); }
        compile_time run_time f16 to_f16() { return std::bit_cast<f16>(cast<u16>(this.bits) << 8); }
        compile_time run_time bool is_nan() { return (this.bits & 0x7F) > 0x7C; }
        compile_time run_time bool is_infinite() { return (this.bits & 0x7F) == 0x7C; }
        compile_time run_time std::ordering total_cmp(f8e5m2 other) { return f8_total_cmp(this.to_f32(), other.to_f32()); }

        compile_time run_time f8e5m2 operator+(f8e5m2 other) { return f8e5m2::from_f32(this.to_f32() + other.to_f32()); }
        compile_time run_time f8e5m2 operator-(f8e5m2 other) { return f8e5m2::from_f32(this.to_f32() - other.to_f32()); }
        compile_time run_time f8e5m2 operator*(f8e5m2 other) { return f8e5m2::from_f32(this.to_f32() * other.to_f32()); }
        compile_time run_time f8e5m2 operator/(f8e5m2 other) { return f8e5m2::from_f32(this.to_f32() / other.to_f32()); }
        compile_time run_time f8e5m2 operator-() { return f8e5m2{ .bits = this.bits ^ 0x80 }; }
        compile_time run_time bool operator==(f8e5m2& other) { return this.to_f32() == other.to_f32(); }

        void format(mut std::formatter& out) { out.write(std::format(f"{this.to_f32()}")); }
    }

    template<type T>
    class nonzero {
    public:
        static nonzero<T> make(T value) {
            run_time check (value != 0) else "std::nonzero::make: the value is 0";
            return nonzero<T>{ .value = value };
        }

        static std::option<nonzero<T>> of(T value) {
            if (value == 0) {
                return std::none;
            }
            return std::some(nonzero<T>{ .value = value });
        }

        T get() {
            return this.value;
        }

    private:
        @std::never_zero
        T value;
    }

    template<type T, type A>
    class unique_ptr {
    public:
        static unique_ptr<T, A> make(T value) {
            mut A alloc = default;
            mut std::raw_ptr<mut T> p = nullptr;
            unsafe {
                p = allocate_in<T, A>(mut alloc, 1);
                std::raw::write(p, move value);
            }
            return unique_ptr<T, A>{ .target = p, .alloc = alloc };
        }

        static unique_ptr<T, A> make_in(T value, A alloc) {
            mut A from = alloc;
            mut std::raw_ptr<mut T> p = nullptr;
            unsafe {
                p = allocate_in<T, A>(mut from, 1);
                std::raw::write(p, move value);
            }
            return unique_ptr<T, A>{ .target = p, .alloc = from };
        }

        T& operator*() {
            unsafe { return *this.target; }
        }

        mut T& operator*() mut {
            unsafe { return *this.target; }
        }

        ~unique_ptr() {
            unsafe {
                std::raw_ptr<mut T> pointee = this.target;
                std::raw::drop(pointee);
                free_in<T, A>(mut this.alloc, pointee, 1);
            }
        }

    private:
        @std::never_zero
        std::raw_ptr<mut T> target;
        A alloc = default;
    }

    template<type T>
    class shared_ptr {
    public:
        static shared_ptr<T> make(T value) {
            mut std::raw_ptr<mut T> p = nullptr;
            mut std::raw_ptr<mut shared_counts> c = nullptr;
            unsafe {
                p = std::raw::allocate<T>(1);
                std::raw::write(p, move value);
                c = std::raw::allocate<shared_counts>(1);
                std::raw::write(c, shared_counts{ .strong = std::atomic<usize>::make(1), .weak = std::atomic<usize>::make(1) });
            }
            return shared_ptr<T>{ .target = p, .counts = c };
        }

        // The counts are atomic (spec 13, 27): a shared_ptr may be cloned and dropped on any thread.
        // Adding an owner needs no ordering (the caller already has one); the last owner's release
        // and acquire make every other owner's use of the value happen before its destruction.

        shared_ptr<T> clone() {
            unsafe { _ = this.counts->strong.fetch_wrapping_add(1, std::memory_order::relaxed); }
            return shared_ptr<T>{ .target = this.target, .counts = this.counts };
        }

        weak_ptr<T> weak() {
            unsafe { _ = this.counts->weak.fetch_wrapping_add(1, std::memory_order::relaxed); }
            return weak_ptr<T>{ .target = this.target, .counts = this.counts };
        }

        usize owners() {
            unsafe { return this.counts->strong.load(std::memory_order::acquire); }
        }

        T& operator*() {
            unsafe { return *this.target; }
        }

        ~shared_ptr() {
            unsafe {
                if (this.counts->strong.fetch_wrapping_sub(1, std::memory_order::release) == 1) {
                    std::atomic_fence(std::memory_order::acquire);
                    std::raw::drop(this.target);
                    std::raw::free(this.target);
                    release_counts(this.counts);   // the strong owners' share of the weak count
                }
            }
        }

    private:
        @std::never_zero
        std::raw_ptr<mut T> target;
        std::raw_ptr<mut shared_counts> counts;
    }

    // Gives up one share of the weak count; the last one frees the counts.
    private unsafe void release_counts(std::raw_ptr<mut shared_counts> counts) {
        if (counts->weak.fetch_wrapping_sub(1, std::memory_order::release) == 1) {
            std::atomic_fence(std::memory_order::acquire);
            std::raw::free(counts);
        }
    }

    template<type T>
    class weak_ptr {
    public:
        std::option<shared_ptr<T>> lock() {
            unsafe {
                mut usize n = this.counts->strong.load(std::memory_order::relaxed);
                while (n != 0) {   // add an owner only while there still is one
                    match (this.counts->strong.compare_exchange_weak(n, n + 1, std::memory_order::acquire, std::memory_order::relaxed)) {
                        std::ok(_) => { return std::some(shared_ptr<T>{ .target = this.target, .counts = this.counts }); },
                        std::error(now) => { n = now; },
                    }
                }
            }
            return std::none;
        }

        weak_ptr<T> clone() {
            unsafe { _ = this.counts->weak.fetch_wrapping_add(1, std::memory_order::relaxed); }
            return weak_ptr<T>{ .target = this.target, .counts = this.counts };
        }

        ~weak_ptr() {
            unsafe { release_counts(this.counts); }
        }

    private:
        std::raw_ptr<mut T> target;
        std::raw_ptr<mut shared_counts> counts;
    }

    // --- ownership helpers (spec 12) ---------------------------------------------------------------

    template<type T>
    T take(mut T& place) {
        T fresh = default;
        return replace(mut place, move fresh);
    }

    template<type T>
    T replace(mut T& place, T value) {
        unsafe {
            T old = std::raw::read(&place);
            std::raw::write(mut &place, move value);
            return old;
        }
    }

    template<type T>
    void swap(mut T& a, mut T& b) {
        unsafe {
            T first = std::raw::read(&a);
            std::raw::write(mut &a, std::raw::read(&b));
            std::raw::write(mut &b, move first);
        }
    }

    // --- array and bitset -------------------------------------------------------------------------

    template<type T, usize N>
    struct array {
        usize len() { return N; }

        std::option<T&> get(usize i) {
            if (i >= N) { return std::none; }
            unsafe { return std::some(*cast::reinterpret<std::raw_ptr<T>>(&this.items).offset(i)); }
        }

        T& operator[](usize i) {
            if compile_time (checks_bounds()) { run_time check (i < N) else f"index {i} out of bounds (length {N})"; }
            unsafe { return *cast::reinterpret<std::raw_ptr<T>>(&this.items).offset(i); }
        }

        mut T& operator[](usize i) mut {
            if compile_time (checks_bounds()) { run_time check (i < N) else f"index {i} out of bounds (length {N})"; }
            unsafe { return *cast::reinterpret<std::raw_ptr<mut T>>(mut &this.items).offset(i); }
        }

        span<T> as_span() {
            unsafe { return span<T>::from_raw(cast::reinterpret<std::raw_ptr<T>>(&this.items), N); }
        }
    }

    template<usize N>
    struct bitset {
        usize len() { return N; }

        bool test(usize i) {
            if compile_time (checks_bounds()) { run_time check (i < N) else f"bit index {i} out of bounds (size {N})"; }
            unsafe {
                u64 word = *cast::reinterpret<std::raw_ptr<u64>>(&this.words).offset(i / 64);
                return (word >> cast::truncate<u64>(i % 64)) & 1 == 1;
            }
        }

        void set(usize i, bool value) mut {
            if compile_time (checks_bounds()) { run_time check (i < N) else f"bit index {i} out of bounds (size {N})"; }
            unsafe {
                std::raw_ptr<mut u64> word = cast::reinterpret<std::raw_ptr<mut u64>>(mut &this.words).offset(i / 64);
                u64 mask = 1u64 << cast::truncate<u64>(i % 64);
                if (value) { *word = *word | mask; } else { *word = *word & ~mask; }
            }
        }

        usize count() {
            mut usize n = 0;
            mut usize i = 0;
            while (i < N) {
                if (this.test(i)) { n += 1; }
                i += 1;
            }
            return n;
        }
    }

    // --- hashing and maps --------------------------------------------------------------------------

    // Folds a 128-bit product into 64 bits: the core of fast hashes like wyhash.
    private u64 fold_multiply(u64 a, u64 b) {
        u128 product = cast<u128>(a) * cast<u128>(b);
        return cast::truncate<u64>(product) ^ cast::truncate<u64>(product >> 64);
    }

    // Hash constants (from wyhash).
    private compile_time u64 hash_k0 = 0xa0761d6478bd642fu64;
    private compile_time u64 hash_k1 = 0xe7037ed1a0b428dbu64;
    private compile_time u64 hash_k2 = 0x8ebc6af09c88c6e3u64;

    // 8 bytes at `p` as a little-endian u64, without alignment requirements.
    private unsafe u64 load_u64(std::raw_ptr<u8> p) {
        mut u64 word = 0;
        std::raw::copy(cast::reinterpret<std::raw_ptr<mut u8>>(mut &word), p, 8);
        return word;
    }

    private unsafe u64 load_u32(std::raw_ptr<u8> p) {
        mut u32 word = 0;
        std::raw::copy(cast::reinterpret<std::raw_ptr<mut u8>>(mut &word), p, 4);
        return cast<u64>(word);
    }

    // 1 to 7 bytes at `p`, without a variable-length copy: two overlapping 4-byte loads, or three
    // single bytes.
    private unsafe u64 load_tail(std::raw_ptr<u8> p, usize n) {
        if (n >= 4) { return (load_u32(p) << 32) | load_u32(p.offset(n - 4)); }
        u64 first = cast<u64>(std::raw::read(p));
        u64 middle = cast<u64>(std::raw::read(p.offset(n >> 1)));
        u64 last = cast<u64>(std::raw::read(p.offset(n - 1)));
        return (first << 16) | (middle << 8) | last;
    }

    unsafe u64 hash_bytes(std::raw_ptr<u8> data, usize n) {
        mut u64 h = hash_seed() ^ cast<u64>(n);
        mut usize i = 0;
        while (i + 16 <= n) {
            h = fold_multiply(load_u64(data.offset(i)) ^ hash_k1, load_u64(data.offset(i + 8)) ^ h);
            i += 16;
        }
        if (i + 8 <= n) {
            h = fold_multiply(load_u64(data.offset(i)) ^ hash_k1, h ^ hash_k2);
            i += 8;
        }
        if (i < n) {
            h = fold_multiply(load_tail(data.offset(i), n - i) ^ hash_k2, h ^ hash_k1);
        }
        return fold_multiply(h ^ hash_k0, hash_k1);
    }

    // Per-process salt for hashing: the address of this variable, which the operating system
    // randomizes (ASLR). Inputs chosen to collide (hash flooding) can't be precomputed, and nobody
    // can rely on an iteration order that changes from run to run.
    private static u8 hash_anchor = 0;

    u64 hash_seed() {
        unsafe { return fold_multiply(cast::reinterpret<u64>(&hash_anchor) ^ hash_k2, hash_k0); }
    }

    u64 hash_combine(u64 a, u64 b) {
        return fold_multiply(a ^ hash_k1, b ^ hash_k2);
    }

    template<type K>
    u64 hash(K& key) {
        if compile_time (std::is_integer<K>()) {
            return fold_multiply(cast::truncate<u64>(key) ^ hash_seed(), hash_k1);
        } else if compile_time (std::is_same<K, char>()) {
            return fold_multiply(cast<u64>(key) ^ hash_seed(), hash_k1);
        } else if compile_time (std::is_same<K, bool>()) {
            return fold_multiply(cast<u64>(key) ^ hash_seed(), hash_k1);
        } else if compile_time (std::is_same<K, std::string>()) {
            std::str text = key.as_str();
            unsafe { return hash_bytes(text.as_ptr(), text.len()); }
        } else if compile_time (std::is_same<K, std::str>()) {
            unsafe { return hash_bytes(key.as_ptr(), key.len()); }
        } else if compile_time (std::is_same<K, std::static_str>()) {
            unsafe { return hash_bytes(key.as_ptr(), key.len()); }
        } else {
            return key.hash();
        }
    }

    // --- hash_map: a SwissTable-style table (spec 20) ---------------------------------------------
    // Control bytes: 0x80 empty, 0xFE deleted, 0x00..0x7F full (the low 7 bits of the hash). Groups of 8
    // control bytes start at multiples of 8 and are read as one u64 (little-endian: byte j of the group
    // is bits 8j..8j+7), so a lookup compares 8 slots with a few integer operations. Probing visits
    // groups in triangular steps, which covers every group of a power-of-two table.

    private compile_time u8 ctrl_empty = 0x80u8;
    private compile_time usize no_slot = 18446744073709551615usize;   // "not found"
    private compile_time u8 ctrl_deleted = 0xFEu8;
    private compile_time u64 group_lsbs = 0x0101010101010101u64;
    private compile_time u64 group_msbs = 0x8080808080808080u64;

    // The bytes of `group` equal to `h2` (one high bit per byte; may include a rare false positive,
    // which the key comparison rejects).
    private u64 group_match(u64 group, u8 h2) {
        u64 x = group ^ (group_lsbs *% cast<u64>(h2));
        return (x -% group_lsbs) & ~x & group_msbs;
    }

    private u64 group_empty(u64 group) { return group & (~group << 6) & group_msbs; }

    private u64 group_free(u64 group) { return group & (~group << 7) & group_msbs; }

    // The slot of a match bit: the byte it is in.
    private usize group_slot(u64 bits) { return cast<usize>(std::trailing_zeros(bits) >> 3); }

    // A key and its value, next to each other in the table.
    private template<type K, type V>
    struct hash_slot {
        K key;
        V value;
    }

    template<type K, type V, type A>
    class hash_map {
        compile_time check (std::implements<K, std::hashable>())
            else f"'{std::type_name<K>()}' can't be a hash_map key: give it a 'u64 hash()' method (or @std::derive::hashable)";
        compile_time check (std::implements<K, std::equatable>())
            else f"'{std::type_name<K>()}' can't be a hash_map key: give it an '==' (bool operator==({std::type_name<K>()}& other) = default;)";
    public:
        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        std::option<V> insert(K key, V value) mut {
            u64 h = hash(key);
            usize found = this.find(key, h);
            if (found != no_slot) {
                unsafe { return std::some(std::replace(mut (*this.slots.offset(found)).value, move value)); }
            }
            this.put(move key, move value, h);
            return std::none;
        }

        bool contains(K& key) { return this.find(key, hash(key)) != no_slot; }

        std::option<V&> get(K& key) {
            usize found = this.find(key, hash(key));
            if (found == no_slot) { return std::none; }
            unsafe { return std::some((*this.slots.offset(found)).value); }
        }

        std::option<mut V&> get_mut(K& key) mut {
            usize found = this.find(key, hash(key));
            if (found == no_slot) { return std::none; }
            unsafe { return std::some(mut (*this.slots.offset(found)).value); }
        }

        mut V& get_or_insert(K key, V value) mut {
            u64 h = hash(key);
            mut usize at = this.find(key, h);
            if (at == no_slot) { at = this.put(move key, move value, h); }
            unsafe { return (*this.slots.offset(at)).value; }
        }

        std::option<V> remove(K& key) mut {
            usize found = this.find(key, hash(key));
            if (found == no_slot) { return std::none; }
            unsafe {
                // A group that still has an empty byte ends every probe that reaches it, so the slot
                // can become empty again; otherwise it must stay a tombstone.
                u64 group = this.group_at(found >> 3);
                if (group_empty(group) != 0) {
                    std::raw::write(this.ctrl.offset(found), ctrl_empty);
                    this.growth_left += 1;
                } else {
                    std::raw::write(this.ctrl.offset(found), ctrl_deleted);
                }
                std::raw_ptr<mut hash_slot<K, V>> slot = this.slots.offset(found);
                std::raw::drop(mut &(*slot).key);
                this.count -= 1;
                return std::some(std::raw::read(mut &(*slot).value));
            }
        }

        V& operator[](K& key) {
            usize found = this.find(key, hash(key));
            run_time check (found != no_slot) else "key not found";
            unsafe { return (*this.slots.offset(found)).value; }
        }

        mut V& operator[](K& key) mut {
            usize found = this.find(key, hash(key));
            run_time check (found != no_slot) else "key not found";
            unsafe { return (*this.slots.offset(found)).value; }
        }

        hash_map_entries<K, V> entries() {
            return hash_map_entries<K, V>{ .ctrl = this.ctrl, .slots = this.slots, .at = 0, .end = this.capacity() };
        }

        static hash_map<K, V, A> with_capacity(usize n) {
            mut hash_map<K, V, A> out = default;
            out.reserve(n);
            return out;
        }

        static hash_map<K, V, A> with_allocator(A alloc) { return hash_map<K, V, A>{ .alloc = alloc }; }

        static hash_map<K, V, A> with_capacity_in(usize n, A alloc) {
            mut hash_map<K, V, A> out = hash_map<K, V, A>{ .alloc = alloc };
            out.reserve(n);
            return out;
        }

        void reserve(usize n) mut {
            // Room for n at a load of 7/8.
            mut usize want = 8;
            while (want - want / 8 < n) { want *= 2; }
            if (want > this.capacity()) { this.rehash(want); }
        }

        void clear() mut {
            if (this.count > 0) {
                mut usize i = 0;
                usize cap = this.capacity();
                while (i < cap) {
                    unsafe {
                        if (std::raw::read(this.ctrl.offset(i)) < 0x80u8) { std::raw::drop(this.slots.offset(i)); }
                    }
                    i += 1;
                }
            }
            this.fill_empty();
            this.count = 0;
        }

        ~hash_map() {
            this.clear();
            unsafe {
                std::raw_ptr<mut u8> control = this.ctrl;
                std::raw_ptr<mut hash_slot<K, V>> slot_base = this.slots;
                usize cap = this.capacity();
                if (control) {
                    free_in<u64, A>(mut this.alloc, cast::reinterpret<std::raw_ptr<mut u64>>(control), cap >> 3);
                    free_in<hash_slot<K, V>, A>(mut this.alloc, slot_base, cap);
                }
            }
        }

    private:
        std::raw_ptr<mut u8> ctrl = nullptr;           // capacity control bytes, 8-byte aligned
        std::raw_ptr<mut hash_slot<K, V>> slots = nullptr;
        usize mask = 0;                                // capacity - 1; capacity 0 before the first insert
        usize count = 0;
        usize growth_left = 0;                         // inserts into empty slots before the next rehash
        A alloc = default;

        usize capacity() {
            if (!this.ctrl) { return 0; }
            return this.mask + 1;
        }

        u64 group_at(usize g) {
            unsafe { return std::raw::read(cast::reinterpret<std::raw_ptr<u64>>(this.ctrl.offset(g << 3))); }
        }

        // The slot holding `key` (whose hash is `h`), or no_slot.
        usize find(K& key, u64 h) {
            if (this.count == 0) { return no_slot; }
            usize groups = this.mask >> 3;
            u8 h2 = cast::truncate<u8>(h & 0x7F);
            mut usize g = cast::truncate<usize>(h >> 7) & groups;
            mut usize step = 0;
            while (true) {
                u64 group = this.group_at(g);
                mut u64 hits = group_match(group, h2);
                while (hits != 0) {
                    usize i = (g << 3) | group_slot(hits);
                    unsafe {
                        if ((*this.slots.offset(i)).key == key) { return i; }
                    }
                    hits &= hits -% 1;
                }
                if (group_empty(group) != 0) { return no_slot; }
                step +%= 1;
                g = (g +% step) & groups;
            }
            return no_slot;
        }

        // The first empty or deleted slot on the probe sequence of `h`.
        usize free_slot(u64 h) {
            usize groups = this.mask >> 3;
            mut usize g = cast::truncate<usize>(h >> 7) & groups;
            mut usize step = 0;
            while (true) {
                u64 free = group_free(this.group_at(g));
                if (free != 0) { return (g << 3) | group_slot(free); }
                step +%= 1;
                g = (g +% step) & groups;
            }
            return 0;
        }

        // Inserts a key that is not in the table; returns its slot.
        usize put(K key, V value, u64 h) mut {
            if (this.growth_left == 0) { this.grow(); }
            usize at = this.free_slot(h);
            unsafe {
                if (std::raw::read(this.ctrl.offset(at)) == ctrl_empty) { this.growth_left -= 1; }
                std::raw::write(this.ctrl.offset(at), cast::truncate<u8>(h & 0x7F));
                std::raw::write(this.slots.offset(at), hash_slot<K, V>{ .key = move key, .value = move value });
            }
            this.count += 1;
            return at;
        }

        // Twice the room, or the same room without tombstones when they are what filled it.
        void grow() mut {
            usize cap = this.capacity();
            if (cap == 0) {
                this.rehash(8);
            } else if (this.count * 2 < cap - cap / 8) {
                this.rehash(cap);
            } else {
                this.rehash(cap * 2);
            }
        }

        void fill_empty() mut {
            usize cap = this.capacity();
            mut usize g = 0;
            while (g < (cap >> 3)) {
                unsafe { std::raw::write(cast::reinterpret<std::raw_ptr<mut u64>>(this.ctrl.offset(g << 3)), 0x8080808080808080u64); }
                g += 1;
            }
            this.growth_left = cap - cap / 8;
        }

        // Moves every entry into a new table of `cap` slots (a power of two, at least 8).
        void rehash(usize cap) mut {
            std::raw_ptr<mut u8> old_ctrl = this.ctrl;
            std::raw_ptr<mut hash_slot<K, V>> old_slots = this.slots;
            usize old_cap = this.capacity();
            unsafe {
                this.ctrl = cast::reinterpret<std::raw_ptr<mut u8>>(allocate_in<u64, A>(mut this.alloc, cap >> 3));
                this.slots = allocate_in<hash_slot<K, V>, A>(mut this.alloc, cap);
            }
            this.mask = cap - 1;
            this.fill_empty();
            this.growth_left -= this.count;
            mut usize i = 0;
            while (i < old_cap) {
                unsafe {
                    if (std::raw::read(old_ctrl.offset(i)) < 0x80u8) {
                        std::raw_ptr<mut hash_slot<K, V>> from = old_slots.offset(i);
                        u64 h = hash((*from).key);
                        usize at = this.free_slot(h);
                        std::raw::write(this.ctrl.offset(at), cast::truncate<u8>(h & 0x7F));
                        std::raw::copy(this.slots.offset(at), from, 1);
                    }
                }
                i += 1;
            }
            unsafe {
                if (old_ctrl) {
                    free_in<u64, A>(mut this.alloc, cast::reinterpret<std::raw_ptr<mut u64>>(old_ctrl), old_cap >> 3);
                    free_in<hash_slot<K, V>, A>(mut this.alloc, old_slots, old_cap);
                }
            }
        }
    }

    template<type K, type V>
    view class hash_map_entries {
    public:
        std::option<map_entry<K, V>> next() mut {
            while (this.at < this.end) {
                usize i = this.at;
                this.at += 1;
                unsafe {
                    if (std::raw::read(this.ctrl.offset(i)) < 0x80u8) {
                        std::raw_ptr<hash_slot<K, V>> slot = this.slots.offset(i);
                        return std::some(map_entry<K, V>{ .key = (*slot).key, .value = (*slot).value });
                    }
                }
            }
            return std::none;
        }

    private:
        std::raw_ptr<u8> ctrl;
        std::raw_ptr<hash_slot<K, V>> slots;
        usize at;
        usize end;
    }

    // --- tree_map: a B-tree (spec 20) ------------------------------------------------------------
    // Nodes hold up to 15 keys (minimum degree 8), so a node is a few cache lines and a lookup in a
    // map of a million entries visits about 7 nodes. Keys and values move bit by bit inside the tree
    // (std::raw::copy), which is what a move is in Edax. Insertion splits full nodes on the way down,
    // removal fills thin nodes on the way down (Cormen et al.), so neither needs to walk back up.

    private compile_time u32 btree_degree = 8;        // t: every node but the root has t-1 .. 2t-1 keys
    private compile_time u32 btree_max = 15;          // 2t - 1

    private template<type K, type V>
    struct btree_node {
        u32 len;
        bool leaf;
        std::raw::array<K, 15> keys;
        std::raw::array<V, 15> values;
        std::raw::array<std::raw_ptr<mut btree_node<K, V>>, 16> children;
    }

    private unsafe template<type K, type V>
    std::raw_ptr<mut K> bt_key(std::raw_ptr<mut btree_node<K, V>> n, u32 i) {
        return cast::reinterpret<std::raw_ptr<mut K>>(mut &(*n).keys).offset(i);
    }

    private unsafe template<type K, type V>
    std::raw_ptr<mut V> bt_value(std::raw_ptr<mut btree_node<K, V>> n, u32 i) {
        return cast::reinterpret<std::raw_ptr<mut V>>(mut &(*n).values).offset(i);
    }

    private unsafe template<type K, type V>
    std::raw_ptr<mut std::raw_ptr<mut btree_node<K, V>>> bt_child(std::raw_ptr<mut btree_node<K, V>> n, u32 i) {
        return cast::reinterpret<std::raw_ptr<mut std::raw_ptr<mut btree_node<K, V>>>>(mut &(*n).children).offset(i);
    }

    // The size of a node in words. A leaf has no children: it is allocated without the children
    // array (the last field), which makes leaves, most of the nodes, 128 bytes smaller.
    private template<type K, type V>
    usize bt_words(bool leaf) {
        mut usize bytes = std::size_of<btree_node<K, V>>();
        if (leaf) { bytes -= 16 * std::size_of<std::raw_ptr<u8>>(); }
        return (bytes + 7) / 8;
    }

    private unsafe template<type K, type V, type A>
    std::raw_ptr<mut btree_node<K, V>> bt_new(mut A& a, bool leaf) {
        std::raw_ptr<mut btree_node<K, V>> n = cast::reinterpret<std::raw_ptr<mut btree_node<K, V>>>(allocate_in<u64, A>(mut a, bt_words<K, V>(leaf)));
        std::raw::write(mut &(*n).len, 0u32);
        std::raw::write(mut &(*n).leaf, leaf);
        return n;
    }

    // The first index whose key is not less than `key`.
    private unsafe template<type K, type V>
    u32 bt_lower_bound(std::raw_ptr<mut btree_node<K, V>> n, K& key) {
        // A linear scan: nodes are short, and it reads keys in memory order.
        mut u32 i = 0;
        u32 len = (*n).len;
        while (i < len && *bt_key(n, i) < key) { i +%= 1; }
        return i;
    }

    // Moves keys and values `from..len` of node `n` one place right (or left with `left`).
    private unsafe template<type K, type V>
    void bt_shift(std::raw_ptr<mut btree_node<K, V>> n, u32 from, bool left) {
        u32 len = (*n).len;
        if (left) {
            std::raw::copy(bt_key(n, from), bt_key(n, from + 1), cast<usize>(len - from - 1));
            std::raw::copy(bt_value(n, from), bt_value(n, from + 1), cast<usize>(len - from - 1));
        } else {
            std::raw::copy(bt_key(n, from + 1), bt_key(n, from), cast<usize>(len - from));
            std::raw::copy(bt_value(n, from + 1), bt_value(n, from), cast<usize>(len - from));
        }
    }

    // Splits the full child `i` of `x` around its middle key, which moves up into `x`.
    private unsafe template<type K, type V, type A>
    void bt_free(mut A& a, std::raw_ptr<mut btree_node<K, V>> n) {
        free_in<u64, A>(mut a, cast::reinterpret<std::raw_ptr<mut u64>>(n), bt_words<K, V>((*n).leaf));
    }

    private unsafe template<type K, type V, type A>
    void bt_split_child(mut A& a, std::raw_ptr<mut btree_node<K, V>> x, u32 i) {
        std::raw_ptr<mut btree_node<K, V>> y = *bt_child(x, i);
        std::raw_ptr<mut btree_node<K, V>> z = bt_new<K, V, A>(mut a, (*y).leaf);
        u32 t = btree_degree;
        std::raw::copy(bt_key(z, 0), bt_key(y, t), cast<usize>(t - 1));
        std::raw::copy(bt_value(z, 0), bt_value(y, t), cast<usize>(t - 1));
        if (!(*y).leaf) { std::raw::copy(bt_child(z, 0), bt_child(y, t), cast<usize>(t)); }
        std::raw::write(mut &(*z).len, t - 1);
        std::raw::write(mut &(*y).len, t - 1);
        u32 len = (*x).len;
        std::raw::copy(bt_child(x, i + 2), bt_child(x, i + 1), cast<usize>(len - i));
        std::raw::write(bt_child(x, i + 1), z);
        bt_shift(x, i, false);
        std::raw::copy(bt_key(x, i), bt_key(y, t - 1), 1);
        std::raw::copy(bt_value(x, i), bt_value(y, t - 1), 1);
        std::raw::write(mut &(*x).len, len + 1);
    }

    // Merges child `i + 1` of `x` and the key between into child `i`; frees child `i + 1`.
    private unsafe template<type K, type V, type A>
    void bt_merge(mut A& a, std::raw_ptr<mut btree_node<K, V>> x, u32 i) {
        std::raw_ptr<mut btree_node<K, V>> y = *bt_child(x, i);
        std::raw_ptr<mut btree_node<K, V>> z = *bt_child(x, i + 1);
        u32 yl = (*y).len;
        u32 zl = (*z).len;
        std::raw::copy(bt_key(y, yl), bt_key(x, i), 1);
        std::raw::copy(bt_value(y, yl), bt_value(x, i), 1);
        std::raw::copy(bt_key(y, yl + 1), bt_key(z, 0), cast<usize>(zl));
        std::raw::copy(bt_value(y, yl + 1), bt_value(z, 0), cast<usize>(zl));
        if (!(*y).leaf) { std::raw::copy(bt_child(y, yl + 1), bt_child(z, 0), cast<usize>(zl + 1)); }
        std::raw::write(mut &(*y).len, yl + zl + 1);
        u32 len = (*x).len;
        bt_shift(x, i, true);
        std::raw::copy(bt_child(x, i + 1), bt_child(x, i + 2), cast<usize>(len - i - 1));
        std::raw::write(mut &(*x).len, len - 1);
        bt_free<K, V, A>(mut a, z);
    }

    // Makes child `i` of `x` hold at least t keys before the removal descends into it (borrowing
    // from a sibling or merging with one); returns the index of the child to descend into.
    private unsafe template<type K, type V, type A>
    u32 bt_fill(mut A& a, std::raw_ptr<mut btree_node<K, V>> x, u32 i) {
        std::raw_ptr<mut btree_node<K, V>> c = *bt_child(x, i);
        u32 t = btree_degree;
        if ((*c).len >= t) { return i; }
        if (i > 0 && (**bt_child(x, i - 1)).len >= t) {        // borrow from the left sibling
            std::raw_ptr<mut btree_node<K, V>> l = *bt_child(x, i - 1);
            u32 ll = (*l).len;
            bt_shift(c, 0, false);
            if (!(*c).leaf) { std::raw::copy(bt_child(c, 1), bt_child(c, 0), cast<usize>((*c).len + 1)); }
            std::raw::copy(bt_key(c, 0), bt_key(x, i - 1), 1);
            std::raw::copy(bt_value(c, 0), bt_value(x, i - 1), 1);
            if (!(*c).leaf) { std::raw::copy(bt_child(c, 0), bt_child(l, ll), 1); }
            std::raw::copy(bt_key(x, i - 1), bt_key(l, ll - 1), 1);
            std::raw::copy(bt_value(x, i - 1), bt_value(l, ll - 1), 1);
            std::raw::write(mut &(*c).len, (*c).len + 1);
            std::raw::write(mut &(*l).len, ll - 1);
            return i;
        }
        if (i < (*x).len && (**bt_child(x, i + 1)).len >= t) {  // borrow from the right sibling
            std::raw_ptr<mut btree_node<K, V>> r = *bt_child(x, i + 1);
            u32 cl = (*c).len;
            std::raw::copy(bt_key(c, cl), bt_key(x, i), 1);
            std::raw::copy(bt_value(c, cl), bt_value(x, i), 1);
            if (!(*c).leaf) { std::raw::copy(bt_child(c, cl + 1), bt_child(r, 0), 1); }
            std::raw::copy(bt_key(x, i), bt_key(r, 0), 1);
            std::raw::copy(bt_value(x, i), bt_value(r, 0), 1);
            bt_shift(r, 0, true);
            if (!(*r).leaf) { std::raw::copy(bt_child(r, 0), bt_child(r, 1), cast<usize>((*r).len)); }
            std::raw::write(mut &(*c).len, cl + 1);
            std::raw::write(mut &(*r).len, (*r).len - 1);
            return i;
        }
        if (i < (*x).len) {
            bt_merge<K, V, A>(mut a, x, i);
            return i;
        }
        bt_merge<K, V, A>(mut a, x, i - 1);
        return i - 1;
    }

    // Moves the smallest (`max` false) or largest entry of the subtree at `start` (which has at
    // least t keys) to `key_to` / `value_to`, and removes it from the subtree.
    private unsafe template<type K, type V, type A>
    void bt_take_end(mut A& a, std::raw_ptr<mut btree_node<K, V>> start, bool max, std::raw_ptr<mut K> key_to, std::raw_ptr<mut V> value_to) {
        mut std::raw_ptr<mut btree_node<K, V>> n = start;
        while (!(*n).leaf) {
            mut u32 i = 0;
            if (max) { i = (*n).len; }
            n = *bt_child(n, bt_fill<K, V, A>(mut a, n, i));
        }
        u32 len = (*n).len;
        mut u32 at = 0;
        if (max) { at = len - 1; }
        std::raw::copy(key_to, bt_key(n, at), 1);
        std::raw::copy(value_to, bt_value(n, at), 1);
        if (!max) { bt_shift(n, 0, true); }
        std::raw::write(mut &(*n).len, len - 1);
    }

    // Destroys every key and value below `n` and frees the nodes.
    private unsafe template<type K, type V, type A>
    void bt_destroy(mut A& a, std::raw_ptr<mut btree_node<K, V>> n) {
        u32 len = (*n).len;
        mut u32 i = 0;
        while (i < len) {
            std::raw::drop(bt_key(n, i));
            std::raw::drop(bt_value(n, i));
            i +%= 1;
        }
        if (!(*n).leaf) {
            mut u32 c = 0;
            while (c <= len) {
                bt_destroy<K, V, A>(mut a, *bt_child(n, c));
                c +%= 1;
            }
        }
        bt_free<K, V, A>(mut a, n);
    }

    template<type K, type V, type A>
    class tree_map {
        compile_time check (std::implements<K, std::comparable>())
            else f"'{std::type_name<K>()}' can't be a tree_map key: give it an 'operator<=>' (or @std::derive::ordered)";
    public:
        static tree_map<K, V, A> with_allocator(A alloc) {
            return tree_map<K, V, A>{ .alloc = alloc };
        }

        usize len() { return this.count; }

        bool is_empty() { return this.count == 0; }

        std::option<V> insert(K key, V value) mut {
            std::raw_ptr<mut V> existing = this.find(key);
            if (existing != nullptr) {
                unsafe { return std::some(std::replace(mut *existing, move value)); }
            }
            this.place(move key, move value);
            return std::none;
        }

        bool contains(K& key) { return this.find(key) != nullptr; }

        std::option<V&> get(K& key) {
            std::raw_ptr<mut V> v = this.find(key);
            if (v == nullptr) { return std::none; }
            unsafe { return std::some(*v); }
        }

        std::option<mut V&> get_mut(K& key) mut {
            std::raw_ptr<mut V> v = this.find(key);
            if (v == nullptr) { return std::none; }
            unsafe { return std::some(mut *v); }
        }

        std::option<V> remove(K& key) mut {
            if (!this.root) { return std::none; }
            unsafe {
                mut std::raw_ptr<mut btree_node<K, V>> n = this.root;
                mut std::option<V> out = std::none;
                while (true) {
                    u32 i = bt_lower_bound(n, key);
                    bool found = i < (*n).len && !(key < *bt_key(n, i));
                    if (found && (*n).leaf) {
                        std::raw::drop(bt_key(n, i));
                        out = std::some(std::raw::read(bt_value(n, i)));
                        bt_shift(n, i, true);
                        std::raw::write(mut &(*n).len, (*n).len - 1);
                        break;
                    }
                    if (found) {
                        std::raw_ptr<mut btree_node<K, V>> left = *bt_child(n, i);
                        std::raw_ptr<mut btree_node<K, V>> right = *bt_child(n, i + 1);
                        if ((*left).len >= btree_degree || (*right).len >= btree_degree) {
                            // The key is replaced by its neighbour from the fuller child.
                            bool from_left = (*left).len >= btree_degree;
                            std::raw_ptr<mut btree_node<K, V>> side = if (from_left) { left } else { right };
                            std::raw::drop(bt_key(n, i));
                            out = std::some(std::raw::read(bt_value(n, i)));
                            bt_take_end<K, V, A>(mut this.alloc, side, from_left, bt_key(n, i), bt_value(n, i));
                            break;
                        }
                        bt_merge<K, V, A>(mut this.alloc, n, i);   // both thin: merge, the key goes down
                        n = left;
                        continue;
                    }
                    if ((*n).leaf) { break; }
                    n = *bt_child(n, bt_fill<K, V, A>(mut this.alloc, n, i));
                }
                if ((*this.root).len == 0 && !(*this.root).leaf) {   // the root emptied: the tree shrinks
                    std::raw_ptr<mut btree_node<K, V>> old = this.root;
                    this.root = *bt_child(old, 0);
                    bt_free<K, V, A>(mut this.alloc, old);
                }
                if (out.is_some()) { this.count -= 1; }
                return out;
            }
        }

        V& operator[](K& key) {
            std::raw_ptr<mut V> v = this.find(key);
            run_time check (v != nullptr) else "key not found";
            unsafe { return *v; }
        }

        mut V& operator[](K& key) mut {
            std::raw_ptr<mut V> v = this.find(key);
            run_time check (v != nullptr) else "key not found";
            unsafe { return *v; }
        }

        mut V& get_or_insert(K key, V value) mut {
            std::raw_ptr<mut V> v = this.place(move key, move value);
            unsafe { return *v; }
        }

        tree_map_entries<K, V> entries() {
            mut tree_map_entries<K, V> it = default;
            unsafe { it.start(cast::reinterpret<std::raw_ptr<u8>>(this.root)); }
            return it;
        }

        std::option<map_entry<K, V>> first() {
            if (this.count == 0) { return std::none; }
            unsafe {
                mut std::raw_ptr<mut btree_node<K, V>> n = this.root;
                while (!(*n).leaf) { n = *bt_child(n, 0); }
                return std::some(map_entry<K, V>{ .key = *bt_key(n, 0), .value = *bt_value(n, 0) });
            }
        }

        std::option<map_entry<K, V>> last() {
            if (this.count == 0) { return std::none; }
            unsafe {
                mut std::raw_ptr<mut btree_node<K, V>> n = this.root;
                while (!(*n).leaf) { n = *bt_child(n, (*n).len); }
                u32 at = (*n).len - 1;
                return std::some(map_entry<K, V>{ .key = *bt_key(n, at), .value = *bt_value(n, at) });
            }
        }

        void clear() mut {
            unsafe {
                if (this.root) { bt_destroy<K, V, A>(mut this.alloc, this.root); }
            }
            this.root = nullptr;
            this.count = 0;
        }

        ~tree_map() { this.clear(); }

    private:
        std::raw_ptr<mut btree_node<K, V>> root = nullptr;
        usize count = 0;
        A alloc = default;
        // The value of `key`, or null.
        std::raw_ptr<mut V> find(K& key) {
            if (!this.root) { return nullptr; }
            unsafe {
                mut std::raw_ptr<mut btree_node<K, V>> n = this.root;
                while (true) {
                    u32 i = bt_lower_bound(n, key);
                    if (i < (*n).len && !(key < *bt_key(n, i))) { return bt_value(n, i); }
                    if ((*n).leaf) { return nullptr; }
                    n = *bt_child(n, i);
                }
            }
            return nullptr;
        }

        // The value of `key`: the existing one (then `key` and `value` are dropped), or `value`
        // inserted with `key`.
        std::raw_ptr<mut V> place(K key, V value) mut {
            unsafe {
                if (!this.root) { this.root = bt_new<K, V, A>(mut this.alloc, true); }
                if ((*this.root).len == btree_max) {                     // a full root: the tree grows a level
                    std::raw_ptr<mut btree_node<K, V>> top = bt_new<K, V, A>(mut this.alloc, false);
                    std::raw::write(bt_child(top, 0), this.root);
                    this.root = top;
                    bt_split_child<K, V, A>(mut this.alloc, top, 0);
                }
                mut std::raw_ptr<mut btree_node<K, V>> n = this.root;
                while (true) {
                    mut u32 i = bt_lower_bound(n, key);
                    if (i < (*n).len && !(key < *bt_key(n, i))) { return bt_value(n, i); }
                    if ((*n).leaf) {
                        bt_shift(n, i, false);
                        std::raw::write(bt_key(n, i), move key);
                        std::raw::write(bt_value(n, i), move value);
                        std::raw::write(mut &(*n).len, (*n).len + 1);
                        this.count += 1;
                        return bt_value(n, i);
                    }
                    if ((**bt_child(n, i)).len == btree_max) {
                        bt_split_child<K, V, A>(mut this.alloc, n, i);
                        if (!(key < *bt_key(n, i)) && !(*bt_key(n, i) < key)) { return bt_value(n, i); }
                        if (*bt_key(n, i) < key) { i += 1; }
                    }
                    n = *bt_child(n, i);
                }
            }
            return nullptr;
        }
    }

    // What `tree_map::entries()` returns: an in-order walk with an explicit stack.
    template<type K, type V>
    view class tree_map_entries {
    public:
        std::option<map_entry<K, V>> next() mut {
            unsafe {
                while (this.depth > 0) {
                    u32 d = this.depth - 1;
                    std::raw_ptr<mut btree_node<K, V>> n = *this.node_at(d);
                    u32 i = *this.index_at(d);
                    if (i < (*n).len) {
                        std::raw::write(this.index_at(d), i + 1);
                        if (!(*n).leaf) { this.descend(*bt_child(n, i + 1)); }
                        return std::some(map_entry<K, V>{ .key = *bt_key(n, i), .value = *bt_value(n, i) });
                    }
                    this.depth = d;
                }
            }
            return std::none;
        }

        unsafe void start(std::raw_ptr<u8> root) mut {
            this.depth = 0;
            if (root) { this.descend(cast::reinterpret<std::raw_ptr<mut btree_node<K, V>>>(root)); }
        }

    private:
        std::raw::array<std::raw_ptr<mut btree_node<K, V>>, 40> nodes = default;
        std::raw::array<u32, 40> indexes = default;
        u32 depth = 0;

        unsafe std::raw_ptr<mut std::raw_ptr<mut btree_node<K, V>>> node_at(u32 d) {
            return cast::reinterpret<std::raw_ptr<mut std::raw_ptr<mut btree_node<K, V>>>>(&this.nodes).offset(d);
        }

        unsafe std::raw_ptr<mut u32> index_at(u32 d) {
            return cast::reinterpret<std::raw_ptr<mut u32>>(&this.indexes).offset(d);
        }

        // Pushes `n` and its leftmost descendants.
        unsafe void descend(std::raw_ptr<mut btree_node<K, V>> node) mut {
            mut std::raw_ptr<mut btree_node<K, V>> n = node;
            while (true) {
                std::raw::write(this.node_at(this.depth), n);
                std::raw::write(this.index_at(this.depth), 0u32);
                this.depth += 1;
                if ((*n).leaf) { return; }
                n = *bt_child(n, 0);
            }
        }
    }

    // --- threads and synchronization (spec 27) ---------------------------------------------------

    private compile_time bool debug_mode() { return std::build::mode_is(std::build::mode::debug); }

    // Debug modes: the mutexes the running thread holds (the first 16), so that locking one twice
    // panics instead of hanging. Kept per thread, so a mutex is still just T and one 32-bit word.
    private thread_local mut std::raw::array<usize, 16> held_locks = default;
    private thread_local mut usize held_count = 0;

    private unsafe std::raw_ptr<mut usize> held_slots() { return cast::reinterpret<std::raw_ptr<mut usize>>(mut &held_locks); }

    private unsafe bool holds_lock(usize address) {
        mut usize i = 0;
        while (i < held_count && i < 16) {
            if (*held_slots().offset(i) == address) { return true; }
            i += 1;
        }
        return false;
    }

    private unsafe void note_locked(usize address) {
        if (held_count < 16) { std::raw::write(held_slots().offset(held_count), address); }
        held_count += 1;
    }

    private unsafe void note_unlocked(usize address) {
        mut usize i = 0;
        while (i < held_count && i < 16) {
            if (*held_slots().offset(i) == address) {
                mut usize last = held_count - 1;
                if (last > 15) { last = 15; }
                std::raw::write(held_slots().offset(i), *held_slots().offset(last));
                std::raw::write(held_slots().offset(last), 0);
                held_count -= 1;
                return;
            }
            i += 1;
        }
        if (held_count > 16) { held_count -= 1; }   // one beyond the first 16
    }

    template<type T>
    class atomic {
    public:
        compile_time check (std::is_integer<T>() || std::is_same<T, bool>() || std::is_same<T, char>() ||
                            std::type_name<T>().starts_with("std::raw_ptr<"))
            else f"std::atomic<{std::type_name<T>()}>: atomics hold an integer, bool, char or std::raw_ptr";
        compile_time check (std::size_of<T>() <= 8)
            else f"std::atomic<{std::type_name<T>()}> is not lock-free on this target (no {std::size_of<T>()}-byte compare-exchange); use a std::mutex";

        static atomic<T> make(T value) { return atomic<T>{ .value = value }; }

        T load(std::memory_order order) {
            compile_time check (order != std::memory_order::release && order != std::memory_order::acquire_release)
                else f"an atomic load can't use '{order}' ordering (use acquire, relaxed or sequentially_consistent)";
            unsafe { return std::raw::atomic_load(&this.value, order); }
        }

        void store(T desired, std::memory_order order) {
            compile_time check (order != std::memory_order::acquire && order != std::memory_order::acquire_release)
                else f"an atomic store can't use '{order}' ordering (use release, relaxed or sequentially_consistent)";
            unsafe { std::raw::atomic_store(&this.value, desired, order); }
        }

        T exchange(T desired, std::memory_order order) {
            compile_time check (true) else "";
            unsafe { return std::raw::atomic_exchange(&this.value, desired, order); }
        }

        std::result<T, T> compare_exchange(T expected, T desired, std::memory_order success, std::memory_order failure) {
            compile_time check (failure != std::memory_order::release && failure != std::memory_order::acquire_release)
                else f"a failed compare-exchange only reads: '{failure}' ordering doesn't apply (use acquire, relaxed or sequentially_consistent)";
            mut T seen = expected;
            unsafe {
                if (std::raw::atomic_compare_exchange(&this.value, mut &seen, desired, success, failure, false)) { return std::ok(seen); }
            }
            return std::error(seen);
        }

        std::result<T, T> compare_exchange_weak(T expected, T desired, std::memory_order success, std::memory_order failure) {
            compile_time check (failure != std::memory_order::release && failure != std::memory_order::acquire_release)
                else f"a failed compare-exchange only reads: '{failure}' ordering doesn't apply (use acquire, relaxed or sequentially_consistent)";
            mut T seen = expected;
            unsafe {
                if (std::raw::atomic_compare_exchange(&this.value, mut &seen, desired, success, failure, true)) { return std::ok(seen); }
            }
            return std::error(seen);
        }

        T fetch_wrapping_add(T v, std::memory_order order) {
            compile_time check (std::is_integer<T>()) else "fetch_wrapping_add needs an integer atomic";
            unsafe { return std::raw::atomic_fetch_add(&this.value, v, order); }
        }

        T fetch_wrapping_sub(T v, std::memory_order order) {
            compile_time check (std::is_integer<T>()) else "fetch_wrapping_sub needs an integer atomic";
            unsafe { return std::raw::atomic_fetch_sub(&this.value, v, order); }
        }

        T fetch_and(T v, std::memory_order order) {
            compile_time check (std::is_integer<T>()) else "fetch_and needs an integer atomic";
            unsafe { return std::raw::atomic_fetch_and(&this.value, v, order); }
        }

        T fetch_or(T v, std::memory_order order) {
            compile_time check (std::is_integer<T>()) else "fetch_or needs an integer atomic";
            unsafe { return std::raw::atomic_fetch_or(&this.value, v, order); }
        }

        T fetch_xor(T v, std::memory_order order) {
            compile_time check (std::is_integer<T>()) else "fetch_xor needs an integer atomic";
            unsafe { return std::raw::atomic_fetch_xor(&this.value, v, order); }
        }

    private:
        T value = default;
    }

    void atomic_fence(std::memory_order order) {
        unsafe { std::raw::atomic_fence(order); }
    }

    template<type T>
    struct cache_aligned {
        static cache_aligned<T> make(T value) { return cache_aligned<T>{ .value = move value }; }
        T& operator*() { return this.value; }
        mut T& operator*() mut { return this.value; }
    }

    // The lock word of a mutex: 0 free, 1 locked, 2 locked and someone may be sleeping on it
    // (Drepper, "Futexes Are Tricky"). An uncontended lock or unlock is one atomic operation.

    private unsafe bool try_lock_word(std::raw_ptr<u32> word) {
        mut u32 expected = 0;
        return std::raw::atomic_compare_exchange(word, mut &expected, 1, std::memory_order::acquire, std::memory_order::relaxed, false);
    }

    private unsafe void lock_word(std::raw_ptr<u32> word) {
        if (try_lock_word(word)) { return; }
        mut u32 spins = 0;
        while (spins < 100) {   // a short spin: the holder may be about to unlock
            if (std::raw::atomic_load(word, std::memory_order::relaxed) == 0 && try_lock_word(word)) { return; }
            std::raw::spin_hint();
            spins += 1;
        }
        while (std::raw::atomic_exchange(word, 2, std::memory_order::acquire) != 0) {
            std::raw::futex_wait(word, 2);
        }
    }

    // Like lock_word, but gives up at `deadline` (an instant's nanoseconds): whether it locked.
    private unsafe bool lock_word_until(std::raw_ptr<u32> word, u64 deadline) {
        if (try_lock_word(word)) { return true; }
        mut u32 spins = 0;
        while (spins < 100) {
            if (std::raw::atomic_load(word, std::memory_order::relaxed) == 0 && try_lock_word(word)) { return true; }
            std::raw::spin_hint();
            spins += 1;
        }
        while (std::raw::atomic_exchange(word, 2, std::memory_order::acquire) != 0) {
            u64 now = std::time::instant::now().nanos;
            if (now >= deadline) { return false; }
            std::raw::futex_wait_for(word, 2, deadline - now);
        }
        return true;
    }

    // The instant `d` from now, in nanoseconds, saturating instead of overflowing.
    private u64 deadline_after(std::time::duration d) {
        u64 now = std::time::instant::now().nanos;
        u64 wait = d.as_nanoseconds();
        if (wait > u64::max - now) { return u64::max; }
        return now + wait;
    }

    private unsafe void unlock_word(std::raw_ptr<u32> word) {
        if (std::raw::atomic_exchange(word, 0, std::memory_order::release) == 2) { std::raw::futex_wake(word, 1); }
    }

    template<type T>
    class mutex {
    public:
        static mutex<T> make(T value) { return mutex<T>{ .data = move value }; }

        mutex_guard<T> lock() {
            run_time(std::build::mode::debug) check (!this.held_here())
                else "this thread already holds this mutex: locking it again would wait forever";
            unsafe { lock_word(&this.state); }
            return this.guard();
        }

        std::option<mutex_guard<T>> try_lock() {
            mut bool locked = false;
            unsafe { locked = try_lock_word(&this.state); }
            if (!locked) { return std::none; }
            return std::some(this.guard());
        }

        std::option<mutex_guard<T>> try_lock_for(std::time::duration d) {
            run_time(std::build::mode::debug) check (!this.held_here())
                else "this thread already holds this mutex: waiting for it can only time out";
            u64 deadline = deadline_after(d);
            mut bool locked = false;
            unsafe { locked = lock_word_until(&this.state, deadline); }
            if (!locked) { return std::none; }
            return std::some(this.guard());
        }

    private:
        u32 state = 0;   // 0 free, 1 locked, 2 locked with sleepers
        T   data;

        bool held_here() {
            unsafe { return holds_lock(cast::reinterpret<usize>(&this)); }
        }

        mutex_guard<T> guard() {
            unsafe {
                if compile_time (debug_mode()) { note_locked(cast::reinterpret<usize>(&this)); }
                return mutex_guard<T>{ .lock = cast::reinterpret<std::raw_ptr<mut mutex<T>>>(&this), .held = true };
            }
        }
    }

    template<type T>
    view class mutex_guard {
    public:
        T& operator*() {
            unsafe { return (*this.lock).data; }
        }

        mut T& operator*() mut {
            unsafe { return (*this.lock).data; }
        }

        void unlock() move { this.release(); }

        ~mutex_guard() { this.release(); }

    private:
        std::raw_ptr<mut mutex<T>> lock;
        bool held = false;

        void release() mut {
            if (!this.held) { return; }
            this.held = false;
            unsafe {
                if compile_time (debug_mode()) { note_unlocked(cast::reinterpret<usize>(this.lock)); }
                unlock_word(&(*this.lock).state);
            }
        }

        void reacquire() mut {
            unsafe {
                lock_word(&(*this.lock).state);
                if compile_time (debug_mode()) { note_locked(cast::reinterpret<usize>(this.lock)); }
            }
            this.held = true;
        }
    }

    // The lock word of a rw_mutex: the number of readers in the low 29 bits, plus a writer bit, a
    // "writer waiting" bit (new readers wait behind it) and a "sleepers" bit (someone sleeps on the
    // word, so an unlock has to wake them).
    private compile_time u32 rw_writer   = 0x80000000;
    private compile_time u32 rw_waiting  = 0x40000000;
    private compile_time u32 rw_sleepers = 0x20000000;
    private compile_time u32 rw_readers  = 0x1FFFFFFF;

    private unsafe bool try_read_word(std::raw_ptr<u32> word) {
        mut u32 s = std::raw::atomic_load(word, std::memory_order::relaxed);
        while ((s & (rw_writer | rw_waiting)) == 0) {
            run_time check ((s & rw_readers) != rw_readers) else "too many readers of one std::rw_mutex";
            if (std::raw::atomic_compare_exchange(word, mut &s, s + 1, std::memory_order::acquire, std::memory_order::relaxed, false)) {
                return true;
            }
        }
        return false;
    }

    private unsafe bool try_write_word(std::raw_ptr<u32> word) {
        mut u32 s = std::raw::atomic_load(word, std::memory_order::relaxed);
        while ((s & (rw_writer | rw_readers)) == 0) {
            if (std::raw::atomic_compare_exchange(word, mut &s, rw_writer | (s & rw_sleepers), std::memory_order::acquire, std::memory_order::relaxed, false)) {
                return true;
            }
        }
        return false;
    }

    // Sleeps on the word while it holds `seen`, after marking that a sleeper is there (and, for a
    // writer, that a writer waits).
    private unsafe void rw_sleep(std::raw_ptr<u32> word, u32 seen, u32 bits) {
        mut u32 expected = seen;
        u32 marked = seen | rw_sleepers | bits;
        if (marked == seen || std::raw::atomic_compare_exchange(word, mut &expected, marked, std::memory_order::relaxed, std::memory_order::relaxed, false)) {
            std::raw::futex_wait(word, marked);
        }
    }

    private unsafe void read_lock_word(std::raw_ptr<u32> word) {
        mut u32 spins = 0;
        while (!try_read_word(word)) {
            if (spins < 100) {
                std::raw::spin_hint();
                spins += 1;
            } else {
                rw_sleep(word, std::raw::atomic_load(word, std::memory_order::relaxed), 0);
            }
        }
    }

    private unsafe void write_lock_word(std::raw_ptr<u32> word) {
        mut u32 spins = 0;
        while (!try_write_word(word)) {
            if (spins < 100) {
                std::raw::spin_hint();
                spins += 1;
            } else {
                rw_sleep(word, std::raw::atomic_load(word, std::memory_order::relaxed), rw_waiting);
            }
        }
    }

    private unsafe void read_unlock_word(std::raw_ptr<u32> word) {
        u32 old = std::raw::atomic_fetch_sub(word, 1, std::memory_order::release);
        if ((old & rw_readers) == 1 && (old & rw_sleepers) != 0) {   // the last reader, and someone sleeps
            _ = std::raw::atomic_fetch_and(word, ~rw_sleepers, std::memory_order::relaxed);
            std::raw::futex_wake(word, 0x7FFFFFFF);
        }
    }

    private unsafe void write_unlock_word(std::raw_ptr<u32> word) {
        if ((std::raw::atomic_exchange(word, 0, std::memory_order::release) & rw_sleepers) != 0) {
            std::raw::futex_wake(word, 0x7FFFFFFF);
        }
    }

    template<type T>
    class rw_mutex {
    public:
        static rw_mutex<T> make(T value) { return rw_mutex<T>{ .data = move value }; }

        read_guard<T> read() {
            unsafe {
                read_lock_word(&this.state);
                return read_guard<T>{ .lock = cast::reinterpret<std::raw_ptr<mut rw_mutex<T>>>(&this), .held = true };
            }
        }

        write_guard<T> write() {
            unsafe {
                write_lock_word(&this.state);
                return write_guard<T>{ .lock = cast::reinterpret<std::raw_ptr<mut rw_mutex<T>>>(&this), .held = true };
            }
        }

        std::option<read_guard<T>> try_read() {
            unsafe {
                if (!try_read_word(&this.state)) { return std::none; }
                return std::some(read_guard<T>{ .lock = cast::reinterpret<std::raw_ptr<mut rw_mutex<T>>>(&this), .held = true });
            }
        }

        std::option<write_guard<T>> try_write() {
            unsafe {
                if (!try_write_word(&this.state)) { return std::none; }
                return std::some(write_guard<T>{ .lock = cast::reinterpret<std::raw_ptr<mut rw_mutex<T>>>(&this), .held = true });
            }
        }

    private:
        u32 state = 0;
        T   data;
    }

    template<type T>
    view class read_guard {
    public:
        T& operator*() {
            unsafe { return (*this.lock).data; }
        }

        void unlock() move { this.release(); }

        ~read_guard() { this.release(); }

    private:
        std::raw_ptr<mut rw_mutex<T>> lock;
        bool held = false;

        void release() mut {
            if (!this.held) { return; }
            this.held = false;
            unsafe { read_unlock_word(&(*this.lock).state); }
        }
    }

    template<type T>
    view class write_guard {
    public:
        T& operator*() {
            unsafe { return (*this.lock).data; }
        }

        mut T& operator*() mut {
            unsafe { return (*this.lock).data; }
        }

        void unlock() move { this.release(); }

        ~write_guard() { this.release(); }

    private:
        std::raw_ptr<mut rw_mutex<T>> lock;
        bool held = false;

        void release() mut {
            if (!this.held) { return; }
            this.held = false;
            unsafe { write_unlock_word(&(*this.lock).state); }
        }
    }

    class condition {
    public:
        template<type T, type F>
        bool wait_for(mut mutex_guard<T>& guard, F ready, std::time::duration d) {
            u64 deadline = deadline_after(d);
            while (!ready(*guard)) {
                u64 now = std::time::instant::now().nanos;
                if (now >= deadline) { return false; }
                mut u32 seen = 0;
                unsafe { seen = std::raw::atomic_load(&this.sequence, std::memory_order::acquire); }
                guard.release();
                unsafe { std::raw::futex_wait_for(&this.sequence, seen, deadline - now); }
                guard.reacquire();
            }
            return true;
        }

        template<type T, type F>
        void wait(mut mutex_guard<T>& guard, F ready) {
            while (!ready(*guard)) {
                mut u32 seen = 0;
                unsafe { seen = std::raw::atomic_load(&this.sequence, std::memory_order::acquire); }
                guard.release();
                unsafe { std::raw::futex_wait(&this.sequence, seen); }
                guard.reacquire();
            }
        }

        void notify_one() {
            unsafe {
                _ = std::raw::atomic_fetch_add(&this.sequence, 1, std::memory_order::release);
                std::raw::futex_wake(&this.sequence, 1);
            }
        }

        void notify_all() {
            unsafe {
                _ = std::raw::atomic_fetch_add(&this.sequence, 1, std::memory_order::release);
                std::raw::futex_wake(&this.sequence, 0x7FFFFFFF);
            }
        }

    private:
        u32 sequence = 0;   // bumped by every notification; waiters sleep on it
    }

    // --- channels (spec 27) ----------------------------------------------------------------------
    // One heap block per channel, shared by the channel object and all its ends. Bounded: a
    // lock-free ring (Vyukov's MPMC queue): every slot has a turn number saying whether it waits for
    // a sender (2 * position) or a receiver (2 * position + 1, so that a ring of one slot works too), senders and receivers claim slots with one compare-exchange on their
    // own position, and the two positions sit on separate cache lines. Unbounded: a ring that
    // doubles, under a lock word. A thread sleeps (futex) only when the queue is full (sender) or
    // empty (receiver).

    private template<type T>
    struct channel_state {
        std::atomic<usize>                      handles = default;   // the channel object and all ends
        std::atomic<usize>                      senders = default;   // the senders and the channel object
        std::atomic<u32>                        closed = default;
        bool                                    bounded = false;
        usize                                   capacity = 0;
        std::raw_ptr<mut usize>                 turns = nullptr;     // bounded: the turn of each slot
        std::raw_ptr<mut T>                     values = nullptr;
        std::cache_aligned<std::atomic<usize>>  send_at = std::cache_aligned<std::atomic<usize>>::make(default);
        std::cache_aligned<std::atomic<usize>>  receive_at = std::cache_aligned<std::atomic<usize>>::make(default);
        u32                                     lock = 0;            // unbounded: guards first/count/capacity/values
        usize                                   first = 0;
        usize                                   count = 0;
        u32                                     items = 0;           // futex words: bumped on every send / receive / close
        u32                                     room = 0;
        u32                                     waiting_items = 0;   // threads sleeping on them
        u32                                     waiting_room = 0;
    }

    // Bumps the futex word and wakes its sleepers, if there may be any. The bump and the sleepers'
    // count are sequentially consistent with `sleep_until`'s, so a wake-up is never missed.
    private unsafe void signal(std::raw_ptr<u32> word, std::raw_ptr<u32> waiting, u32 count) {
        _ = std::raw::atomic_fetch_add(word, 1, std::memory_order::sequentially_consistent);
        if (std::raw::atomic_load(waiting, std::memory_order::sequentially_consistent) != 0) { std::raw::futex_wake(word, count); }
    }

    private unsafe template<type T>
    std::raw_ptr<mut channel_state<T>> new_channel_state(bool bounded, usize capacity) {
        std::raw_ptr<mut channel_state<T>> s = std::raw::allocate<channel_state<T>>(1);
        std::raw::write(s, channel_state<T>{ .bounded = bounded, .capacity = capacity });
        (*s).handles.store(1, std::memory_order::relaxed);
        (*s).senders.store(1, std::memory_order::relaxed);
        if (capacity > 0) {
            (*s).values = std::raw::allocate<T>(capacity);
            if (bounded) {
                (*s).turns = std::raw::allocate<usize>(capacity);
                mut usize i = 0;
                while (i < capacity) {
                    std::raw::write((*s).turns.offset(i), 2 * i);
                    i += 1;
                }
            }
        }
        return s;
    }

    private unsafe template<type T>
    void close_channel(std::raw_ptr<mut channel_state<T>> s) {
        if ((*s).closed.exchange(1, std::memory_order::sequentially_consistent) == 0) {
            signal(&(*s).items, &(*s).waiting_items, 0x7FFFFFFF);
            signal(&(*s).room, &(*s).waiting_room, 0x7FFFFFFF);
        }
    }

    // One sender (or the channel object) is gone; the last one closes the channel.
    private unsafe template<type T>
    void leave_as_sender(std::raw_ptr<mut channel_state<T>> s) {
        if ((*s).senders.fetch_wrapping_sub(1, std::memory_order::acquire_release) == 1) { close_channel(s); }
    }

    // One handle is gone; the last one destroys the values still queued and frees the channel.
    private unsafe template<type T>
    void release_channel(std::raw_ptr<mut channel_state<T>> s) {
        if ((*s).handles.fetch_wrapping_sub(1, std::memory_order::release) != 1) { return; }
        std::atomic_fence(std::memory_order::acquire);
        while (true) {
            std::option<T> left = take_value(s);
            if (left.is_none()) { break; }
        }
        if ((*s).values) { std::raw::free((*s).values); }
        if ((*s).turns) { std::raw::free((*s).turns); }
        std::raw::drop(s);
        std::raw::free(s);
    }

    // Puts `value` in if there is room: `none` when it did, otherwise the value comes back.
    private unsafe template<type T>
    std::option<T> put_value(std::raw_ptr<mut channel_state<T>> s, T value) {
        if (!(*s).bounded) {
            lock_word(&(*s).lock);
            if ((*s).count == (*s).capacity) { grow_ring(s); }
            usize at = ((*s).first + (*s).count) % (*s).capacity;
            std::raw::write((*s).values.offset(at), move value);
            (*s).count += 1;
            unlock_word(&(*s).lock);
            return std::none;
        }
        usize cap = (*s).capacity;
        mut usize pos = (*(*s).send_at).load(std::memory_order::relaxed);
        while (true) {
            std::raw_ptr<mut usize> turn = (*s).turns.offset(pos % cap);
            usize t = std::raw::atomic_load(turn, std::memory_order::acquire);
            if (t == 2 * pos) {   // the slot waits for this position's sender
                match ((*(*s).send_at).compare_exchange_weak(pos, pos + 1, std::memory_order::relaxed, std::memory_order::relaxed)) {
                    std::ok(_) => {
                        std::raw::write((*s).values.offset(pos % cap), move value);
                        std::raw::atomic_store(turn, 2 * pos + 1, std::memory_order::release);
                        return std::none;
                    },
                    std::error(now) => { pos = now; },
                }
            } else if (t < 2 * pos) {   // still holds the value of the previous round: full
                return std::some(move value);
            } else {
                pos = (*(*s).send_at).load(std::memory_order::relaxed);
            }
        }
        return std::none;
    }

    // Takes the next value out, or `none` when the queue is empty.
    private unsafe template<type T>
    std::option<T> take_value(std::raw_ptr<mut channel_state<T>> s) {
        if (!(*s).bounded) {
            lock_word(&(*s).lock);
            if ((*s).count == 0) {
                unlock_word(&(*s).lock);
                return std::none;
            }
            T out = std::raw::read((*s).values.offset((*s).first));
            (*s).first = ((*s).first + 1) % (*s).capacity;
            (*s).count -= 1;
            unlock_word(&(*s).lock);
            return std::some(move out);
        }
        usize cap = (*s).capacity;
        mut usize pos = (*(*s).receive_at).load(std::memory_order::relaxed);
        while (true) {
            std::raw_ptr<mut usize> turn = (*s).turns.offset(pos % cap);
            usize t = std::raw::atomic_load(turn, std::memory_order::acquire);
            if (t == 2 * pos + 1) {   // a sender filled the slot for this position
                match ((*(*s).receive_at).compare_exchange_weak(pos, pos + 1, std::memory_order::relaxed, std::memory_order::relaxed)) {
                    std::ok(_) => {
                        T out = std::raw::read((*s).values.offset(pos % cap));
                        std::raw::atomic_store(turn, 2 * (pos + cap), std::memory_order::release);
                        return std::some(move out);
                    },
                    std::error(now) => { pos = now; },
                }
            } else if (t < 2 * pos + 1) {   // not filled yet: empty
                return std::none;
            } else {
                pos = (*(*s).receive_at).load(std::memory_order::relaxed);
            }
        }
        return std::none;
    }

    // The unbounded ring is full: twice the room, values kept in order (called under the lock).
    private unsafe template<type T>
    void grow_ring(std::raw_ptr<mut channel_state<T>> s) {
        usize old = (*s).capacity;
        mut usize next = old * 2;
        if (next < 16) { next = 16; }
        std::raw_ptr<mut T> moved = std::raw::allocate<T>(next);
        mut usize i = 0;
        while (i < (*s).count) {
            std::raw::write(moved.offset(i), std::raw::read((*s).values.offset(((*s).first + i) % old)));
            i += 1;
        }
        if ((*s).values) { std::raw::free((*s).values); }
        (*s).values   = moved;
        (*s).capacity = next;
        (*s).first    = 0;
    }

    // Sleeps until the futex word moves on from `seen` (a send, a receive or a close happened).
    private unsafe void sleep_on(std::raw_ptr<u32> word, std::raw_ptr<u32> waiting, u32 seen) {
        _ = std::raw::atomic_fetch_add(waiting, 1, std::memory_order::sequentially_consistent);
        std::raw::futex_wait(word, seen);
        _ = std::raw::atomic_fetch_sub(waiting, 1, std::memory_order::sequentially_consistent);
    }

    // The same, waking up at most `ns` nanoseconds later.
    private unsafe void sleep_on_for(std::raw_ptr<u32> word, std::raw_ptr<u32> waiting, u32 seen, u64 ns) {
        _ = std::raw::atomic_fetch_add(waiting, 1, std::memory_order::sequentially_consistent);
        std::raw::futex_wait_for(word, seen, ns);
        _ = std::raw::atomic_fetch_sub(waiting, 1, std::memory_order::sequentially_consistent);
    }

    template<type T>
    class channel {
    public:
        static channel<T> bounded(usize capacity) {
            run_time check (capacity > 0) else "a bounded channel needs room for at least one value";
            unsafe { return channel<T>{ .state = new_channel_state<T>(true, capacity) }; }
        }

        static channel<T> unbounded() {
            unsafe { return channel<T>{ .state = new_channel_state<T>(false, 0) }; }
        }

        channel_sender<T> sender() {
            unsafe {
                _ = (*this.state).handles.fetch_wrapping_add(1, std::memory_order::relaxed);
                _ = (*this.state).senders.fetch_wrapping_add(1, std::memory_order::relaxed);
            }
            return channel_sender<T>{ .state = this.state };
        }

        channel_receiver<T> receiver() {
            unsafe { _ = (*this.state).handles.fetch_wrapping_add(1, std::memory_order::relaxed); }
            return channel_receiver<T>{ .state = this.state };
        }

        void close() {
            unsafe { close_channel(this.state); }
        }

        ~channel() {
            unsafe {
                leave_as_sender(this.state);
                release_channel(this.state);
            }
        }

    private:
        std::raw_ptr<mut channel_state<T>> state;
    }

    template<type T>
    class channel_sender {
    public:
        std::result<void, T> send(T value) {
            mut T pending = move value;
            unsafe {
                std::raw_ptr<mut channel_state<T>> s = this.state;
                while (true) {
                    if ((*s).closed.load(std::memory_order::acquire) != 0) { return std::error(move pending); }
                    u32 seen = std::raw::atomic_load(&(*s).room, std::memory_order::sequentially_consistent);
                    match (put_value(s, move pending)) {
                        std::none => {
                            signal(&(*s).items, &(*s).waiting_items, 1);
                            return std::ok();
                        },
                        std::some(back) => { pending = move back; },
                    }
                    if ((*s).closed.load(std::memory_order::acquire) != 0) { return std::error(move pending); }
                    sleep_on(&(*s).room, &(*s).waiting_room, seen);   // full: wait for a receive
                }
            }
            return std::error(move pending);
        }

        std::result<void, std::send_error<T>> try_send(T value) {
            unsafe {
                std::raw_ptr<mut channel_state<T>> s = this.state;
                if ((*s).closed.load(std::memory_order::acquire) != 0) { return std::error(std::send_error<T>::closed(move value)); }
                match (put_value(s, move value)) {
                    std::none => {
                        signal(&(*s).items, &(*s).waiting_items, 1);
                        return std::ok();
                    },
                    std::some(back) => { return std::error(std::send_error<T>::full(move back)); },
                }
            }
        }

        void close() {
            unsafe { close_channel(this.state); }
        }

        channel_sender<T> clone() {
            unsafe {
                _ = (*this.state).handles.fetch_wrapping_add(1, std::memory_order::relaxed);
                _ = (*this.state).senders.fetch_wrapping_add(1, std::memory_order::relaxed);
            }
            return channel_sender<T>{ .state = this.state };
        }

        ~channel_sender() {
            unsafe {
                leave_as_sender(this.state);
                release_channel(this.state);
            }
        }

    private:
        std::raw_ptr<mut channel_state<T>> state;
    }

    template<type T>
    class channel_receiver {
    public:
        std::option<T> receive() {
            unsafe {
                std::raw_ptr<mut channel_state<T>> s = this.state;
                while (true) {
                    u32 seen = std::raw::atomic_load(&(*s).items, std::memory_order::sequentially_consistent);
                    match (take_value(s)) {
                        std::some(v) => {
                            signal(&(*s).room, &(*s).waiting_room, 1);
                            return std::some(move v);
                        },
                        std::none => { },
                    }
                    if ((*s).closed.load(std::memory_order::acquire) != 0) {
                        // Closed: what was sent before the close is still delivered.
                        match (take_value(s)) {
                            std::some(v) => { return std::some(move v); },
                            std::none => { return std::none; },
                        }
                    }
                    sleep_on(&(*s).items, &(*s).waiting_items, seen);   // empty: wait for a send or a close
                }
            }
            return std::none;
        }

        std::result<T, std::receive_error> try_receive() {
            unsafe {
                std::raw_ptr<mut channel_state<T>> s = this.state;
                match (take_value(s)) {
                    std::some(v) => {
                        signal(&(*s).room, &(*s).waiting_room, 1);
                        return std::ok(move v);
                    },
                    std::none => { },
                }
                if ((*s).closed.load(std::memory_order::acquire) != 0) { return std::error(std::receive_error::closed); }
            }
            return std::error(std::receive_error::empty);
        }

        std::result<T, std::receive_error> receive_for(std::time::duration d) {
            u64 deadline = deadline_after(d);
            unsafe {
                std::raw_ptr<mut channel_state<T>> s = this.state;
                while (true) {
                    u32 seen = std::raw::atomic_load(&(*s).items, std::memory_order::sequentially_consistent);
                    match (take_value(s)) {
                        std::some(v) => {
                            signal(&(*s).room, &(*s).waiting_room, 1);
                            return std::ok(move v);
                        },
                        std::none => { },
                    }
                    if ((*s).closed.load(std::memory_order::acquire) != 0) {
                        match (take_value(s)) {
                            std::some(v) => { return std::ok(move v); },
                            std::none => { return std::error(std::receive_error::closed); },
                        }
                    }
                    u64 now = std::time::instant::now().nanos;
                    if (now >= deadline) { return std::error(std::receive_error::timed_out); }
                    sleep_on_for(&(*s).items, &(*s).waiting_items, seen, deadline - now);
                }
            }
            return std::error(std::receive_error::closed);
        }

        std::option<T> next() { return this.receive(); }

        channel_receiver<T> clone() {
            unsafe { _ = (*this.state).handles.fetch_wrapping_add(1, std::memory_order::relaxed); }
            return channel_receiver<T>{ .state = this.state };
        }

        ~channel_receiver() {
            unsafe { release_channel(this.state); }
        }

    private:
        std::raw_ptr<mut channel_state<T>> state;
    }

    // --- thread pool (spec 28) ------------------------------------------------------------------
    // Every worker has a Chase-Lev deque of jobs: it pushes and pops at the bottom without contention,
    // idle workers steal from the top. Jobs from threads outside the pool go into a shared queue (the
    // injector). A job is the address of a `pool_job` that starts the struct it belongs to: a task
    // block on the heap (spawn), or a part of a loop on the stack of the thread that split it
    // (for_chunks, reduce_chunks), so loops allocate nothing.

    private extern(std::build::language::c) {
        i32 pthread_create(std::raw_ptr<mut u64> thread, std::raw_ptr<u8> attributes,
                           std::fn_ptr<std::raw_ptr<u8>(std::raw_ptr<u8>)> start, std::raw_ptr<u8> argument);
        i32 pthread_join(u64 thread, std::raw_ptr<u8> result);
        i32 pthread_attr_init(std::raw_ptr<mut u8> attributes);
        i32 pthread_attr_setstacksize(std::raw_ptr<mut u8> attributes, usize size);
        i32 pthread_attr_destroy(std::raw_ptr<mut u8> attributes);
        i32 pthread_setname_np(u64 thread, std::raw_ptr<u8> name);
    }

    private struct pool_job {
        std::fn_ptr<void(std::raw_ptr<u8>)> run;
    }

    private compile_time usize pool_deque_size = 4096;   // jobs per worker deque (a power of two)

    private struct pool_worker {
        std::cache_aligned<std::atomic<isize>> top = std::cache_aligned<std::atomic<isize>>::make(default);
        std::cache_aligned<std::atomic<isize>> bottom = std::cache_aligned<std::atomic<isize>>::make(default);
        std::raw_ptr<mut usize>                slots = nullptr;
        u64                                    thread = 0;
    }

    private struct pool_state {
        std::raw_ptr<mut pool_worker> workers = nullptr;
        usize                         count = 0;
        u64                           idle_spin = 0;   // nanoseconds
        std::atomic<u32>              stopping = default;
        u32                           signal = 0;      // futex word: bumped when work arrives
        u32                           sleepers = 0;
        u32                           injector_lock = 0;
        std::raw_ptr<mut usize>       injector = nullptr;
        usize                         injector_room = 0;
        usize                         injector_first = 0;
        std::atomic<usize>            injector_count = default;
    }

    private struct pool_start {
        std::raw_ptr<mut pool_state> state;
        usize                        index;
    }

    // The pool and the worker index (+ 1) of the running thread: 0 outside every pool.
    private thread_local mut usize pool_current = 0;
    private thread_local mut usize pool_index = 0;

    private unsafe usize address_of_job(std::raw_ptr<mut pool_job> job) { return cast::reinterpret<usize>(job); }
    private unsafe std::raw_ptr<mut pool_job> job_at(usize address) { return cast::reinterpret<std::raw_ptr<mut pool_job>>(address); }

    // The calling thread's worker in `pool`, or `none` outside it.
    private unsafe std::option<usize> worker_of(std::raw_ptr<mut pool_state> pool) {
        if (pool_index == 0 || pool_current != cast::reinterpret<usize>(pool)) { return std::none; }
        return std::some(pool_index - 1);
    }

    // Wakes a sleeping worker, if there is one.
    private unsafe void pool_wake(std::raw_ptr<mut pool_state> pool) {
        _ = std::raw::atomic_fetch_add(&(*pool).signal, 1, std::memory_order::sequentially_consistent);
        if (std::raw::atomic_load(&(*pool).sleepers, std::memory_order::sequentially_consistent) != 0) {
            std::raw::futex_wake(&(*pool).signal, 1);
        }
    }

    // Queues `job`: on the calling worker's deque, or on the injector from outside the pool. False
    // when the deque is full (the caller runs the job itself).
    private unsafe bool pool_push(std::raw_ptr<mut pool_state> pool, std::raw_ptr<mut pool_job> job) {
        match (worker_of(pool)) {
            std::some(i) => {
                std::raw_ptr<mut pool_worker> w = (*pool).workers.offset(i);
                isize b = (*(*w).bottom).load(std::memory_order::relaxed);
                isize t = (*(*w).top).load(std::memory_order::acquire);
                if (b - t >= cast::reinterpret<isize>(pool_deque_size)) { return false; }
                std::raw::atomic_store((*w).slots.offset(cast::reinterpret<usize>(b) & (pool_deque_size - 1)), address_of_job(job),
                                       std::memory_order::relaxed);
                (*(*w).bottom).store(b + 1, std::memory_order::release);
            },
            std::none => {
                lock_word(&(*pool).injector_lock);
                usize n = (*pool).injector_count.load(std::memory_order::relaxed);
                if (n == (*pool).injector_room) { grow_injector(pool); }
                std::raw::write((*pool).injector.offset(((*pool).injector_first + n) % (*pool).injector_room), address_of_job(job));
                (*pool).injector_count.store(n + 1, std::memory_order::release);
                unlock_word(&(*pool).injector_lock);
            },
        }
        pool_wake(pool);
        return true;
    }

    private unsafe void grow_injector(std::raw_ptr<mut pool_state> pool) {
        usize old = (*pool).injector_room;
        mut usize next = old * 2;
        if (next < 64) { next = 64; }
        std::raw_ptr<mut usize> moved = std::raw::allocate<usize>(next);
        usize n = (*pool).injector_count.load(std::memory_order::relaxed);
        mut usize i = 0;
        while (i < n) {
            std::raw::write(moved.offset(i), std::raw::read((*pool).injector.offset(((*pool).injector_first + i) % old)));
            i += 1;
        }
        if ((*pool).injector) { std::raw::free((*pool).injector); }
        (*pool).injector       = moved;
        (*pool).injector_room  = next;
        (*pool).injector_first = 0;
    }

    // The newest job of worker `i`'s own deque (the owner only).
    private unsafe std::raw_ptr<mut pool_job> pool_pop(std::raw_ptr<mut pool_state> pool, usize i) {
        std::raw_ptr<mut pool_worker> w = (*pool).workers.offset(i);
        isize b = (*(*w).bottom).load(std::memory_order::relaxed) - 1;
        (*(*w).bottom).store(b, std::memory_order::relaxed);
        std::atomic_fence(std::memory_order::sequentially_consistent);
        isize t = (*(*w).top).load(std::memory_order::relaxed);
        if (t > b) {   // empty
            (*(*w).bottom).store(b + 1, std::memory_order::relaxed);
            return nullptr;
        }
        usize found = std::raw::atomic_load((*w).slots.offset(cast::reinterpret<usize>(b) & (pool_deque_size - 1)), std::memory_order::relaxed);
        if (t == b) {   // the last one: race the thieves for it
            bool won = (*(*w).top).compare_exchange(t, t + 1, std::memory_order::sequentially_consistent, std::memory_order::relaxed).is_ok();
            (*(*w).bottom).store(b + 1, std::memory_order::relaxed);
            if (!won) { return nullptr; }
        }
        return job_at(found);
    }

    // The oldest job of worker `i`'s deque, taken by another thread.
    private unsafe std::raw_ptr<mut pool_job> pool_steal(std::raw_ptr<mut pool_state> pool, usize i) {
        std::raw_ptr<mut pool_worker> w = (*pool).workers.offset(i);
        isize t = (*(*w).top).load(std::memory_order::acquire);
        std::atomic_fence(std::memory_order::sequentially_consistent);
        isize b = (*(*w).bottom).load(std::memory_order::acquire);
        if (t >= b) { return nullptr; }
        usize found = std::raw::atomic_load((*w).slots.offset(cast::reinterpret<usize>(t) & (pool_deque_size - 1)), std::memory_order::relaxed);
        if ((*(*w).top).compare_exchange(t, t + 1, std::memory_order::sequentially_consistent, std::memory_order::relaxed).is_error()) {
            return nullptr;
        }
        return job_at(found);
    }

    private unsafe std::raw_ptr<mut pool_job> pool_take_injected(std::raw_ptr<mut pool_state> pool) {
        if ((*pool).injector_count.load(std::memory_order::acquire) == 0) { return nullptr; }
        lock_word(&(*pool).injector_lock);
        usize n = (*pool).injector_count.load(std::memory_order::relaxed);
        if (n == 0) {
            unlock_word(&(*pool).injector_lock);
            return nullptr;
        }
        usize found = std::raw::read((*pool).injector.offset((*pool).injector_first));
        (*pool).injector_first = ((*pool).injector_first + 1) % (*pool).injector_room;
        (*pool).injector_count.store(n - 1, std::memory_order::release);
        unlock_word(&(*pool).injector_lock);
        return job_at(found);
    }

    // A job for the calling thread: its own newest, a stolen one, or one from the injector.
    private unsafe std::raw_ptr<mut pool_job> pool_find(std::raw_ptr<mut pool_state> pool) {
        mut usize start = 0;
        match (worker_of(pool)) {
            std::some(i) => {
                std::raw_ptr<mut pool_job> own = pool_pop(pool, i);
                if (own) { return own; }
                start = i + 1;
            },
            std::none => { },
        }
        mut usize k = 0;
        while (k < (*pool).count) {
            std::raw_ptr<mut pool_job> stolen = pool_steal(pool, (start + k) % (*pool).count);
            if (stolen) { return stolen; }
            k += 1;
        }
        return pool_take_injected(pool);
    }

    private unsafe bool pool_has_work(std::raw_ptr<mut pool_state> pool) {
        if ((*pool).injector_count.load(std::memory_order::acquire) != 0) { return true; }
        mut usize i = 0;
        while (i < (*pool).count) {
            std::raw_ptr<mut pool_worker> w = (*pool).workers.offset(i);
            if ((*(*w).bottom).load(std::memory_order::acquire) > (*(*w).top).load(std::memory_order::acquire)) { return true; }
            i += 1;
        }
        return false;
    }

    private unsafe void pool_run(std::raw_ptr<mut pool_job> job) {
        std::fn_ptr<void(std::raw_ptr<u8>)> run = (*job).run;
        run(cast::reinterpret<std::raw_ptr<u8>>(job));
    }

    // Runs jobs of the pool until the futex word `done` is no longer 0: a joining thread never sits
    // idle (spec 28). It spins briefly when there is nothing to do, then sleeps on `done`.
    private unsafe void pool_help_until(std::raw_ptr<mut pool_state> pool, std::raw_ptr<u32> done) {
        mut u32 idle = 0;
        while (std::raw::atomic_load(done, std::memory_order::acquire) == 0) {
            std::raw_ptr<mut pool_job> job = pool_find(pool);
            if (job) {
                pool_run(job);
                idle = 0;
            } else if (idle < 2000) {
                std::raw::spin_hint();
                idle += 1;
            } else {
                std::raw::futex_wait(done, 0);
            }
        }
    }

    // Marks a job's futex word done and wakes its joiner.
    private unsafe void pool_finish(std::raw_ptr<u32> done) {
        std::raw::atomic_store(done, 1, std::memory_order::release);
        std::raw::futex_wake(done, 0x7FFFFFFF);
    }

    private unsafe void pool_worker_main(std::raw_ptr<u8> argument) {
        std::raw_ptr<mut pool_start> start = cast::reinterpret<std::raw_ptr<mut pool_start>>(argument);
        std::raw_ptr<mut pool_state> pool = (*start).state;
        pool_current = cast::reinterpret<usize>(pool);
        pool_index   = (*start).index + 1;
        std::raw::free(start);
        while (true) {
            std::raw_ptr<mut pool_job> job = pool_find(pool);
            if (job) {
                pool_run(job);
                continue;
            }
            if ((*pool).stopping.load(std::memory_order::acquire) != 0 && !pool_has_work(pool)) { return; }
            // Idle: spin for the pool's idle_spin, then sleep until work arrives.
            std::time::instant began = std::time::instant::now();
            mut bool found = false;
            mut u32 spins = 0;
            while (!found) {
                if (pool_has_work(pool) || (*pool).stopping.load(std::memory_order::acquire) != 0) { found = true; }
                else {
                    std::raw::spin_hint();
                    spins += 1;
                    if ((spins & 63) == 0 && began.elapsed().as_nanoseconds() >= (*pool).idle_spin) { break; }
                }
            }
            if (found) { continue; }
            _ = std::raw::atomic_fetch_add(&(*pool).sleepers, 1, std::memory_order::sequentially_consistent);
            u32 seen = std::raw::atomic_load(&(*pool).signal, std::memory_order::sequentially_consistent);
            if (!pool_has_work(pool) && (*pool).stopping.load(std::memory_order::acquire) == 0) {
                std::raw::futex_wait(&(*pool).signal, seen);
            }
            _ = std::raw::atomic_fetch_sub(&(*pool).sleepers, 1, std::memory_order::sequentially_consistent);
        }
    }

    // --- tasks ---

    private template<type R>
    struct pool_task_head {
        pool_job                     job;
        u32                          state = 0;   // 0 queued or running, 1 finished, 2 detached; joiners sleep on it
        std::raw_ptr<mut pool_state> pool = nullptr;
        std::option<R>               result = std::none;
    }

    private template<type F, type R>
    struct pool_task_block {
        pool_task_head<R> head;
        F                 body;
    }

    private compile_time u32 task_finished = 1;
    private compile_time u32 task_detached = 2;

    private unsafe template<type F, type R>
    void run_pool_task(std::raw_ptr<u8> argument) {
        std::raw_ptr<mut pool_task_block<F, R>> block = cast::reinterpret<std::raw_ptr<mut pool_task_block<F, R>>>(argument);
        (*block).head.result = std::some(call_task_body<F, R>(mut (*block).body));
        std::raw::drop(mut &(*block).body);
        if (std::raw::atomic_exchange(&(*block).head.state, task_finished, std::memory_order::acquire_release) == task_detached) {
            std::raw::drop(mut &(*block).head);
            std::raw::free(block);
            return;
        }
        std::raw::futex_wake(&(*block).head.state, 0x7FFFFFFF);
    }

    private template<type F, type R>
    R call_task_body(mut F& body) { return body(); }

    // Waits for a task (helping the pool) and takes its result; frees the block.
    private unsafe template<type R>
    std::option<R> join_task(std::raw_ptr<mut pool_task_head<R>> head) {
        if (std::raw::atomic_load(&(*head).state, std::memory_order::acquire) == 0) { pool_help_until((*head).pool, &(*head).state); }
        std::option<R> result = std::raw::read(mut &(*head).result);
        std::raw::free(head);
        return result;
    }


    // --- loops ---

    // A parallel loop over `count` chunks; `call(context, chunk)` does one. Lives on the stack of
    // the thread that runs the loop.
    private struct chunk_loop {
        std::raw_ptr<mut pool_state>                   pool;
        std::raw_ptr<u8>                               context;
        std::fn_ptr<void(std::raw_ptr<u8>, usize)>     call;
    }

    // The right half of a split, queued for other threads; on the stack of the thread that split.
    private struct chunk_part {
        pool_job                job;
        u32                     done = 0;
        std::raw_ptr<chunk_loop> lp = nullptr;
        usize                   first = 0;
        usize                   end = 0;
    }

    private unsafe void run_chunk_part(std::raw_ptr<u8> argument) {
        std::raw_ptr<mut chunk_part> part = cast::reinterpret<std::raw_ptr<mut chunk_part>>(argument);
        run_chunk_range((*part).lp, (*part).first, (*part).end);
        pool_finish(&(*part).done);
    }

    // Runs chunks `first..end`: halves until one chunk is left, queueing the right halves so that
    // idle threads steal large pieces first.
    private unsafe void run_chunk_range(std::raw_ptr<chunk_loop> lp, usize first, usize end) {
        if (end - first == 1) {
            std::fn_ptr<void(std::raw_ptr<u8>, usize)> call = (*lp).call;
            call((*lp).context, first);
            return;
        }
        usize mid = first + (end - first) / 2;
        mut chunk_part right = chunk_part{ .job = pool_job{ .run = [](std::raw_ptr<u8> p) -> void { run_chunk_part(p); } },
                                           .lp = lp, .first = mid, .end = end };
        std::raw_ptr<mut pool_job> job = cast::reinterpret<std::raw_ptr<mut pool_job>>(mut &right);
        if (!pool_push((*lp).pool, job)) {   // the deque is full: no split
            run_chunk_range(lp, first, mid);
            run_chunk_range(lp, mid, end);
            return;
        }
        run_chunk_range(lp, first, mid);
        take_back_or_help((*lp).pool, job, &right.done);
    }

    // After the left half: run the right half here if nobody stole it, otherwise help until it is done.
    private unsafe void take_back_or_help(std::raw_ptr<mut pool_state> pool, std::raw_ptr<mut pool_job> job, std::raw_ptr<u32> done) {
        match (worker_of(pool)) {
            std::some(i) => {
                std::raw_ptr<mut pool_job> top = pool_pop(pool, i);
                if (top == job) {
                    pool_run(job);   // not stolen: the deque's newest job is ours
                    return;
                }
                if (top) { pool_run(top); }
            },
            std::none => { },
        }
        pool_help_until(pool, done);
    }

    private template<type T, type F>
    struct chunk_context {
        std::raw_ptr<mut T> data;
        usize               len;
        usize               size;
        std::raw_ptr<F>     body;
    }

    private template<type F, type A>
    void call_with(F& body, A argument) { body(move argument); }

    private template<type F>
    void call_range(F& body, usize from, usize to) { body(from, to); }

    // How many chunks of `size` cover `len` elements.
    private usize chunk_count(usize len, usize size) {
        run_time check (size > 0) else "a chunk size of 0";
        return (len + size - 1) / size;
    }

    private unsafe void run_loop(std::raw_ptr<mut pool_state> pool, std::raw_ptr<u8> context,
                                 std::fn_ptr<void(std::raw_ptr<u8>, usize)> call, usize chunks) {
        if (chunks == 0) { return; }
        chunk_loop lp = chunk_loop{ .pool = pool, .context = context, .call = call };
        run_chunk_range(&lp, 0, chunks);
    }

    // --- reductions ---

    private template<type T, type R, type M, type C>
    struct reduce_context {
        std::raw_ptr<T> data;
        usize           len;
        usize           size;
        std::raw_ptr<M> map;
        std::raw_ptr<C> combine;
        std::raw_ptr<mut pool_state> pool;
    }

    private template<type T, type R, type M, type C>
    struct reduce_part {
        pool_job                                job;
        u32                                     done = 0;
        std::raw_ptr<reduce_context<T, R, M, C>> context = nullptr;
        usize                                   first = 0;
        usize                                   end = 0;
        std::option<R>                          result = std::none;
    }

    private template<type M, type T, type R>
    R call_map(M& map, std::span<T> part) { return map(part); }

    private template<type C, type R>
    R call_combine(C& combine, R a, R b) { return combine(move a, move b); }

    private unsafe template<type T, type R, type M, type C>
    void run_reduce_part(std::raw_ptr<u8> argument) {
        std::raw_ptr<mut reduce_part<T, R, M, C>> part = cast::reinterpret<std::raw_ptr<mut reduce_part<T, R, M, C>>>(argument);
        (*part).result = std::some(reduce_range<T, R, M, C>((*part).context, (*part).first, (*part).end));
        pool_finish(&(*part).done);
    }

    // The reduction of chunks `first..end`, combined as a fixed binary tree: the split points depend
    // only on the chunk indices, so the result doesn't depend on which thread ran what.
    private unsafe template<type T, type R, type M, type C>
    R reduce_range(std::raw_ptr<reduce_context<T, R, M, C>> ctx, usize first, usize end) {
        if (end - first == 1) {
            usize from = first * (*ctx).size;
            mut usize n = (*ctx).size;
            if (from + n > (*ctx).len) { n = (*ctx).len - from; }
            return call_map<M, T, R>(*(*ctx).map, std::span<T>::from_raw((*ctx).data.offset(from), n));
        }
        usize mid = first + (end - first) / 2;
        mut reduce_part<T, R, M, C> right = reduce_part<T, R, M, C>{
            .job = pool_job{ .run = [](std::raw_ptr<u8> p) -> void { run_reduce_part<T, R, M, C>(p); } },
            .context = ctx, .first = mid, .end = end };
        std::raw_ptr<mut pool_job> job = cast::reinterpret<std::raw_ptr<mut pool_job>>(mut &right);
        if (!pool_push((*ctx).pool, job)) {
            R a = reduce_range<T, R, M, C>(ctx, first, mid);
            R b = reduce_range<T, R, M, C>(ctx, mid, end);
            return call_combine<C, R>(*(*ctx).combine, move a, move b);
        }
        R left = reduce_range<T, R, M, C>(ctx, first, mid);
        take_back_or_help((*ctx).pool, job, &right.done);
        R taken = std::take(mut right.result).expect("a part of the reduction produced no result");
        return call_combine<C, R>(*(*ctx).combine, move left, move taken);
    }

    class thread_pool {
    public:
        template<type R>
        class task {
        public:
            compile_time check (std::implements<R, std::sendable>())
                else f"the task's result type {std::type_name<R>()} can't be moved back to the thread that joins it (it isn't std::sendable)";

            R join() move {
                std::raw_ptr<mut pool_task_head<R>> header = this.head;
                this.head = nullptr;
                unsafe { return join_task(header).expect("the task produced no result"); }
            }

            void detach() move {
                std::raw_ptr<mut pool_task_head<R>> header = this.head;
                this.head = nullptr;
                unsafe {
                    if (std::raw::atomic_exchange(&(*header).state, task_detached, std::memory_order::acquire_release) == task_finished) {
                        std::raw::drop(header);
                        std::raw::free(header);
                    }
                }
            }

            ~task() {
                if (this.head) {
                    unsafe { _ = join_task(this.head); }
                }
            }

        private:
            std::raw_ptr<mut pool_task_head<R>> head = nullptr;
        }

        template<type R>
        view class scoped_task {
        public:
            compile_time check (std::implements<R, std::sendable>())
                else f"the task's result type {std::type_name<R>()} can't be moved back to the thread that joins it (it isn't std::sendable)";

            R join() move {
                std::raw_ptr<mut pool_task_head<R>> header = this.head;
                this.head = nullptr;
                unsafe { return join_task(header).expect("the task produced no result"); }
            }

            ~scoped_task() {
                if (this.head) {
                    unsafe { _ = join_task(this.head); }
                }
            }

        private:
            std::raw_ptr<mut pool_task_head<R>> head = nullptr;
        }

        static thread_pool make(options settings) {
            compile_time check (std::build::target_has(std::build::capability::threads)) else "std::thread_pool needs a target with threads";
            run_time check (settings.threads > 0) else "a thread pool needs at least one thread";
            unsafe {
                std::raw_ptr<mut pool_state> pool = std::raw::allocate<pool_state>(1);
                std::raw::write(pool, pool_state{ .count = settings.threads, .idle_spin = settings.idle_spin.as_nanoseconds() });
                (*pool).workers = std::raw::allocate<pool_worker>(settings.threads);
                mut usize i = 0;
                while (i < settings.threads) {
                    std::raw::write((*pool).workers.offset(i), pool_worker{ .slots = std::raw::allocate<usize>(pool_deque_size) });
                    i += 1;
                }
                i = 0;
                while (i < settings.threads) {
                    std::raw_ptr<mut pool_start> start = std::raw::allocate<pool_start>(1);
                    std::raw::write(start, pool_start{ .state = pool, .index = i });
                    std::fn_ptr<std::raw_ptr<u8>(std::raw_ptr<u8>)> entry = [](std::raw_ptr<u8> argument) -> std::raw_ptr<u8> {
                        pool_worker_main(argument);
                        return argument;
                    };
                    mut std::raw::array<u64, 8> attributes = default;
                    std::raw_ptr<mut u8> attr = cast::reinterpret<std::raw_ptr<mut u8>>(mut &attributes);
                    _ = pthread_attr_init(attr);
                    if (settings.stack_size > 0) { _ = pthread_attr_setstacksize(attr, settings.stack_size); }
                    mut u64 thread = 0;
                    i32 failed = pthread_create(mut &thread, attr, entry, cast::reinterpret<std::raw_ptr<u8>>(start));
                    _ = pthread_attr_destroy(attr);
                    run_time check (failed == 0) else "std::thread_pool::make: the operating system can't start another thread";
                    (*(*pool).workers.offset(i)).thread = thread;
                    std::string name = std::format(f"{settings.name}-{i}");
                    mut std::raw::array<u8, 16> bytes = default;
                    std::raw_ptr<mut u8> out = cast::reinterpret<std::raw_ptr<mut u8>>(mut &bytes);
                    mut usize k = 0;
                    while (k < 15 && k < name.len()) {
                        std::raw::write(out.offset(k), *name.as_str().as_ptr().offset(k));
                        k += 1;
                    }
                    _ = pthread_setname_np(thread, out);
                    i += 1;
                }
                return thread_pool{ .state = pool };
            }
        }

        usize thread_count() {
            unsafe { return (*this.state).count; }
        }

        template<type F : std::sendable>
        deduce spawn(F f) {
            compile_time type R = std::meta::result_of<F>();
            mut std::raw_ptr<mut pool_task_head<R>> head = nullptr;
            unsafe {
                std::raw_ptr<mut pool_task_block<F, R>> block = std::raw::allocate<pool_task_block<F, R>>(1);
                std::raw::write(block, pool_task_block<F, R>{
                    .head = pool_task_head<R>{ .job = pool_job{ .run = [](std::raw_ptr<u8> p) -> void { run_pool_task<F, R>(p); } },
                                               .pool = this.state },
                    .body = move f });
                head = cast::reinterpret<std::raw_ptr<mut pool_task_head<R>>>(block);
                std::raw_ptr<mut pool_job> job = cast::reinterpret<std::raw_ptr<mut pool_job>>(block);
                if (!pool_push(this.state, job)) { pool_run(job); }   // a full deque: run it now
            }
            if compile_time (std::meta::is_view<F>()) {
                return scoped_task<R>{ .head = head };
            } else {
                return task<R>{ .head = head };
            }
        }

        template<type T, type F : std::shareable>
        void for_chunks(std::span<T> data, usize chunk_size, F f) {
            unsafe {
                chunk_context<T, F> ctx = chunk_context<T, F>{ .data = cast::reinterpret<std::raw_ptr<mut T>>(span_data(data)), .len = data.len(),
                                                               .size = chunk_size, .body = &f };
                std::fn_ptr<void(std::raw_ptr<u8>, usize)> call = [](std::raw_ptr<u8> c, usize chunk) -> void {
                    std::raw_ptr<chunk_context<T, F>> x = cast::reinterpret<std::raw_ptr<chunk_context<T, F>>>(c);
                    usize from = chunk * (*x).size;
                    mut usize n = (*x).size;
                    if (from + n > (*x).len) { n = (*x).len - from; }
                    call_with<F, std::span<T>>(*(*x).body, std::span<T>::from_raw((*x).data.offset(from), n));
                };
                run_loop(this.state, cast::reinterpret<std::raw_ptr<u8>>(&ctx), call, chunk_count(data.len(), chunk_size));
            }
        }

        template<type T, type F : std::shareable>
        void for_chunks(std::span<mut T> data, usize chunk_size, F f) {
            unsafe {
                usize len = data.len();
                chunk_context<T, F> ctx = chunk_context<T, F>{ .data = span_mut_data(move data), .len = len, .size = chunk_size, .body = &f };
                std::fn_ptr<void(std::raw_ptr<u8>, usize)> call = [](std::raw_ptr<u8> c, usize chunk) -> void {
                    std::raw_ptr<chunk_context<T, F>> x = cast::reinterpret<std::raw_ptr<chunk_context<T, F>>>(c);
                    usize from = chunk * (*x).size;
                    mut usize n = (*x).size;
                    if (from + n > (*x).len) { n = (*x).len - from; }
                    call_with<F, std::span<mut T>>(*(*x).body, std::span_mut<T>::from_raw((*x).data.offset(from), n));
                };
                run_loop(this.state, cast::reinterpret<std::raw_ptr<u8>>(&ctx), call, chunk_count(len, chunk_size));
            }
        }

        template<type F : std::shareable>
        void for_index_chunks(usize count, usize chunk_size, F f) {
            unsafe {
                chunk_context<u8, F> ctx = chunk_context<u8, F>{ .data = nullptr, .len = count, .size = chunk_size, .body = &f };
                std::fn_ptr<void(std::raw_ptr<u8>, usize)> call = [](std::raw_ptr<u8> c, usize chunk) -> void {
                    std::raw_ptr<chunk_context<u8, F>> x = cast::reinterpret<std::raw_ptr<chunk_context<u8, F>>>(c);
                    usize from = chunk * (*x).size;
                    mut usize to = from + (*x).size;
                    if (to > (*x).len) { to = (*x).len; }
                    call_range<F>(*(*x).body, from, to);
                };
                run_loop(this.state, cast::reinterpret<std::raw_ptr<u8>>(&ctx), call, chunk_count(count, chunk_size));
            }
        }

        template<type T, type R, type M : std::shareable, type C : std::shareable>
        R reduce_chunks(std::span<T> data, usize chunk_size, R identity, M map, C combine) {
            compile_time check (std::implements<R, std::sendable>())
                else f"reduce_chunks moves results between threads, but {std::type_name<R>()} isn't std::sendable";
            usize chunks = chunk_count(data.len(), chunk_size);
            if (chunks == 0) { return identity; }
            unsafe {
                reduce_context<T, R, M, C> ctx = reduce_context<T, R, M, C>{ .data = span_data(data), .len = data.len(), .size = chunk_size,
                                                                             .map = &map, .combine = &combine, .pool = this.state };
                return reduce_range<T, R, M, C>(&ctx, 0, chunks);
            }
        }

        ~thread_pool() {
            if (!this.state) { return; }
            unsafe {
                std::raw_ptr<mut pool_state> pool = this.state;
                (*pool).stopping.store(1, std::memory_order::release);
                _ = std::raw::atomic_fetch_add(&(*pool).signal, 1, std::memory_order::sequentially_consistent);
                std::raw::futex_wake(&(*pool).signal, 0x7FFFFFFF);
                mut usize i = 0;
                while (i < (*pool).count) {
                    _ = pthread_join((*(*pool).workers.offset(i)).thread, nullptr);
                    i += 1;
                }
                // Jobs queued from outside after the workers left: run them here.
                while (true) {
                    std::raw_ptr<mut pool_job> job = pool_take_injected(pool);
                    if (!job) { break; }
                    pool_run(job);
                }
                i = 0;
                while (i < (*pool).count) {
                    std::raw::free((*(*pool).workers.offset(i)).slots);
                    i += 1;
                }
                std::raw::free((*pool).workers);
                if ((*pool).injector) { std::raw::free((*pool).injector); }
                std::raw::free(pool);
            }
        }

    private:
        std::raw_ptr<mut pool_state> state = nullptr;
    }

    private template<type T>
    std::raw_ptr<T> span_data(std::span<T> s) { return s.data; }

    private template<type T>
    std::raw_ptr<mut T> span_mut_data(std::span_mut<T> s) { return s.data; }

    // --- annotations (spec 29) -------------------------------------------------------------------

    struct test {
        compile_time check (annotated.parameters.len() == 0)
            else f"a test takes no parameters, but '{annotated.name}' has {annotated.parameters.len()}";
        compile_time check (annotated.result == void)
            else f"a test returns nothing, but '{annotated.name}' returns a value";
    }

    struct call_site {
        compile_time static std::call_site from_call(std::call_site where) override {
            return where;
        }
    }
}

namespace std::simd {
    template<usize N>
    struct block {
        usize len() { return this.count; }
        bool is_full() { return this.count == N; }
    }

    template<usize N>
    struct block_stream {
        std::option<std::simd::block<N>> next() mut {
            if (this.next_start >= this.total) {
                return std::none;
            }
            usize start = this.next_start;
            usize left  = this.total - start;
            usize count = if (left < N) { left } else { N };
            this.next_start = start + count;
            return std::some(std::simd::block<N>{ .start = start, .count = count, .active = std::simd::mask<N>::prefix(count) });
        }
    }

    template<usize N>
    std::simd::block_stream<N> blocks(usize n) {
        return std::simd::block_stream<N>{ .total = n };
    }
}

namespace std {
    view class formatter {
    public:
        void write(std::str text) mut {
            unsafe { (*this.out).push_str(text); }
        }

        std::format_spec spec() { return this.hole; }

    private:
        std::raw_ptr<mut std::string> out;
        std::format_spec              hole;
    }
}


namespace std {
    // Facts for the optimizer (spec 34). The checks are entry checks: a failure names the
    // caller's line. Modes that allow undefined behaviour compile them away.
    void assume(bool condition) {
        run_time check (condition || std::build::current_mode().allow_undefined_behavior()) else "assumption failed (std::assume)";
        unsafe { std::raw::assume(condition); }
    }

    never unreachable() {
        run_time check (std::build::current_mode().allow_undefined_behavior()) else "reached code marked unreachable (std::unreachable)";
        unsafe { std::raw::unreachable(); }
    }
}
