// The Edax standard library: core types (spec 08, 11, 04, 20).
//
// This file is compiled into edaxc and loaded as module `std` by `import std;`, together with the
// library's other modules (std::thread, std::time, std::filesystem, std::env, std::build,
// std::build::mode). Every module declares into namespace `std` or one of its sub-namespaces
// (spec 30); nothing else may add to them. Names under `std::` that no module declares
// (printing, `std::meta`, `std::raw`) are known only to the compiler.
//
// The alternatives of `option` and `result` are also exported directly in `std::`
// (`std::some(x)`, `std::none`, `std::ok(x)`, `std::error(e)`, spec 08). Their template
// arguments come from context, like the type of a literal. Their methods (`value_or`,
// `expect`, `or_error`, `map_error`) and the `?` operator are provided by the compiler.

namespace std {
    // Whether calling a callable of type F gives an R, for the checks of functions that take one:
    // `compile_time check (std::returns<F, bool>()) else "...";`.
    template<type F, type R>
    compile_time bool returns();

    // A value that may be absent.
    template<type T>
    enum option : u8 {
        some(T),
        none,
    }

    // The result of an operation that can fail.
    template<type T, type E>
    enum result : u8 {
        ok(T),
        error(E),
    }

    // The result of `a <=> b` (spec 16): `a < b` is `(a <=> b) < 0`.
    enum ordering : i8 {
        less = -1,
        equal = 0,
        greater = 1,
    }

    // A field of this type keeps a type on the thread that made it (spec 27): it is neither
    // std::sendable nor std::shareable. It takes no space.
    struct thread_bound {
    }

    // The name of a compile-time warning (or error) that checks report (spec 23). Its identity is
    // where it is declared: `compile_time std::diagnostic deprecated = default;` in module `gfx`
    // is `gfx::deprecated`, and `--warn=gfx::deprecated=off` switches it off. The doc comment above
    // the declaration describes it.
    struct diagnostic {
    }

    // A place in the source code, for `std::compile_warning(std::location_of(param), ...)` (spec 23).
    struct source_location {
    }

    // Opening a file by a relative path written in the code: the path is relative to the working
    // directory the program is started from, not to the executable. Use
    // `std::filesystem::executable_dir() / "name"`, or `std::filesystem::path::relative("name")` when
    // the working directory is meant (spec 19).
    compile_time std::diagnostic relative_path = default;

    // The direction of a sort (spec 20).
    enum sort_order : u8 {
        ascending,
        descending,
    }

    // What `main` reports to the operating system (spec 04).
    enum exit_code : u8 {
        success = 0,
        failure = 1,
    }

    // A version number, major.minor.patch: of a graphics API (std::graphics::api), a library, a
    // file format. Compares field by field, major first, and prints as "1.4.320".
    struct version {
        u32 major = 0;
        u32 minor = 0;
        u32 patch = 0;

        bool operator==(version& other) = default;
        compile_time run_time std::ordering operator<=>(version& other);
        // Whether this version is `other` or a later one ("needs at least `other`"). Usable in
        // compile-time code, like in a `compile_time check`.
        compile_time run_time bool at_least(version other);
        void format(mut std::formatter& out);
    }

    // What a panic hook is told: the message, where the panic happened (and in which function:
    // `geo::polygon::area`, `lambda in main`; empty when unknown) and on which thread.
    view struct panic_info {
        std::str        message;
        std::call_site  where;
        std::static_str function;
        std::str        thread_name;
    }

    // Installs the hook every panic calls on the panicking thread before the panic is printed
    // and the process ends; returns the previous one. A program has at most one hook. The hook
    // can record or flush; it can't stop the process from ending, and it runs at most once.
    std::option<std::fn_ptr<void(std::panic_info&)>> set_panic_hook(std::fn_ptr<void(std::panic_info&)> hook);

    // --- allocators ------------------------------------------------------------------------------

    // Where allocating types take their memory from (allocators). The methods are `unsafe` to
    // free and grow: the caller vouches for the sizes and alignments.
    interface allocator {
        // A block of `size` bytes aligned to `alignment`; nullptr when out of memory.
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut;

        // Gives back a block from `allocate` with the same size and alignment.
        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut;

        // The block grown or shrunk to `new_size`, its contents kept; nullptr when out of memory
        // (the old block is still valid then). By default: allocate, copy and free.
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut;
    }

    // The program's global allocator: what `g.set_global_allocator` chose for the target, else
    // the C library's heap. An empty struct, so a container with it costs no space.
    struct global_allocator : std::allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override;
        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override;
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override;
    }

    // One block of memory handed out front to back, freed all at once when the arena is
    // destroyed or `reset()`.
    class arena : unsafe std::sendable {
    public:
        // An arena of `size` bytes (one heap block).
        static arena make(usize size);

        // An allocator that takes its memory from this arena. It borrows the arena: a view, so
        // every container using it is a view too and can't outlive the arena.
        arena_allocator allocator();

        // The bytes handed out so far.
        usize used();

        // The arena's size in bytes.
        usize capacity();

        // Makes all of its memory available again (nothing may still borrow the arena).
        void reset() mut;

        ~arena();
    }

    // Memory from a `std::arena`. `free` does nothing.
    view struct arena_allocator : std::allocator {
        arena& source;

        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override;
        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override;
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override;
    }

    // The C library's heap, with a switch: after `std::seal_heap()` every allocation panics.
    // A global allocator for embedded and real-time programs (`g.set_global_allocator`).
    struct sealable_allocator : std::allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override;
        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override;
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override;
    }

    // From now on, every allocation through `std::sealable_allocator` panics: "no allocation
    // after start-up" is checked on every run.
    void seal_heap();

    // Whether `std::seal_heap()` was called.
    bool is_heap_sealed();

    // Panics on the first allocation: for programs that must never use the heap.
    struct no_allocator : std::allocator {
        std::raw_ptr<mut u8> allocate(usize size, usize alignment) mut override;
        unsafe void free(std::raw_ptr<mut u8> block, usize size, usize alignment) mut override;
        unsafe std::raw_ptr<mut u8> reallocate(std::raw_ptr<mut u8> block, usize old_size, usize new_size, usize alignment) mut override;
    }

    // A growable array (spec 20) with its memory from the allocator `A`. `a[i]` panics when `i`
    // is out of bounds. An empty one is `default` (when `A` has a default).
    template<type T, type A = std::global_allocator>
    class darray : unsafe std::sendable(std::implements<T, std::sendable>() && std::implements<A, std::sendable>()),
                   unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        // An empty darray with room for `n` elements (one allocation, none for `n == 0`).
        static darray<T, A> with_capacity(usize n);

        // An empty darray that allocates from `alloc`.
        static darray<T, A> with_allocator(A alloc);

        // An empty darray with room for `n` elements from `alloc`.
        static darray<T, A> with_capacity_in(usize n, A alloc);

        // A new darray with copies of `items`: `std::darray<u32>::from([1, 2, 3])` (allocates).
        static darray<T, A> from(span<T> items);

        // The number of elements.
        usize len();

        // Whether there are no elements.
        bool is_empty();

        // Adds `value` at the end.
        void push(T value) mut;

        // Removes the last element and returns it, or `none` when empty.
        std::option<T> pop() mut;

        // Destroys every element; the capacity is kept.
        void clear() mut;

        // A copy with every element cloned.
        darray<T, A> clone();

        // Keeps the elements for which `keep(element)` is true, in order; the others are destroyed.
        template<type F>
        void retain(mut F keep) mut;

        // Sorts by `key(element)`, stably (equal keys keep their order). O(n log n): a merge sort
        // with one buffer of n elements.
        template<type F>
        void sort_by_key(std::sort_order order, F key) mut;

        // Sorts in ascending order with `<`, not stably. O(n log n) worst case, in place: an
        // introsort (quicksort with median-of-3 pivots, insertion sort for small runs, heapsort
        // when the recursion gets too deep).
        void sort() mut;

        // Sorts so that `less(a, b)` holds for no later `a` and earlier `b`; not stable, in place.
        template<type F>
        void sort_by(F less) mut;

        // Makes room for at least `n` elements in total, so pushes up to there do not allocate.
        void reserve(usize n) mut;

        // The number of elements there is room for.
        usize capacity();

        // Removes the last elements so that `n` remain.
        void truncate(usize n) mut;

        // Gives back unused room: the capacity becomes `len()` (freeing the buffer when empty).
        void shrink_to_fit() mut;

        // Makes the length `n`: removes elements from the end, or appends clones of `value`.
        void resize(usize n, T value) mut;

        // Removes element `i` in O(1) by moving the last element into its place (the order changes);
        // panics when out of bounds.
        T swap_remove(usize i) mut;

        // Whether some element `== value`.
        bool contains(T& value);

        T& operator[](usize i);
        mut T& operator[](usize i) mut;

        // A view of the elements.
        span<T> as_span();

        // A view of the elements that can change them (spec 20): `list.as_mut_span().chunks(n)` hands
        // disjoint parts to threads.
        span<mut T> as_mut_span() mut;

        // Element `i`, or `none` when out of bounds.
        std::option<T&> get(usize i);

        // Inserts `value` before element `i` (`i == len()` appends); panics when out of bounds.
        void insert(usize i, T value) mut;

        // Removes element `i` and returns it; panics when out of bounds.
        T remove(usize i) mut;

        ~darray();
    }

    // A view of elements stored somewhere else (spec 20): `a[i]` panics when out of bounds.
    template<type T>
    view class span : unsafe std::sendable(std::implements<T, std::shareable>()),
                      unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        // A view of `count` elements at `data`; the caller vouches that they live long enough.
        static unsafe span<T> from_raw(std::raw_ptr<T> data, usize count);

        usize len();
        bool is_empty();
        T& operator[](usize i);

        // The address of the first element, for C and graphics APIs (glBufferData).
        std::raw_ptr<T> as_ptr();

        // The elements `from..to`; panics when out of bounds.
        span<T> slice(usize from, usize to);

        // The elements before `i` and from `i` on, as two views; panics when `i > len()`.
        (span<T>, span<T>) split_at(usize i) move;

        // Consecutive, non-overlapping parts of `n` elements (the last may be shorter): a stream.
        span_chunks<T> chunks(usize n);
    }

    // `std::span<mut T>` (spec 20, 27): a view of elements that may be changed, even through an
    // immutable span or capture. Not a copy type, and splitting it consumes it, so two mutable views
    // of the same element can't exist; that is what lets threads change disjoint parts in parallel.
    template<type T>
    view class span_mut : unsafe std::sendable(std::implements<T, std::sendable>()),
                          unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        // A view of `count` elements at `data`; the caller vouches that nothing else uses them.
        static unsafe span_mut<T> from_raw(std::raw_ptr<mut T> data, usize count);

        usize len();
        bool is_empty();
        mut T& operator[](usize i);

        // A read-only view of the same elements.
        span<T> as_span();

        // The elements `from..to` (consumes the span); panics when out of bounds.
        span_mut<T> slice(usize from, usize to) move;

        // The elements before `i` and from `i` on, as two views that never overlap, so both can be
        // changed at once; panics when `i > len()`.
        (span_mut<T>, span_mut<T>) split_at(usize i) move;

        // Sorts the elements with `<` (introsort, not stable), with a comparison, or stably by a key.
        void sort();
        template<type F>
        void sort_by(F less);
        template<type F>
        void sort_by_key(std::sort_order order, F key);

        // Consecutive, non-overlapping parts of `n` elements (consumes the span): a stream.
        span_mut_chunks<T> chunks(usize n) move;
    }

    // The parts of a `std::span<T>`, `n` elements each (spec 20).
    template<type T>
    view class span_chunks : unsafe std::sendable(std::implements<T, std::shareable>()),
                             unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        std::option<span<T>> next() mut;
    }

    // The parts of a `std::span<mut T>`, `n` elements each (spec 20).
    template<type T>
    view class span_mut_chunks : unsafe std::sendable(std::implements<T, std::sendable>()),
                                 unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        std::option<span_mut<T>> next() mut;
    }

    // Text in UTF-8 (spec 19). It converts to a `std::str` implicitly; a string literal converts to it
    // with a warning, because that may allocate.
    //
    // 24 bytes. Up to 23 bytes of text are stored inside the string itself (no allocation); longer
    // text is on the heap.
    class string : unsafe std::sendable, unsafe std::shareable {
    public:
        // A new string with a copy of `text` (allocates).
        static string from(std::str text);

        // An empty string with room for `n` bytes (no allocation up to 23).
        static string with_capacity(usize n);

        // The length in bytes.
        usize len();

        // Whether the string is empty.
        bool is_empty();

        // A view of the text.
        std::str as_str();

        // Appends `text`.
        void push_str(std::str text) mut;

        // Appends one character.
        void push(char c) mut;

        // Removes all text; the capacity is kept.
        void clear() mut;

        // Makes room for `n` bytes in total.
        void reserve(usize n) mut;

        // The number of bytes there is room for without allocating.
        usize capacity();

        // A copy (allocates only when longer than 23 bytes).
        string clone();

        bool operator==(string& other);

        // Byte-wise order (UTF-8 bytes compare like code points): `<`, `<=`, ... follow from it.
        std::ordering operator<=>(string& other);

        ~string();
    }

    // Text in UTF-8 whose bytes come from the allocator `A` (allocators): `std::string` is the
    // global allocator's (with 23 bytes stored inline), `std::string_with<std::arena_allocator>`
    // keeps its text in an arena. It converts to a `std::str` implicitly and formats like a string.
    template<type A = std::global_allocator>
    class string_with : unsafe std::sendable(std::implements<A, std::sendable>()),
                        unsafe std::shareable(std::implements<A, std::shareable>()) {
    public:
        // An empty string that allocates from `alloc`.
        static string_with<A> with_allocator(A alloc);

        // A copy of `text` in memory from `alloc`.
        static string_with<A> from_in(std::str text, A alloc);

        // A copy of `text` (when `A` has a default).
        static string_with<A> from(std::str text);

        usize len();
        bool is_empty();
        std::str as_str();
        void push_str(std::str text) mut;
        void push(char c) mut;
        void clear() mut;
        void reserve(usize n) mut;
        usize capacity();

        // A copy, from the same allocator.
        string_with<A> clone();

        bool operator==(string_with<A>& other);
        std::ordering operator<=>(string_with<A>& other);

        ~string_with();
    }

    // Why an I/O operation failed (spec 20). It prints as its name: `not_found`.
    enum io_error : u8 {
        not_found,
        permission_denied,
        already_exists,
        is_directory,
        invalid_data,
        other,
    }

    // An open file. It is closed when it is destroyed.
    class file : unsafe std::sendable, unsafe std::shareable {
    public:
        // Opens an existing file for reading.
        static std::result<file, io_error> open(std::filesystem::path& path);

        // Opens the file named by `path`. A relative path written in the code is warned about
        // (`std::relative_path`).
        static std::result<file, io_error> open(std::str path);

        // Creates (or empties) a file for writing.
        static std::result<file, io_error> create(std::filesystem::path& path);
        static std::result<file, io_error> create(std::str path);

        // Opens a file for writing at its end, creating it if it doesn't exist.
        static std::result<file, io_error> append(std::filesystem::path& path);

        // The lines of the file, one after the other, without their line ends.
        file_lines lines() mut;

        // The rest of the file as text; `invalid_data` when it is not UTF-8.
        std::result<std::string, io_error> read_all() mut;

        // Writes `text`. Writes are buffered; `flush` hands them to the operating system.
        std::result<usize, io_error> write(std::str text) mut;

        // Hands every buffered write to the operating system.
        std::result<void, io_error> flush() mut;

        ~file();
    }

    // The lines of a `std::file`: a stream for `for (std::str line : f.lines())`. Each line is a
    // view that is valid until the next one is read.
    view class file_lines : unsafe std::sendable, unsafe std::shareable {
    public:
        std::option<std::str> next() mut;

        ~file_lines();
    }

    // Why `std::plugin<I>::load` failed.
    enum plugin_error : u8 {
        // No library at that path, or the operating system couldn't load it.
        not_found,
        // A shared library, but not a Edax plugin.
        not_a_plugin,
        // A plugin built against another interface (or another version of it), or by another edaxc.
        incompatible,
        platform_error,
        // `reload`: a field of the plugin's @std::hot_reload_state object has another type in the
        // new build; the old plugin stays loaded.
        state_changed,
    }

    // Marks the class a plugin provides (`g.add_plugin`): it implements the plugin's interface
    // and has `static T make()`, which the loader calls. Exactly one class of a plugin has it.
    annotation(std::meta::target::type)
    struct plugin_entry { }

    // A Edax plugin loaded at run time (dynamic libraries): the object of its
    // `@std::plugin_entry` class, used through the interface `I` both sides import. Loading
    // checks that the plugin implements this `I` (the same compiled interface) and was built by
    // the same edaxc. Destroying it destroys the object and unloads the library.
    template<type I>
    class plugin : unsafe std::sendable {
    public:
        // Loads the plugin at `path`. Needs a target with dynamic libraries.
        static std::result<plugin<I>, plugin_error> load(std::filesystem::path& path);

        // Replaces the plugin with the build at `path` (checked like `load`). When the plugin's
        // object is of a type marked @std::hot_reload_state in both builds, its fields move into
        // the new object by name: a field in both keeps its value, a new field keeps the value the
        // new `make()` gave it, a removed field is destroyed with the old object. A field whose
        // type changed is `std::plugin_error::state_changed`, and nothing is replaced.
        std::result<void, plugin_error> reload(std::filesystem::path& path) mut;

        // The plugin's object, through its interface: a reference into the plugin.
        I& operator*();
        mut I& operator*() mut;

        ~plugin();
    }

    // A C++ exception caught by a wrapper that g.wrap_cpp generated: its `what()` text.
    struct cpp_exception {
        std::string message = default;

        // The exception's `what()`.
        std::str what();
    }

    // Why `std::c_library::load` or `function` failed.
    enum c_library_error : u8 {
        not_found,
        symbol_not_found,
        platform_error,
    }

    // A C shared library loaded at run time (dynamic libraries). Its functions are looked up by
    // name as `std::c_library::function<R(A...)>`: views of the library, called in `unsafe`.
    // Destroying it unloads the library.
    class c_library : unsafe std::sendable {
    public:
        // Loads a library by file name (the operating system's search rules) or path. Needs a
        // target with dynamic libraries.
        static std::result<c_library, c_library_error> load(std::str name);

        // The C function `symbol` with the signature `F` (`R(A...)`): the compiler can't check
        // that the library's function has it, so calls are `unsafe`.
        template<type F>
        std::result<F, c_library_error> function(std::raw_ptr<u8> symbol);

        ~c_library();
    }

    // The sole owner of a value on the heap (spec 13). Never null; moved, not copied. Destroying it
    // destroys the value (through its class's destructor, also when the pointer's type is a base).
    template<type T, type A = std::global_allocator>
    class unique_ptr : unsafe std::sendable(std::implements<T, std::sendable>() && std::implements<A, std::sendable>()),
                       unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        // Moves `value` to the heap (allocates).
        static unique_ptr<T, A> make(T value);

        // Moves `value` into memory from `alloc`.
        static unique_ptr<T, A> make_in(T value, A alloc);

        T& operator*();
        mut T& operator*() mut;

        ~unique_ptr();
    }

    // The counts of a shared value.
    struct shared_counts {
        std::atomic<usize> strong = default;
        std::atomic<usize> weak = default;   // the weak pointers, plus one for all strong ones together
    }

    // One of several owners of a value on the heap (spec 13). `clone()` adds an owner; the value is
    // destroyed with its last owner. The value is read-only through a shared pointer.
    template<type T>
    class shared_ptr : unsafe std::sendable(std::implements<T, std::sendable>() && std::implements<T, std::shareable>()),
                       unsafe std::shareable(std::implements<T, std::sendable>() && std::implements<T, std::shareable>()) {
    public:
        // Moves `value` to the heap (allocates).
        static shared_ptr<T> make(T value);

        // Another owner of the same value (count + 1).
        shared_ptr<T> clone();

        // An observer that does not keep the value alive.
        weak_ptr<T> weak();

        // The number of owners.
        usize owners();

        T& operator*();

        ~shared_ptr();
    }

    // Observes a value owned by shared pointers without keeping it alive (spec 13).
    template<type T>
    class weak_ptr : unsafe std::sendable(std::implements<T, std::sendable>() && std::implements<T, std::shareable>()),
                       unsafe std::shareable(std::implements<T, std::sendable>() && std::implements<T, std::shareable>()) {
    public:
        // An owner of the value, or `none` once its last owner is gone.
        std::option<shared_ptr<T>> lock();

        weak_ptr<T> clone();

        ~weak_ptr();
    }

    // Takes the value out of `place` and leaves its default behind (spec 12): `std::take(mut obj.field)`.
    template<type T>
    T take(mut T& place);

    // Puts `value` into `place` and returns what was there.
    template<type T>
    T replace(mut T& place, T value);

    // Exchanges the values of `a` and `b`.
    template<type T>
    void swap(mut T& a, mut T& b);

    // N values of T, stored inline (spec 20). `a[i]` panics when out of bounds. An array of
    // defaults is `default`.
    template<type T, usize N>
    struct array {
        std::raw::array<T, N> items = default;

        // The number of elements: N.
        usize len();

        // Element `i`, or `none` when out of bounds.
        std::option<T&> get(usize i);

        T& operator[](usize i);
        mut T& operator[](usize i) mut;

        // A view of the elements.
        span<T> as_span();
    }

    // N bits (spec 20), stored inline.
    template<usize N>
    struct bitset {
        std::raw::array<u64, (N + 63) / 64> words = default;

        // The number of bits: N.
        usize len();

        // Whether bit `i` is set; panics when out of bounds.
        bool test(usize i);

        // Sets bit `i` to `value`.
        void set(usize i, bool value) mut;

        // The number of bits that are set.
        usize count();
    }

    // A key and its value in a map: what `entries()` lists.
    template<type K, type V>
    view struct map_entry {
        K& key;
        V& value;
    }

    // A map with keys in no particular order, found by their hash (spec 20). Keys are integers,
    // chars, bools, strings, or types with a `u64 hash()` method; they are compared with `==`.
    //
    // An open-addressing table in the style of Abseil's SwissTable: one control byte per slot (7 bits
    // of the hash, or empty/deleted) scanned 8 at a time, and keys stored next to their values.
    // Lookups touch one group of control bytes and usually one slot. Load factor at most 7/8.
    template<type K, type V, type A = std::global_allocator>
    class hash_map : unsafe std::sendable(std::implements<K, std::sendable>() && std::implements<V, std::sendable>() && std::implements<A, std::sendable>()),
                     unsafe std::shareable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()) {
    public:
        // An empty map with room for `n` entries before it rehashes.
        static hash_map<K, V, A> with_capacity(usize n);

        // An empty map that allocates from `alloc`.
        static hash_map<K, V, A> with_allocator(A alloc);

        // An empty map with room for `n` entries from `alloc`.
        static hash_map<K, V, A> with_capacity_in(usize n, A alloc);

        usize len();
        bool is_empty();

        // Adds or replaces the value of `key`; returns the old value.
        std::option<V> insert(K key, V value) mut;

        bool contains(K& key);

        // The value of `key`, or `none`.
        std::option<V&> get(K& key);

        // The value of `key` to change in place, or `none`.
        std::option<mut V&> get_mut(K& key) mut;

        // The value of `key`; when it is missing, `value` is inserted first (`key` is moved in only
        // then). `m.get_or_insert(k, 0) += 1` counts.
        mut V& get_or_insert(K key, V value) mut;

        // Removes `key` and returns its value, or `none`.
        std::option<V> remove(K& key) mut;

        // The value of `key`; panics when it is missing.
        V& operator[](K& key);
        mut V& operator[](K& key) mut;

        // Every key and value, in no particular order: a stream for `for`, nothing is copied.
        hash_map_entries<K, V> entries();

        // Makes room for `n` entries in total without rehashing.
        void reserve(usize n) mut;

        void clear() mut;

        ~hash_map();
    }

    // What `hash_map::entries()` returns: walks the table without allocating.
    template<type K, type V>
    view class hash_map_entries : unsafe std::sendable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()),
                                  unsafe std::shareable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()) {
    public:
        std::option<map_entry<K, V>> next() mut;
    }

    // A map with its keys in order (spec 20). Keys are compared with `<`.
    //
    // A B-tree: nodes of up to 15 keys keep lookups to a few cache lines per level and make the
    // ordered walk of `entries()` fast; nothing is reached through one pointer per key.
    // Its nodes come from the allocator `A` (allocators).
    template<type K, type V, type A = std::global_allocator>
    class tree_map : unsafe std::sendable(std::implements<K, std::sendable>() && std::implements<V, std::sendable>() &&
                                          std::implements<A, std::sendable>()),
                     unsafe std::shareable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()) {
    public:
        // An empty map whose nodes come from `alloc`.
        static tree_map<K, V, A> with_allocator(A alloc);

        usize len();
        bool is_empty();
        std::option<V> insert(K key, V value) mut;
        bool contains(K& key);
        std::option<V&> get(K& key);
        std::option<mut V&> get_mut(K& key) mut;

        // The value of `key`; when it is missing, `value` is inserted first.
        mut V& get_or_insert(K key, V value) mut;

        std::option<V> remove(K& key) mut;
        V& operator[](K& key);
        mut V& operator[](K& key) mut;

        // Every key and value, keys in ascending order: a stream for `for`, nothing is copied.
        tree_map_entries<K, V> entries();

        // The entry with the smallest key, or `none` when empty.
        std::option<map_entry<K, V>> first();

        // The entry with the largest key, or `none` when empty.
        std::option<map_entry<K, V>> last();

        void clear() mut;

        ~tree_map();
    }

    // What `tree_map::entries()` returns: an in-order walk without allocating.
    template<type K, type V>
    view class tree_map_entries : unsafe std::sendable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()),
                                  unsafe std::shareable(std::implements<K, std::shareable>() && std::implements<V, std::shareable>()) {
    public:
        std::option<map_entry<K, V>> next() mut;

        // Starts the walk at a tree's root node (what `entries()` calls; the node type is private).
        unsafe void start(std::raw_ptr<u8> root) mut;
    }

    // The hash of a key (spec 20): integers, chars, bools, strings (`std::string`, `std::str`,
    // `std::static_str`), or a type's `u64 hash()`.
    // Integers take one 128-bit multiply; text is hashed 8 bytes at a time.
    template<type K>
    u64 hash(K& key);

    // Hashes `n` bytes at `data` (what strings use).
    unsafe u64 hash_bytes(std::raw_ptr<u8> data, usize n);

    // The per-process seed of std::hash (spec 20): a `hash()` method starts from it.
    u64 hash_seed();

    // Mixes the hash `b` into `a`; the order matters. For `hash()` methods over several parts:
    // `h = std::hash_combine(h, std::hash(this.x));`
    u64 hash_combine(u64 a, u64 b);

    // A type that is a `std::hash_map` key through its own hash (spec 20). Integers, chars, bools
    // and strings are keys without it. `@std::derive::hashable` implements it from the fields.
    interface hashable {
        u64 hash();
    }

    // What an f-string prints with `{value}` (spec 19): `format` appends the value's text.
    // Numbers, bools, chars, strings and simple enums print without it; `@std::derive::formattable`
    // implements it from the fields.
    interface formattable {
        void format(mut std::formatter& out);
    }

    // The format spec of an f-string hole (`{x:>8.2}`): what a `format` method may look at.
    // `align` is 0 or the character '<', '>' or '^'; `radix` is 0 or 'x', 'X', 'b' or 'o';
    // `width` and `precision` are -1 when not given.
    struct format_spec {
        u8   align     = 0;
        bool plus      = false;
        i32  width     = -1;
        i32  precision = -1;
        u8   radix     = 0;
    }

    // Where a type's `format` method writes its text. Alignment and width are applied around
    // everything it writes, so most types ignore the spec.
    view class formatter {
    public:
        // Appends `text`.
        void write(std::str text) mut;

        // The hole's spec.
        std::format_spec spec();
    }

    // --- call sites and implicit parameters (spec 31) ---------------------------------------------

    // A type that can be the type of an `implicit` parameter: when a call leaves the argument
    // out, the compiler passes `T::from_call(<the call's site>)`, evaluated at compile time.
    template<type T>
    interface implicit {
        compile_time static T from_call(std::call_site where);
    }

    // The place a call is written. The compiler makes one for every call that leaves out an
    // `implicit std::call_site` argument; every field is static data it computed. A copy type
    // that can be stored anywhere and sent to any thread.
    struct call_site : std::implicit<std::call_site> {
        // The file, relative to where edaxc was started: `renderer/vulkan/pipeline.ed`.
        std::static_str file = "";
        // The file's name only: `pipeline.ed`.
        std::static_str file_name = "";
        // The function with its namespace and type: `gfx::vulkan::create_pipeline`.
        std::static_str function = "";
        // The function's own name: `create_pipeline`.
        std::static_str function_name = "";
        // The namespace the function is in: `gfx::vulkan` ("" for the global namespace).
        std::static_str namespace_name = "";
        // The module (file path as a module name): `renderer::vulkan::pipeline`.
        std::static_str module = "";
        // The build target: its name in build.ed, or the main file's name without `.ed`.
        std::static_str target = "";
        // 1-based line and column of the call.
        u32 line = 0;
        u32 column = 0;

        // The call site itself (std::implicit).
        compile_time static std::call_site from_call(std::call_site where) override;
    }


    // --- threads and synchronization (spec 27) ---------------------------------------------------
    // `std::sendable` and `std::shareable` are derived by the compiler from a type's parts; the
    // types below make the promise themselves (`unsafe std::sendable`) because they hold raw
    // pointers or change through immutable references, which is safe here because they synchronize.

    // How an atomic operation orders the memory accesses around it (spec 27). Every operation
    // names one; there is no default.
    enum memory_order : u8 {
        relaxed,
        acquire,
        release,
        acquire_release,
        sequentially_consistent,
    }

    // One integer, `bool`, `char` or `std::raw_ptr` that threads change atomically (spec 27).
    // Always lock-free; the size and alignment of `T`. Arithmetic wraps.
    @std::interior_mutable
    template<type T>
    class atomic : unsafe std::sendable, unsafe std::shareable {
    public:
        // An atomic holding `value` (`default` holds zero).
        static atomic<T> make(T value);

        // Reads the value. `order`: relaxed, acquire or sequentially_consistent.
        T load(std::memory_order order);

        // Writes `value`. `order`: relaxed, release or sequentially_consistent.
        void store(T desired, std::memory_order order);

        // Writes `value` and returns the old value.
        T exchange(T desired, std::memory_order order);

        // If the value is `expected`, makes it `desired` and returns `ok(expected)`; otherwise
        // returns `error(actual)`.
        std::result<T, T> compare_exchange(T expected, T desired, std::memory_order success, std::memory_order failure);

        // Like compare_exchange, but may fail even when the value matched: cheaper in a retry loop.
        std::result<T, T> compare_exchange_weak(T expected, T desired, std::memory_order success, std::memory_order failure);

        // Adds `v` (wrapping on overflow) and returns the old value.
        T fetch_wrapping_add(T v, std::memory_order order);

        // Subtracts `v` (wrapping on overflow) and returns the old value.
        T fetch_wrapping_sub(T v, std::memory_order order);

        // Bit operations; each returns the old value.
        T fetch_and(T v, std::memory_order order);
        T fetch_or(T v, std::memory_order order);
        T fetch_xor(T v, std::memory_order order);
    }

    // A memory fence on its own (spec 27).
    void atomic_fence(std::memory_order order);

    // The size of a cache line of the target in bytes.
    compile_time usize cache_line_size = 64;

    // `T` padded so that values written by different threads never share a cache line ("false
    // sharing", spec 27). Access with `*x` / `x->`.
    template<type T>
    struct cache_aligned {
        T value;
        std::raw::array<u8, cache_line_size> padding = default;

        static cache_aligned<T> make(T value);
        T& operator*();
        mut T& operator*() mut;
    }

    // Data `T` that one thread at a time can lock and change (spec 27). The mutex owns the data:
    // there is no way to reach it without locking. Inline, no heap: `T` plus one 32-bit word.
    @std::interior_mutable
    template<type T>
    class mutex : unsafe std::sendable(std::implements<T, std::sendable>()),
                  unsafe std::shareable(std::implements<T, std::sendable>()) {
    public:
        // A mutex holding `value`, unlocked.
        static mutex<T> make(T value);

        // Waits until the mutex is free, then locks it. The guard unlocks when it is destroyed.
        // In debug modes, locking a mutex this thread already holds panics instead of hanging.
        mutex_guard<T> lock();

        // Locks the mutex if it is free; `none` if another thread holds it. Never waits.
        std::option<mutex_guard<T>> try_lock();

        // Waits at most `d` for the mutex; `none` if it is still held by then.
        std::option<mutex_guard<T>> try_lock_for(std::time::duration d);
    }

    // The locked data of a `std::mutex<T>` (spec 27). A view of the mutex: it can't outlive it or
    // be stored in a field. `*g` / `g->` reach the data; destroying the guard unlocks.
    template<type T>
    view class mutex_guard : unsafe std::sendable(std::implements<T, std::sendable>()),
                             unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        T& operator*();
        mut T& operator*() mut;

        // Unlocks now instead of at the end of the scope.
        void unlock() move;

        ~mutex_guard();
    }

    // Data `T` that is read often and written rarely: any number of readers at once, or one
    // writer. Writers are not starved: once a writer waits, new readers wait behind it. One
    // 32-bit word next to `T`, like `std::mutex`.
    @std::interior_mutable
    template<type T>
    class rw_mutex : unsafe std::sendable(std::implements<T, std::sendable>()),
                     unsafe std::shareable(std::implements<T, std::sendable>() && std::implements<T, std::shareable>()) {
    public:
        // A rw_mutex holding `value`, unlocked.
        static rw_mutex<T> make(T value);

        // Waits until no writer holds or waits for the lock, then reads. Several threads can
        // read at once.
        read_guard<T> read();

        // Waits until nobody reads or writes, then writes.
        write_guard<T> write();

        // Reads if no writer holds or waits for the lock; never waits.
        std::option<read_guard<T>> try_read();

        // Writes if nobody reads or writes; never waits.
        std::option<write_guard<T>> try_write();
    }

    // Read access to the data of a `std::rw_mutex<T>`: a view of it. Destroying it unlocks.
    template<type T>
    view class read_guard : unsafe std::sendable(std::implements<T, std::shareable>()),
                            unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        T& operator*();

        // Unlocks now instead of at the end of the scope.
        void unlock() move;

        ~read_guard();
    }

    // Write access to the data of a `std::rw_mutex<T>`: a view of it. Destroying it unlocks.
    template<type T>
    view class write_guard : unsafe std::sendable(std::implements<T, std::sendable>()),
                             unsafe std::shareable(std::implements<T, std::shareable>()) {
    public:
        T& operator*();
        mut T& operator*() mut;

        // Unlocks now instead of at the end of the scope.
        void unlock() move;

        ~write_guard();
    }

    // Waits until the data behind a mutex reaches a state (spec 27).
    @std::interior_mutable
    class condition : unsafe std::sendable, unsafe std::shareable {
    public:
        // Unlocks `guard` and sleeps until notified and `ready(*guard)` holds; returns with the
        // guard locked. Spurious wake-ups and missed notifications can't make it return early.
        template<type T, type F>
        void wait(mut mutex_guard<T>& guard, F ready);

        // The same, waiting at most `d`: whether `ready(*guard)` holds. The guard is locked when
        // it returns either way.
        template<type T, type F>
        bool wait_for(mut mutex_guard<T>& guard, F ready, std::time::duration d);

        // Wakes one waiting thread.
        void notify_one();

        // Wakes all waiting threads.
        void notify_all();
    }

    // Why `try_send` didn't send: the value comes back either way.
    template<type T>
    enum send_error : u8 {
        full(T),
        closed(T),
    }

    // Why `try_receive` didn't receive.
    enum receive_error : u8 {
        empty,
        closed,
        timed_out,
    }

    // A thread-safe queue (spec 27): values go in at a `std::channel_sender<T>` and come out at a
    // `std::channel_receiver<T>`, in order. The channel object makes the ends and closes the
    // channel. Each value is received exactly once.
    template<type T>
    class channel : unsafe std::sendable(std::implements<T, std::sendable>()),
                    unsafe std::shareable(std::implements<T, std::sendable>()) {
    public:
        // A channel with room for `capacity` values, allocated once. `send` waits while it is full.
        static channel<T> bounded(usize capacity);

        // A channel that grows: `send` never waits.
        static channel<T> unbounded();

        // A new end that puts values in.
        channel_sender<T> sender();

        // A new end that takes values out.
        channel_receiver<T> receiver();

        // Closes the channel: `send` fails from now on; receivers still get what is queued.
        void close();

        ~channel();
    }

    // The end of a channel that puts values in.
    template<type T>
    class channel_sender : unsafe std::sendable(std::implements<T, std::sendable>()),
                           unsafe std::shareable(std::implements<T, std::sendable>()) {
    public:
        // Queues `value`, waiting for room on a full bounded channel. `error(value)` when the
        // channel is closed: the value comes back.
        std::result<void, T> send(T value);

        // Queues `value` without waiting: `error(full(value))` or `error(closed(value))`.
        std::result<void, std::send_error<T>> try_send(T value);

        // Closes the channel.
        void close();

        // Another sender of the same channel.
        channel_sender<T> clone();

        ~channel_sender();
    }

    // The end of a channel that takes values out. A stream: `for (T x : receiver)` runs until the
    // channel is closed and empty.
    template<type T>
    class channel_receiver : unsafe std::sendable(std::implements<T, std::sendable>()),
                             unsafe std::shareable(std::implements<T, std::sendable>()) {
    public:
        // The next value, waiting while the channel is empty; `none` once it is closed and empty.
        std::option<T> receive();

        // The next value without waiting: `error(empty)` or `error(closed)`.
        std::result<T, std::receive_error> try_receive();

        // The next value, waiting at most `d`: `error(timed_out)` after that, `error(closed)`
        // once the channel is closed and empty.
        std::result<T, std::receive_error> receive_for(std::time::duration d);

        // The same as receive(): a receiver is a stream (spec 10).
        std::option<T> next();

        // Another receiver of the same channel.
        channel_receiver<T> clone();

        ~channel_receiver();
    }

    // --- thread pool (spec 28) ------------------------------------------------------------------
    // Runs many short tasks on a fixed set of threads (spec 28): single tasks (`spawn`), parallel
    // loops over chunks (`for_chunks`, `for_index_chunks`) and deterministic parallel reductions
    // (`reduce_chunks`). Work stealing: every worker has its own deque, idle workers steal, and a
    // thread that waits for a task runs other tasks meanwhile. Destroying the pool runs every task
    // already submitted, then joins the workers.
    class thread_pool : unsafe std::sendable, unsafe std::shareable {
    public:
        // How to make a `std::thread_pool`.
        view struct options {
            // The number of worker threads (required).
            usize threads;
            // The workers' names: "pool-0", "pool-1", ...
            std::str name = "pool";
            // The stack size of each worker in bytes; 0: the platform's default.
            usize stack_size = 0;
            // How long an idle worker spins before it sleeps in the OS.
            std::time::duration idle_spin = std::time::duration::microseconds(50);
        }

        // A task on a pool whose lambda owns its captures: can be stored, returned and detached.
        template<type R>
        class task : unsafe std::sendable, unsafe std::shareable {
        public:
            // Waits for the task (running other tasks of the pool meanwhile) and returns its result.
            R join() move;

            // Lets the task run on; nobody waits for it or gets its result.
            void detach() move;

            ~task();
        }

        // A task on a pool whose lambda borrows: a view; it is joined at the latest when destroyed.
        template<type R>
        view class scoped_task : unsafe std::sendable, unsafe std::shareable {
        public:
            // Waits for the task (running other tasks of the pool meanwhile) and returns its result.
            R join() move;

            ~scoped_task();
        }

        // Starts `settings.threads` workers.
        static thread_pool make(options settings);

        // The number of worker threads.
        usize thread_count();

        // Runs `f` on the pool. Returns a `std::thread_pool::task<R>` when `f` owns its captures, a
        // `std::thread_pool::scoped_task<R>` (a view) when it borrows.
        template<type F : std::sendable>
        deduce spawn(F f);

        // Calls `f(chunk)` for consecutive, non-overlapping chunks of `chunk_size` elements, on
        // several threads at once (the calling thread too); returns when all are done.
        template<type T, type F : std::shareable>
        void for_chunks(std::span<T> data, usize chunk_size, F f);

        // The same over elements that `f` may change: each call gets a `std::span<mut T>` of its chunk.
        template<type T, type F : std::shareable>
        void for_chunks(std::span<mut T> data, usize chunk_size, F f);

        // Calls `f(from, to)` for consecutive ranges of `chunk_size` indices of `0..count`.
        template<type F : std::shareable>
        void for_index_chunks(usize count, usize chunk_size, F f);

        // `map(chunk)` for every chunk, joined with `combine(a, b)` in chunk order as a fixed binary
        // tree; `identity` for empty data. The same result for any number of threads.
        template<type T, type R, type M : std::shareable, type C : std::shareable>
        R reduce_chunks(std::span<T> data, usize chunk_size, R identity, M map, C combine);

        ~thread_pool();
    }

    // --- facts for the optimizer (spec 34) ---------------------------------------------------------

    // Tells the optimizer that `condition` holds, so it can drop checks and branches that
    // depend on it. Checked in every mode that doesn't allow undefined behaviour: a false
    // assumption panics there, at the call. In a mode with `allow_undefined_behavior()` it is
    // only a promise. Write one fact per call: `std::assume(a.len() == n); std::assume(b.len() == n);`
    // gives the optimizer two facts, `std::assume(x && y)` only their combination.
    void assume(bool condition);

    // Marks code that can't be reached. Panics if it is reached in a safe mode; in a mode with
    // `allow_undefined_behavior()` the optimizer removes the path.
    never unreachable();

    // --- annotations (spec 29) -------------------------------------------------------------------

    // Every use of what it's written on is a warning with this message (id `std::deprecated`).
    annotation(std::meta::target::type, std::meta::target::function, std::meta::target::field,
               std::meta::target::alternative)
    struct deprecated {
        std::static_str message = "";
    }

    // Silences the warning `id` inside the function: `@std::allow{ .id = gfx::deprecated }`.
    annotation(std::meta::target::function)
    struct allow {
        std::diagnostic id;
    }

    // Ignoring the result of the function (or of a function returning this type) is an error;
    // discard it with `_ = f();`.
    annotation(std::meta::target::function, std::meta::target::type)
    struct must_use { }

    // The function returns `bool` and reports its own failure (logs it, counts it); a call to it,
    // written as a statement, may be followed by `else { ... }`, which runs when it returns false.
    annotation(std::meta::target::function)
    struct check_result { }

    // Always inline the function, whatever the optimizer thinks.
    annotation(std::meta::target::function)
    struct inline_always { }

    // Never inline the function.
    annotation(std::meta::target::function)
    struct inline_never { }

    // The function is rarely called (error paths): the optimizer moves it, and branches to it,
    // out of the hot path.
    annotation(std::meta::target::function)
    struct cold { }

    // The memory layout of a struct or class (spec 34). `.align` raises its alignment (a power of
    // two up to 64, written as a number): `@std::layout{ .align = 16 }` for SIMD and GPU data,
    // 64 for a cache line. `.no_implicit_padding` makes every gap the compiler would insert
    // between fields an error, so GPU and file structs spell their padding out with
    // `std::padding<N>`.
    annotation(std::meta::target::type)
    struct layout {
        u64  align               = 0;
        bool no_implicit_padding = false;
        bool packed              = false;   // no padding at all; fields can't be borrowed (they may be misaligned)
    }

    // `N` bytes of explicit padding in a struct (spec 34): zero when the struct is built, and
    // never read. GPU and file layouts write their gaps out with it.
    template<usize N>
    struct padding {
        std::raw::array<u8, N> bytes = default;
    }

    // The type changes through immutable references (its methods use atomics or a lock on its
    // own fields). The optimizer is not told that a `T&` of it is read-only (spec 34). Types
    // containing it are interior mutable too.
    annotation(std::meta::target::type)
    struct interior_mutable { }

    // A promise that the field is never 0 (an integer) or null (a pointer) in a live value
    // (spec 34, "Niches"): `std::option` of the type then stores `none` as 0 there and needs no
    // tag. `std::unique_ptr`, `std::shared_ptr` and `std::nonzero` use it. Breaking the promise
    // makes the value read as `none`.
    annotation(std::meta::target::field)
    struct never_zero { }

    // An integer that is never 0 (spec 34): `std::option<std::nonzero<u32>>` is 4 bytes.
    // `make` checks the value; `of` gives `none` for 0.
    template<type T>
    class nonzero {
    public:
        static nonzero<T> make(T value);
        static std::option<nonzero<T>> of(T value);
        T get();
    }

    // Overrides the build mode's optimization for one function (spec 34): `.level = none` to
    // debug one function in an optimized build, `.level = speed` for a hot function in a debug build.
    annotation(std::meta::target::function)
    struct optimize {
        std::build::optimization level;
    }

    // Every run-time check of the function must be removed by the optimizer (spec 34): a bounds,
    // overflow or other check that is left is a compile error naming it (checked when the program
    // is built, as a release build optimizes it).
    annotation(std::meta::target::function)
    struct no_checks_left { }

    // Relaxed floating point for the operations written in one function (spec 34). The default is
    // strict IEEE: the same results on every machine. A mode with `float_determinism()` strict
    // rejects it.
    annotation(std::meta::target::function)
    struct float_mode {
        bool contract        = false;   // a * b + c may become one fused multiply-add
        bool reassociate     = false;   // sums may be reordered (vectorized reductions)
        bool finite_only     = false;   // the operands are never NaN or infinite
        bool no_signed_zeros = false;   // -0.0 and 0.0 may be treated alike
        bool reciprocal      = false;   // a / b may become a * (1 / b)
    }

    // A test: `edaxc test` finds and runs every `@std::test` function of the test targets. It
    // takes no parameters and returns nothing; it passes when it returns.
    annotation(std::meta::target::function)
    struct test { }

    // On a plugin's entry class (dynamic libraries, "Hot reload"): `std::plugin::reload` moves
    // the object's fields into the new build's object by name.
    annotation(std::meta::target::type)
    struct hot_reload_state { }

    // --- 8-bit floats (OCP FP8) -------------------------------------------------------------------
    // Storage types for weights, compressed vertex data and HDR data in memory. They convert to
    // and from f32; arithmetic converts to f32, computes, and rounds back once, which gives the
    // correctly rounded result (f32 has more than twice their precision). Conversions round to
    // nearest, ties to even. Formatting prints the exact value through f32.

    // E4M3 ("FN"): 1 sign, 4 exponent (bias 7) and 3 mantissa bits. Range ±448, smallest
    // positive 2^-9. No infinities; 0x7F and 0xFF are NaN. More precision, less range than E5M2.
    struct f8e4m3 {
        u8 bits = 0;

        // NaN for NaN, infinities and values that round beyond ±448.
        compile_time run_time static f8e4m3 from_f32(f32 v);
        // Like from_f32, but beyond ±448 (and ±inf) gives ±448. NaN stays NaN.
        compile_time run_time static f8e4m3 saturate(f32 v);
        compile_time run_time static f8e4m3 from_bits(u8 bits);
        compile_time run_time static f8e4m3 max();            // 448
        compile_time run_time static f8e4m3 min();            // -448
        compile_time run_time static f8e4m3 epsilon();        // 0.125
        compile_time run_time static f8e4m3 min_positive();   // 2^-9
        compile_time run_time static f8e4m3 nan();

        compile_time run_time f32 to_f32();
        compile_time run_time f16 to_f16();                   // exact
        compile_time run_time bool is_nan();
        // -1, 0, 1 by value; NaN after everything (a total order for sorting).
        compile_time run_time std::ordering total_cmp(f8e4m3 other);

        compile_time run_time f8e4m3 operator+(f8e4m3 other);
        compile_time run_time f8e4m3 operator-(f8e4m3 other);
        compile_time run_time f8e4m3 operator*(f8e4m3 other);
        compile_time run_time f8e4m3 operator/(f8e4m3 other);
        compile_time run_time f8e4m3 operator-();
        // IEEE: NaN is not equal to itself; 0 equals -0.
        compile_time run_time bool operator==(f8e4m3& other);

        void format(mut std::formatter& out);
    }

    // E5M2: 1 sign, 5 exponent (bias 15) and 2 mantissa bits: the top byte of an f16. Range
    // ±57344, smallest positive 2^-16, with infinities and NaN like IEEE.
    struct f8e5m2 {
        u8 bits = 0;

        // ±inf for values that round beyond ±57344.
        compile_time run_time static f8e5m2 from_f32(f32 v);
        // Like from_f32, but beyond ±57344 (and ±inf) gives ±57344. NaN stays NaN.
        compile_time run_time static f8e5m2 saturate(f32 v);
        compile_time run_time static f8e5m2 from_bits(u8 bits);
        compile_time run_time static f8e5m2 max();            // 57344
        compile_time run_time static f8e5m2 min();            // -57344
        compile_time run_time static f8e5m2 epsilon();        // 0.25
        compile_time run_time static f8e5m2 min_positive();   // 2^-16
        compile_time run_time static f8e5m2 infinity();
        compile_time run_time static f8e5m2 nan();

        compile_time run_time f32 to_f32();
        compile_time run_time f16 to_f16();                   // exact
        compile_time run_time bool is_nan();
        compile_time run_time bool is_infinite();
        compile_time run_time std::ordering total_cmp(f8e5m2 other);

        compile_time run_time f8e5m2 operator+(f8e5m2 other);
        compile_time run_time f8e5m2 operator-(f8e5m2 other);
        compile_time run_time f8e5m2 operator*(f8e5m2 other);
        compile_time run_time f8e5m2 operator/(f8e5m2 other);
        compile_time run_time f8e5m2 operator-();
        compile_time run_time bool operator==(f8e5m2& other);

        void format(mut std::formatter& out);
    }

    // On a template of a library: its instances don't appear in the instantiation chains of
    // errors, and an error inside it is reported at the user's call that reached it (templates,
    // "Library error frames").
    annotation(std::meta::target::function, std::meta::target::type)
    struct diagnostic_frame {
        bool hide = false;
    }
}

// --- SIMD: blocks over a range (the vector types are built into the compiler) --------------------
namespace std::simd {
    // Compiles the function once per CPU level and picks the best one for the running CPU at
    // the first call (one indirect call per call afterwards). `std::simd::native_lanes` and
    // `std::build::target_has_cpu_feature` follow each copy's level. A CPU below every level
    // runs the build's own copy.
    annotation(std::meta::target::function)
    view struct multiversion {
        std::span<std::build::cpu> levels;
    }

    // Every plain `for` loop of the function must become vector code: a loop the optimizer
    // can't vectorize is an error with its reason (when the program is built).
    annotation(std::meta::target::function)
    struct must_vectorize { }

    // `N` consecutive positions of a range, from `start`; the last block of a range may be partial.
    template<usize N>
    struct block {
        usize              start  = 0;
        usize              count  = 0;
        // The lanes inside the range.
        std::simd::mask<N> active = default;

        // `N`, or fewer in the last block.
        usize len();
        // Whether all `N` lanes are inside the range.
        bool is_full();
    }

    // The blocks of `0..n`: a stream (`for (std::simd::block<8> at : std::simd::blocks<8>(n))`).
    template<usize N>
    struct block_stream {
        usize next_start = 0;
        usize total      = 0;

        std::option<std::simd::block<N>> next() mut;
    }

    // The blocks of `N` positions that cover `0..n`; every block is full except possibly the last.
    template<usize N>
    std::simd::block_stream<N> blocks(usize n);

    // Warning id: vector code computed one lane at a time (a target without a SIMD unit).
    compile_time std::diagnostic scalarized = default;
}

