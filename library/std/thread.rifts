// The Rift standard library: module std::thread (spec 27), on POSIX threads.

namespace std::thread {
    private extern(std::build::language::c) {
        i32 pthread_create(std::raw_ptr<mut u64> thread, std::raw_ptr<u8> attributes,
                           std::fn_ptr<std::raw_ptr<u8>(std::raw_ptr<u8>)> start, std::raw_ptr<u8> argument);
        i32 pthread_join(u64 thread, std::raw_ptr<u8> result);
        i32 pthread_detach(u64 thread);
        u64 pthread_self();
        i32 pthread_attr_init(std::raw_ptr<mut u8> attributes);
        i32 pthread_attr_setstacksize(std::raw_ptr<mut u8> attributes, usize size);
        i32 pthread_attr_destroy(std::raw_ptr<mut u8> attributes);
        i32 pthread_setname_np(u64 thread, std::raw_ptr<u8> name);
        i32 pthread_getname_np(u64 thread, std::raw_ptr<mut u8> name, usize size);
        i64 sysconf(i32 name);
        i32 sched_yield();
        i32 pthread_attr_setinheritsched(std::raw_ptr<mut u8> attributes, i32 inherit);
        i32 pthread_attr_setschedpolicy(std::raw_ptr<mut u8> attributes, i32 policy);
        i32 pthread_attr_setschedparam(std::raw_ptr<mut u8> attributes, std::raw_ptr<i32> parameter);
        i32 pthread_attr_setaffinity_np(std::raw_ptr<mut u8> attributes, usize size, std::raw_ptr<u8> cpus);
        i32 nanosleep(std::raw_ptr<sleep_time> wanted, std::raw_ptr<mut sleep_time> left);
    }

    private struct sleep_time {
        i64 seconds = 0;
        i64 nanos = 0;
    }

    private compile_time i32 online_processors = 84;   // _SC_NPROCESSORS_ONLN (Linux)

    // The operating system being built for.
    private compile_time std::build::os target_os = std::build::target_platform().os;

    // Whether `p` is for the target's operating system.
    private compile_time run_time bool fits_target(platform_options& p) {
        match (p) {
            platform_options::none => { return true; },
            platform_options::linux(_) => { return target_os == std::build::os::linux; },
            platform_options::windows(_) => { return target_os == std::build::os::windows; },
            platform_options::macos(_) => { return target_os == std::build::os::macos; },
        }
    }

    // Puts Linux options into the pthread attributes.
    private unsafe void apply_linux(std::raw_ptr<mut u8> attr, linux_options& o) {
        i32 policy = match (o.policy) {
            linux_policy::other => 0,
            linux_policy::fifo => 1,
            linux_policy::round_robin => 2,
            linux_policy::batch => 3,
            linux_policy::idle => 5,
        };
        if (policy != 0 || o.priority != 0) {
            _ = pthread_attr_setinheritsched(attr, 1);   // PTHREAD_EXPLICIT_SCHED
            _ = pthread_attr_setschedpolicy(attr, policy);
            i32 priority = o.priority;
            _ = pthread_attr_setschedparam(attr, &priority);
        }
        if (!o.cpus.is_empty()) {
            mut std::raw::array<u64, 16> set = default;   // a cpu_set_t: 1024 bits
            std::raw_ptr<mut u64> words = cast::reinterpret<std::raw_ptr<mut u64>>(mut &set);
            for (u32 cpu : o.cpus) {
                run_time check (cpu < 1024) else f"CPU {cpu} is out of range: a thread's CPUs are numbered below 1024";
                std::raw_ptr<mut u64> word = words.offset(cast<usize>(cpu / 64));
                std::raw::write(word, std::raw::read(word) | (1u64 << cast<u64>(cpu % 64)));
            }
            _ = pthread_attr_setaffinity_np(attr, 128, cast::reinterpret<std::raw_ptr<u8>>(&set));
        }
    }

    // The thread's state, shared by the handle and the thread: whether it is running, finished or
    // detached (whoever comes second frees the block), and its result.
    private template<type R>
    struct thread_packet {
        u32            state = 0;   // 0 running, 1 finished, 2 detached
        std::option<R> result = std::none;
    }

    private compile_time u32 running = 0;
    private compile_time u32 finished = 1;
    private compile_time u32 detached = 2;

    // The block the new thread gets: the packet first (so that its address is the block's), then
    // the lambda, which the thread runs and destroys, and the name the thread gives itself before
    // running it (at most 15 bytes and a NUL; empty: no name).
    private template<type F, type R>
    struct thread_start {
        thread_packet<R>         packet;
        F                        body;
        std::raw::array<u8, 16>  name = default;
    }

    private template<type F, type R>
    R call_body(mut F& body) { return body(); }

    private unsafe template<type F, type R>
    void thread_main(std::raw_ptr<u8> argument) {
        std::raw_ptr<mut thread_start<F, R>> start = cast::reinterpret<std::raw_ptr<mut thread_start<F, R>>>(argument);
        std::raw_ptr<u8> name = cast::reinterpret<std::raw_ptr<u8>>(&(*start).name);
        if (*name != 0) { _ = pthread_setname_np(pthread_self(), name); }
        (*start).packet.result = std::some(call_body<F, R>(mut (*start).body));
        std::raw::drop(mut &(*start).body);   // the lambda's captures are destroyed on this thread
        if (std::raw::atomic_exchange(&(*start).packet.state, finished, std::memory_order::acquire_release) == detached) {
            std::raw::drop(mut &(*start).packet);   // nobody will join: the thread cleans up itself
            std::raw::free(start);
        }
    }

    // Waits for the thread and takes its result; frees the shared block.
    private unsafe template<type R>
    std::option<R> join_thread(u64 thread, std::raw_ptr<mut thread_packet<R>> packet) {
        _ = pthread_join(thread, nullptr);
        std::option<R> result = std::raw::read(mut &(*packet).result);
        std::raw::free(packet);
        return result;
    }

    template<type F : std::sendable>
    deduce spawn(F f) {
        compile_time check (std::build::target_has(std::build::capability::threads)) else "std::thread::spawn needs a target with threads";
        return spawn(options{}, move f);
    }

    template<type F : std::sendable>
    deduce spawn(options settings, F f) {
        compile_time check (std::build::target_has(std::build::capability::threads)) else "std::thread::spawn needs a target with threads";
        compile_time run_time check (fits_target(settings.platform))
            else "these thread options are for another operating system than the target's";
        compile_time type R = std::meta::result_of<F>();
        mut u64 thread = 0;
        mut std::raw_ptr<mut thread_packet<R>> packet = nullptr;
        unsafe {
            std::raw_ptr<mut thread_start<F, R>> start = std::raw::allocate<thread_start<F, R>>(1);
            std::raw::write(start, thread_start<F, R>{ .packet = thread_packet<R>{}, .body = move f });
            packet = cast::reinterpret<std::raw_ptr<mut thread_packet<R>>>(start);
            std::raw_ptr<mut u8> name_bytes = cast::reinterpret<std::raw_ptr<mut u8>>(mut &(*start).name);
            mut usize i = 0;
            while (i < 15 && i < settings.name.len()) {
                std::raw::write(name_bytes.offset(i), *settings.name.as_ptr().offset(i));
                i += 1;
            }
            std::fn_ptr<std::raw_ptr<u8>(std::raw_ptr<u8>)> entry = [](std::raw_ptr<u8> argument) -> std::raw_ptr<u8> {
                thread_main<F, R>(argument);
                return argument;
            };
            mut std::raw::array<u64, 8> attributes = default;   // a pthread_attr_t (56 or 64 bytes)
            std::raw_ptr<mut u8> attr = cast::reinterpret<std::raw_ptr<mut u8>>(mut &attributes);
            _ = pthread_attr_init(attr);
            if (settings.stack_size > 0) { _ = pthread_attr_setstacksize(attr, settings.stack_size); }
            match (settings.platform) {
                platform_options::linux(o) => { apply_linux(attr, o); },
                _ => { },
            }
            i32 failed = pthread_create(mut &thread, attr, entry, cast::reinterpret<std::raw_ptr<u8>>(start));
            _ = pthread_attr_destroy(attr);
            run_time check (failed != 1) else "std::thread::spawn: the operating system refused the thread's scheduling options (real-time policies need privileges)";
            run_time check (failed != 22) else "std::thread::spawn: the operating system rejected the thread's options (a priority or CPU it doesn't have)";
            run_time check (failed == 0) else "std::thread::spawn: the operating system can't start another thread";
        }
        if compile_time (std::meta::is_view<F>()) {
            return scoped_handle<R>{ .thread = thread, .packet = packet };
        } else {
            return handle<R>{ .thread = thread, .packet = packet };
        }
    }

    template<type R>
    class handle {
    public:
        compile_time check (std::implements<R, std::sendable>())
            else f"the thread's result type {std::type_name<R>()} can't be moved back to the thread that joins it (it isn't std::sendable)";

        R join() move {
            std::raw_ptr<mut thread_packet<R>> packet = this.packet;
            this.packet = nullptr;
            unsafe { return join_thread(this.thread, packet).expect("the thread produced no result"); }
        }

        void detach() move {
            std::raw_ptr<mut thread_packet<R>> packet = this.packet;
            this.packet = nullptr;
            unsafe {
                _ = pthread_detach(this.thread);
                if (std::raw::atomic_exchange(&(*packet).state, detached, std::memory_order::acquire_release) == finished) {
                    std::raw::drop(packet);   // it already ended: its result is dropped here
                    std::raw::free(packet);
                }
            }
        }

        ~handle() {
            if (this.packet) {
                unsafe { _ = join_thread(this.thread, this.packet); }
            }
        }

    private:
        u64 thread = 0;
        std::raw_ptr<mut thread_packet<R>> packet = nullptr;
    }

    template<type R>
    view class scoped_handle {
    public:
        compile_time check (std::implements<R, std::sendable>())
            else f"the thread's result type {std::type_name<R>()} can't be moved back to the thread that joins it (it isn't std::sendable)";

        R join() move {
            std::raw_ptr<mut thread_packet<R>> packet = this.packet;
            this.packet = nullptr;
            unsafe { return join_thread(this.thread, packet).expect("the thread produced no result"); }
        }

        ~scoped_handle() {
            if (this.packet) {
                unsafe { _ = join_thread(this.thread, this.packet); }
            }
        }

    private:
        u64 thread = 0;
        std::raw_ptr<mut thread_packet<R>> packet = nullptr;
    }

    usize available_parallelism() {
        unsafe {
            i64 n = sysconf(online_processors);
            if (n < 1) { return 1; }
            return cast::truncate<usize>(cast::reinterpret<u64>(n));
        }
    }

    // The calling thread's name (spec 31), read from the operating system once: `name_length` 255
    // means "not read yet".
    private thread_local mut std::raw::array<u8, 16> name_bytes = default;
    private thread_local mut u8 name_length = 255;

    void set_current_name(std::str name) {
        unsafe {
            std::raw_ptr<mut u8> bytes = cast::reinterpret<std::raw_ptr<mut u8>>(mut &name_bytes);
            mut usize i = 0;
            while (i < 15 && i < name.len()) {
                std::raw::write(bytes.offset(i), *name.as_ptr().offset(i));
                i += 1;
            }
            std::raw::write(bytes.offset(i), 0u8);
            name_length = cast::truncate<u8>(i);
            _ = pthread_setname_np(pthread_self(), bytes);
        }
    }

    std::string current_name() {
        unsafe {
            std::raw_ptr<mut u8> bytes = cast::reinterpret<std::raw_ptr<mut u8>>(mut &name_bytes);
            if (name_length == 255) {
                _ = pthread_getname_np(pthread_self(), bytes, 16);
                mut usize n = 0;
                while (n < 15 && *bytes.offset(n) != 0) {
                    n += 1;
                }
                name_length = cast::truncate<u8>(n);
            }
            return std::string::from(std::raw::str_from(bytes, cast<usize>(name_length)));
        }
    }

    u64 current_id() {
        unsafe { return pthread_self(); }
    }

    void sleep(std::time::duration d) {
        u64 ns = d.as_nanoseconds();
        sleep_time wanted = sleep_time{ .seconds = cast::saturate<i64>(ns / 1000000000), .nanos = cast::saturate<i64>(ns % 1000000000) };
        mut sleep_time left = default;
        unsafe { _ = nanosleep(&wanted, mut &left); }
    }

    void yield_now() {
        unsafe { _ = sched_yield(); }
    }

    void spin_hint() {
        unsafe { std::raw::spin_hint(); }
    }
}
