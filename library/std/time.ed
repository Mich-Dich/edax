// The Edax standard library: module std::time.

namespace std::time {
    // `n` in units of `unit`, with up to two decimals and no trailing zeros: 1.5ms, 2.25s.
    private std::string trimmed(u64 n, u64 unit, std::static_str suffix) {
        u64 whole = n / unit;
        u64 hundredths = n % unit * 100 / unit;
        if (hundredths == 0) { return std::format(f"{whole}{suffix}"); }
        if (hundredths % 10 == 0) { return std::format(f"{whole}.{hundredths / 10}{suffix}"); }
        if (hundredths < 10) { return std::format(f"{whole}.0{hundredths}{suffix}"); }
        return std::format(f"{whole}.{hundredths}{suffix}");
    }

    private struct timespec {
        i64 seconds = 0;
        i64 nanos = 0;
    }

    private extern(std::build::language::c) i32 clock_gettime(i32 clock, std::raw_ptr<mut timespec> out);

    // `struct tm` of C: nine ints, then (glibc) a long and a pointer.
    private struct calendar {
        i32 second = 0;
        i32 minute = 0;
        i32 hour = 0;
        i32 day = 0;
        i32 month = 0;
        i32 year = 0;
        i32 weekday = 0;
        i32 yearday = 0;
        i32 dst = 0;
        i64 gmtoff = 0;
        u64 zone = 0;
    }

    private extern(std::build::language::c) std::raw_ptr<u8> localtime_r(std::raw_ptr<i64> seconds, std::raw_ptr<mut calendar> out);
    private extern(std::build::language::c) std::raw_ptr<u8> gmtime_r(std::raw_ptr<i64> seconds, std::raw_ptr<mut calendar> out);

    private civil_time civil_of(calendar c, u32 nanos) {
        return civil_time{
            .year = c.year + 1900,
            .month = cast::saturate<u8>(c.month + 1),
            .day = cast::saturate<u8>(c.day),
            .hour = cast::saturate<u8>(c.hour),
            .minute = cast::saturate<u8>(c.minute),
            .second = cast::saturate<u8>(c.second),
            .nanosecond = nanos,
            .utc_offset_seconds = cast::saturate<i32>(c.gmtoff),
        };
    }

    // --- time zones -------------------------------------------------------------------------
    // A loaded zone is the transitions of its TZif file (RFC 8536) and, for the times after the
    // last one, the POSIX TZ rule of the file's footer ("CET-1CEST,M3.5.0,M10.5.0/3").

    private extern(std::build::language::c) {
        i32 open(std::raw_ptr<u8> name, i32 flags);
        isize read(i32 fd, std::raw_ptr<mut u8> buffer, usize count);
        i32 close(i32 fd);
        std::raw_ptr<u8> getenv(std::raw_ptr<u8> name);
        isize readlink(std::raw_ptr<u8> path, std::raw_ptr<mut u8> buffer, usize size);
        usize strlen(std::raw_ptr<u8> text);
    }

    // A day of a POSIX TZ rule: `Jn` (1..=365, never Feb 29), `n` (0..=365) or `Mm.w.d`.
    private struct rule_day {
        u8  form = 0;      // 0 Jn, 1 n, 2 Mm.w.d
        u16 day = 0;
        u8  month = 1;
        u8  week = 1;      // 1..=5, 5: the last
        u8  weekday = 0;   // 0 Sunday
        i32 time = 7200;   // seconds after local midnight: 02:00 unless written
    }

    private struct tz_rule {
        bool     present = false;
        i32      std_offset = 0;   // seconds east of UTC
        bool     has_dst = false;
        i32      dst_offset = 0;
        rule_day start = default;
        rule_day end = default;
    }

    // `a / b` rounded towards minus infinity.
    private i64 floor_div(i64 a, i64 b) {
        i64 q = a / b;
        if ((a % b != 0) && ((a < 0) != (b < 0))) { return q - 1; }
        return q;
    }

    private bool is_leap(i64 y) { return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0); }

    // Days since 1970-01-01 of a date of the proleptic Gregorian calendar (H. Hinnant).
    private i64 days_from_civil(i64 year, i64 month, i64 day) {
        i64 y = if (month <= 2) { year - 1 } else { year };
        i64 era = floor_div(y, 400);
        i64 yoe = y - era * 400;
        i64 mp = if (month > 2) { month - 3 } else { month + 9 };
        i64 doy = (153 * mp + 2) / 5 + day - 1;
        i64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        return era * 146097 + doe - 719468;
    }

    // The year of a day since 1970-01-01.
    private i64 year_of_day(i64 z0) {
        i64 z = z0 + 719468;
        i64 era = floor_div(z, 146097);
        i64 doe = z - era * 146097;
        i64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        i64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        i64 mp = (5 * doy + 2) / 153;
        i64 month = if (mp < 10) { mp + 3 } else { mp - 9 };
        return yoe + era * 400 + if (month <= 2) { 1 } else { 0 };
    }

    private i64 days_in_month(i64 year, i64 month) {
        if (month == 2) { return if (is_leap(year)) { 29 } else { 28 }; }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    // The day (since 1970-01-01) a rule day falls on in `year`.
    private i64 rule_day_in(rule_day r, i64 year) {
        i64 jan1 = days_from_civil(year, 1, 1);
        if (r.form == 0) {
            i64 n = cast<i64>(r.day);
            return jan1 + n - 1 + if (is_leap(year) && n >= 60) { 1 } else { 0 };
        }
        if (r.form == 1) { return jan1 + cast<i64>(r.day); }
        i64 month = cast<i64>(r.month);
        i64 first = days_from_civil(year, month, 1);
        i64 first_weekday = floor_div(first + 4, 7) * -7 + first + 4;   // 1970-01-01 was a Thursday
        mut i64 day = first + (cast<i64>(r.weekday) - first_weekday + 7) % 7 + (cast<i64>(r.week) - 1) * 7;
        while (day >= first + days_in_month(year, month)) { day -= 7; }
        return day;
    }

    // Whether daylight-saving time is in effect at `t` (UTC seconds) under the rule.
    private bool rule_is_dst(tz_rule& r, i64 t) {
        if (!r.has_dst) { return false; }
        i64 year = year_of_day(floor_div(t + cast<i64>(r.std_offset), 86400));
        i64 start = rule_day_in(r.start, year) * 86400 + cast<i64>(r.start.time) - cast<i64>(r.std_offset);
        i64 end = rule_day_in(r.end, year) * 86400 + cast<i64>(r.end.time) - cast<i64>(r.dst_offset);
        if (start < end) { return start <= t && t < end; }
        return !(end <= t && t < start);   // the southern hemisphere: DST spans the new year
    }

    // Reads a POSIX TZ string. `failed` is set at the first thing that doesn't fit, and the
    // readers return 0 from then on (no option types: each one would be another instance).
    private view struct tz_reader {
        std::str text;
        usize at = 0;
        bool failed = false;
    }

    private bool tz_done(tz_reader& r) { return r.at >= r.text.len(); }

    private u8 tz_peek(tz_reader& r) {
        if (tz_done(r)) { return 0; }
        unsafe { return *r.text.as_ptr().offset(r.at); }
    }

    // Skips the byte `c` if it is next; else marks the reader failed.
    private void tz_expect(mut tz_reader& r, u8 c) {
        if (tz_peek(r) == c) {
            r.at += 1;
        } else {
            r.failed = true;
        }
    }

    private void tz_name(mut tz_reader& r) {
        if (tz_peek(r) == 60) {   // '<' quoted name '>'
            r.at += 1;
            while (!tz_done(r) && tz_peek(r) != 62) { r.at += 1; }
            tz_expect(mut r, 62);
            return;
        }
        usize begin = r.at;
        while (!tz_done(r) && ((tz_peek(r) >= 65 && tz_peek(r) <= 90) || (tz_peek(r) >= 97 && tz_peek(r) <= 122))) { r.at += 1; }
        if (r.at - begin < 3) { r.failed = true; }
    }

    private i64 tz_number(mut tz_reader& r) {
        if (tz_done(r) || tz_peek(r) < 48 || tz_peek(r) > 57) {
            r.failed = true;
            return 0;
        }
        mut i64 n = 0;
        while (!tz_done(r) && tz_peek(r) >= 48 && tz_peek(r) <= 57) {
            n = n * 10 + cast<i64>(tz_peek(r) - 48);
            if (n > 1000000) {
                r.failed = true;
                return 0;
            }
            r.at += 1;
        }
        return n;
    }

    // `[+-]hh[:mm[:ss]]` in seconds.
    private i64 tz_time(mut tz_reader& r) {
        mut i64 sign = 1;
        if (tz_peek(r) == 45) {
            sign = -1;
            r.at += 1;
        } else if (tz_peek(r) == 43) {
            r.at += 1;
        }
        mut i64 total = tz_number(mut r) * 3600;
        if (tz_peek(r) == 58) {
            r.at += 1;
            total += tz_number(mut r) * 60;
            if (tz_peek(r) == 58) {
                r.at += 1;
                total += tz_number(mut r);
            }
        }
        return sign * total;
    }

    private rule_day tz_rule_day(mut tz_reader& r) {
        mut rule_day d = default;
        if (tz_peek(r) == 74) {   // 'J'
            r.at += 1;
            d.form = 0;
            d.day = cast::saturate<u16>(tz_number(mut r));
        } else if (tz_peek(r) == 77) {   // 'M'
            r.at += 1;
            d.form = 2;
            d.month = cast::saturate<u8>(tz_number(mut r));
            tz_expect(mut r, 46);
            d.week = cast::saturate<u8>(tz_number(mut r));
            tz_expect(mut r, 46);
            d.weekday = cast::saturate<u8>(tz_number(mut r));
            if (d.month < 1 || d.month > 12 || d.week < 1 || d.week > 5 || d.weekday > 6) { r.failed = true; }
        } else {
            d.form = 1;
            d.day = cast::saturate<u16>(tz_number(mut r));
        }
        if (tz_peek(r) == 47) {   // '/time'
            r.at += 1;
            d.time = cast::saturate<i32>(tz_time(mut r));
        }
        return d;
    }

    // The rule of a POSIX TZ string; `present` is false when it is not one.
    private tz_rule parse_tz_rule(std::str text) {
        mut tz_reader r = tz_reader{ .text = text };
        mut tz_rule rule = default;
        tz_name(mut r);
        rule.std_offset = cast::saturate<i32>(-tz_time(mut r));
        if (r.failed) { return tz_rule{}; }
        rule.present = true;
        if (tz_done(r)) { return rule; }
        tz_name(mut r);
        rule.has_dst = true;
        rule.dst_offset = rule.std_offset + 3600;
        if (tz_peek(r) != 44 && !tz_done(r)) { rule.dst_offset = cast::saturate<i32>(-tz_time(mut r)); }
        tz_expect(mut r, 44);   // without dates POSIX leaves them to the system: not supported
        rule.start = tz_rule_day(mut r);
        tz_expect(mut r, 44);
        rule.end = tz_rule_day(mut r);
        if (r.failed) { return tz_rule{}; }
        return rule;
    }

    // Reads the file at `path` into `bytes`: false when it can't be read.
    private bool read_file(std::str path, mut std::darray<u8>& bytes) {
        mut std::raw::array<u8, 1024> name = default;
        if (path.len() >= 1024) { return false; }
        unsafe {
            std::raw_ptr<mut u8> c_name = cast::reinterpret<std::raw_ptr<mut u8>>(mut &name);
            mut usize i = 0;
            while (i < path.len()) {
                std::raw::write(c_name.offset(i), *path.as_ptr().offset(i));
                i += 1;
            }
            i32 fd = open(c_name, 0);
            if (fd < 0) { return false; }
            mut std::raw::array<u8, 4096> chunk = default;
            std::raw_ptr<mut u8> buffer = cast::reinterpret<std::raw_ptr<mut u8>>(mut &chunk);
            while (true) {
                isize n = read(fd, buffer, 4096);
                if (n <= 0) { break; }
                mut usize k = 0;
                while (k < cast::saturate<usize>(n)) {
                    bytes.push(*buffer.offset(k));
                    k += 1;
                }
            }
            _ = close(fd);
        }
        return true;
    }

    private i64 big_endian(std::darray<u8>& b, usize at, usize size) {
        mut u64 v = 0;
        mut usize i = 0;
        while (i < size) {
            v = (v << 8) | cast<u64>(b[at + i]);
            i += 1;
        }
        if (size == 4) { return cast<i64>(cast::truncate<i32>(v)); }   // the low bits, two's complement
        return cast::truncate<i64>(v);
    }

    // The text of a C string.
    private std::string c_text(std::raw_ptr<u8> text) {
        unsafe { return std::string::from(std::raw::str_from(text, strlen(text))); }
    }

    private compile_time u8 source_utc = 0;
    private compile_time u8 source_local = 1;
    private compile_time u8 source_data = 2;

    class zone {
    public:
        static zone utc() { return zone{ .zone_name = std::string::from("UTC") }; }

        static zone local() {
            mut std::string name = std::string::from("localtime");
            unsafe {
                std::raw_ptr<u8> tz = getenv(c"TZ");
                if (tz && *tz != 0) {
                    std::string text = c_text(tz);
                    std::str value = text.as_str();
                    name = std::string::from(if (value.starts_with(":")) { value.slice(1, value.len()) } else { value });
                } else {
                    mut std::raw::array<u8, 1024> link = default;
                    std::raw_ptr<mut u8> buffer = cast::reinterpret<std::raw_ptr<mut u8>>(mut &link);
                    isize n = readlink(c"/etc/localtime", buffer, 1023);
                    if (n > 0) {
                        std::str target = std::raw::str_from(buffer, cast::saturate<usize>(n));
                        match (target.find("zoneinfo/")) {
                            std::some(at) => { name = std::string::from(target.slice(at + 9, target.len())); },
                            std::none => { },
                        }
                    }
                }
            }
            return zone{ .zone_name = move name, .source = source_local };
        }

        static std::result<zone, zone_error> load(std::str name) {
            compile_time check (std::build::target_has(std::build::capability::files))
                else "std::time::zone::load reads the time-zone database: it needs a target with files (utc() and local() work everywhere)";
            if (name == "UTC" || name == "Etc/UTC") { return std::ok(zone::utc()); }
            if (name.is_empty() || name.starts_with("/") || name.contains("..")) { return std::error(zone_error::not_found); }
            mut std::string path = std::string::from("/usr/share/zoneinfo/");
            unsafe {
                std::raw_ptr<u8> dir = getenv(c"TZDIR");
                if (dir && *dir != 0) {
                    path = c_text(dir);
                    path.push('/');
                }
            }
            path.push_str(name);
            mut std::darray<u8> bytes = default;
            if (!read_file(path.as_str(), mut bytes)) { return std::error(zone_error::not_found); }
            mut zone z = zone{ .zone_name = std::string::from(name), .source = source_data };
            if (!z.parse(bytes)) { return std::error(zone_error::invalid_data); }
            return std::ok(move z);
        }

        std::str name() { return this.zone_name.as_str(); }

        i32 offset_at(wall_time t) {
            if (this.source == source_utc) { return 0; }
            if (this.source == source_local) { return t.local().utc_offset_seconds; }
            return this.data_offset(t.seconds);
        }

        bool is_dst_at(wall_time t) {
            if (this.source == source_utc) { return false; }
            if (this.source == source_local) {
                mut calendar c = default;
                i64 s = t.seconds;
                unsafe { _ = localtime_r(&s, mut &c); }
                return c.dst > 0;
            }
            usize i = this.transition_at(t.seconds);
            if (i < this.times.len()) { return (this.kind_info[cast<usize>(this.kinds[i])] & 1) != 0; }
            if (this.times.is_empty() || t.seconds < this.times[0]) { return false; }
            return rule_is_dst(this.rule, t.seconds);
        }

        zone clone() {
            return zone{
                .zone_name = this.zone_name.clone(),
                .source = this.source,
                .times = this.times.clone(),
                .kinds = this.kinds.clone(),
                .kind_info = this.kind_info.clone(),
                .first_offset = this.first_offset,
                .rule = this.rule,
            };
        }

    private:
        std::string        zone_name = default;
        u8                 source = 0;
        std::darray<i64>   times = default;          // transition times, UTC seconds
        std::darray<u8>    kinds = default;          // the kind in effect from each transition
        std::darray<i64>   kind_info = default;      // per kind: seconds east of UTC * 2, + 1 for daylight-saving time
        i32                first_offset = 0;         // before the first transition
        tz_rule            rule = default;           // after the last transition

        // The index of the last transition at or before `t`, while the transitions cover `t`;
        // else the number of transitions.
        usize transition_at(i64 t) {
            usize n = this.times.len();
            if (n == 0 || t < this.times[0]) { return n; }
            if (t >= this.times[n - 1] && this.rule.present) { return n; }
            mut usize lo = 0;
            mut usize hi = n;   // times[lo] <= t < times[hi]
            while (hi - lo > 1) {
                usize mid = lo + (hi - lo) / 2;
                if (this.times[mid] <= t) { lo = mid; } else { hi = mid; }
            }
            return lo;
        }

        i32 data_offset(i64 t) {
            usize i = this.transition_at(t);
            if (i < this.times.len()) { return cast::truncate<i32>(this.kind_info[cast<usize>(this.kinds[i])] >> 1); }
            if (this.times.is_empty() && !this.rule.present) { return this.first_offset; }
            if (!this.times.is_empty() && t < this.times[0]) { return this.first_offset; }
            if (rule_is_dst(this.rule, t)) { return this.rule.dst_offset; }
            return this.rule.std_offset;
        }

        // Reads a TZif file (versions 1 to 4): the 64-bit data block when there is one, and the
        // POSIX TZ footer.
        bool parse(std::darray<u8>& b) mut {
            if (b.len() < 44 || b[0] != 84 || b[1] != 90 || b[2] != 105 || b[3] != 102) { return false; }   // "TZif"
            u8 version = b[4];
            mut usize at = 0;
            mut usize time_size = 4;
            if (version >= 50) {   // '2' and later: skip the 32-bit block, read the 64-bit one
                usize skip = self_block_size(b, 0, 4);
                if (skip == 0 || 44 + skip + 44 > b.len()) { return false; }
                at = 44 + skip;
                time_size = 8;
            }
            if (b.len() < at + 44) { return false; }
            usize isutcnt = cast::saturate<usize>(big_endian(b, at + 20, 4));
            usize isstdcnt = cast::saturate<usize>(big_endian(b, at + 24, 4));
            usize leapcnt = cast::saturate<usize>(big_endian(b, at + 28, 4));
            usize timecnt = cast::saturate<usize>(big_endian(b, at + 32, 4));
            usize typecnt = cast::saturate<usize>(big_endian(b, at + 36, 4));
            usize charcnt = cast::saturate<usize>(big_endian(b, at + 40, 4));
            if (typecnt == 0) { return false; }
            usize size = self_block_size(b, at, time_size);
            if (at + 44 + size > b.len()) { return false; }
            mut usize p = at + 44;
            mut usize i = 0;
            while (i < timecnt) {
                this.times.push(big_endian(b, p + i * time_size, time_size));
                i += 1;
            }
            p += timecnt * time_size;
            i = 0;
            while (i < timecnt) {
                if (cast<usize>(b[p + i]) >= typecnt) { return false; }
                this.kinds.push(b[p + i]);
                i += 1;
            }
            p += timecnt;
            i = 0;
            mut bool first_set = false;
            while (i < typecnt) {
                i32 offset = cast::truncate<i32>(big_endian(b, p + i * 6, 4));
                bool dst = b[p + i * 6 + 4] != 0;
                this.kind_info.push(cast<i64>(offset) * 2 + if (dst) { 1 } else { 0 });
                if (!first_set && !dst) {
                    this.first_offset = offset;
                    first_set = true;
                }
                i += 1;
            }
            if (!first_set) { this.first_offset = cast::truncate<i32>(this.kind_info[0] >> 1); }
            p += typecnt * 6 + charcnt + leapcnt * (time_size + 4) + isstdcnt + isutcnt;
            if (time_size == 8 && p < b.len() && b[p] == 10) {   // the footer: "\n" TZ "\n"
                usize begin = p + 1;
                mut usize end = begin;
                while (end < b.len() && b[end] != 10) { end += 1; }
                if (end < b.len() && end > begin) {
                    mut std::string text = std::string::with_capacity(end - begin);
                    mut usize k = begin;
                    while (k < end) {
                        text.push(cast::checked<char>(cast<u32>(b[k])).value_or('?'));
                        k += 1;
                    }
                    tz_rule r = parse_tz_rule(text.as_str());
                    if (r.present) { this.rule = r; }
                }
            }
            if (this.times.is_empty() && !this.rule.present) {
                this.rule.present = true;
                this.rule.std_offset = this.first_offset;
            }
            return true;
        }
    }

    // The size of a TZif data block after its 44-byte header at `at`.
    private usize self_block_size(std::darray<u8>& b, usize at, usize time_size) {
        if (at + 44 > b.len()) { return 0; }
        usize isutcnt = cast::saturate<usize>(big_endian(b, at + 20, 4));
        usize isstdcnt = cast::saturate<usize>(big_endian(b, at + 24, 4));
        usize leapcnt = cast::saturate<usize>(big_endian(b, at + 28, 4));
        usize timecnt = cast::saturate<usize>(big_endian(b, at + 32, 4));
        usize typecnt = cast::saturate<usize>(big_endian(b, at + 36, 4));
        usize charcnt = cast::saturate<usize>(big_endian(b, at + 40, 4));
        return timecnt * time_size + timecnt + typecnt * 6 + charcnt + leapcnt * (time_size + 4) + isstdcnt + isutcnt;
    }

    private compile_time i32 clock_monotonic = 1;
    private compile_time i32 clock_realtime = 0;

    struct wall_time {
        static wall_time now() {
            mut timespec t = default;
            unsafe { _ = clock_gettime(clock_realtime, mut &t); }
            return wall_time{ .seconds = t.seconds, .nanos = cast::saturate<u32>(t.nanos) };
        }

        i64 unix_nanoseconds() { return this.seconds * 1000000000 + cast<i64>(this.nanos); }

        civil_time utc() {
            mut calendar c = default;
            i64 s = this.seconds;
            unsafe { _ = gmtime_r(&s, mut &c); }
            return civil_of(c, this.nanos);
        }

        civil_time local() {
            mut calendar c = default;
            i64 s = this.seconds;
            unsafe { _ = localtime_r(&s, mut &c); }
            return civil_of(c, this.nanos);
        }

        civil_time in_zone(zone& z) {
            if (z.source == source_local) { return this.local(); }
            i32 offset = z.offset_at(this);
            mut calendar c = default;
            i64 s = this.seconds + cast<i64>(offset);
            unsafe { _ = gmtime_r(&s, mut &c); }
            mut civil_time out = civil_of(c, this.nanos);
            out.utc_offset_seconds = offset;
            return out;
        }
    }

    struct duration {
        compile_time run_time static duration nanoseconds(u64 n) { return duration{ .nanos = n }; }
        compile_time run_time static duration microseconds(u64 n) { return duration{ .nanos = n * 1000 }; }
        compile_time run_time static duration milliseconds(u64 n) { return duration{ .nanos = n * 1000000 }; }
        compile_time run_time static duration seconds(u64 n) { return duration{ .nanos = n * 1000000000 }; }
        compile_time run_time static duration minutes(u64 n) { return duration{ .nanos = n * 60000000000 }; }
        compile_time run_time static duration hours(u64 n) { return duration{ .nanos = n * 3600000000000 }; }

        u64 as_nanoseconds() { return this.nanos; }
        u64 as_microseconds() { return this.nanos / 1000; }
        u64 as_milliseconds() { return this.nanos / 1000000; }
        u64 as_seconds() { return this.nanos / 1000000000; }
        f64 as_seconds_f64() { return cast::round<f64>(this.nanos) / 1000000000.0; }

        duration operator+(duration other) { return duration{ .nanos = this.nanos + other.nanos }; }
        duration operator-(duration other) {
            run_time check (other.nanos <= this.nanos) else "a duration can't be negative";
            return duration{ .nanos = this.nanos - other.nanos };
        }
        duration operator*(u64 n) { return duration{ .nanos = this.nanos * n }; }
        duration operator/(u64 n) { return duration{ .nanos = this.nanos / n }; }
        std::ordering operator<=>(duration& other) { return this.nanos <=> other.nanos; }

        void format(mut std::formatter& out) {
            u64 n = this.nanos;
            if (n < 1000) {
                out.write(std::format(f"{n}ns"));
            } else if (n < 1000000) {
                out.write(trimmed(n, 1000, "us"));
            } else if (n < 1000000000) {
                out.write(trimmed(n, 1000000, "ms"));
            } else if (n < 60000000000) {
                out.write(trimmed(n, 1000000000, "s"));
            } else {
                u64 s = n / 1000000000;
                if (s < 3600) {
                    out.write(std::format(f"{s / 60}m {s % 60}s"));
                } else {
                    out.write(std::format(f"{s / 3600}h {s / 60 % 60}m"));
                }
            }
        }
    }

    struct instant {
        static instant now() {
            mut timespec t = default;
            unsafe { _ = clock_gettime(clock_monotonic, mut &t); }
            return instant{ .nanos = cast::saturate<u64>(t.seconds) * 1000000000 + cast::saturate<u64>(t.nanos) };
        }

        duration elapsed() { return instant::now().since(this); }

        duration since(instant earlier) {
            run_time check (earlier.nanos <= this.nanos) else "instant::since: 'earlier' is later";
            return duration{ .nanos = this.nanos - earlier.nanos };
        }

        instant operator+(duration d) { return instant{ .nanos = this.nanos + d.nanos }; }
        instant operator-(duration d) {
            run_time check (d.nanos <= this.nanos) else "an instant before the clock's start";
            return instant{ .nanos = this.nanos - d.nanos };
        }
    }
}
