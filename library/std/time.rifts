// The Rift standard library: module std::time.

private struct timespec {
    i64 seconds = 0;
    i64 nanos = 0;
}

private extern(std::build::language::c) i32 clock_gettime(i32 clock, std::raw_ptr<mut timespec> out);

private compile_time i32 clock_monotonic = 1;

struct duration {
    static duration nanoseconds(u64 n) { return duration{ .nanos = n }; }
    static duration microseconds(u64 n) { return duration{ .nanos = std::saturating_mul(n, 1000) }; }
    static duration milliseconds(u64 n) { return duration{ .nanos = std::saturating_mul(n, 1000000) }; }
    static duration seconds(u64 n) { return duration{ .nanos = std::saturating_mul(n, 1000000000) }; }

    u64 as_nanoseconds() { return this.nanos; }
    u64 as_microseconds() { return this.nanos / 1000; }
    u64 as_milliseconds() { return this.nanos / 1000000; }
    f64 as_seconds() { return cast::round<f64>(this.nanos) / 1000000000.0; }
}

struct instant {
    static instant now() {
        mut timespec t = default;
        unsafe { _ = clock_gettime(clock_monotonic, mut &t); }
        return instant{ .nanos = cast::saturate<u64>(t.seconds) * 1000000000 + cast::saturate<u64>(t.nanos) };
    }

    duration elapsed() { return instant::now().since(this); }

    duration since(instant earlier) {
        if (earlier.nanos >= this.nanos) { return duration{}; }
        return duration{ .nanos = this.nanos - earlier.nanos };
    }
}
