// The Edax standard library: module std::ui::nodes (see nodes.edh).

import std;

namespace std::ui::nodes {
    namespace im = std::ui::immediate;


    struct edits {
        bool changed() {
            return !this.created.is_empty() || !this.deleted_links.is_empty() || !this.deleted_nodes.is_empty() ||
                   !this.moved.is_empty() || this.dropped.is_some() || this.menu_at.is_some() || this.duplicate;
        }
    }

    private bool contains_id(std::span<u64> ids, u64 id) {
        for (u64 x : ids) {
            if (x == id) {
                return true;
            }
        }
        return false;
    }

    private void remove_id(mut std::darray<u64>& ids, u64 id) {
        mut std::darray<u64> kept = default;
        for (u64 x : ids) {
            if (x != id) {
                kept.push(x);
            }
        }
        ids = move kept;
    }

    private void toggle_id(mut std::darray<u64>& ids, u64 id) {
        if (contains_id(ids.as_span(), id)) {
            remove_id(mut ids, id);
        } else {
            ids.push(id);
        }
    }

    private void insert_point(mut std::darray<std::ui::vec2>& points, usize at, std::ui::vec2 p) {
        usize i = at.min(points.len());
        points.push(p);
        mut usize k = points.len() - 1;
        while (k > i) {
            points[k] = points[k - 1];
            k -= 1;
        }
        points[i] = p;
    }

    private void remove_point(mut std::darray<std::ui::vec2>& points, usize at) {
        if (at >= points.len()) {
            return;
        }
        for (usize k : at..(points.len() - 1)) {
            points[k] = points[k + 1];
        }
        points.truncate(points.len() - 1);
    }

    // Where the selected nodes go for `how`, from their boxes (canvas units).
    private void arrange(mut view_state& view, arrangement how, std::ui::vec2 origin) {
        mut std::darray<node_place> chosen = default;
        for (node_place n : view.boxes) {
            if (contains_id(view.selected.as_span(), n.id)) {
                std::ui::vec2 low = (n.bounds.origin() - origin - view.pan) * (1.0 / view.zoom);
                chosen.push(node_place{ .id = n.id, .bounds = std::ui::rect{ .x = low.x, .y = low.y, .width = n.bounds.width / view.zoom, .height = n.bounds.height / view.zoom } });
            }
        }
        if (chosen.len() < 2) {
            return;
        }
        mut std::ui::rect all = chosen[0].bounds;
        for (node_place n : chosen) {
            all = all.united(n.bounds);
        }
        bool spread = how == arrangement::spread_x || how == arrangement::spread_y;
        if (spread) {
            bool across = how == arrangement::spread_x;
            chosen.sort_by([across](node_place& a, node_place& b) { return if (across) { a.bounds.x < b.bounds.x } else { a.bounds.y < b.bounds.y }; });
            mut f32 taken = 0.0;
            for (node_place n : chosen) {
                taken += if (across) { n.bounds.width } else { n.bounds.height };
            }
            f32 room = if (across) { all.width } else { all.height };
            f32 gap = (room - taken) / cast::round<f32>(chosen.len() - 1);
            mut f32 at = if (across) { all.x } else { all.y };
            for (node_place n : chosen) {
                _ = view.arranged.insert(n.id, axis_target{ .horizontal = across, .value = at });
                at += gap + if (across) { n.bounds.width } else { n.bounds.height };
            }
            return;
        }
        for (node_place n : chosen) {
            std::ui::rect b = n.bounds;
            axis_target goal = match (how) {
                arrangement::left => axis_target{ .horizontal = true, .value = all.x },
                arrangement::center => axis_target{ .horizontal = true, .value = all.x + (all.width - b.width) * 0.5 },
                arrangement::right => axis_target{ .horizontal = true, .value = all.right() - b.width },
                arrangement::top => axis_target{ .horizontal = false, .value = all.y },
                arrangement::middle => axis_target{ .horizontal = false, .value = all.y + (all.height - b.height) * 0.5 },
                _ => axis_target{ .horizontal = false, .value = all.bottom() - b.height },
            };
            _ = view.arranged.insert(n.id, goal);
        }
    }

    // The box between two corners.
    private std::ui::rect box_between(std::ui::vec2 a, std::ui::vec2 b) {
        return std::ui::rect{ .x = a.x.min(b.x), .y = a.y.min(b.y), .width = (b.x - a.x).abs(), .height = (b.y - a.y).abs() };
    }

    private bool boxes_touch(std::ui::rect a, std::ui::rect b) {
        std::ui::rect both = a.intersection(b);
        return both.width > 0.0 && both.height > 0.0;
    }

    // The two control points of a curved run from `a` to `b`: horizontal at both ends, reaching
    // out at least 50 units from a pin (`pin_a`, `pin_b`; reroute points need no room).
    private (std::ui::vec2, std::ui::vec2) bends(std::ui::vec2 a, std::ui::vec2 b, f32 zoom, bool pin_a, bool pin_b) {
        f32 half = (b.x - a.x).abs() * 0.5;
        f32 out = if (pin_a) { half.max(50.0 * zoom) } else { half };
        f32 back = if (pin_b) { half.max(50.0 * zoom) } else { half };
        return (a + std::ui::vec2{ .x = out }, b - std::ui::vec2{ .x = back });
    }

    // The corners of a subway line from `a` to `b`: out of `a` to the right and into `b` from the
    // left (after `stub_a` and `stub_b`), every run horizontal, vertical or at 45°.
    private void metro_corners(mut std::darray<std::ui::vec2>& out, std::ui::vec2 a, std::ui::vec2 b, f32 stub_a, f32 stub_b) {
        f32 stub = stub_a.max(stub_b).max(1.0);
        std::ui::vec2 p = a + std::ui::vec2{ .x = stub_a };
        std::ui::vec2 q = b - std::ui::vec2{ .x = stub_b };
        out.push(a);
        if (q.x >= p.x) {
            f32 dx = q.x - p.x;
            f32 dy = q.y - p.y;
            f32 rise = dy.abs();
            f32 sign = if (dy < 0.0) { -1.0 } else { 1.0 };
            if (dx >= rise) {
                // Across, down (or up) at 45°, across.
                f32 run = (dx - rise) * 0.5;
                out.push(std::ui::vec2{ .x = p.x + run, .y = a.y });
                out.push(std::ui::vec2{ .x = p.x + run + rise, .y = b.y });
            } else {
                // Steeper than 45°: half the width at 45°, straight down (or up), the other half.
                f32 half = dx * 0.5;
                out.push(p);
                out.push(std::ui::vec2{ .x = p.x + half, .y = p.y + sign * half });
                out.push(std::ui::vec2{ .x = p.x + half, .y = q.y - sign * half });
                out.push(q);
            }
        } else {
            // Backwards: out, down (or up) to between the pins (or below both), across, and in.
            f32 middle = if ((b.y - a.y).abs() > 4.0 * stub) { (a.y + b.y) * 0.5 } else { a.y.max(b.y) + 3.0 * stub };
            out.push(p);
            out.push(std::ui::vec2{ .x = p.x, .y = middle });
            out.push(std::ui::vec2{ .x = q.x, .y = middle });
            out.push(q);
        }
        out.push(b);
    }

    // Drops points on top of the one before and points in the middle of a straight run.
    private void simplify(mut std::darray<std::ui::vec2>& points) {
        mut usize n = 0;
        for (usize i : 0..points.len()) {
            std::ui::vec2 q = points[i];
            if (n > 0 && (q - points[n - 1]).length() < 0.5) {
                continue;
            }
            if (n >= 2) {
                std::ui::vec2 d1 = points[n - 1] - points[n - 2];
                std::ui::vec2 d2 = q - points[n - 1];
                f32 cross = d1.x * d2.y - d1.y * d2.x;
                if (cross.abs() <= 0.001 * d1.length() * d2.length() && d1.dot(d2) > 0.0) {
                    points[n - 1] = q;
                    continue;
                }
            }
            points[n] = q;
            n += 1;
        }
        points.truncate(n);
    }

    // `corners` with every inner corner replaced by an arc of `radius` (smaller where the runs
    // beside it are short), appended to `out`.
    private void round_into(mut std::darray<std::ui::vec2>& out, std::span<std::ui::vec2> corners, f32 radius) {
        usize n = corners.len();
        if (n == 0) {
            return;
        }
        out.push(corners[0]);
        if (n > 2) {
            for (usize i : 1..(n - 1)) {
                std::ui::vec2 u = corners[i - 1];
                std::ui::vec2 v = corners[i];
                std::ui::vec2 w = corners[i + 1];
                f32 l1 = (v - u).length();
                f32 l2 = (w - v).length();
                if (l1 < 0.001 || l2 < 0.001) {
                    out.push(v);
                    continue;
                }
                std::ui::vec2 e1 = (v - u) * (1.0 / l1);
                std::ui::vec2 e2 = (w - v) * (1.0 / l2);
                f32 c = e1.dot(e2).clamp(-0.999, 1.0);
                // The arc meets each run tan(turn / 2) × radius before the corner.
                f32 tangent = ((1.0 - c) / (1.0 + c)).sqrt();
                f32 room1 = if (i == 1) { l1 } else { l1 * 0.5 };
                f32 room2 = if (i == n - 2) { l2 } else { l2 * 0.5 };
                f32 cut = (radius * tangent).min(room1).min(room2);
                std::ui::vec2 from = v - e1 * cut;
                std::ui::vec2 to = v + e2 * cut;
                for (u32 k : 0..9) {
                    f32 t = cast::round<f32>(k) / 8.0;
                    f32 s = 1.0 - t;
                    out.push(from * (s * s) + v * (2.0 * s * t) + to * (t * t));
                }
            }
        }
        out.push(corners[n - 1]);
    }

    // A run of a link from `a` to `b` as a polyline appended to `out` (`corners` is room for its
    // corners); `pin_a` and `pin_b`: whether the ends are pins (or reroute points).
    private void route(mut std::darray<std::ui::vec2>& out, mut std::darray<std::ui::vec2>& corners, std::ui::vec2 a, std::ui::vec2 b, link_look look, f32 zoom, bool pin_a, bool pin_b) {
        f32 stub_a = if (pin_a) { look.stub * zoom } else { 0.0 };
        f32 stub_b = if (pin_b) { look.stub * zoom } else { 0.0 };
        match (look.shape) {
            link_shape::curve => {
                (std::ui::vec2 c1, std::ui::vec2 c2) = bends(a, b, zoom, pin_a, pin_b);
                f32 reach = (c1 - a).length() + (c2 - c1).length() + (b - c2).length();
                u32 steps = cast::saturate<u32>((reach / 8.0).ceil()).max(12).min(64);
                for (u32 i : 0..(steps + 1)) {
                    f32 t = cast::round<f32>(i) / cast::round<f32>(steps);
                    f32 s = 1.0 - t;
                    out.push(a * (s * s * s) + c1 * (3.0 * s * s * t) + c2 * (3.0 * s * t * t) + b * (t * t * t));
                }
                return;
            },
            link_shape::metro => {
                corners.clear();
                metro_corners(mut corners, a, b, stub_a, stub_b);
            },
            link_shape::straight => {
                corners.clear();
                corners.push(a);
                corners.push(a + std::ui::vec2{ .x = stub_a });
                corners.push(b - std::ui::vec2{ .x = stub_b });
                corners.push(b);
            },
        }
        simplify(mut corners);
        if (look.round_corners && look.corner_radius > 0.0) {
            round_into(mut out, corners.as_span(), look.corner_radius * zoom);
        } else {
            for (std::ui::vec2 c : corners) {
                out.push(c);
            }
        }
    }

    private f32 segment_distance(std::ui::vec2 p, std::ui::vec2 a, std::ui::vec2 b) {
        std::ui::vec2 d = b - a;
        f32 along = d.length_squared();
        if (along < 0.000001) {
            return (p - a).length();
        }
        f32 t = ((p - a).dot(d) / along).clamp(0.0, 1.0);
        return (p - (a + d * t)).length();
    }

    private f32 path_distance(std::ui::vec2 p, std::span<std::ui::vec2> points) {
        mut f32 best = 1000000.0;
        if (points.len() == 1) {
            return (p - points[0]).length();
        }
        for (usize i : 1..points.len()) {
            best = best.min(segment_distance(p, points[i - 1], points[i]));
        }
        return best;
    }

    // Whether the segment from `a` to `b` touches `r` (Liang-Barsky clipping).
    private bool segment_touches(std::ui::rect r, std::ui::vec2 a, std::ui::vec2 b) {
        if (r.contains(a) || r.contains(b)) {
            return true;
        }
        f32 dx = b.x - a.x;
        f32 dy = b.y - a.y;
        std::array<f32, 4> p = [-dx, dx, -dy, dy];
        std::array<f32, 4> q = [a.x - r.x, r.right() - a.x, a.y - r.y, r.bottom() - a.y];
        mut f32 low = 0.0;
        mut f32 high = 1.0;
        for (usize i : 0..4) {
            if (p[i] == 0.0) {
                if (q[i] < 0.0) {
                    return false;
                }
            } else {
                f32 t = q[i] / p[i];
                if (p[i] < 0.0) {
                    if (t > high) {
                        return false;
                    }
                    low = low.max(t);
                } else {
                    if (t < low) {
                        return false;
                    }
                    high = high.min(t);
                }
            }
        }
        return low <= high;
    }

    private bool path_touches(std::ui::rect r, std::span<std::ui::vec2> points) {
        if (r.width <= 0.0 || r.height <= 0.0) {
            return false;
        }
        for (usize i : 1..points.len()) {
            if (segment_touches(r, points[i - 1], points[i])) {
                return true;
            }
        }
        return false;
    }

    private std::span<std::ui::vec2> path_of(std::darray<std::ui::vec2>& path, link_place l) {
        return path.as_span().slice(cast<usize>(l.first), cast<usize>(l.first + l.count));
    }

    implement widgets for std::ui::immediate::scope {
        editor node_editor(std::str name, mut view_state& view, f32 height, implicit compile_time std::call_site where) mut override {
            u64 wid = this.make_id(name, where);
            std::ui::theme outer = this.ctx.look;
            std::ui::theme t = match (view.look.canvas_theme) {
                std::some(own) => {
                    mut std::ui::theme inside = own;
                    inside.density = outer.density;
                    inside
                },
                std::none => outer,
            };
            f32 wanted = if (height > 0.0) { height * outer.density } else { this.available_height().max(160.0) };
            std::ui::rect r = if (this.open()) { this.allocate(std::ui::vec2{ .x = this.available_width(), .y = wanted }) } else { std::ui::rect{} };
            std::ui::rect clip = this.ctx.layers[this.layer_index].list.current_clip();
            im::response resp = this.ctx.respond(wid, r, this.window, clip, true);
            std::ui::vec2 cursor = this.ctx.in.cursor;
            // Lining up the selection: from the boxes of the last frame, applied as nodes come.
            match (view.arrange_next) {
                std::some(how) => {
                    arrange(mut view, how, r.origin());
                    view.arrange_next = std::none;
                },
                std::none => {},
            }
            // Alt and a press on a link (as it was drawn last frame) adds a reroute point rather
            // than panning.
            mut bool alt_on_link = false;
            if (this.ctx.in.alt && this.ctx.in.mouse_pressed) {
                for (link_place l : view.links) {
                    if (path_distance(cursor, path_of(view.path, l)) < 6.0) {
                        alt_on_link = true;
                    }
                }
            }
            // Zoom at the cursor: the canvas point under it stays put.
            if (resp.state.hovered && this.ctx.in.scroll != 0.0 && this.scroll_unused()) {
                this.take_scroll();
                f32 before = view.zoom;
                f32 after = (before * (1.0 + 0.12 * this.ctx.in.scroll)).clamp(0.35, 2.5);
                std::ui::vec2 under = (cursor - r.origin() - view.pan) * (1.0 / before);
                view.zoom = after;
                view.pan = cursor - r.origin() - under * after;
            }
            // Drags: what the press started, and how far the cursor moved since the last frame.
            std::ui::vec2 moved = cursor - view.last;
            view.last = cursor;
            view.step = if (this.ctx.in.mouse_pressed) { std::ui::vec2{} } else { moved };
            view.move_by = std::ui::vec2{};
            view.frame_delta = std::ui::vec2{};
            bool pan_drag = this.ctx.in.middle_down || (this.ctx.in.alt && this.ctx.in.mouse_down);
            if (resp.state.hovered && (this.ctx.in.middle_pressed || (this.ctx.in.alt && this.ctx.in.mouse_pressed && !alt_on_link))) {
                view.drag = drag_kind::pan;
            }
            if (view.drag == drag_kind::pan) {
                if (pan_drag) {
                    view.pan = view.pan + moved;
                } else {
                    view.drag = drag_kind::none;
                }
            }
            if (view.drag == drag_kind::nodes) {
                if (this.ctx.in.mouse_down) {
                    view.move_by = view.step * (1.0 / view.zoom);
                } else {
                    view.drag = drag_kind::none;
                }
            }
            bool background = resp.state.pressed && this.ctx.in.mouse_pressed && !this.ctx.in.alt;
            mut edits out = default;
            if (resp.state.hovered && this.ctx.in.right_pressed) {
                out.menu_at = std::some((cursor - r.origin() - view.pan) * (1.0 / view.zoom));
            }
            if (resp.has_focus && this.ctx.in.pressed(std::ui::key::space) && resp.state.hovered) {
                out.menu_at = std::some((cursor - r.origin() - view.pan) * (1.0 / view.zoom));
            }
            // Everything inside draws with the style's theme.
            this.ctx.look = t;
            {
                canvas_part c = canvas_part{ .bounds = r, .origin = r.origin() + view.pan, .zoom = view.zoom, .grid = view.look.grid, .step = view.look.grid_step * view.zoom, .major_every = view.look.major_every };
                mut std::ui::painter p = this.painter();
                p.list.push_clip(r);
                view.look.draw.canvas(mut p, c);
                p.list.pop_clip();
            }
            u32 start = cast::truncate<u32>(this.ctx.layers[this.layer_index].list.indices.len());
            view.area = r;
            view.pins.clear();
            view.boxes.clear();
            view.links.clear();
            view.linked_now.clear();
            view.path.clear();
            view.marks.clear();
            view.reroutes.clear();
            // Nodes draw at the zoom: the theme's density carries it to every widget in them.
            this.ctx.look.density = t.density * view.zoom;
            return editor{ .parent = this, .state = view, .id = wid, .area = r, .look = outer, .mark = start, .out = move out, .background_pressed = background };
        }
    }

    view class editor {
    public:
        std::ui::vec2 to_screen(std::ui::vec2 p) {
            return this.area.origin() + this.state.pan + p * this.state.zoom;
        }

        std::ui::vec2 to_canvas(std::ui::vec2 p) {
            return (p - this.area.origin() - this.state.pan) * (1.0 / this.state.zoom);
        }

        void frame(u64 frame_id, mut std::ui::rect& box, std::str title, std::ui::color tint) mut {
            f32 z = this.state.zoom;
            std::ui::vec2 top_left = this.to_screen(box.origin());
            std::ui::rect r = std::ui::rect{ .x = top_left.x, .y = top_left.y, .width = box.width * z, .height = box.height * z };
            std::ui::rect head = std::ui::rect{ .x = r.x, .y = r.y, .width = r.width, .height = (26.0 * z).max(12.0) };
            std::ui::rect grip = std::ui::rect{ .x = r.right() - 14.0, .y = r.bottom() - 14.0, .width = 14.0, .height = 14.0 };
            std::ui::rect clip = this.area;
            u64 head_id = std::hash_combine(this.id, std::hash_combine(frame_id, 0x667261));
            im::response head_resp = this.parent.ctx.respond(head_id, head, this.parent.window, clip, false);
            im::response grip_resp = this.parent.ctx.respond(std::hash_combine(head_id, 1), grip, this.parent.window, clip, false);
            if (this.parent.ctx.in.mouse_pressed && head_resp.state.pressed) {
                this.state.pressed_frame = std::some(frame_id);
                this.state.pressed_frame_widget = head_id;
            }
            if (this.parent.ctx.in.mouse_pressed && grip_resp.state.pressed) {
                this.state.pressed_frame = std::some(std::hash_combine(frame_id, 1));
                this.state.pressed_frame_widget = std::hash_combine(head_id, 1);
            }
            if (this.state.drag == drag_kind::frame && !this.parent.ctx.in.mouse_down) {
                this.state.drag = drag_kind::none;
            }
            std::ui::vec2 moved = this.state.step * (1.0 / z);
            if (this.state.drag == drag_kind::frame && this.state.moving_frame == frame_id) {
                // The nodes inside move with it (they are declared after it).
                this.state.frame_before = box;
                this.state.frame_delta = moved;
                box = std::ui::rect{ .x = box.x + moved.x, .y = box.y + moved.y, .width = box.width, .height = box.height };
            }
            if (this.state.drag == drag_kind::frame && this.state.moving_frame == std::hash_combine(frame_id, 1)) {
                box = std::ui::rect{ .x = box.x, .y = box.y, .width = (box.width + moved.x).max(80.0), .height = (box.height + moved.y).max(60.0) };
            }
            frame_part part = frame_part{ .bounds = r, .header = head, .grip = grip, .title = title, .tint = tint, .hover = head_resp.state.hover, .grip_hover = grip_resp.state.hover, .zoom = z };
            mut std::ui::painter p = this.parent.painter();
            p.list.push_clip(this.area);
            this.state.look.draw.frame(mut p, part);
            p.list.pop_clip();
        }

        node_view node(u64 node_id, mut std::ui::vec2& position, std::str title, node_look appearance) mut {
            f32 z = this.state.zoom;
            f32 header = this.state.look.header_height;
            f32 last_height = match (this.state.heights.get(node_id)) {
                std::some(h) => h,
                std::none => header + 8.0,
            };
            bool collapsed = match (this.state.collapsed.get(node_id)) {
                std::some(c) => c,
                std::none => false,
            };
            match (this.state.arranged.remove(node_id)) {
                std::some(goal) => {
                    if (goal.horizontal) {
                        position.x = goal.value;
                    } else {
                        position.y = goal.value;
                    }
                    this.out.moved.push(node_id);
                },
                std::none => {},
            }
            // Moved by its frame, or with the selection.
            if (this.state.frame_delta.x != 0.0 || this.state.frame_delta.y != 0.0) {
                std::ui::rect f = this.state.frame_before;
                if (position.x >= f.x && position.y >= f.y && position.x + appearance.width <= f.right() && position.y + last_height <= f.bottom()) {
                    position = position + this.state.frame_delta;
                    this.out.moved.push(node_id);
                }
            }
            bool chosen = contains_id(this.state.selected.as_span(), node_id);
            if (chosen && (this.state.move_by.x != 0.0 || this.state.move_by.y != 0.0)) {
                position = position + this.state.move_by;
                this.out.moved.push(node_id);
            }
            std::ui::vec2 at = this.to_screen(position);
            f32 head = (header * z).round();
            std::ui::rect r = std::ui::rect{ .x = at.x.round(), .y = at.y.round(), .width = (appearance.width * z).round(), .height = if (collapsed) { head } else { (last_height * z).round() } };
            this.state.boxes.push(node_place{ .id = node_id, .bounds = r });
            u64 widget = std::hash_combine(this.id, node_id);
            im::response resp = this.parent.ctx.respond(widget, r, this.parent.window, this.area, false);
            // Whether the press moves the node is known at finish(): a widget declared later (in its
            // body, its chevron, a pin's inline widget) takes it instead.
            if (resp.state.pressed && this.parent.ctx.in.mouse_pressed) {
                this.state.pressed_node = std::some(node_id);
            }
            f32 knob = (16.0 * z).round();
            std::ui::rect chevron = std::ui::rect{ .x = (r.right() - 8.0 * z - knob).round(), .y = (r.y + (head - knob) * 0.5).round(), .width = knob, .height = knob };
            im::response fold = this.parent.ctx.respond(std::hash_combine(widget, 0x63686576), chevron, this.parent.window, this.area, false);
            if (fold.clicked) {
                _ = this.state.collapsed.insert(node_id, !collapsed);
            }
            bool selected_now = contains_id(this.state.selected.as_span(), node_id);
            // Inside the selection box being dragged: shown as what the box will select.
            bool preview = !selected_now && this.state.drag == drag_kind::box && boxes_touch(r, box_between(this.state.press_at, this.parent.ctx.in.cursor));
            node_part part = node_part{ .bounds = r, .header = std::ui::rect{ .x = r.x, .y = r.y, .width = r.width, .height = head }, .title = title, .look = appearance, .selected = selected_now, .preview = preview, .hover = resp.state.hover, .zoom = z, .collapsed = collapsed, .chevron = chevron, .chevron_hover = fold.state.hover };
            mut std::ui::painter p = this.parent.painter();
            p.list.push_clip(this.area);
            this.state.look.draw.node(mut p, part);
            p.list.pop_clip();
            return node_view{ .ed = this, .id = node_id, .bounds = r, .cursor_y = r.y + head + 4.0 * z, .collapsed = collapsed };
        }

        void link(u64 link_id, u64 from, u64 to) mut {
            std::darray<std::ui::vec2> none = default;
            place_link(mut this, link_id, from, to, none.as_span());
        }

        void link_via(u64 link_id, u64 from, u64 to, mut std::darray<std::ui::vec2>& via) mut {
            f32 z = this.state.zoom;
            bool alt = this.parent.ctx.in.alt;
            bool pressed = this.parent.ctx.in.mouse_pressed;
            // A point asked for by an Alt-click on this link last frame.
            match (this.state.insert_next) {
                std::some(add) => {
                    if (add.link == link_id) {
                        insert_point(mut via, add.index, add.at);
                        this.out.rerouted.push(link_id);
                        this.state.insert_next = std::none;
                    }
                },
                std::none => {},
            }
            if (this.state.drag == drag_kind::reroute && this.state.reroute_link == link_id) {
                if (!this.parent.ctx.in.mouse_down) {
                    this.state.drag = drag_kind::none;
                } else if (this.state.reroute_index < via.len() && (this.state.step.x != 0.0 || this.state.step.y != 0.0)) {
                    via[this.state.reroute_index] = via[this.state.reroute_index] + this.state.step * (1.0 / z);
                    this.out.rerouted.push(link_id);
                }
            }
            // The points as widgets (declared after the nodes, so they are on top of them).
            mut std::option<usize> removed = std::none;
            mut std::darray<std::ui::vec2> screen = std::darray<std::ui::vec2>::with_capacity(via.len());
            u64 base = std::hash_combine(this.id, std::hash_combine(link_id, 0x7265726f));
            f32 reach = 7.0 * z.max(0.8);
            for (usize k : 0..via.len()) {
                std::ui::vec2 at = this.to_screen(via[k]);
                screen.push(at);
                std::ui::rect spot = std::ui::rect{ .x = at.x - reach, .y = at.y - reach, .width = 2.0 * reach, .height = 2.0 * reach };
                im::response resp = this.parent.ctx.respond(std::hash_combine(base, cast<u64>(k)), spot, this.parent.window, this.area, false);
                if (resp.state.pressed && pressed) {
                    if (alt) {
                        removed = std::some(k);
                    } else {
                        this.state.drag = drag_kind::reroute;
                        this.state.reroute_link = link_id;
                        this.state.reroute_index = k;
                    }
                }
                bool dragging = this.state.drag == drag_kind::reroute && this.state.reroute_link == link_id && this.state.reroute_index == k;
                this.state.reroutes.push(reroute_place{ .at = at, .hovered = resp.state.hovered, .dragging = dragging });
            }
            match (removed) {
                std::some(k) => {
                    remove_point(mut via, k);
                    remove_point(mut screen, k);
                    this.state.reroutes.truncate(this.state.reroutes.len() - screen.len() - 1);
                    for (std::ui::vec2 at : screen) {
                        this.state.reroutes.push(reroute_place{ .at = at });
                    }
                    this.out.rerouted.push(link_id);
                },
                std::none => {},
            }
            usize dots_end = this.state.reroutes.len();
            usize dots_start = dots_end - screen.len();
            place_link(mut this, link_id, from, to, screen.as_span());
            // The points take their link's colour.
            if (!this.state.links.is_empty() && this.state.links[this.state.links.len() - 1].id == link_id) {
                std::ui::color tone = this.state.links[this.state.links.len() - 1].color;
                for (usize k : dots_start..dots_end) {
                    this.state.reroutes[k].color = tone;
                }
            }
        }

        bool is_linked(u64 pin) {
            return this.state.linked.contains(pin);
        }

        edits finish() move {
            f32 z = this.state.zoom;
            std::ui::rect r = this.area;
            // What the frame's input says, read before drawing (the painter borrows the scope).
            std::ui::vec2 cursor = this.parent.ctx.in.cursor;
            bool down = this.parent.ctx.in.mouse_down;
            bool pressed = this.parent.ctx.in.mouse_pressed;
            bool adding = this.parent.ctx.in.shift || this.parent.ctx.in.control;
            bool on_canvas = this.parent.ctx.hot == this.id;
            bool keys = this.parent.ctx.focused == this.id && this.parent.ctx.editing == 0;
            bool delete_key = keys && (this.parent.ctx.in.pressed(std::ui::key::delete) || this.parent.ctx.in.pressed(std::ui::key::backspace));
            bool all_key = keys && this.parent.ctx.in.pressed_with_control(std::ui::key::a);
            bool duplicate_key = keys && this.parent.ctx.in.pressed_with_control(std::ui::key::d);
            bool fit_key = keys && this.parent.ctx.in.pressed(std::ui::key::f) && !this.parent.ctx.in.control;
            f32 pin_reach = (this.state.look.pin_radius + 4.0) * z.max(0.8);
            bool alt = this.parent.ctx.in.alt;
            u64 active = this.parent.ctx.active;
            mut bool on_pin = false;
            if (pressed && r.contains(cursor)) {
                for (pin_place& pp : this.state.pins) {
                    if ((pp.at - cursor).length() <= pin_reach) {
                        on_pin = true;
                    }
                }
            }
            // A press on a node that no widget inside it took: select it and drag the selection.
            match (this.state.pressed_node) {
                std::some(node_id) => {
                    if (!on_pin && active == std::hash_combine(this.id, node_id)) {
                        bool chosen = contains_id(this.state.selected.as_span(), node_id);
                        if (adding) {
                            toggle_id(mut this.state.selected, node_id);
                        } else {
                            if (!chosen) {
                                this.state.selected.clear();
                                this.state.selected.push(node_id);
                            }
                            this.state.selected_links.clear();
                        }
                        this.state.drag = drag_kind::nodes;
                        this.parent.ctx.focused = this.id;
                    }
                    this.state.pressed_node = std::none;
                },
                std::none => {},
            }
            match (this.state.pressed_frame) {
                std::some(target) => {
                    if (active == this.state.pressed_frame_widget) {
                        this.state.drag = drag_kind::frame;
                        this.state.moving_frame = target;
                    }
                    this.state.pressed_frame = std::none;
                },
                std::none => {},
            }
            // Alt and a press on a link: a reroute point there, added next frame.
            if (alt && pressed && active == this.id) {
                for (link_place& l : this.state.links) {
                    std::span<std::ui::vec2> points = path_of(this.state.path, l);
                    if (path_distance(cursor, points) < 6.0) {
                        mut usize nearest = 0;
                        mut f32 best = 1000000.0;
                        for (usize k : 1..points.len()) {
                            f32 d = segment_distance(cursor, points[k - 1], points[k]);
                            if (d < best) {
                                best = d;
                                nearest = cast<usize>(l.first) + k - 1;
                            }
                        }
                        mut usize run = 0;
                        for (usize j : 0..cast<usize>(l.mark_count)) {
                            if (cast<usize>(this.state.marks[cast<usize>(l.mark_first) + j]) <= nearest) {
                                run = j;
                            }
                        }
                        this.state.insert_next = std::some(reroute_insert{ .link = l.id, .index = run, .at = this.to_canvas(cursor) });
                    }
                }
            }
            // A press on the canvas itself: a link under it is selected, otherwise a box starts.
            if (this.background_pressed && on_canvas) {
                mut u64 hit = 0;
                for (link_place& l : this.state.links) {
                    if (path_distance(cursor, path_of(this.state.path, l)) < 6.0) {
                        hit = l.id;
                    }
                }
                if (hit != 0) {
                    if (adding) {
                        toggle_id(mut this.state.selected_links, hit);
                    } else {
                        this.state.selected.clear();
                        this.state.selected_links.clear();
                        this.state.selected_links.push(hit);
                    }
                } else {
                    this.state.drag = drag_kind::box;
                    this.state.press_at = cursor;
                    if (!adding) {
                        this.state.selected.clear();
                        this.state.selected_links.clear();
                    }
                }
                this.parent.ctx.focused = this.id;
            }
            // A press on a pin starts a link.
            if (on_pin) {
                for (pin_place& pp : this.state.pins) {
                    if ((pp.at - cursor).length() <= pin_reach) {
                        this.state.drag = drag_kind::link;
                        this.state.link_from = pp.id;
                        this.state.link_from_output = pp.output;
                    }
                }
            }
            // The link being dragged: from its pin to the cursor, or to a pin it would connect to.
            mut std::option<pin_place> start = std::none;
            mut std::option<pin_place> target = std::none;
            if (this.state.drag == drag_kind::link) {
                for (pin_place& pp : this.state.pins) {
                    if (pp.id == this.state.link_from && pp.output == this.state.link_from_output) {
                        start = std::some(pp);
                    } else if (pp.output != this.state.link_from_output && (pp.at - cursor).length() <= 14.0 * z.max(0.8)) {
                        target = std::some(pp);
                    }
                }
                if (!down) {
                    match (start) {
                        std::some(s) => {
                            match (target) {
                                std::some(tp) => {
                                    this.out.created.push(if (s.output) { link_request{ .from = s.id, .to = tp.id } } else { link_request{ .from = tp.id, .to = s.id } });
                                },
                                std::none => {
                                    if (r.contains(cursor)) {
                                        this.out.dropped = std::some(canvas_drop{ .from = s.id, .from_output = s.output, .at = this.to_canvas(cursor) });
                                    }
                                },
                            }
                        },
                        std::none => {},
                    }
                    this.state.drag = drag_kind::none;
                }
            }
            // The selection box: nodes and links it touches are selected when it is let go.
            std::ui::rect box = box_between(this.state.press_at, cursor);
            bool boxing = this.state.drag == drag_kind::box;
            if (boxing && !down) {
                for (node_place& n : this.state.boxes) {
                    if (boxes_touch(n.bounds, box) && !contains_id(this.state.selected.as_span(), n.id)) {
                        this.state.selected.push(n.id);
                    }
                }
                for (link_place& l : this.state.links) {
                    if (path_touches(box, path_of(this.state.path, l)) && !contains_id(this.state.selected_links.as_span(), l.id)) {
                        this.state.selected_links.push(l.id);
                    }
                }
                this.state.drag = drag_kind::none;
            }
            // Keys.
            if (delete_key) {
                for (u64 n : this.state.selected) {
                    this.out.deleted_nodes.push(n);
                }
                for (u64 l : this.state.selected_links) {
                    this.out.deleted_links.push(l);
                }
                this.state.selected.clear();
                this.state.selected_links.clear();
            }
            if (all_key) {
                this.state.selected.clear();
                this.state.selected_links.clear();
                for (node_place& n : this.state.boxes) {
                    this.state.selected.push(n.id);
                }
                for (link_place& l : this.state.links) {
                    this.state.selected_links.push(l.id);
                }
            }
            if (duplicate_key && !this.state.selected.is_empty()) {
                this.out.duplicate = true;
            }
            if (fit_key) {
                this.state.fit_next = true;
            }
            if (this.state.drag == drag_kind::nodes && !down) {
                this.state.drag = drag_kind::none;
            }
            bool previewing = boxing && down;
            // The links, put under the nodes.
            {
                mut std::ui::draw_list under = default;
                under.begin(this.parent.ctx.frame_size);
                under.push_clip(r);
                {
                    mut std::ui::painter lp = std::ui::painter{ .list = under, .faces = this.parent.ctx.faces, .tokens = this.parent.ctx.look };
                    for (link_place& l : this.state.links) {
                        std::span<std::ui::vec2> points = path_of(this.state.path, l);
                        bool picked = contains_id(this.state.selected_links.as_span(), l.id);
                        link_part part = link_part{
                            .points = points,
                            .color = l.color,
                            .look = this.state.look.link,
                            .selected = picked,
                            .preview = previewing && !picked && path_touches(box, points),
                            .hovered = r.contains(cursor) && path_distance(cursor, points) < 6.0,
                            .dragging = false,
                            .zoom = z,
                        };
                        this.state.look.draw.link(mut lp, part);
                    }
                    for (reroute_place& d : this.state.reroutes) {
                        this.state.look.draw.reroute(mut lp, reroute_part{ .at = d.at, .color = d.color, .hovered = d.hovered, .dragging = d.dragging, .zoom = z });
                    }
                }
                under.pop_clip();
                this.parent.ctx.layers[this.parent.layer_index].list.insert(this.mark, under);
            }
            // The link being dragged, routed like the others.
            u32 dragged_first = cast::truncate<u32>(this.state.path.len());
            mut std::ui::color dragged_color = std::ui::color::transparent();
            match (start) {
                std::some(s) => {
                    std::ui::vec2 end = match (target) {
                        std::some(tp) => tp.at,
                        std::none => cursor,
                    };
                    std::ui::vec2 from = if (s.output) { s.at } else { end };
                    std::ui::vec2 to = if (s.output) { end } else { s.at };
                    route(mut this.state.path, mut this.state.corners, from, to, this.state.look.link, z, true, true);
                    dragged_color = s.style.color;
                },
                std::none => {},
            }
            u32 dragged_end = cast::truncate<u32>(this.state.path.len());
            mut std::ui::painter p = this.parent.painter();
            p.list.push_clip(r);
            if (dragged_end > dragged_first) {
                link_part part = link_part{
                    .points = this.state.path.as_span().slice(cast<usize>(dragged_first), cast<usize>(dragged_end)),
                    .color = dragged_color,
                    .look = this.state.look.link,
                    .selected = false,
                    .preview = false,
                    .hovered = false,
                    .dragging = true,
                    .zoom = z,
                };
                this.state.look.draw.link(mut p, part);
            }
            // The pins, over the nodes' edges.
            for (pin_place& pp : this.state.pins) {
                bool hovered = (pp.at - cursor).length() <= pin_reach;
                pin_part part = pin_part{
                    .at = pp.at,
                    .style = pp.style,
                    .output = pp.output,
                    .linked = contains_id(this.state.linked_now.as_span(), pp.id),
                    .hovered = hovered,
                    .radius = (this.state.look.pin_radius + if (hovered) { 1.5 } else { 0.0 }) * z.max(0.6),
                    .zoom = z,
                };
                this.state.look.draw.pin(mut p, part);
            }
            if (previewing) {
                this.state.look.draw.selection_box(mut p, box_part{ .bounds = box });
            }
            // The minimap: every node and the view, in the bottom-right corner.
            if (this.state.look.minimap && !this.state.boxes.is_empty()) {
                std::ui::color map_back = p.tokens.colors.surface.with_alpha(0.92);
                std::ui::color map_edge = p.tokens.colors.border;
                std::ui::color map_node = p.tokens.colors.text_faint;
                std::ui::color map_chosen = p.tokens.colors.primary;
                std::ui::color map_view = p.tokens.colors.text_muted;
                f32 map_radius = p.tokens.radius.small;
                mut std::ui::rect world = this.state.boxes[0].bounds;
                for (node_place& n : this.state.boxes) {
                    world = world.united(n.bounds);
                }
                world = world.united(r);
                f32 mw = 150.0;
                f32 mh = 96.0;
                std::ui::rect map = std::ui::rect{ .x = r.right() - mw - 10.0, .y = r.bottom() - mh - 10.0, .width = mw, .height = mh };
                f32 k = ((mw - 8.0) / world.width).min((mh - 8.0) / world.height);
                std::ui::vec2 o = std::ui::vec2{ .x = map.x + 4.0 + ((mw - 8.0) - world.width * k) * 0.5, .y = map.y + 4.0 + ((mh - 8.0) - world.height * k) * 0.5 };
                p.list.fill(map, map_back, map_radius);
                p.list.stroke(map, map_edge, map_radius, 1.0);
                for (node_place& n : this.state.boxes) {
                    bool sel = contains_id(this.state.selected.as_span(), n.id);
                    std::ui::rect m = std::ui::rect{ .x = o.x + (n.bounds.x - world.x) * k, .y = o.y + (n.bounds.y - world.y) * k, .width = (n.bounds.width * k).max(2.0), .height = (n.bounds.height * k).max(2.0) };
                    p.list.fill(m, if (sel) { map_chosen } else { map_node }, 1.0);
                }
                std::ui::rect seen = std::ui::rect{ .x = o.x + (r.x - world.x) * k, .y = o.y + (r.y - world.y) * k, .width = r.width * k, .height = r.height * k };
                p.list.stroke(seen, map_view, 1.0, 1.0);
            }
            p.list.pop_clip();
            this.state.path.truncate(cast<usize>(dragged_first));
            // Fit: the selection (or every node) in view, with a margin; applies next frame.
            if (this.state.fit_next && !this.state.boxes.is_empty()) {
                mut std::ui::rect all = default;
                mut bool any = false;
                for (node_place& n : this.state.boxes) {
                    if (this.state.selected.is_empty() || contains_id(this.state.selected.as_span(), n.id)) {
                        all = if (any) { all.united(n.bounds) } else { n.bounds };
                        any = true;
                    }
                }
                std::ui::vec2 low = this.to_canvas(all.origin());
                std::ui::vec2 high = this.to_canvas(std::ui::vec2{ .x = all.right(), .y = all.bottom() });
                f32 fit = ((r.width - 80.0) / (high.x - low.x).max(1.0)).min((r.height - 80.0) / (high.y - low.y).max(1.0)).clamp(0.35, 1.6);
                this.state.zoom = fit;
                std::ui::vec2 middle = (low + high) * 0.5;
                this.state.pan = std::ui::vec2{ .x = r.width * 0.5, .y = r.height * 0.5 } - middle * fit;
                this.state.fit_next = false;
            }
            this.state.linked.clear();
            for (u64 pin : this.state.linked_now) {
                _ = this.state.linked.insert(pin, true);
            }
            this.parent.ctx.look = this.look;
            this.finished = true;
            return std::take(mut this.out);
        }

        ~editor() {
            if (!this.finished) {
                this.parent.ctx.look = this.look;
            }
        }
    }

    view class node_view {
    public:
        void input(u64 pin, std::str label, pin_style style) mut {
            add_pin(mut this, pin, label, style, false);
        }

        void output(u64 pin, std::str label, pin_style style) mut {
            add_pin(mut this, pin, label, style, true);
        }

        std::ui::immediate::scope input_widget(u64 pin, std::str label, pin_style style) mut {
            f32 z = this.ed.state.zoom;
            u64 field_id = std::hash_combine(this.ed.id, std::hash_combine(this.id, std::hash_combine(pin, 0x696e6c)));
            if (this.collapsed || this.ed.state.linked.contains(pin)) {
                add_pin(mut this, pin, label, style, false);
                return this.ed.parent.hidden_region(field_id);
            }
            f32 content = this.ed.parent.state(field_id).content;
            f32 row = (this.ed.state.look.pin_row * z).round().max((content + 2.0).round());
            f32 top = this.cursor_y;
            f32 label_width = {
                mut std::ui::painter p = this.ed.parent.painter();
                std::ui::text_style text = p.tokens.style(std::ui::text_role::caption, p.tokens.colors.text_muted);
                p.measure(label, text).x
            };
            add_pin_row(mut this, pin, label, style, false, row);
            f32 left = this.bounds.x + 12.0 * z + label_width + 8.0 * z;
            std::ui::rect field = std::ui::rect{ .x = left.round(), .y = top + ((row - content) * 0.5).max(0.0).round(), .width = (this.bounds.right() - 10.0 * z - left).max(8.0), .height = content.max(4.0) + 2.0 };
            return this.ed.parent.region(field_id, field.intersection(this.ed.area), 0.0);
        }

        std::ui::immediate::scope body() mut {
            f32 z = this.ed.state.zoom;
            if (this.collapsed) {
                return this.ed.parent.hidden_region(std::hash_combine(this.ed.id, std::hash_combine(this.id, 0x626f6479)));
            }
            f32 pad = this.ed.state.look.padding * z;
            u64 body_id = std::hash_combine(this.ed.id, std::hash_combine(this.id, 0x626f6479));
            f32 content = this.ed.parent.state(body_id).content;
            std::ui::rect r = std::ui::rect{ .x = this.bounds.x + pad, .y = this.cursor_y, .width = this.bounds.width - 2.0 * pad, .height = content.max(4.0) + 2.0 };
            this.cursor_y = r.bottom();
            return this.ed.parent.region(body_id, r.intersection(this.ed.area), 0.0);
        }

        ~node_view() {
            if (this.collapsed) {
                return;
            }
            f32 z = this.ed.state.zoom;
            f32 height = (this.cursor_y + this.ed.state.look.padding * z - this.bounds.y) / z;
            _ = this.ed.state.heights.insert(this.id, height);
        }
    }

    // A pin's row: the label, and the pin on the node's edge (drawn at the end, over the edge).
    // While the node is collapsed, its pins sit on the header's edges and have no rows.
    private void add_pin(mut node_view& n, u64 pin, std::str label, pin_style style, bool output) {
        if (n.collapsed) {
            std::ui::vec2 at = std::ui::vec2{ .x = if (output) { n.bounds.right() } else { n.bounds.x }, .y = (n.bounds.y + n.bounds.height * 0.5).round() };
            n.ed.state.pins.push(pin_place{ .id = pin, .node = n.id, .at = at, .output = output, .style = style });
            return;
        }
        f32 row = (n.ed.state.look.pin_row * n.ed.state.zoom).round();
        add_pin_row(mut n, pin, label, style, output, row);
    }

    private void add_pin_row(mut node_view& n, u64 pin, std::str label, pin_style style, bool output, f32 row) {
        f32 z = n.ed.state.zoom;
        f32 y = n.cursor_y + row * 0.5;
        std::ui::vec2 at = std::ui::vec2{ .x = if (output) { n.bounds.right() } else { n.bounds.x }, .y = y.round() };
        n.ed.state.pins.push(pin_place{ .id = pin, .node = n.id, .at = at, .output = output, .style = style });
        pin_label_part part = pin_label_part{ .row = std::ui::rect{ .x = n.bounds.x, .y = n.cursor_y, .width = n.bounds.width, .height = row }, .label = label, .style = style, .output = output, .zoom = z };
        std::ui::rect clip = n.ed.area;
        usize layer = n.ed.parent.layer_index;
        mut std::ui::painter p = std::ui::painter{ .list = n.ed.parent.ctx.layers[layer].list, .faces = n.ed.parent.ctx.faces, .tokens = n.ed.parent.ctx.look };
        p.list.push_clip(clip);
        n.ed.state.look.draw.pin_label(mut p, part);
        p.list.pop_clip();
        n.cursor_y += row;
    }

    // A link through `via` (screen coordinates): routed run by run, from pin to point to pin.
    private void place_link(mut editor& ed, u64 link_id, u64 from, u64 to, std::span<std::ui::vec2> via) {
        mut std::option<pin_place> a = std::none;
        mut std::option<pin_place> b = std::none;
        for (pin_place& pp : ed.state.pins) {
            if (pp.id == from && pp.output) {
                a = std::some(pp);
            }
            if (pp.id == to && !pp.output) {
                b = std::some(pp);
            }
        }
        match (a) {
            std::some(pa) => {
                match (b) {
                    std::some(pb) => {
                        u32 first = cast::truncate<u32>(ed.state.path.len());
                        u32 mark_first = cast::truncate<u32>(ed.state.marks.len());
                        f32 z = ed.state.zoom;
                        link_look look = ed.state.look.link;
                        mut std::ui::vec2 last = pa.at;
                        mut bool from_pin = true;
                        for (std::ui::vec2 p : via) {
                            ed.state.marks.push(cast::truncate<u32>(ed.state.path.len()));
                            route(mut ed.state.path, mut ed.state.corners, last, p, look, z, from_pin, false);
                            last = p;
                            from_pin = false;
                        }
                        ed.state.marks.push(cast::truncate<u32>(ed.state.path.len()));
                        route(mut ed.state.path, mut ed.state.corners, last, pb.at, look, z, from_pin, true);
                        u32 count = cast::truncate<u32>(ed.state.path.len()) - first;
                        u32 mark_count = cast::truncate<u32>(ed.state.marks.len()) - mark_first;
                        ed.state.links.push(link_place{ .id = link_id, .from = pa.at, .to = pb.at, .color = pa.style.color, .first = first, .count = count, .mark_first = mark_first, .mark_count = mark_count });
                        ed.state.linked_now.push(from);
                        ed.state.linked_now.push(to);
                    },
                    std::none => {},
                }
            },
            std::none => {},
        }
    }

    std::result<std::darray<u64>, u64> topological_order(std::span<u64> nodes, std::span<edge> edges) {
        // Kahn's algorithm: repeatedly take a node no remaining edge points to.
        mut std::darray<usize> waiting = std::darray<usize>::with_capacity(nodes.len());
        for (usize i : 0..nodes.len()) {
            mut usize n = 0;
            for (edge e : edges) {
                if (e.to == nodes[i] && contains_id(nodes, e.from)) {
                    n += 1;
                }
            }
            waiting.push(n);
        }
        mut std::darray<u64> order = std::darray<u64>::with_capacity(nodes.len());
        mut std::darray<bool> done = std::darray<bool>::with_capacity(nodes.len());
        for (usize i : 0..nodes.len()) {
            done.push(false);
        }
        mut bool progress = true;
        while (progress) {
            progress = false;
            for (usize i : 0..nodes.len()) {
                if (done[i] || waiting[i] != 0) {
                    continue;
                }
                done[i] = true;
                progress = true;
                order.push(nodes[i]);
                for (edge e : edges) {
                    if (e.from == nodes[i]) {
                        for (usize j : 0..nodes.len()) {
                            if (nodes[j] == e.to && waiting[j] > 0) {
                                waiting[j] -= 1;
                            }
                        }
                    }
                }
            }
        }
        for (usize i : 0..nodes.len()) {
            if (!done[i]) {
                return std::error(nodes[i]);
            }
        }
        return std::ok(move order);
    }

    struct style {
        static style studio() {
            return style{};
        }

        static style metro() {
            mut style s = default;
            s.header_height = 32.0;
            s.pin_row = 24.0;
            s.pin_radius = 6.0;
            s.grid = grid_kind::dots;
            s.link = link_look{ .shape = link_shape::metro, .round_corners = true, .corner_radius = 16.0, .stub = 22.0, .width = 4.5, .halo = 0.0 };
            s.draw.canvas = [](mut std::ui::painter& p, canvas_part& c) { std::ui::nodes::painters::metro::canvas(mut p, c); };
            s.draw.node = [](mut std::ui::painter& p, node_part& n) { std::ui::nodes::painters::metro::node(mut p, n); };
            s.draw.pin = [](mut std::ui::painter& p, pin_part& n) { std::ui::nodes::painters::metro::pin(mut p, n); };
            s.draw.link = [](mut std::ui::painter& p, link_part& l) { std::ui::nodes::painters::metro::link(mut p, l); };
            return s;
        }

