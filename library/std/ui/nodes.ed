            t.colors.text_muted = std::ui::color::hex(0x4a4a4a);
            t.colors.border = std::ui::color::hex(0x1a1a1a);
            mut style s = default;
            s.header_height = 32.0;
            s.pin_row = 24.0;
            s.pin_radius = 5.5;
            s.grid = grid_kind::dots;
            s.grid_step = 22.0;
            s.link = link_look{ .shape = link_shape::curve, .round_corners = true, .corner_radius = 12.0, .stub = 20.0, .width = 3.0, .halo = 0.0 };
            s.canvas_theme = std::some(t);
            s.draw.canvas = [](mut std::ui::painter& p, canvas_part& c) { std::ui::nodes::painters::paper::canvas(mut p, c); };
            s.draw.node = [](mut std::ui::painter& p, node_part& n) { std::ui::nodes::painters::paper::node(mut p, n); };
            s.draw.pin = [](mut std::ui::painter& p, pin_part& n) { std::ui::nodes::painters::paper::pin(mut p, n); };
            s.draw.link = [](mut std::ui::painter& p, link_part& l) { std::ui::nodes::painters::paper::link(mut p, l); };
