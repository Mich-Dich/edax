            s.header_height = 28.0;
            s.grid_step = 20.0;
            s.major_every = 5;
            s.link = link_look{ .shape = link_shape::metro, .round_corners = false, .corner_radius = 0.0, .stub = 18.0, .width = 1.3, .halo = 0.0 };
            s.canvas_theme = std::some(t);
            s.draw.canvas = [](mut std::ui::painter& p, canvas_part& c) { std::ui::nodes::painters::blueprint::canvas(mut p, c); };
            s.draw.node = [](mut std::ui::painter& p, node_part& n) { std::ui::nodes::painters::blueprint::node(mut p, n); };
            s.draw.pin = [](mut std::ui::painter& p, pin_part& n) { std::ui::nodes::painters::blueprint::pin(mut p, n); };
            s.draw.link = [](mut std::ui::painter& p, link_part& l) { std::ui::nodes::painters::blueprint::link(mut p, l); };
            s.draw.frame = [](mut std::ui::painter& p, frame_part& f) { std::ui::nodes::painters::blueprint::frame(mut p, f); };
            return s;
        }

        static style neon() {
            mut std::ui::theme t = std::ui::theme::studio(std::ui::color::hex(0x22d3ee), std::ui::brightness::dark);
            t.colors.background = std::ui::color::hex(0x06060a);
