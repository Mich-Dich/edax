import std;

@std::test
void parses_negative_numbers() {
    run_time check ("-12".parse<i32>().value_or(0) == -12) else "parse failed";
}

@std::test
void trims_spaces() {
    run_time check ("  edax ".trim() == "edax") else "trim failed";
}

@std::test
void wrong_on_purpose() {
    run_time check ("7".parse<u32>().value_or(0) == 8) else "7 is not 8";
}
