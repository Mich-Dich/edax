// Uses the Edax module that g.import_c_headers generated from shapes/shapes.h and abi.h:
// constants, enums, structs (passed by value as C does), unions, callbacks.
import std;
import shapes_c;

extern(std::build::language::c) sh::big edax_big_twice(sh::big b) {
    return sh::big{ .m = [b.m[0] * 2.0, b.m[1] * 2.0, b.m[2] * 2.0] };
}

i32 main() {
    std::println(f"version {sh::SHAPES_VERSION} of '{sh::SHAPES_NAME}', limit {sh::SHAPES_LIMIT}, pi {sh::SHAPES_PI}");
    mut sh::shape square = sh::shape{ .kind = sh::shape_kind::SHAPE_SQUARE, .size = 2.0 };
    mut sh::shape circle = sh::shape{ .kind = sh::shape_kind::SHAPE_CIRCLE, .center = sh::point{ .x = 1, .y = 2 }, .size = 1.0 };
    square.tag[0] = 5;
    circle.tag[0] = 7;
    std::array<sh::shape, 2> list = [square, circle];
    sh::shape_visitor visit = [](std::raw_ptr<sh::shape> s, std::raw_ptr<mut u8> user) {
        unsafe {
            if (std::raw::read(s).kind == sh::shape_kind::SHAPE_SQUARE) {
                return 1i32;
            }
        }
        return 0;
    };
    unsafe {
        std::println(f"{sh::shapes_count()} shapes, scale {sh::shapes_scale()}");
        std::println(f"areas {sh::shape_area(&square)} {sh::shape_area(&circle)}");
        std::println(f"squares: {sh::shapes_visit(cast::reinterpret<std::raw_ptr<sh::shape>>(&list), 2, visit, nullptr)}");
        std::raw_ptr<mut sh::registry> r = sh::registry_make();
        sh::registry_add(r, square);
        sh::registry_add(r, circle);
        std::println(f"registry {sh::registry_size(r)}");
        sh::registry_free(r);
        mut sh::number n = sh::number{};
        n.set_real(1.25);
        sh::number twice = sh::number_twice(n, 1);
        std::println(f"union {twice.real()}");
        n.set_integer(21);
        std::println(f"union {sh::number_twice(n, 0).integer()}");
    }
    unsafe {
        sh::pair_i32 p = sh::abi_pair_swap(sh::pair_i32{ .a = 1, .b = 2 });
        std::println(f"pair {p.a} {p.b}");
        sh::vec3f v = sh::abi_vec_scale(sh::vec3f{ .x = 1.0f32, .y = 2.0f32, .z = 3.0f32 }, 2.0f32);
        std::println(f"vec {v.x} {v.y} {v.z}");
        sh::mixed m = sh::abi_mixed_next(sh::mixed{ .d = 1.0, .n = 41 });
        std::println(f"mixed {m.d} {m.n}");
        sh::small_ints si = sh::abi_small(sh::small_ints{ .a = 1, .b = 2, .c = 3 });
        std::println(f"small {si.a} {si.b} {si.c}");
        sh::big b = sh::abi_big_sum(sh::big{ .m = [1.0, 2.0, 3.0] }, sh::big{ .m = [10.0, 20.0, 30.0] });
        std::println(f"big {b.m[0]} {b.m[1]} {b.m[2]}");
        std::println(f"C calls Edax: {sh::abi_call_edax()}");
    }
    std::println(f"enum any = {cast<i32>(sh::shape_kind::SHAPE_ANY)}");
    return 0;
}
