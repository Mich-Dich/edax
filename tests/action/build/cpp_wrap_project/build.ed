// build.ed with g.wrap_cpp: C++ classes become Edax classes through generated C wrappers.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::target counter = g.add_c_library(std::build::c_target{
            .name = "counter", .language = std::build::language::cpp, .standard = std::build::cpp_standard::cpp20 });
        g.add_sources(counter, "counter/counter.cpp");
        g.add_include_dir(counter, "counter/include", std::build::visibility::shared);
        g.wrap_cpp(counter, std::build::cpp_wrap{
            .headers   = ["demo/counter.h"],
            .classes   = ["demo::Counter"],
            .templates = ["demo::Box<int>"],
            .module    = "counter_cpp",
            .namespace = "demo",
        });
        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
        g.link(app, counter);
    }
}
