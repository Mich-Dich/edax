// build.ed of a test project (spec 25): modes, an option, a C library, a Edax library, a
// program and a test.
import std;

namespace build {
    // release with debug info and link-time optimization, for profiling.
    open class profile : std::build::mode::release_with_debug_info {
    public:
        compile_time bool link_time_optimization() override { return true; }
    }

    // Fast and unchecked: for benchmarks only.
    class fast : std::build::mode::release {
    public:
        compile_time std::build::overflow overflow() override { return std::build::overflow::wrap; }
        compile_time std::build::bounds bounds() override { return std::build::bounds::unchecked; }
        compile_time bool allow_undefined_behavior() override { return true; }
    }

    // Panics are trap instructions; shift counts are masked. Still no undefined behaviour.
    class embedded : std::build::mode::debug {
    public:
        compile_time std::build::panic_behavior panic() override { return std::build::panic_behavior::trap; }
        compile_time std::build::shifts shifts() override { return std::build::shifts::mask; }
    }

    // Print more.
    compile_time std::build::setting<bool> verbose = default;

    compile_time void build(mut std::build::graph& g) {
        g.add_mode(profile);
        g.add_mode(fast);
        g.add_mode(embedded);
        bool chatty = g.option(verbose, std::build::mode_is(std::build::mode::debug), "Print more");
        std::build::target clib = g.add_c_library(std::build::c_target{ .name = "mathc" });
        g.add_sources(clib, "vendor/mathc.c");
        g.define(clib, "FACTOR", "3");
        std::build::target core = g.add_library(std::build::edax_target{ .name = "core", .root = "core/util.ed" });
        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
        g.link(app, core);
        g.link(app, clib);
        g.set(app, verbose, chatty);
        g.add_executable(std::build::edax_target{ .name = "shifter", .root = "app/shifter.ed" });
        std::build::target t = g.add_test(std::build::edax_target{ .name = "util_test", .root = "tests/util_test.ed" });
        g.link(t, core);
    }
}
