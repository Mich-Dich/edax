// build.rifts of a test project (spec 25): modes, an option, a C library, a Rift library, a
// program and a test.
import std;

/// release with debug info and link-time optimization, for profiling.
open class profile : std::build::mode::release_with_debug_info {
public:
    bool link_time_optimization() override { return true; }
}

/// Fast and unchecked: for benchmarks only.
class fast : std::build::mode::release {
public:
    std::build::overflow overflow() override { return std::build::overflow::wrap; }
    std::build::bounds bounds() override { return std::build::bounds::unchecked; }
    bool allow_undefined_behavior() override { return true; }
}

/// Panics are trap instructions; shift counts are masked. Still no undefined behaviour.
class embedded : std::build::mode::debug {
public:
    std::build::panic_behavior panic() override { return std::build::panic_behavior::trap; }
    std::build::shifts shifts() override { return std::build::shifts::mask; }
}

compile_time void build(mut std::build::graph& g) {
    g.add_mode(profile);
    g.add_mode(fast);
    g.add_mode(embedded);
    bool verbose = g.option<bool>("verbose", std::build::mode_is(std::build::mode::debug), "Print more");
    std::build::target clib = g.add_c_library(std::build::c_target{ .name = "mathc" });
    g.add_sources(clib, "vendor/mathc.c");
    g.define(clib, "FACTOR", "3");
    std::build::target core = g.add_library(std::build::rift_target{ .name = "core", .root = "core/util.rifts" });
    std::build::target app = g.add_executable(std::build::rift_target{ .name = "app", .root = "app/main.rifts" });
    g.link(app, core);
    g.link(app, clib);
    g.set(app, "verbose", verbose);
    g.add_executable(std::build::rift_target{ .name = "shifter", .root = "app/shifter.rifts" });
    std::build::target t = g.add_test(std::build::rift_target{ .name = "util_test", .root = "tests/util_test.rifts" });
    g.link(t, core);
}
