import std;
namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::target lib = g.add_library(std::build::edax_target{ .name = "fastlib", .root = "fastlib/fastlib.ed" });
        g.set_mode(lib, std::build::mode::release);
        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
        g.link(app, lib);
    }
}
