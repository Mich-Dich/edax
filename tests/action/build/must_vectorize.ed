// RUN: edaxc build -o %t/must_vectorize %s
// @std::simd::must_vectorize: the loop of scale() becomes vector code; the loop of chain() can't
// (a dependency between iterations), so the build fails with the reasons.
import std;

@std::simd::must_vectorize
void scale(std::span<mut f32> values, f32 factor) {
    for (usize i : 0..values.len()) {
        values[i] = values[i] * factor;
    }
}

@std::simd::must_vectorize
u64 chain(std::span<u64> values) {
    mut u64 x = 1;
    for (usize i : 0..values.len()) {
        x = x *% 31 +% values[i];
    }
    return x;
}

i32 main() {
    mut std::darray<f32> data = std::darray<f32>::from([1.0, 2.0, 3.0]);
    scale(data.as_mut_span(), 2.0);
    std::darray<u64> more = std::darray<u64>::from([1, 2, 3]);
    std::println(f"{data[2]} {chain(more.as_span())}");
    return 0;
}
