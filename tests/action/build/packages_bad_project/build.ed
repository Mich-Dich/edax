// A package whose CMakeLists.txt does something the CMake reader doesn't translate.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::package odd = g.package(std::build::package_spec{ .source = std::build::local{ .path = "vendor/odd" } });
        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
        g.link(app, odd.target("odd"));
    }
}
