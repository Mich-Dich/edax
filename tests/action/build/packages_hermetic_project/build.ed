// A package that links a library of the build machine (`dl`), which no `.uses` answers.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::package z = g.package(std::build::package_spec{ .source = std::build::local{ .path = "vendor/z" } });
        std::build::target app = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
        g.link(app, z.target("z"));
    }
}
