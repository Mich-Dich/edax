// build.ed with Edax plugins (dynamic libraries): two plugins of one interface, loaded by the
// program at run time, and one built against another interface.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        _ = g.add_plugin(std::build::edax_target{ .name = "shout", .root = "shout/shout.ed" });
        _ = g.add_plugin(std::build::edax_target{ .name = "quiet", .root = "quiet/quiet.ed" });
        _ = g.add_plugin(std::build::edax_target{ .name = "wrong", .root = "wrong/wrong.ed" });
        _ = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
    }
}
