// build.rifts with Rift plugins (dynamic libraries): two plugins of one interface, loaded by the
// program at run time, and one built against another interface.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        _ = g.add_plugin(std::build::rift_target{ .name = "shout", .root = "shout/shout.rifts" });
        _ = g.add_plugin(std::build::rift_target{ .name = "quiet", .root = "quiet/quiet.rifts" });
        _ = g.add_plugin(std::build::rift_target{ .name = "wrong", .root = "wrong/wrong.rifts" });
        _ = g.add_executable(std::build::rift_target{ .name = "app", .root = "app/main.rifts" });
    }
}
