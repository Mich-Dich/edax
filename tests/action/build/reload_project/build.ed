// build.ed for hot reload (dynamic libraries): three builds of one plugin; v2 adds and removes
// fields, v3 changes a field's type.
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        _ = g.add_plugin(std::build::edax_target{ .name = "v1", .root = "v1/game.ed" });
        _ = g.add_plugin(std::build::edax_target{ .name = "v2", .root = "v2/game.ed" });
        _ = g.add_plugin(std::build::edax_target{ .name = "v3", .root = "v3/game.ed" });
        _ = g.add_executable(std::build::edax_target{ .name = "app", .root = "app/main.ed" });
    }
}
