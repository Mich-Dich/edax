import std;

void main() {
    mut std::darray<u32> v = default;
    mut u32 x = 7;
    for (u32 i : 0..1000) {
        x = x *% 1103515245 +% 12345;
        v.push(x >> 16);
    }
    v.sort();
    mut bool sorted = true;
    for (usize i : 1..v.len()) {
        if (v[i - 1] > v[i]) { sorted = false; }
    }
    std::println(f"sorted {sorted}, first {v[0]}, last {v[999]}");
}
