// build.rifts with a step that writes a file it doesn't declare (spec 25: steps are verified).
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::target app = g.add_executable(std::build::rift_target{ .name = "app", .root = "app/main.rifts" });
        std::build::program sh = g.find_program("sh");
        std::build::path declared = g.output_path(std::build::path{ .text = "generated.txt" });
        std::build::path stray = g.output_path(std::build::path{ .text = "stray.txt" });
        std::build::step s = g.add_step(std::build::step_spec{ .name = "generate", .program = sh });
        g.add_arguments(s, ["-c", "echo one > \"$0\"; echo two > \"$1\"", declared.text, stray.text]);
        g.add_outputs(s, [declared]);
        g.depends_on(app, s);
    }
}
