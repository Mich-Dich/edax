// build.rifts with steps, globs, a system library and two local dependencies (spec 25).
import std;

namespace build {
    compile_time void build(mut std::build::graph& g) {
        std::build::target app = g.add_executable(std::build::rift_target{ .name = "app", .root = "app/main.rifts" });

        // A step per data file: copied into the build directory by an external program.
        std::build::program cp = g.find_program("cp");
        for (std::build::path file : g.glob("data/**/*.txt")) {
            std::build::path copy = g.output_path(file.with_extension("copy"));
            std::build::step s = g.add_step(std::build::step_spec{ .name = file.stem(), .program = cp });
            g.add_arguments(s, [file.text, copy.text]);
            g.add_inputs(s, [file]);
            g.add_outputs(s, [copy]);
            g.depends_on(app, s);
        }

        // libm, linked by name.
        std::build::target m = g.add_system_library(std::build::system_library{ .name = "m" });
        g.link(app, m);

        // A Rift library from a dependency with its own build.rifts.
        std::build::project geo = g.dependency(std::build::local{ .path = "vendor/geo" });
        g.link(app, g.target_of(geo, "geo"));

        // C sources of a dependency without a build.rifts.
        std::build::project csrc = g.dependency(std::build::local{ .path = "vendor/csrc" });
        std::build::target clib = g.add_c_library(std::build::c_target{ .name = "csrc" });
        g.add_sources(clib, g.glob_in(csrc, "src/*.c"));
        g.link(app, clib);
    }
}
