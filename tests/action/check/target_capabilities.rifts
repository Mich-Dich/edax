// RUN: riftc check --target=tests/action/check/target_board.rifts %s
// Library functions that need a capability the target lacks are errors at the call, with the
// library's message (and only that message). Code asks with std::build::target_has.
import std;

compile_time check (std::build::target_platform().os == std::build::os::none) else "no operating system";
compile_time check (std::build::target_platform().cpu == std::build::cpu::x86_64_v2) else "the description's CPU level";
compile_time check (std::build::target_has_cpu_feature(std::build::cpu_feature::sse4_2)) else "x86_64_v2 has SSE4.2";
compile_time check (!std::build::target_has_cpu_feature(std::build::cpu_feature::avx2)) else "but not AVX2";

u32 work() {
    if compile_time (std::build::target_has(std::build::capability::threads)) {
        std::thread::handle<u32> h = std::thread::spawn([]() { return 1u32; });   // not checked here
        return h.join();
    }
    return 1;
}

i32 main() {
    _ = work();
    std::thread::handle<u32> h = std::thread::spawn([]() { return 1u32; });
    std::result<std::file, std::io_error> f = std::file::open(std::filesystem::path::from("data.bin"));
    return 0;
}
