// RUN: edaxc check %s
// The @ui annotations check what they are written on (draft 35 §7.3): ranges, steps and units
// only on numbers, min <= max, a widget that fits the field's type.
import std;
namespace ui = std::ui;

struct settings {
    @ui::range{ .min = 0.0, .max = 1.0 }
    std::string name = default;
    @ui::range{ .min = 5.0, .max = 1.0 }
    f32 speed = 1.0;
    @ui::unit{ .text = "m" }
    bool flag = false;
    @ui::widget{ .kind = ui::widget_kind::checkbox }
    f32 volume = 0.5;
    @ui::step{ .value = 0.0 }
    f32 gain = 1.0;
}

void main() {
    settings s = default;
}
