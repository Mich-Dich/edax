// The file the cli/definition test asks `riftc definition` about.
import std;

struct point {
    i32 x = 0;
    static point make() { return point{ .x = 1 }; }
    i32 get() { return this.x; }
}

i32 main() {
    point p = point::make();
    i32 v = p.get();
    std::darray<i32> list = default;
    return p.x + v + cast::truncate<i32>(list.len());
}
