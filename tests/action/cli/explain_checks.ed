// RUN: edaxc explain-checks %s
// edaxc explain-checks (spec 34 §5): the checks of sum() go away (the loop stays in bounds), the
// one of pick() stays (the index comes from outside), and so does the overflow check of grow().
import std;

u64 sum(std::darray<u64>& xs) {
    mut u64 total = 0;
    for (usize i : 0..xs.len()) {
        total +%= xs[i];
    }
    return total;
}

u64 pick(std::darray<u64>& xs, usize i) {
    return xs[i];
}

u32 grow(u32 x) {
    return x * 3;
}

i32 main() {
    std::darray<u64> xs = std::darray<u64>::from([1, 2, 3]);
    std::println(f"{sum(xs)} {pick(xs, 1)} {grow(5)}");
    return 0;
}
