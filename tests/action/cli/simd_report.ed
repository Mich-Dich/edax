// RUN: edaxc simd-report %s
// edaxc simd-report: hardware forms, split and emulated operations, masked tails, multiversion
// copies and must_vectorize loops of each function, for the default CPU level.
import std;

void add_arrays(std::span<f32> a, std::span<f32> b, std::span<mut f32> result) {
    for (std::simd::block<8> at : std::simd::blocks<8>(result.len())) {
        result.store(at, a.load(at) + b.load(at));
    }
}

i32x16 divide(i32x16 a, i32x16 b) {
    return a / b;
}

u64x4 times(u64x4 a, u64x4 b) {
    return a * b;
}

@std::simd::multiversion{ .levels = [std::build::cpu::x86_64_v3, std::build::cpu::x86_64_v4] }
f32 total(std::span<f32> values) {
    compile_time usize w = std::simd::native_lanes<f32>();
    mut std::simd::vec<f32, w> acc = default;
    for (std::simd::block<w> at : std::simd::blocks<w>(values.len())) {
        acc = acc + values.load(at);
    }
    return acc.reduce_add();
}

@std::simd::must_vectorize
void scale(std::span<mut f32> values, f32 factor) {
    for (usize i : 0..values.len()) {
        values[i] = values[i] * factor;
    }
}

i32 main() { return 0; }
