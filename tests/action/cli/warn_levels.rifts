// RUN: riftc check --diagnostic-format=short --warn=warn_levels::noisy=off --warn=warn_levels::strict=error %s
// --warn switches the warnings of checks by their declared id (spec 23): `noisy` is off,
// `strict` became an error, `plain` stays a warning.
import std;

/// Switched off on the command line.
compile_time std::diagnostic noisy = default;
/// Made an error on the command line.
compile_time std::diagnostic strict = default;
/// Left alone.
compile_time std::diagnostic plain = default;

void f() {
    compile_time check {
        std::compile_warning(noisy, "noisy warning");
        std::compile_warning(strict, "strict warning");
        std::compile_warning(plain, "plain warning");
    }
}

void main() {
    f();
}
