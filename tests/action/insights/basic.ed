// RUN: edaxc insights %s
// What the compiler does implicitly (the VS Code extension's code insights).
import std;
struct big { f64 a = 0.0; f64 b = 0.0; f64 c = 0.0; }
f64 sum(big v) { return v.a + v.b + v.c; }
std::string greet(std::str who) {
    mut std::string out = std::string::from("hi ");
    out.push_str(who);
    return out;
}
std::exit_code main() {
    mut std::darray<u32> list = default;
    list.push(7);
    std::string name = std::string::from("Ann");
    std::string other = move name;
    big b = big{ .a = 1.0 };
    f64 t = sum(b);
    u32 count = cast::truncate<u32>(list.length());
    if (count) {
        std::string tmp = greet(other);
    }
    return std::exit_code::success;
}
