// RUN: riftc insights %s
// Insights follow the program: no "may allocate" for pushes into reserved capacity, certain
// allocations named, no drop for a moved value, no check that cannot fail, short text on the stack.
import std;

struct disk {
    f64 radius = 1.0;
}

enum shape : u8 {
    circle(disk),
    dot,
}

std::exit_code main() {
    mut std::darray<shape> shapes = default;
    shapes.reserve(6);
    shapes.push(shape::circle(disk{ .radius = 1.5 }));
    shapes.push(shape::dot);
    for (u32 i : 0..4) {
        shapes.push(shape::dot);
    }
    shapes.push(shape::dot);

    mut std::darray<u32> grow = default;
    grow.push(1);
    grow.push(2);
    grow.push(3);
    grow.push(4);
    grow.push(5);

    mut std::darray<u32> loop = std::darray<u32>::with_capacity(100);
    for (u32 i : 0..100) { loop.push(i); }
    for (u32 i : 0..10) { if (i > 5) { loop.push(i); } }

    mut std::string s = std::string::with_capacity(32);
    s.push_str("hello ");
    s.push_str("world");

    std::string other = std::string::from("x");
    std::string taken = move other;
    std::println(f"{shapes.len()} {grow.len()} {loop.len()} {s} {taken}");
    std::println(f"count {shapes.len()} ok {true}");
    u32 k = 7;
    u32 r = k % 4;
    return std::exit_code::success;
}
