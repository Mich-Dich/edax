// RUN: edaxc run %s
// Argument generators (spec 26): `f(for compile_time (P p : list) { decls; tail })` passes one
// argument per element; `p.pass(x)` passes x the way the parameter p is declared (`mut x` for a
// mutable reference). How std::ecs calls a query's lambda with its components.
import std;

struct position { f32 x = 0.0; }
struct velocity { f32 x = 0.0; }

template<type F>
void call_with_columns(mut F fn, std::raw_ptr<mut u8> a, std::raw_ptr<mut u8> b, usize n) {
    std::array<std::raw_ptr<mut u8>, 2> cols = [a, b];
    for (usize i : 0..n) {
        unsafe {
            fn(for compile_time (std::meta::parameter p : std::meta::parameters_of<F>()) {
                compile_time type t = p.type;
                p.pass(*cast::reinterpret<std::raw_ptr<mut t>>(cols[p.index]).offset(i))
            });
        }
    }
}

u32 sum3(u32 a, u32 b, u32 c) { return a + b + c; }

class bag {
public:
    // A method with a parameter pack (templates, "Parameter packs"): `this` in the walked body.
    template<type... C>
    void put(C... values) mut {
        for compile_time (C v : values) {
            this.names.push(std::format(f"{std::type_name<C>()}"));
            this.kept.push(std::format(f"{v.x}"));
        }
    }
    std::darray<std::string> names = default;
    std::darray<std::string> kept = default;
}

i32 main() {
    unsafe {
        std::raw_ptr<mut position> ps = std::raw::allocate<position>(3);
        std::raw_ptr<mut velocity> vs = std::raw::allocate<velocity>(3);
        for (usize i : 0..3) {
            std::raw::write(ps.offset(i), position{});
            std::raw::write(vs.offset(i), velocity{ .x = cast::round<f32>(i) + 1.0 });
        }
        call_with_columns([](mut position& p, velocity& v) { p.x += v.x * 2.0; },
                          cast::reinterpret<std::raw_ptr<mut u8>>(ps), cast::reinterpret<std::raw_ptr<mut u8>>(vs), 3);
        call_with_columns([](position& p, velocity& v) { std::println(f"{p.x} from {v.x}"); },
                          cast::reinterpret<std::raw_ptr<mut u8>>(ps), cast::reinterpret<std::raw_ptr<mut u8>>(vs), 3);
        std::raw::free(ps);
        std::raw::free(vs);
    }
    std::array<u32, 3> xs = [1, 2, 3];
    u32 total = sum3(for compile_time (usize k : 0..3) { xs[k] * 10 });
    std::println(f"{total}");
    mut bag b = bag{};
    b.put(position{ .x = 1.5 }, velocity{ .x = 2.5 });
    std::println(f"{b.names[0]} {b.kept[0]}, {b.names[1]} {b.kept[1]}");
    return 0;
}
