// RUN: edaxc run %s
// Fixed-size arrays, bitsets and checked element access returning std::option<T&> (spec 20).
import std;
struct cell { std::string name = ""; u32 n = 0; }
i32 main() {
    mut std::array<u32, 4> a = default;
    a[0] = 5;
    a[3] = 7;
    mut u32 sum = 0;
    for (u32 x : a) { sum += x; }
    std::println(f"{a.len()} {sum} {a.get(9).value_or(a[0])}");
    match (a.get(3)) {
        std::some(v) => std::println(f"got {v}"),
        std::none => std::println("none"),
    }
    mut std::array<cell, 3> cells = default;
    cells[1].name = std::string::from("middle");
    std::array<cell, 3> copy = cells.clone();
    std::println(f"[{copy[1].name}] {std::size_of<std::array<u32, 4>>()}");
    mut std::bitset<100> bits = default;
    bits.set(3, true);
    bits.set(99, true);
    bits.set(3, false);
    bits.set(64, true);
    std::println(f"{bits.test(99)} {bits.test(3)} {bits.count()} {std::size_of<std::bitset<100>>()}");
    mut std::darray<u32> d = default;
    d.push(1);
    std::println(f"{d.get(0).value_or(0)} {d.get(5).value_or(d[0])}");
    return 0;
}
