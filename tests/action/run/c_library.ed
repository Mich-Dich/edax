// RUN: edaxc run %s
// std::c_library: a C shared library loaded at run time, its functions looked up by name and
// called in unsafe; missing libraries and symbols are errors.
import std;

i32 main() {
    mut std::c_library libm = std::c_library::load("libm.so.6").expect("libm");
    std::c_library::function<f64(f64)> cosine = libm.function<f64(f64)>(c"cos").expect("cos");
    std::c_library::function<f64(f64, f64)> power = libm.function<f64(f64, f64)>(c"pow").expect("pow");
    unsafe {
        std::println(f"cos(0) = {cosine(0.0)}, pow(2, 10) = {power(2.0, 10.0)}");
    }
    std::println(f"{libm.function<f64(f64)>(c"no_such_function").is_error()}");
    std::println(f"{std::c_library::load("libdoes-not-exist.so").is_error()}");
    return 0;
}
