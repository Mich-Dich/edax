// RUN: edaxc run %s
// std::darray (spec 20), written in Edax with std::raw (spec 13): push, pop, index, clone,
// retain, sort_by_key, nested arrays and their destruction.
import std;
struct emp { u32 age = 0; f64 salary = 0.0; }
i32 structs() {
    mut std::darray<emp> v = default;
    v.push(emp{ .age = 25, .salary = 10.0 });
    v.push(emp{ .age = 40, .salary = 30.0 });
    v.push(emp{ .age = 35, .salary = 50.0 });
    v.push(emp{ .age = 31, .salary = 30.5 });
    v.retain([](emp& e) { return e.age >= 30; });
    v.sort_by_key(std::sort_order::descending, [](emp& e) { return e.salary; });
    std::println(f"{v.len()} {v[0].salary} {v[1].salary} {v[2].salary}");
    std::darray<emp> w = v.clone();
    std::println(f"{w.len()} {w[2].age}");
    return 0;
}
i32 nested() {
    mut std::darray<std::darray<u32>> grid = default;
    for (u32 r : 0..5) {
        mut std::darray<u32> row = default;
        for (u32 c : 0..r) { row.push(c); }
        grid.push(move row);
    }
    std::darray<std::darray<u32>> copy = grid.clone();
    std::option<std::darray<u32>> last = grid.pop();
    grid.retain([](std::darray<u32>& row) { return row.len() % 2 == 0; });
    std::println(f"{grid.len()} {copy.len()} {copy[4][3]}");
    return 0;
}
i32 numbers() {
    mut std::darray<u32> v = default;
    for (u32 i : 0..20) { v.push(i * i); }
    v[0] = 99;
    std::println(f"{v.len()} {v[19]} {v[0]} {v.is_empty()}");
    u32 last = v.pop().value_or(0);
    std::println(f"{last} {v.len()}");
    return 0;
}

i32 main() {
    numbers();
    structs();
    nested();
    return 0;
}
