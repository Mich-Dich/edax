// RUN: riftc run %s
// cast::dynamic (spec 07, 17) through a three-level hierarchy, and virtual methods introduced in
// the middle of it.
import std;
open class animal {
public:
    u32 legs = 0;
    virtual std::str sound() { return "..."; }
}
open class dog : animal {
public:
    std::str sound() override { return "woof"; }
    virtual u32 tricks() { return 3; }
}
class puppy : dog {
public:
    u32 tricks() override { return 1; }
}
class cat : animal {
public:
    std::str sound() override { return "meow"; }
}

void inspect(animal& a) {
    match (cast::dynamic<dog&>(a)) {
        std::some(d) => std::println(f"a dog: {d.sound()} {d.tricks()} {d.legs}"),
        std::none => std::println(f"not a dog: {a.sound()}"),
    }
}

i32 main() {
    puppy p = puppy{ .legs = 4 };
    cat c = cat{ .legs = 4 };
    dog d = dog{ .legs = 3 };
    inspect(p);
    inspect(c);
    inspect(d);
    dog& dr = p;
    std::println(f"{dr.tricks()} {dr.dog::tricks()}");
    return 0;
}
