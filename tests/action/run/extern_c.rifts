// RUN: riftc run %s
// extern(std::build::language::c) functions (spec 13): imported from the C library and called inside unsafe (one
// alone, the others in an extern block), and Rift functions exported to C (callable from Rift
// without unsafe).
import std;
extern(std::build::language::c) i32 puts(std::raw_ptr<u8> text);

extern(std::build::language::c) {
    i32 abs(i32 x);
    std::raw_ptr<mut u8> malloc(usize n);
    void free(std::raw_ptr<mut u8> p);
}

/// Exported: C sees it as `int rift_compare(const void*, const void*)`.
extern(std::build::language::c) i32 rift_compare(std::raw_ptr<i32> a, std::raw_ptr<i32> b) {
    unsafe { return *a - *b; }
}

extern(std::build::language::c) bool rift_is_even(i32 x) { return x % 2 == 0; }

i32 main() {
    unsafe {
        i32 written = puts(c"hello from C");   // a C string: NUL-terminated
        std::println(f"{abs(-7)} {written >= 0}");
        std::raw_ptr<mut u8> buf = malloc(4);
        *buf = 65u8;
        *buf.offset(1) = 0u8;
        puts(buf);
        free(buf);
    }
    i32 x = 3;
    i32 y = 5;
    std::println(f"{rift_is_even(4)} {rift_is_even(7)} {rift_compare(&x, &y)}");
    return 0;
}
