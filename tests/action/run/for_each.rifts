// RUN: riftc run %s
// for-loops over containers and streams (spec 10): by value, by reference, mutably, over a
// temporary, and over a stream whose elements are owned.
import std;
struct emp { u32 age = 0; std::darray<u32> tags; }

class countdown {
public:
    u32 left = 0;
    std::option<std::darray<u32>> next() mut {
        if (this.left == 0) { return std::none; }
        this.left -= 1;
        mut std::darray<u32> d = default;
        d.push(this.left);
        return std::some(move d);
    }
}

std::darray<u32> make() {
    mut std::darray<u32> d = default;
    d.push(7); d.push(8);
    return move d;
}

i32 main() {
    mut std::darray<u32> v = default;
    for (u32 i : 0..5) { v.push(i); }
    mut u32 sum = 0;
    for (u32 x : v) { sum += x; }
    for (mut u32& x : v) { x *= 10; }
    for (u32& x : v) { if (x == 30) { break; } sum += x; }
    for (u32 x : make()) { sum += x; }
    mut u32 got = 0;
    for (std::darray<u32> d : countdown{ .left = 4 }) {
        if (d[0] == 2) { continue; }
        got += d[0];
    }
    std::println(f"{sum} {v[4]} {got}");
    return 0;
}
