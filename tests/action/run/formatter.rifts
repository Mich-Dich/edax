// RUN: riftc run %s
// std::formatter: a type's format method writes through it and can read the hole's spec.
import std;
struct money {
    i64 cents;
    void format(mut std::formatter& out) {
        std::format_spec s = out.spec();
        out.write(std::format(f"${this.cents / 100}.{this.cents % 100:>02}"));
        if (s.width > 0) { out.write("!"); }
    }
}
@std::derive::formattable
struct point { f64 x; f64 y; }
std::exit_code main() {
    money m = money{ .cents = 1234 };
    std::println(f"[{m}] [{m:>12}] {point{ .x = 1.0, .y = 2.5 }}");
    return std::exit_code::success;
}
