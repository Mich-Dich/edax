// RUN: edaxc run %s
// Inheritance and interfaces (spec 07): base fields in derived literals, virtual and abstract
// methods, this.base::method(), destructor order, interface references (fat pointers) and
// template constraints.
import std;

open class shape {
public:
    std::string name = "";
    virtual f64 area() abstract;
    virtual std::string describe() {
        return std::format(f"{this.name} with area {this.area()}");
    }
    ~shape() { std::println(f"drop shape {this.name}"); }
}

class circle : shape {
public:
    f64 radius = 0.0;
    f64 area() override { return 3.0 * this.radius * this.radius; }
    std::string describe() override {
        std::string base = this.shape::describe();
        return std::format(f"circle: {base}");
    }
    ~circle() { std::println("drop circle"); }
}

class square : shape {
public:
    f64 side = 0.0;
    f64 area() override { return this.side * this.side; }
}

interface printable {
    std::string to_text();
}

struct point : printable {
    f64 x = 0.0;
    f64 y = 0.0;
    std::string to_text() override { return std::format(f"({this.x}, {this.y})"); }
}

void show(shape& s) {
    std::println(s.describe());
}

void print_it(printable& p) {
    std::println(p.to_text());
}

template<type T : printable>
void print_one(T& item) {
    std::println(item.to_text());
}

i32 main() {
    circle c = circle{ .name = std::string::from("c1"), .radius = 2.0 };
    square q = square{ .name = std::string::from("q1"), .side = 3.0 };
    show(c);
    show(q);
    shape& s = c;
    std::println(f"{s.area()}");
    point p = point{ .x = 1.0, .y = 2.5 };
    print_it(p);
    print_one(p);
    printable& pr = p;
    print_it(pr);
    return 0;
}
