// RUN: edaxc run %s
// Lambdas (spec 18): every capture kind, calls, lambdas passed to templates, map_error, and
// `deduce` return types per instance (spec 15).
import std;

enum parse_error : u8 { bad }
enum app_error : u8 { config, other }

template<type F>
u32 apply_twice(F f, u32 x) {
    return f(f(x));
}

template<type T>
deduce double_it(T x) {
    if compile_time (std::is_integer<T>()) {
        return cast<i64>(x) * 2;
    } else {
        return cast<f64>(x) * 2.0;
    }
}

std::result<u32, parse_error> parse(u32 x) {
    if (x > 9) { return std::error(parse_error::bad); }
    return std::ok(x);
}

std::result<u32, app_error> load(u32 x) {
    u32 v = parse(x).map_error([](parse_error e) { return app_error::config; })?;
    return std::ok(v);
}

void main() {
    mut u32 counter = 0;
    u32 threshold = 10;
    auto inc  = [mut &counter]() { counter += 1; };
    auto add  = [threshold](u32 x) { return x + threshold; };
    auto init = [value = 10u32](u32 x) -> u32 { return x + value; };
    auto noop = []() { };
    inc();
    inc();
    noop();
    std::println(f"counter {counter}, add {add(5)}, init {init(1)}");
    std::println(f"twice {apply_twice(add, 1)} {apply_twice([](u32 x) { return x * 3; }, 2)}");
    std::println(f"deduce {double_it(21i32)} {double_it(1.25f64)}");
    match (load(4)) {
        std::ok(v) => std::println(f"ok {v}"),
        std::error(e) => std::println("error"),
    }
    match (load(40)) {
        std::ok(v) => std::println(f"ok {v}"),
        std::error(e) => std::println(f"error {cast<u8>(e)}"),
    }
}
