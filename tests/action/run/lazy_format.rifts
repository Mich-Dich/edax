// RUN: riftc run %s
// An f-string passed as a std::format_args is evaluated only if it is formatted (spec 31).
import std;

u32 noisy(u32 x) {
    std::println(f"noisy({x}) ran");
    return x;
}

void maybe(bool on, std::format_args message) {
    if (on) {
        std::println(move message);
    }
}

struct counter {
    u32 n = 4;
    void show(bool on) {
        maybe(on, f"counter {this.n}, doubled {noisy(this.n) * 2}");
    }
}

u32 main() {
    u32 a = 5;
    std::string text = std::string::from("text");
    maybe(false, f"never {noisy(a)}");
    maybe(true, f"once {noisy(a)} {text} {text.len()}");
    counter{}.show(false);
    counter{}.show(true);
    maybe(true, "a plain literal");
    mut std::log::session logs = std::log::start(std::log::options{});
    std::log::history h = std::log::history::make(8);
    _ = logs.add(std::log::memory::make(h), std::log::sink_options{
        .min_level = std::log::level::warn,
        .pattern = std::log::pattern::from("{message}"),
    });
    std::log::info(f"below every sink: {noisy(1)}");
    std::log::warn(f"taken: {noisy(2)}");
    logs.flush();
    for (std::string& line : h.snapshot()) {
        std::println(f"logged: {line}");
    }
    return 0;
}
