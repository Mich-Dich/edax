// RUN: edaxc run %s
// std::log::assert and std::log::validate (spec 31): the condition is always checked; a failure
// is logged (assert: fatal, validate: error) and the call returns false, so `else { ... }` can
// recover. Success messages are trace records.
import std;

struct texture {
    u32 id = 0;
    bool is_valid() { return this.id != 0; }
}

bool bind(texture& t) {
    std::log::validate(t.is_valid(), f"bound texture {t.id}", f"texture {t.id} is invalid") else {
        return false;
    }
    return true;
}

u32 checked_index(u32 index, u32 count) {
    std::log::assert(index < count, f"index {index} out of {count}") else {
        return 0;
    }
    return index;
}

u32 main() {
    mut std::log::session logs = std::log::start(std::log::options{});
    _ = logs.add(std::log::console::make(), std::log::sink_options{ .pattern = std::log::pattern::from("{level} {function_name}:{line} {message}") });
    bool good = bind(texture{ .id = 4 });
    bool bad = bind(texture{});
    u32 inside = checked_index(2, 5);
    u32 outside = checked_index(7, 5);
    bool kept = std::log::assert(true, "never shown");
    logs.flush();
    std::println(f"{good} {bad} {inside} {outside} {kept}");
    std::println("still running");
    return 0;
}
