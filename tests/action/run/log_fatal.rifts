// RUN: riftc run %s
// std::log::fatal logs, writes every queued record and flushes every sink, then returns: the
// program decides what happens next (spec 31).
import std;

u32 attempt(u32 n) {
    if (n < 2) {
        std::log::fatal(f"attempt {n} failed, resetting");
        return 0;
    }
    return n;
}

u32 main() {
    mut std::log::session logs = std::log::start(std::log::options{});
    _ = logs.add(std::log::console::make(), std::log::sink_options{ .pattern = std::log::pattern::from("{level} {file_name}:{line} {message}") });
    std::log::warn("starting");
    mut u32 n = 0;
    while (attempt(n) == 0) {
        n += 1;
    }
    std::log::info(f"succeeded on attempt {n}");
    return 0;
}
