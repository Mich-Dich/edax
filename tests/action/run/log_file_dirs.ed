// RUN: edaxc run %s
// The file sink creates the directories above its file (spec 31); std::filesystem::parent and
// create_directories.
import std;

u32 main() {
    std::filesystem::path dir = std::filesystem::executable_dir() / "logs" / "nested";
    std::filesystem::path log_path = dir / "app.log";
    std::println(f"{std::filesystem::path::from("logs/app.log").parent().as_str()}|{std::filesystem::path::from("/app.log").parent().as_str()}|{std::filesystem::path::from("app.log").parent().as_str()}|");
    {
        mut std::log::session logs = std::log::start(std::log::options{});
        _ = logs.add(std::log::file::create(std::log::file_options{ .path = log_path.clone() }).expect("can't open the log file"),
                     std::log::sink_options{ .pattern = std::log::pattern::from("{level} {message}") });
        std::log::info("into a new directory");
    }
    mut std::file in = std::file::open(log_path).expect("the log file exists");
    for (std::str line : in.lines()) {
        if (line.starts_with("INFO")) { std::println(line); }
    }
    // Existing directories are fine; a file in the way is an error.
    std::println(f"{std::filesystem::create_directories(dir).is_ok()}");
    std::filesystem::path blocked = log_path / "sub";
    std::result<void, std::io_error> r = std::filesystem::create_directories(blocked);
    std::println(f"{r.is_error()}");
    return 0;
}
