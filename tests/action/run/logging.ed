// RUN: edaxc run %s
// std::log (spec 31): sinks with their own levels, patterns and filters, changes in message
// order, records from before the session, threads, a file sink and lazy messages.
import std;

@std::log::level_override{ .level = std::log::level::debug };

private compile_time std::log::pattern short_pattern = std::log::pattern::from("{level:<5}|{function_name}|{file_name}:{line}|{message}");
private compile_time std::log::pattern brackets = std::log::pattern::from("[{level:^7}] {{{message}}}");

u32 expensive(u32 x) {
    std::println(f"expensive({x}) ran");
    return x;
}

struct worker {
    u32 id = 0;

    void run() {
        std::log::trace(f"worker {this.id}: trace is below the file's level (removed)");
        std::log::debug(f"worker {this.id} runs");
    }

    @std::log::level_override{ .level = std::log::level::trace }
    void verbose() {
        std::log::trace(f"worker {this.id}: trace through a function override");
    }
}

u32 main() {
    std::log::info("before the session");
    mut std::log::session logs = std::log::start(std::log::options{});
    std::log::history all = std::log::history::make(400);
    std::log::history problems = std::log::history::make(64);
    _ = logs.add(std::log::memory::make(all), std::log::sink_options{ .pattern = short_pattern });
    std::log::sink_id p = logs.add(std::log::memory::make(problems), std::log::sink_options{
        .min_level = std::log::level::warn,
        .pattern = brackets,
    });
    worker{ .id = 1 }.run();
    worker{ .id = 2 }.verbose();
    std::log::debug(f"lazy: {expensive(1)}");   // a sink takes debug: formatted
    logs.set_level(p, std::log::level::error);
    std::log::warn("only the first sink");
    std::log::error("both sinks");
    logs.remove(p);
    std::log::error("first sink only again");
    mut std::darray<std::thread::handle<void>> threads = default;
    for (u32 t : 0..3) {
        threads.push(std::thread::spawn([t]() {
            for (u32 i : 0..100) {
                std::log::warn(f"thread {t} message {i}");
            }
        }));
    }
    threads.clear();   // joins
    logs.flush();
    for (std::string& line : all.snapshot()) {
        if (line.as_str().contains("thread ")) {
            continue;
        }
        std::println(f"all: {line}");
    }
    for (std::string& line : problems.snapshot()) {
        std::println(f"problems: {line}");
    }
    std::println(f"history keeps {all.snapshot().len()} lines");
    return 0;
}
