// RUN: edaxc run %s
// Randomized tree_map (B-tree) and hash_map (SwissTable) inserts/removes checked against a reference.
import std;
// Random inserts/removes on tree_map and hash_map, checked against a plain bitmap of present keys.
i32 main() {
    mut std::tree_map<u32, std::string> t = default;
    mut std::hash_map<u32, std::string> h = default;
    mut std::darray<bool> present = default;
    mut std::darray<u32> values = default;
    for (u32 i : 0..3000) { present.push(false); values.push(0); }
    mut u32 x = 12345;
    for (u32 step : 0..60000) {
        x ^= x << 13;
        x ^= x >> 17;
        x ^= x << 5;
        u32 key = x % 3000;
        u32 op = (x >> 16) % 3;
        usize k = cast<usize>(key);
        if (op < 2) {
            std::option<std::string> old = t.insert(key, std::format(f"v{step}"));
            std::option<std::string> old2 = h.insert(key, std::format(f"v{step}"));
            run_time check (old.is_some() == present[k]) else f"insert {key}: old {old.is_some()} present {present[k]}";
            run_time check (old2.is_some() == present[k]) else "hash insert";
            present[k] = true;
            values[k] = step;
        } else {
            std::option<std::string> gone = t.remove(key);
            std::option<std::string> gone2 = h.remove(key);
            run_time check (gone.is_some() == present[k]) else f"remove {key}: got {gone.is_some()} present {present[k]}";
            run_time check (gone2.is_some() == present[k]) else "hash remove";
            present[k] = false;
        }
        if (step % 997 == 0) {
            mut usize n = 0;
            mut u32 prev = 0;
            mut bool first = true;
            for (std::map_entry<u32, std::string> e : t.entries()) {
                run_time check (first || prev < e.key) else "order";
                run_time check (present[cast<usize>(e.key)]) else "extra key";
                std::string want = std::format(f"v{values[cast<usize>(e.key)]}");
                run_time check (e.value == want) else "value";
                first = false;
                prev = e.key;
                n += 1;
            }
            mut usize hn = 0;
            for (std::map_entry<u32, std::string> e : h.entries()) { hn += 1; }
            run_time check (n == t.len() && hn == h.len() && n == hn) else f"len {n} {t.len()} {hn}";
        }
    }
    mut usize count = 0;
    for (usize i : 0..3000) {
        u32 key = cast::truncate<u32>(i);
        run_time check (t.contains(key) == present[i]) else "contains";
        run_time check (h.contains(key) == present[i]) else "hash contains";
        if (present[i]) { count += 1; }
    }
    std::println(f"ok {count} {t.len()} first {t.first().is_some()}");
    match (t.last()) {
        std::some(e) => std::println(f"last {e.key}"),
        std::none => { },
    }
    t.get_or_insert(5000, std::string::from("x")).push_str("y");
    std::println(t[5000]);
    return 0;
}
