// RUN: riftc run %s
// match (mut x): the bindings are the parts of x, and writing them changes x (spec 10).
import std;
enum shape : u8 { circle(f64), square(f64), empty }
struct pt { i32 x = 0; i32 y = 0; }
i32 main() {
    mut shape s = shape::circle(1.0);
    match (mut s) {
        shape::circle(r) => { r *= 2.0; },
        shape::square(side) => { side += 1.0; },
        shape::empty => {},
    }
    match (s) {
        shape::circle(r) => std::println(f"{r}"),
        _ => {},
    }
    mut pt p = pt{ .x = 1, .y = 2 };
    match (mut p) {
        pt{ .x = x, .. } => { x = 10; },
    }
    std::println(f"{p.x}");
    return 0;
}
