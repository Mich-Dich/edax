// RUN: edaxc run %s
// std::meta::parameters_of<F>() (spec 26): the parameters of a lambda or callable type, with their
// names, types (without the reference) and passing: what an ECS reads from a system's signature.
import std;

struct position { f32 x = 0.0; }
struct velocity { f32 x = 0.0; }

template<type F>
void describe(F& system) {
    for compile_time (std::meta::parameter p : std::meta::parameters_of<F>()) {
        compile_time type t = p.type;
        std::str access = if (p.passing == std::meta::passing::by_mut_reference) { "writes" }
                          else if (p.passing == std::meta::passing::by_reference) { "reads" } else { "takes" };
        std::println(f"{p.index}: {p.name} {access} {std::type_name<t>()}");
    }
    std::println(f"{std::meta::parameters_of<F>().len()} parameters");
}

i32 main() {
    f32 dt = 0.5;
    describe([dt](mut position& p, velocity& v) { p.x += v.x * dt; });
    describe([](u32 n) { std::println(f"{n}"); });
    describe([]() {});
    return 0;
}
