// RUN: riftc run %s
// Method templates (spec 14): deduced from the arguments, on plain types and class templates.
import std;
struct box {
    u32 v = 0;
    template<type F>
    u32 apply(F f) { return f(this.v); }
}
i32 main() {
    box b = box{ .v = 4 };
    std::println(f"{b.apply([](u32 x) { return x * 3; })}");
    return 0;
}
