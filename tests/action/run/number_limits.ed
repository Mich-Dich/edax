// RUN: edaxc run %s
// Limits of number types: T::min, T::max, T::bits, float infinity/nan/epsilon (types).
import std;
std::exit_code main() {
    u32 a = u32::max;
    i8 b = i8::min;
    u32 w = u64::bits;
    f64 inf = f64::infinity;
    std::println(f"{a} {b} {w} {inf} {f32::epsilon}");
    return std::exit_code::success;
}
