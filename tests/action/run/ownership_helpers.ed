// RUN: edaxc run %s
// std::take, std::replace and std::swap (spec 12), and std::span from a darray (spec 20).
import std;
struct holder { std::string text = ""; std::darray<u32> list; }
i32 main() {
    mut holder h = holder{ .text = std::string::from("first"), .list = default };
    h.list.push(1);
    std::string old = std::take(mut h.text);
    std::println(f"[{old}] [{h.text}]");
    std::string prev = std::replace(mut h.text, std::string::from("second"));
    std::println(f"[{prev}] [{h.text}]");
    mut std::string a = std::string::from("a");
    mut std::string b = std::string::from("b");
    std::swap(mut a, mut b);
    mut u32 x = 1;
    mut u32 y = 2;
    std::swap(mut x, mut y);
    std::println(f"{a} {b} {x} {y}");
    std::darray<u32> l = std::take(mut h.list);
    std::println(f"{l.len()} {h.list.len()}");
    spans();
    return 0;
}
u32 sum(std::span<u32> values) {
    mut u32 total = 0;
    for (u32 v : values) { total += v; }
    return total;
}
i32 spans() {
    mut std::darray<u32> d = default;
    d.push(3); d.push(4);
    std::println(f"{sum(d.as_span())} {d.as_span()[1]}");
    return 0;
}
