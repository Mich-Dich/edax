// RUN: riftc run %s
// std::set_panic_hook: the hook gets the message, where and the thread name before the panic ends the program.
import std;
std::exit_code main() {
    _ = std::set_panic_hook([](std::panic_info& info) {
        std::eprintln(f"hook: '{info.message}' at {info.where.file_name}:{info.where.line} on '{info.thread_name}'");
    });
    std::darray<u32> empty = default;
    u32 x = empty[3];
    return std::exit_code::success;
}
