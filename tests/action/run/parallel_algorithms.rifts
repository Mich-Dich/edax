// RUN: riftc run %s
// std::parallel: sort, sort_by, sort_by_key, find, any, all and transform on a thread pool.
import std;
std::exit_code main() {
    std::thread_pool pool = std::thread_pool::make(std::thread_pool::options{ .threads = 4 });
    mut std::darray<i64> items = default;
    mut u64 x = 12345;
    for (usize i : 0..50000) {
        x = x *% 6364136223846793005 +% 1442695040888963407;
        items.push(cast::truncate<i64>(x >> 40));
    }
    std::parallel::sort(pool, items.as_mut_span());
    mut bool sorted = true;
    for (usize i : 1..items.len()) { if (items[i - 1] > items[i]) { sorted = false; } }
    std::println(f"sorted {sorted}");
    std::parallel::sort_by(pool, items.as_mut_span(), [](i64& a, i64& b) { return a > b; });
    std::println(f"desc {items[0] >= items[1] && items[1] >= items[2]}");
    std::option<usize> big = std::parallel::find(pool, items.as_span(), [](i64& v) { return v < 100; });
    std::println(f"find {big.is_some()} any {std::parallel::any(pool, items.as_span(), [](i64& v) { return v == -1; })} all {std::parallel::all(pool, items.as_span(), [](i64& v) { return v >= 0; })}");
    mut std::darray<i64> doubled = default;
    doubled.resize(items.len(), 0);
    std::parallel::transform(pool, items.as_span(), doubled.as_mut_span(), [](i64& v) { return v * 2; });
    std::println(f"transform {doubled[10] == items[10] * 2} {doubled[49999] == items[49999] * 2}");
    std::parallel::sort_by_key(pool, items.as_mut_span(), std::sort_order::ascending, [](i64& v) { return v % 1000; });
    std::println(f"key {items[0] % 1000 <= items[1] % 1000}");
    return std::exit_code::success;
}
