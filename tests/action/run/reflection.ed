// RUN: edaxc run %s
// Reflection added in design v0.10 (spec 26): methods and calling them, parameters,
// interfaces, template arguments, annotations on types, and enum <-> name.
import std;

annotation(std::meta::target::function) struct command { std::static_str word; }
annotation(std::meta::target::type) struct component { std::static_str kind = "plain"; }

interface named {
    std::static_str label();
}

@component{ .kind = "terminal" }
class shell : named {
public:
    u32 resets = 0;
    @command{ .word = "status" } void show_status() { std::println(f"status: {this.resets} resets"); }
    @command{ .word = "reset" }  void reset() mut { this.resets += 1; }
    void plain(u32 count, mut u32& total, std::str note) { }
    std::static_str label() override { return "shell"; }
    static u32 version() { return 7; }
}

// The command table is the methods themselves (spec 26, example 5).
bool dispatch(mut shell& sh, std::str input) {
    for compile_time (std::meta::function m : std::meta::methods<shell>()) {
        if compile_time (m.has<command>()) {
            if (input == m.annotation<command>().expect("has").word) {
                if compile_time (m.is_mut) { m.call(mut sh); } else { m.call(sh); }
                return true;
            }
        }
    }
    return false;
}

template<type K, type V>
struct entry { K key; V value; }

enum color : u8 { red, green, blue }

void main() {
    mut shell sh = default;
    _ = dispatch(mut sh, "reset");
    _ = dispatch(mut sh, "reset");
    _ = dispatch(mut sh, "status");
    std::println(f"unknown: {dispatch(mut sh, "nope")}");
    for compile_time (std::meta::function m : std::meta::methods<shell>()) {
        std::print(f"{m.name}/{m.parameters.len()}{if (m.is_mut) { "mut" } else { "" }} ");
    }
    std::println("");
    for compile_time (std::meta::function m : std::meta::methods<shell>()) {
        if compile_time (m.name == "plain") {
            for compile_time (std::meta::parameter p : m.parameters) {
                std::print(f"{p.index}:{p.name}:{std::meta::name_of(p.passing)} ");
            }
        }
        if compile_time (m.is_static) {
            std::print(f"{m.name}() = {m.call()} ");
        }
    }
    std::println("");
    compile_time type first_arg = std::meta::template_args<entry<u32, std::str>>()[0];
    std::println(f"interfaces: {std::meta::interfaces<shell>().len()}, args: {std::meta::template_args<entry<u32, std::str>>().len()}, first: {std::type_name<first_arg>()}");
    std::println(f"{std::meta::has_annotation<component, shell>()} {std::meta::annotation<component, shell>().expect("has").kind}");
    std::println(f"{std::meta::name_of(color::green)} {std::meta::from_name<color>("blue").is_some()} {std::meta::from_name<color>("pink").is_some()}");
    color c = std::meta::from_name<color>("red").value_or(color::blue);
    std::println(f"{c}");
}
