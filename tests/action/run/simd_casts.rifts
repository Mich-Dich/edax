// RUN: riftc run %s
// SIMD: lane-by-lane casts, bit casts, and an overflowing lane panics like a scalar.
import std;
std::exit_code main() {
    i32x4 a = [1, 2, 3, 4];
    f64x4 f = cast<f64x4>(a);
    u8x4 t = cast::truncate<u8x4>(i32x4::splat(300));
    i8x4 s = cast::saturate<i8x4>(i32x4::splat(300));
    u32x4 bits = f32x4::splat(1.0).to_bits();
    std::println(f"{f[3]} {t[0]} {s[1]} {bits[0]} {f32x4::from_bits(bits)[2]}");
    i32x4 big = i32x4::splat(2147483647);
    i32x4 boom = big + a;
    std::println(f"{boom[0]}");
    return std::exit_code::success;
}
