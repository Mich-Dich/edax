// RUN: riftc run %s
// span split_at gives two non-overlapping views as a tuple; std::span<mut T> changes elements.
import std;
std::exit_code main() {
    mut std::darray<i64> items = std::darray<i64>::from([5, 1, 4, 2, 3]);
    (std::span<mut i64> left, std::span<mut i64> right) = items.as_mut_span().split_at(2);
    left[0] = 50;
    right[0] = 40;
    auto (a, b) = items.as_span().split_at(3);
    std::println(f"{items.len()} {a.len()} {b.len()} {items[0]} {items[2]} {b[0]}");
    return std::exit_code::success;
}
