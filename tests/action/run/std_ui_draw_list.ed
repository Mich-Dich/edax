// RUN: edaxc run %s
// std::ui's core without a GPU: themes from an accent, text measuring and wrapping, and what the
// draw list holds after shapes, text and images (the draw data is plain data a test can check).
import std;
namespace ui = std::ui;

void main() {
    ui::theme dark = ui::theme::dark();
    ui::theme light = ui::theme::light();
    std::println(f"text on surface >= 4.5: {dark.colors.text_muted.contrast(dark.colors.surface) >= 4.5} {light.colors.text_muted.contrast(light.colors.surface) >= 4.5}");
    std::println(f"on_primary readable: {dark.colors.on_primary.contrast(dark.colors.primary) >= 3.0}");
    std::println(f"mix ends: {ui::theme::mix(dark, light, 1.0).colors.background == light.colors.background}");

    mut ui::fonts fonts = ui::fonts::make();
    ui::text_style body = dark.style(ui::text_role::body, dark.colors.text);
    std::println(f"line height {fonts.line_height(body)}, 'Hello' wider than 'Hi': {fonts.measure("Hello", body).x > fonts.measure("Hi", body).x}");
    std::darray<ui::text_line> lines = fonts.wrap("one two three four five six seven eight nine ten", body, 100.0);
    std::println(f"{lines.len()} lines, all within 100: {lines[0].width <= 100.0 && lines[1].width <= 100.0}");

    mut ui::draw_list list = default;
    list.begin(ui::vec2{ .x = 400.0, .y = 300.0 });
    ui::rect card = ui::rect{ .x = 10.0, .y = 10.0, .width = 200.0, .height = 100.0 };
    list.shadow(card, 12.0, dark.elevation(2), dark.colors.shadow);
    list.fill(card, dark.colors.surface, 12.0);
    list.stroke(card, dark.colors.border, 12.0, 1.0);
    _ = list.text(mut fonts, ui::vec2{ .x = 20.0, .y = 20.0 }, "Hi", body);
    list.push_clip(ui::rect{ .x = 0.0, .y = 0.0, .width = 50.0, .height = 50.0 });
    list.circle(ui::vec2{ .x = 25.0, .y = 25.0 }, 10.0, dark.colors.primary);
    list.pop_clip();
    list.image(ui::texture{ .id = 7, .width = 4, .height = 4 }, card, ui::rect{ .width = 1.0, .height = 1.0 }, ui::color::white(), 0.0);
    std::println(f"{list.vertices.len()} vertices, {list.indices.len()} indices, {list.commands.len()} commands");
    for (ui::draw_command c : list.commands) {
        std::println(f"  clip {c.clip.width}x{c.clip.height} texture {c.image.id} indices {c.first_index}+{c.index_count}");
    }
}
