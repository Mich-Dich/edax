// RUN: edaxc run %s
// The studio look and the editor widgets of std::ui (draft 35): theme::studio's tokens, the icon
// set, icon buttons and toggles, spacers in rows, the height left in a panel, and menus (open on a
// click, switch on hover while open, close on an item or a press elsewhere).
import std;
namespace ui = std::ui;
namespace im = std::ui::immediate;

struct seen {
    bool saved = false;
    bool grid = false;
    ui::rect after_spacer = default;
    f32 left_below = 0.0;
    ui::rect file_at = default;
    ui::rect edit_at = default;
    bool open = false;
}

seen frame_of(mut im::context& ctx, mut bool& grid, ui::input in) {
    mut seen out = default;
    {
        mut im::frame f = ctx.begin_frame(move in, ui::vec2{ .x = 800.0, .y = 600.0 });
        {
            mut im::scope top = f.panel(std::hash("bar"), ui::rect{ .width = 800.0, .height = 40.0 }, 3, 8.0);
            mut im::scope bar = top.row();
            out.file_at = bar.allocate(ui::vec2{});
            {
                mut im::scope file = bar.menu("File");
                out.open = out.open || file.open();
                _ = file.menu_item(ui::icon::folder, "Open", "Ctrl+O");
                if (file.menu_item(ui::icon::save, "Save", "Ctrl+S")) {
                    out.saved = true;
                }
            }
            out.edit_at = bar.allocate(ui::vec2{});
            {
                mut im::scope edit = bar.menu("Edit");
                out.open = out.open || edit.open();
                _ = edit.menu_check("Snap", mut grid);
            }
            _ = bar.icon_toggle(ui::icon::grid, mut grid, "Grid");
            bar.spacer();
            out.after_spacer = bar.allocate(ui::vec2{ .x = 24.0, .y = 24.0 });
        }
        {
            mut im::scope body = f.panel(std::hash("body"), ui::rect{ .y = 40.0, .width = 800.0, .height = 560.0 }, 2, 10.0);
            body.text(f"one line");
            out.left_below = body.available_height();
        }
        f.finish();
    }
    out.grid = grid;
    return out;
}

ui::input at(ui::vec2 p) {
    return ui::input{ .cursor = p, .dt = 0.016 };
}

seen click(mut im::context& ctx, mut bool& grid, ui::vec2 p) {
    _ = frame_of(mut ctx, mut grid, ui::input{ .cursor = p, .mouse_down = true, .mouse_pressed = true, .dt = 0.016 });
    return frame_of(mut ctx, mut grid, ui::input{ .cursor = p, .mouse_released = true, .dt = 0.016 });
}

void main() {
    ui::theme t = ui::theme::studio(ui::color::hex(0x3b82f6), ui::brightness::dark);
    std::println(f"studio: row {t.controls.row_height}, tabs {t.controls.window.tab_height}, gap {t.controls.window.dock_gap}, body {t.typography.body.size} px, bools as {t.controls.boolean}, gradient {t.controls.button.gradient}");
    std::println(f"neutral: surface {t.colors.surface.r == t.colors.surface.g && t.colors.surface.g < t.colors.surface.b + 0.02}, primary bluish {t.colors.primary.b > t.colors.primary.r}");

    // Every icon draws something but none.
    mut ui::draw_list l = default;
    l.begin(ui::vec2{ .x = 100.0, .y = 100.0 });
    mut u32 empty = 0;
    mut u32 count = 0;
    for compile_time (std::meta::alternative a : std::meta::alternatives<ui::icon>()) {
        usize before = l.vertices.length();
        l.draw_icon(a.make(), ui::rect{ .width = 16.0, .height = 16.0 }, ui::color::white());
        if (l.vertices.length() == before) {
            empty += 1;
        }
        count += 1;
    }
    std::println(f"icons: {count}, drawing nothing: {empty}");

    mut im::context ctx = im::context::create(t);
    ctx.skin() = ui::skin::studio();
    mut bool grid = false;
    _ = frame_of(mut ctx, mut grid, at(ui::vec2{}));
    seen a = frame_of(mut ctx, mut grid, at(ui::vec2{}));
    std::println(f"spacer: the last widget ends at {a.after_spacer.right()} of 792, height left {a.left_below > 500.0}, duplicates {ctx.duplicate_ids()}");

    // The grid toggle: after the two menus.
    ui::vec2 toggle = ui::vec2{ .x = a.edit_at.x + 60.0, .y = 20.0 };
    seen b = click(mut ctx, mut grid, toggle);
    std::println(f"toggle: grid {b.grid}");

    // Open File, hover Edit (it opens instead), back to File, click Save.
    ui::vec2 file = ui::vec2{ .x = a.file_at.x + 12.0, .y = 20.0 };
    ui::vec2 edit = ui::vec2{ .x = a.edit_at.x + 12.0, .y = 20.0 };
    seen c = click(mut ctx, mut grid, file);
    std::println(f"file menu open: {c.open}");
    _ = frame_of(mut ctx, mut grid, at(edit));
    seen d = frame_of(mut ctx, mut grid, at(edit));
    std::println(f"hovering Edit keeps a menu open: {d.open}");
    // Snap is the Edit menu's first item: a click flips it, the menu stays open.
    seen e = click(mut ctx, mut grid, ui::vec2{ .x = edit.x + 20.0, .y = 58.0 });
    std::println(f"snap: grid {e.grid}, still open {e.open}");
    _ = frame_of(mut ctx, mut grid, at(file));
    _ = frame_of(mut ctx, mut grid, at(file));
    seen g = click(mut ctx, mut grid, ui::vec2{ .x = file.x + 20.0, .y = 82.0 });
    std::println(f"save clicked: {g.saved}, open after {frame_of(mut ctx, mut grid, at(ui::vec2{})).open}");

    // A press elsewhere closes an open menu.
    _ = click(mut ctx, mut grid, file);
    seen h = click(mut ctx, mut grid, ui::vec2{ .x = 400.0, .y = 300.0 });
    std::println(f"closed by a press elsewhere: {!h.open}");
}
