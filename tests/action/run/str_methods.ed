// RUN: edaxc run %s
// The methods of std::str (written in the library: trim, split, parse, starts_with, ...) and
// checked/saturating arithmetic (spec 16).
import std;
i32 main() {
    std::str line = "  Ada Lovelace,36,1234.5  ";
    std::str t = line.trim();
    std::darray<std::str> parts = t.split(',');
    std::println(f"[{t}] {parts.len()} [{parts[0]}] [{parts[1]}] [{parts[2]}]");
    u32 age = parts[1].parse<u32>().value_or(0);
    f64 salary = parts[2].parse<f64>().value_or(0.0);
    bool ada = parts[0].starts_with("Ada");
    bool love = t.contains("Love");
    std::println(f"{age} {salary} {ada} {love}");
    std::str min = "-128";
    std::str over = "128";
    std::str bad = "x1";
    i8 m = min.parse<i8>().value_or(0);
    bool o = over.parse<i8>().value_or(0) == 0;
    bool b = bad.parse<u32>().value_or(7) == 7;
    std::println(f"{m} {o} {b}");
    arith();
    return 0;
}
i32 arith() {
    u8 a = 200;
    u8 b = 100;
    i8 c = -100;
    std::println(f"{std::saturating_add(a, b)} {std::saturating_sub(b, a)} {std::saturating_mul(c, 2i8)} {std::saturating_mul(c, -2i8)}");
    std::option<u8> sum = std::checked_add(a, b);
    std::option<u8> fits = std::checked_add(a, 55u8);
    std::println(f"{sum.value_or(0)} {fits.value_or(0)} {std::checked_mul(c, 1i8).value_or(0)}");
    return 0;
}
