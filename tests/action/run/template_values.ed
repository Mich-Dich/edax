// RUN: edaxc run %s
// Template value parameters (spec 14): values in types, value parameters in bodies, and
// compile_time checks in type bodies per instance (spec 23).
import std;

template<type T, usize N>
struct ring_buffer {
    compile_time check (N > 0) else f"ring_buffer<{std::type_name<T>()}, 0>: capacity must be at least 1";
    compile_time check ((N & (N - 1)) == 0) else f"ring_buffer capacity must be a power of two, got {N}";
    T first;
    usize count = 0;

    usize capacity() { return N; }
    usize mask() { return N - 1; }
}

template<usize N>
u64 power_of_two() {
    return 1u64 << cast<u64>(N);
}

template<usize N>
struct grid {
    u32 cells = 0;
    usize area() { return N * N; }
}

compile_time usize side = 3;

void main() {
    ring_buffer<u32, 16> a = ring_buffer<u32, 16>{ .first = 7 };
    std::println(f"capacity {a.capacity()}, mask {a.mask()}, first {a.first}");
    std::println(f"2^10 = {power_of_two<10>()}");
    grid<side> g = grid<side>{};
    grid<side + 1> h = grid<side + 1>{};
    std::println(f"areas {g.area()} {h.area()}");
}
