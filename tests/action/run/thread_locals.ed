// RUN: edaxc run %s
// thread_local (spec 27): one copy per thread, initialized at compile time; statics are shared.
import std;
struct counts { u32 a = 5; u64 b = 7; }
thread_local mut counts mine = default;
thread_local mut u32 calls = 100;
static std::atomic<u32> total = default;
static u32 limit = 3;
void bump() {
    calls += 1;
    mine.a += 10;
    _ = total.fetch_wrapping_add(1, std::memory_order::relaxed);
}
i32 main() {
    bump();
    bump();
    std::thread::handle<u32> other = std::thread::spawn([]() {
        bump();
        return calls * 1000 + mine.a;
    });
    std::println(f"other thread saw {other.join()}");
    std::println(f"main {calls} {mine.a} {mine.b} total {total.load(std::memory_order::acquire)} limit {limit}");
    return 0;
}
