// RUN: riftc run %s
// std::time: duration units, arithmetic and formatting, instants, the calendar clock.
import std;
std::exit_code main() {
    std::time::duration d = std::time::duration::milliseconds(1500);
    std::println(f"{std::time::duration::nanoseconds(250)} {std::time::duration::microseconds(1500)} {d} {std::time::duration::seconds(192)} {std::time::duration::hours(2)}");
    std::println(f"{(d + d).as_seconds()} {(d * 3).as_milliseconds()} {d < d * 2} {d == std::time::duration::seconds(1) + std::time::duration::milliseconds(500)}");
    std::time::instant a = std::time::instant::now();
    std::time::instant b = a + std::time::duration::seconds(1);
    std::println(f"{b.since(a)} {std::time::wall_time{ .seconds = 86400 }.utc().day} {std::time::wall_time::now().unix_nanoseconds() > 0}");
    std::println(f"{a.since(b)}");
    return std::exit_code::success;
}
