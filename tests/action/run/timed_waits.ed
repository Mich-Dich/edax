// RUN: edaxc run %s
// std::rw_mutex, try_lock_for, condition::wait_for, receive_for, and temporaries destroyed at the end of the statement.
import std;

struct counts {
    u64 a = 0;
    u64 b = 0;
}

std::static_str describe(std::result<u32, std::receive_error> r) {
    match (r) {
        std::ok(v) => { if (v == 7) { return "7"; } return "?"; },
        std::error(e) => {
            match (e) {
                std::receive_error::empty => { return "empty"; },
                std::receive_error::closed => { return "closed"; },
                std::receive_error::timed_out => { return "timed out"; },
            }
        },
    }
}

i32 main() {
    std::rw_mutex<counts> shared = std::rw_mutex<counts>::make(counts{});
    {
        std::read_guard<counts> r1 = shared.read();
        std::read_guard<counts> r2 = shared.read();
        std::println(f"two readers: {r1->a} {r2->b}");
        std::option<std::write_guard<counts>> w = shared.try_write();
        std::println(f"write while reading: {w.is_some()}");
    }
    {
        mut std::write_guard<counts> w = shared.write();
        w->a = 5;
        std::println(f"try_read while writing: {shared.try_read().is_some()}");
    }
    mut std::darray<std::thread::scoped_handle<void>> running = default;
    mut usize t = 0;
    while (t < 4) {
        running.push(std::thread::spawn([&shared]() {
            mut usize i = 0;
            while (i < 10000) {
                if (i % 10 == 0) {
                    mut std::write_guard<counts> w = shared.write();
                    w->a += 1;
                    w->b += 1;
                } else {
                    std::read_guard<counts> r = shared.read();
                    run_time check (r->a == r->b + 5) else "torn";
                }
                i += 1;
            }
        }));
        t += 1;
    }
    running.clear();
    std::println(f"a = {shared.read()->a}");

    std::mutex<u32> m = std::mutex<u32>::make(1);
    {
        std::mutex_guard<u32> g = m.lock();
        std::thread::scoped_handle<bool> other = std::thread::spawn([&m]() { return m.try_lock_for(std::time::duration::milliseconds(20)).is_some(); });
        std::println(f"timed lock while held: {other.join()}");
    }
    std::println(f"timed lock free: {m.try_lock_for(std::time::duration::milliseconds(20)).is_some()}");

    std::condition c = default;
    mut std::mutex_guard<u32> g = m.lock();
    std::time::instant start = std::time::instant::now();
    bool ok = c.wait_for(mut g, [](u32& v) { return v == 2; }, std::time::duration::milliseconds(30));
    std::println(f"wait_for: {ok}, waited >= 30ms: {start.elapsed() >= std::time::duration::milliseconds(30)}");
    g.unlock();

    std::channel<u32> ch = std::channel<u32>::bounded(4);
    std::channel_receiver<u32> rx = ch.receiver();
    std::println(f"empty: {describe(rx.receive_for(std::time::duration::milliseconds(10)))}");
    _ = ch.sender().send(7);
    std::println(f"one: {describe(rx.receive_for(std::time::duration::milliseconds(10)))}");
    ch.close();
    std::println(f"closed: {describe(rx.receive_for(std::time::duration::milliseconds(10)))}");
    return 0;
}
