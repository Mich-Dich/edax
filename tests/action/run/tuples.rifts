// RUN: riftc run %s
// Tuples: values, destructuring, elements, patterns, comparisons, nesting (tuples and list literals).
import std;
(u32, u32) min_max(std::span<u32> values) {
    mut u32 lo = u32::max;
    mut u32 hi = 0;
    for (u32 v : values) {
        if (v < lo) { lo = v; }
        if (v > hi) { hi = v; }
    }
    return (lo, hi);
}
std::exit_code main() {
    std::array<u32, 4> data = [5, 3, 9, 1];
    (u32 lo, u32 hi) = min_max(data.as_span());
    auto (a, b) = min_max(data.as_span());
    (u32, u32) both = min_max(data.as_span());
    (mut u32 x, _) = (7u32, 8u32);
    x += 1;
    std::println(f"{lo} {hi} {a} {b} {both.0} {both.1} {x}");
    std::str label = match (both) {
        (0, _) => "zero",
        (l, h) if l == h => "same",
        _ => "other",
    };
    std::println(label);
    if (both == (1u32, 9u32)) { std::println("equal"); }
    ((u32, bool), std::string) nested = ((1u32, true), std::string::from("s"));
    std::println(f"{nested.0.0} {nested.0.1} {nested.1}");
    return std::exit_code::success;
}
