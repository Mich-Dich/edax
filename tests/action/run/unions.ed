// RUN: edaxc run %s
// Unions (spec 34): members share memory, a literal zeroes the rest, `= default` equality
// compares the bytes.
import std;

union bits32 {
    u32 word;
    f32 number;
    u16 low;

    bool operator==(bits32& other) = default;
}

union wide {
    u8 small;
    f64 big;
}

struct packet {
    u8 kind;
    bits32 value;
}

void main() {
    mut bits32 b = bits32{ .number = 1.0 };
    u32 w = unsafe { b.word };
    std::println(f"1.0 = 0x{w:x}, size {std::size_of<bits32>()}, align {std::align_of<bits32>()}");
    b.word = 0x40490FDB;
    unsafe { std::println(f"pi ~ {b.number}, low half = {b.low}"); }
    std::println(f"wide: size {std::size_of<wide>()} align {std::align_of<wide>()}");
    wide x = wide{ .small = 7 };
    unsafe { std::println(f"wide big bits zeroed: {std::bit_cast<u64>(x.big)}"); }
    packet p = packet{ .kind = 1, .value = bits32{ .word = 5 } };
    unsafe { std::println(f"packet {p.kind} {p.value.word} size {std::size_of<packet>()}"); }
    bits32 c = bits32{ .word = 0x3F800000 };
    bits32 d = bits32{ .number = 1.0 };
    std::println(f"same bits: {c == d}");
}
