// RUN: edaxc run %s
// View structs hold references: building one binds the places, reading goes through them (spec 12).
import std;
view struct pair { i32& first; i32& second; }
template<type T> view struct one { T& item; }
i32 main() {
    i32 x = 1;
    mut i32 y = 2;
    y = 20;
    pair p = pair{ .first = x, .second = y };
    one<i32> o = one<i32>{ .item = y };
    std::println(f"{p.first} {p.second} {y} {o.item}");
    return 0;
}
