// RUN: riftc run %s
// Wrapping annotations on a function template and on a method of a class template: every
// instance gets the wrap.
import std;

annotation(std::meta::target::function)
struct traced {
    wrap {
        std::println(f"enter {annotated.name}");
        if compile_time (annotated.result == void) {
            std::meta::wrapped_body();
            std::println("leave");
        } else {
            auto result = std::meta::wrapped_body();
            std::println("leave");
            return move result;
        }
    }
}

@traced
template<type T>
T twice(T x) {
    return x + x;
}

template<type T>
class box {
public:
    @traced
    void show() {
        std::println(f"box of {this.value}");
    }

    T value;
}

i32 main() {
    std::println(f"{twice(21u32)}");
    std::println(f"{twice(1.5f64)}");
    box<u8> b = box<u8>{ .value = 7 };
    b.show();
    return 0;
}
