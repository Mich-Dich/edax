// A '{' left open inside a call: the '}' that lines up with the outer '{' closes that one, so
// the mistake is reported once, at the inner '{' (and nothing else in the file).
struct size { u32 width = 0; u32 height = 0; }
struct config { size size = default; u32 count = 0; }

u32 count_of(config c) { return c.count; }

u32 f() {
    return count_of(config{
        .size = size{ .width = 480,               //~ error[E2016]: unclosed '{'
    });
}

u32 g() {
    return 1;
}
