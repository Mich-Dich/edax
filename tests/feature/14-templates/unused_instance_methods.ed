// feature 14: a method of a class template instance only has to compile when it is used.
import std;
struct item { u32 n = 0; }

void f(std::darray<std::unique_ptr<item>> list, item plain) {
    u32 count = cast::truncate<u32>(list.length());     // fine: length() compiles for any T
    auto copy = list.clone();                         //~ error[E4214]: 'std::darray<std::unique_ptr<item>>::clone' does not compile
    u32 bad = plain->n;                               //~ error[E4074]: '->' needs a pointer
}
