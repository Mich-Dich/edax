// A compile_time check with a user-defined operator runs the operator (spec 16, 23); an operator
// that isn't compile_time is an error, never a check that passes unseen.
import std;

struct ver {
    u32 major = 0;
    u32 minor = 0;
    bool operator==(ver& other) = default;
    compile_time run_time std::ordering operator<=>(ver& other) {
        if (this.major != other.major) { return this.major <=> other.major; }
        return this.minor <=> other.minor;
    }
}

struct plain {
    u32 n = 0;
    std::ordering operator<=>(plain& other) { return this.n <=> other.n; }
}

compile_time ver two = ver{ .major = 2 };
compile_time check (two < ver{ .major = 3 }) else "2.0 < 3.0";
compile_time check ((two <=> ver{ .major = 1, .minor = 9 }) == std::ordering::greater) else "2.0 > 1.9";
compile_time check (two >= ver{ .major = 3 }) else "needs 3.0";          //~ error[E4210]: needs 3.0
compile_time check (two != ver{ .major = 2 }) else "not 2.0";           //~ error[E4210]: not 2.0
compile_time check (plain{ .n = 1 } < plain{ .n = 2 }) else "plain";    //~ error[E4200]: 'operator<=>' of 'plain' is not a compile_time function

template<ver V>
class needs_three {
    compile_time check (V >= ver{ .major = 3 }) else "needs_three: needs 3.0";
}

void f() {
    needs_three<two> n = default;     //~ error[E4210]: needs_three: needs 3.0
}
