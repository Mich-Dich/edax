// feature 31: an annotation followed by ';' at the top of a .ed annotates the file.
import std;

@std::log::level_override{ .level = std::log::level::info };

@only_functions;                                     //~ error[E3071]: '@only_functions' can't be written on a file

annotation(std::meta::target::function) struct only_functions { }

u32 main() {
    return 0;
}
